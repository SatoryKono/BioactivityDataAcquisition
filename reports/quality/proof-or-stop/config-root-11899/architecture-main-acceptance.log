        scripts = manifest["scripts"]
        zero_ref_rows = [
            row
            for row in scripts
            if row.get("status") == "supporting" and row.get("reference_count") == 0
        ]
        # The zero-reference supporting-script ratchet may only decrease.
        assert (
            len(zero_ref_rows)
