p()]\n    if dirty_entries:\n        pytest.skip(\n            \"Committed module-coverage inventory is only authoritative for a clean \"\n            \"src/bioetl tree. Dirty entries: \" + \", \".join(dirty_entries[:20])\n        )"]}
