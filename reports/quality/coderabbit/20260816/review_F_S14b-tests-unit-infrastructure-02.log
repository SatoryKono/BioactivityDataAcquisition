r(\n            f\"{module_path}.resolve_configs_root\", _resolve_configs_root\n        )\n    load_pipeline_config_cached.cache_clear()\n    load_source_config.cache_clear()\n    return configs_root\n\n\n@pytest.fixture(autouse=True)\ndef _clear_config_caches():\n    load_pipeline_config_cached.cache_clear()\n    load_source_config.cache_clear()\n    yield\n    load_pipeline_config_cached.cache_clear()\n    load_source_config.cache_clear()"]}
