h suppress(OSError):\n            path.chmod(0o700)\n            st = path.stat()\n            mode = stat.S_IMODE(st.st_mode)\n        if mode & 0o077:\n            raise OSError(\n                f\"private runtime path is not owner-private (mode={oct(mode)}): {path}\"\n            )"]}
