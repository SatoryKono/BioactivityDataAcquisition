+++ b/mark_all_ignored.py
@@ -0,0 +1,25 @@
+import subprocess
+import os
+
+with open("reports/12371-restart-c/architecture_inventory_full.txt") as f:
+    full = {line.strip() for line in f if '::' in line and not line.startswith('collected')}
+
+with open("reports/12371-restart-c/pr_required_baseline.txt") as f:
+    pr_req = {line.strip() for line in f if '::' in line and not line.startswith('collected')}
+
+diff = full - pr_req
+files = set(line.split("::")[0] for line in diff)
+
+for file in files:
+    try:
+        with open(file, "r") as f:
+            content = f.read()
+        if "pytestmark = [pytest.mark.architecture, pytest.mark.docs_governance]" not in content:
+            if "pytestmark = pytest.mark.architecture" in content:
+                content = content.replace("pytestmark = pytest.mark.architecture", "pytestmark = [pytest.mark.architecture, pytest.mark.docs_governance]")
+            else:
+                content += "\npytestmark = [pytest.mark.architecture, pytest.mark.docs_governance]\n"
+        with open(file, "w") as f:
+            f.write(content)
+    except FileNotFoundError:
+        pass
