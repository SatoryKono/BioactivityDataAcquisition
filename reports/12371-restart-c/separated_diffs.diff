--- /dev/null
+++ b/split_pr_required.py
@@ -0,0 +1,22 @@
+import re
+
+with open(".github/workflows/pr-required.yml") as f:
+    text = f.read()
+
+# Replace the ignore arguments with a simpler marker expression
+text = text.replace(
+    '--parallel-marker "not slow and not benchmark and not memory and not serial"',
+    '--parallel-marker "not slow and not benchmark and not memory and not serial and not docs_governance"'
+)
+
+text = text.replace(
+    '--serial-marker "serial and not slow and not benchmark and not memory"',
+    '--serial-marker "serial and not slow and not benchmark and not memory and not docs_governance"'
+)
+
+text = re.sub(r' --ignore-glob=tests/architecture/[a-zA-Z0-9_.*\[\]-]+\.py', '', text)
+text = re.sub(r' --ignore=tests/architecture/[a-zA-Z0-9_.*\[\]-]+\.py', '', text)
+
+with open(".github/workflows/pr-required.yml", "w") as f:
+    f.write(text)
+
diff --git a/split_shards.py b/split_shards.py
new file mode 100644
index 000000000..3082947f9
--- /dev/null
+++ b/split_shards.py
@@ -0,0 +1,25 @@
+import re
+
+with open("configs/quality/pytest_shards.yaml") as f:
+    shards = f.read()
+
+# For S7-crosscutting-architecture-d and other shards, replace ignores with our marker.
+# We will just remove all the --ignore and --ignore-glob lines for tests/architecture
+lines = shards.split("\n")
+new_lines = []
+for line in lines:
+    if "--ignore-glob=tests/architecture" in line or "--ignore=tests/architecture" in line:
+        continue
+    new_lines.append(line)
+
+shards = "\n".join(new_lines)
+
+# But we need to make sure the ones running tests/architecture run it with -m "architecture and not docs_governance"
+shards = shards.replace(
+    'tests/architecture/ -m "architecture and not slow and not benchmark and not memory"',
+    'tests/architecture/ -m "architecture and not slow and not benchmark and not memory and not docs_governance"'
+)
+
+with open("configs/quality/pytest_shards.yaml", "w") as f:
+    f.write(shards)
+
