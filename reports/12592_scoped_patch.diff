+def test_request_metadata__redacts_email_and_apikey__12592(
+    adapter: PubMedAdapter,
+) -> None:
+    """Check that both email and api_key are redacted while db is preserved."""
+    adapter._request_collector.record_request(
+        url=f"{ENTREZ_API_BASE}efetch.fcgi?email=synthetic-user@example.invalid&api_key=synthetic-placeholder&db=pubmed",
+        method="GET",
+        duration_ms=15.0,
+        status_code=200,
+    )
+
+    metadata = adapter.get_source_metadata(api_version="v1")
+    request = metadata.api_requests[0]
+
+    assert request.query_params["email"] == "[REDACTED]"
+    assert request.query_params["api_key"] == "[REDACTED]"
+    assert request.query_params["db"] == "pubmed"
