        "__aexit__",
    }
)
CONTRACT_DUNDERS = frozenset(
    {"__enter__", "__exit__", "__aenter__", "__aexit__", "__call__"}
)
WEAK_MEMBER_NAMES = frozenset(
    {
        "close",
        "read",
        "write",
        "get",
        "set",
        "run",
        "start",
        "stop",
        "flush",
        "exists",
        "open",
        "name",
        "id",
        "keys",
        "items",
        "update",
        "clear",
        "append",
        "add",
        "remove",
        "contains",
        "configure",
        "get_config",
        "__call__",
        "logger",
