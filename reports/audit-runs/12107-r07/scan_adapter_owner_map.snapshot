#!/usr/bin/env python3
"""Report-only R07 universe scan: adapters, factories, callable seams, owners.

This script is an audit method. It is not a quality ratchet, does not write
``configs/quality/``, and does not change debt budgets.

Usage (from the repository root)::

    .venv/bin/python reports/audit-runs/12107-r07/scan_adapter_owner_map.snapshot
"""

from __future__ import annotations

import ast
import hashlib
import json
import os
import re
import subprocess
import sys
from collections import defaultdict
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

PROJECT_ROOT = Path(__file__).resolve().parents[3]
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

SRC_ROOT = PROJECT_ROOT / "src" / "bioetl"
TEST_ROOT = PROJECT_ROOT / "tests"
OUT_DIR = PROJECT_ROOT / "reports" / "audit-runs" / "12107-r07"
SMOKE_SCRIPT = Path(__file__).resolve().parent / "runtime_smoke.snapshot"
BASELINE_PORTS = PROJECT_ROOT / "reports" / "quality" / "domain-ports-inventory.json"
BASELINE_COVERAGE = (
    PROJECT_ROOT / "reports" / "quality" / "port-adapter-factory-coverage.json"
)

CANDIDATE_ROOTS: tuple[str, ...] = (
    "src/bioetl/infrastructure/adapters/",
    "src/bioetl/infrastructure/storage/",
    "src/bioetl/infrastructure/quarantine/",
    "src/bioetl/infrastructure/control_plane/",
