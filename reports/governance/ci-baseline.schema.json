{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CI Baseline Snapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ci-baseline-v1"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "git": {
      "type": "object",
      "properties": {
        "main_sha": {
          "type": "string"
        },
        "develop_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "develop_branch_status": {
          "type": "string",
          "enum": [
            "present",
            "absent"
          ]
        }
      },
      "required": [
        "main_sha",
        "develop_sha",
        "develop_branch_status"
      ]
    },
    "tools": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string"
        },
        "uv": {
          "type": "string"
        },
        "mypy": {
          "type": "string"
        },
        "ruff": {
          "type": "string"
        }
      },
      "required": [
        "python",
        "uv",
        "mypy",
        "ruff"
      ]
    },
    "inventory_sha256": {
      "type": "string"
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "timestamp_utc",
    "git",
    "tools",
    "inventory",
    "inventory_sha256"
  ]
}