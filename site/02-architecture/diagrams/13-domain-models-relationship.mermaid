%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
classDiagram
    direction TB

    class BaseEntity {
        <<abstract>>
        +entity_id: EntityID
        +content_hash: ContentHash
        +run_id: RunID
        +run_type: RunType
        +ingestion_ts: datetime
        +source_batch_id: BatchID
        +dq_warn: bool = False
    }

    class Activity {
        +activity_id: str
        +assay_id: str
        +molecule_id: str
        +target_id: str | None
        +standard_type: str
        +standard_value: float | None
        +standard_units: str | None
        +standard_relation: str | None
        +pchembl_value: float | None
        +data_validity_comment: str | None
        +activity_comment: str | None
        +potential_duplicate: bool | None
    }

    class Assay {
        +assay_id: str
        +assay_type: str
        +description: str | None
        +assay_organism: str | None
        +assay_strain: str | None
        +assay_cell_type: str | None
        +assay_subcellular_fraction: str | None
        +target_id: str | None
        +document_id: str | None
        +src_id: int | None
        +confidence_score: int | None
    }

    class Target {
        +target_id: str
        +target_type: str
        +pref_name: str | None
        +organism: str | None
        +tax_id: int | None
        +uniprot_accessions: list~str~ | None
        +gene_names: list~str~ | None
        +target_components: list~str~ | None
        +species_group_flag: bool | None
    }

    class Molecule {
        +molecule_id: str
        +pref_name: str | None
        +molecule_type: str
        +max_phase: int | None
        +therapeutic_flag: bool | None
        +dosed_ingredient: bool | None
        +canonical_smiles: str | None
        +standard_inchi: str | None
        +standard_inchi_key: str | None
        +molecular_formula: str | None
        +molecular_weight: float | None
        +alogp: float | None
        +psa: float | None
        +hba: int | None
        +hbd: int | None
        +num_ro5_violations: int | None
        +parent_molecule_id: str | None
    }

    class Document {
        +document_id: str
        +doc_type: str
        +doi: str | None
        +pmid: int | None
        +title: str | None
        +authors: list~str~ | None
        +journal: str | None
        +year: int | None
        +volume: str | None
        +first_page: str | None
        +last_page: str | None
        +abstract: str | None
        +patent_id: str | None
    }

    class Protein {
        +protein_id: str
        +entry_name: str
        +protein_name: str
        +organism: str
        +tax_id: int
        +sequence: str
        +sequence_length: int
        +gene_names: list~str~ | None
        +go_terms: list~str~ | None
        +features: dict | None
        +subcellular_locations: list~str~ | None
    }

    class Compound {
        +compound_id: str
        +iupac_name: str | None
        +canonical_smiles: str
        +isomeric_smiles: str | None
        +inchi: str | None
        +inchikey: str | None
        +molecular_weight: float
        +molecular_formula: str
        +xlogp: float | None
        +exact_mass: float | None
        +monoisotopic_mass: float | None
        +tpsa: float | None
        +complexity: float | None
        +h_bond_donor_count: int
        +h_bond_acceptor_count: int
        +rotatable_bond_count: int | None
        +heavy_atom_count: int | None
    }

    class Publication {
        +pubmed_id: str
        +title: str
        +abstract: str | None
        +authors: list~str~
        +journal: str | None
        +publication_date: str | None
        +doi: str | None
        +pmc_id: str | None
        +mesh_terms: list~str~ | None
        +keywords: list~str~ | None
        +publication_types: list~str~ | None
        +affiliations: list~str~ | None
    }

    class QuarantineRecord {
        +ingestion_ts: datetime
        +pipeline: str
        +error_code: str
        +error_message: str
        +payload: str
        +payload_hash: str
        +bronze_batch_id: BatchID
        +bronze_file_uri: str
        +dq_status: str = "NEW"
    }

    class LineageLogEntry {
        +batch_id: BatchID
        +pipeline: str
        +bronze_paths: list~str~
        +transform_version: str
        +run_params: dict
        +created_at: datetime
    }

    %% Inheritance from BaseEntity
    BaseEntity <|-- Activity : extends
    BaseEntity <|-- Assay : extends
    BaseEntity <|-- Target : extends
    BaseEntity <|-- Molecule : extends
    BaseEntity <|-- Document : extends
    BaseEntity <|-- Protein : extends
    BaseEntity <|-- Compound : extends
    BaseEntity <|-- Publication : extends

    %% ChEMBL Entity Relationships
    Activity --> Assay : assay_id
    Activity --> Molecule : molecule_id
    Activity --> Target : target_id (nullable)
    Assay --> Target : target_id (nullable)
    Assay --> Document : document_id (nullable)
    Molecule --> Molecule : parent_molecule_id (self-ref)

    %% Cross-provider relationships (conceptual)
    Target ..> Protein : uniprot_accessions
    Molecule ..> Compound : inchikey match
    Document ..> Publication : pmid match

    %% Notes
    note for BaseEntity "All entities inherit lineage fields:\n• entity_id (business key)\n• content_hash (SHA256)\n• run_id (correlation)\n• run_type (INCREMENTAL|BACKFILL|REBUILD)\n• ingestion_ts (timestamp)"

    note for Activity "ChEMBL bioactivity measurements\nPrimary entity for drug discovery data"

    note for QuarantineRecord "Failed records during DQ validation\nRetention: 30 days\nStates: NEW → IGNORED | REPROCESSED"
