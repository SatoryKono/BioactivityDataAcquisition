%%{init: {'theme':'base', 'themeVariables': { 'fontSize':'13px'}}}%%
graph TB
    subgraph writers["Storage Writers"]
        direction TB

        Bronze["BronzeWriter (400 LOC)<br/>Format: JSONL + zstd<br/>Storage: Local FileSystem"]
        Silver["SilverWriter (500 LOC)<br/>Format: Delta Lake<br/>Operation: Merge by content_hash"]
        Gold["GoldWriter (650 LOC)<br/>Format: Delta Lake<br/>Validation: Strict Pandera"]

        Base["BaseDeltaWriter (200 LOC)<br/>Common Delta Operations<br/>- table_exists()<br/>- write_delta()<br/>- merge_delta()<br/>- optimize_table()"]

        Silver -.->|Extends| Base
        Gold -.->|Extends| Base
    end

    subgraph bronze_ops["Bronze Operations"]
        direction TB

        BronzeWrite["write_bronze(batch)"]
        SerializeJSON["Serialize to JSONL"]
        Compress["Compress with zstd"]
        WriteToDisk["Write to disk:<br/>bronze/v1/{provider}/{entity}/{date}/"]
        WriteMetadata["Write _metadata.yaml"]

        BronzeWrite --> SerializeJSON
        SerializeJSON --> Compress
        Compress --> WriteToDisk
        WriteToDisk --> WriteMetadata
    end

    subgraph silver_ops["Silver Operations"]
        direction TB

        SilverWrite["write_silver(batch, mode)"]
        Mode{Write Mode}
        Merge["MERGE Mode<br/>By content_hash"]
        Append["APPEND Mode<br/>Append rows"]
        Delete["DELETE Mode<br/>Remove by filter"]

        SilverWrite --> Mode
        Mode -->|Default| Merge
        Mode --> Append
        Mode --> Delete

        Merge --> CheckExists{Table<br/>Exists?}
        CheckExists -->|No| CreateTable["Create Delta Table"]
        CheckExists -->|Yes| DeltaMerge["Delta Merge Operation"]

        CreateTable --> DeltaMerge
        DeltaMerge --> Deduplicate["Deduplicate by content_hash"]
        Deduplicate --> ACIDCommit["ACID Commit"]
    end

    subgraph gold_ops["Gold Operations"]
        direction TB

        GoldWrite["write_gold(batch, mode)"]
        FilterJSON["Filter JSON Fields<br/>(Exclude nested data)"]
        StrictValidate["Strict Validation<br/>Pandera schema"]
        GoldMode{Write Mode}

        SCD2["SCD2 Mode<br/>valid_from/valid_to"]
        Overwrite["OVERWRITE Mode<br/>Replace table"]
        AppendGold["APPEND Mode<br/>Append rows"]

        GoldWrite --> FilterJSON
        FilterJSON --> StrictValidate
        StrictValidate --> GoldMode

        GoldMode --> SCD2
        GoldMode --> Overwrite
        GoldMode --> AppendGold

        SCD2 --> UpdateHistory["Update valid_to for existing"]
        UpdateHistory --> InsertNew["Insert new with valid_from"]
        InsertNew --> ACIDCommitGold["ACID Commit"]

        Overwrite --> ACIDCommitGold
        AppendGold --> ACIDCommitGold
    end

    subgraph retention["Retention & Cleanup"]
        direction TB

        VACUUMSvc["VACUUM Service<br/>Weekly schedule"]
        RetentionPolicy["Retention Policy:<br/>- Default: 7 days<br/>- Critical: 30 days"]
        ForensicHistory["Forensic History<br/>Delta Time Travel"]

        VACUUMSvc --> RetentionPolicy
        RetentionPolicy --> ForensicHistory
    end

    subgraph delta_reader["Delta Reader"]
        direction TB

        Reader["DeltaReader (150 LOC)"]
        ReadTable["read_table(table_name)"]
        Query["query(sql_expression)"]
        TimeTravel["read_version(table, version)"]

        Reader --> ReadTable
        Reader --> Query
        Reader --> TimeTravel
    end

    subgraph metadata_writer["Metadata Writer"]
        direction TB

        MetaWriter["MetadataWriter (150 LOC)"]
        WriteYAML["write_metadata(path, metadata)"]
        MetadataContent["Metadata Fields:<br/>- _run_id<br/>- _run_type<br/>- _ingestion_ts<br/>- _provider<br/>- _entity<br/>- _record_count"]

        MetaWriter --> WriteYAML
        WriteYAML --> MetadataContent
    end

    %% Connections
    Bronze --> bronze_ops
    Silver --> silver_ops
    Gold --> gold_ops

    Bronze --> MetaWriter
    Silver -.->|After write| VACUUMSvc
    Gold -.->|After write| VACUUMSvc

    Reader -.->|Reads from| Silver
    Reader -.->|Reads from| Gold

    classDef bronzeStyle fill:#d7ccc8,stroke:#5d4037,stroke-width:2px
    classDef silverStyle fill:#cfd8dc,stroke:#455a64,stroke-width:2px
    classDef goldStyle fill:#fff9c4,stroke:#f57f17,stroke-width:2px
    classDef readerStyle fill:#e1bee7,stroke:#7b1fa2,stroke-width:2px
    classDef retentionStyle fill:#ffccbc,stroke:#bf360c,stroke-width:2px

    class Bronze,bronze_ops,BronzeWrite,SerializeJSON,Compress,WriteToDisk,WriteMetadata bronzeStyle
    class Silver,silver_ops,SilverWrite,Merge,Append,DeltaMerge,Deduplicate,ACIDCommit silverStyle
    class Gold,gold_ops,GoldWrite,FilterJSON,StrictValidate,SCD2,Overwrite,AppendGold,ACIDCommitGold goldStyle
    class delta_reader,Reader,ReadTable,Query,TimeTravel readerStyle
    class retention,VACUUMSvc,RetentionPolicy,ForensicHistory retentionStyle
