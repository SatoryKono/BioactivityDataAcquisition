stateDiagram-v2
    [*] --> CLOSED: Initialize

    state CLOSED {
        [*] --> MonitoringRequests
        MonitoringRequests: Allow all requests
        MonitoringRequests: Track failure count
        MonitoringRequests: Reset on success
    }

    CLOSED --> OPEN: 5 consecutive failures

    state OPEN {
        [*] --> BlockingRequests
        BlockingRequests: Block all requests
        BlockingRequests: Return error immediately
        BlockingRequests: Start timeout timer (5 min)
    }

    OPEN --> HALF_OPEN: Timeout expires (5 minutes)

    state HALF_OPEN {
        [*] --> SendingProbe
        SendingProbe: Allow 1 probe request
        SendingProbe: Test if service recovered
        SendingProbe: Block other requests
    }

    HALF_OPEN --> CLOSED: Probe succeeds
    HALF_OPEN --> OPEN: Probe fails

    note right of CLOSED
        State: CLOSED
        Behavior: Normal operation
        Failure threshold: 5 consecutive
        On success: Reset failure count
        On failure: Increment counter
    end note

    note right of OPEN
        State: OPEN
        Behavior: Fail fast
        Duration: 5 minutes
        Error: CircuitBreakerOpenError
        Metrics: circuit_breaker_state=OPEN
    end note

    note right of HALF_OPEN
        State: HALF_OPEN
        Behavior: Testing recovery
        Probe count: 1
        On probe success → CLOSED
        On probe fail → OPEN (retry 5 min)
    end note

    state "Metrics Emitted" as Metrics {
        state "Counters" as Counters {
            circuit_breaker_trips_total
            circuit_breaker_state_changes
        }

        state "Gauges" as Gauges {
            circuit_breaker_state
            circuit_breaker_failure_count
        }

        state "Histograms" as Histograms {
            circuit_breaker_request_duration
        }
    }

    state "Configuration" as Config {
        failure_threshold: 5
        timeout: 300s
        probe_count: 1
        success_threshold: 1
    }

    CLOSED -.-> Metrics: Emit metrics
    OPEN -.-> Metrics: Emit metrics
    HALF_OPEN -.-> Metrics: Emit metrics
