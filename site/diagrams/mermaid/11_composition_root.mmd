%%{init: {'theme':'base', 'themeVariables': { 'fontSize':'13px'}}}%%
flowchart TD
    CLI["CLI Command<br/>(e.g., bioetl run chembl_activity)"] --> Entrypoint

    subgraph entrypoint["Entrypoint (composition/entrypoints.py)"]
        Entrypoint["handle_run(pipeline_name, config)"]
    end

    Entrypoint --> Bootstrap

    subgraph bootstrap["bootstrap_pipeline() - Composition Root"]
        direction TB

        Start["1. Parse RuntimeConfig"] --> Observability
        Observability["2. bootstrap_observability()"] --> Storage
        Storage["3. bootstrap_storage()"] --> Checkpoint
        Checkpoint["4. bootstrap_checkpoint()"] --> Quarantine
        Quarantine["5. bootstrap_quarantine()"] --> Lock
        Lock["6. bootstrap_lock()"] --> Lifecycle
        Lifecycle["7. bootstrap_lifecycle_service()"] --> DataSource
        DataSource["8. create_data_source()"] --> Transformer
        Transformer["9. create_transformer()"] --> Services
        Services["10. assemble_services_bundle()"] --> Runner
        Runner["11. create_runner()"] --> Return["Return PipelineRunner"]
    end

    subgraph obs_bootstrap["bootstrap_observability() Details"]
        direction TB

        LoggerSetup["Logger: StructlogLogger"]
        TracerSetup["Tracer: OpenTelemetryTracer or NoOpTracing"]
        MetricsSetup["Metrics: PrometheusMetrics or NoOpMetrics"]
        DQMonitorSetup["DQ Monitor: DQMonitor"]

        LoggerSetup --> TracerSetup
        TracerSetup --> MetricsSetup
        MetricsSetup --> DQMonitorSetup
        DQMonitorSetup --> ObsReturn["Return (logger, tracer, metrics, dq_monitor)"]
    end

    subgraph storage_bootstrap["bootstrap_storage() Details"]
        direction TB

        DataDir["Get data_dir from config"]
        BronzeFactory["BronzeWriter(data_dir, logger)"]
        SilverFactory["SilverWriter(data_dir, logger, tracer)"]
        GoldFactory["GoldWriter(data_dir, logger, tracer, validator)"]

        DataDir --> BronzeFactory
        BronzeFactory --> SilverFactory
        SilverFactory --> GoldFactory
        GoldFactory --> StorageReturn["Return StoragePort (composite)"]
    end

    subgraph checkpoint_bootstrap["bootstrap_checkpoint() Details"]
        direction TB

        CheckpointDir["checkpoints_dir = data_dir / 'checkpoints'"]
        CheckpointFactory["CheckpointAdapter(checkpoints_dir, logger)"]

        CheckpointDir --> CheckpointFactory
        CheckpointFactory --> CheckpointReturn["Return CheckpointPort"]
    end

    subgraph quarantine_bootstrap["bootstrap_quarantine() Details"]
        direction TB

        QuarantineDir["quarantine_dir = data_dir / 'quarantine'"]
        QuarantineFactory["QuarantineAdapter(quarantine_dir, logger)"]

        QuarantineDir --> QuarantineFactory
        QuarantineFactory --> QuarantineReturn["Return QuarantinePort"]
    end

    subgraph lock_bootstrap["bootstrap_lock() Details"]
        direction TB

        LockType["lock_type = 'memory' (from config)"]
        LockTTL["lock_ttl = 90s (from config)"]
        MemoryLockFactory["MemoryLock(ttl=lock_ttl, logger=logger)"]

        LockType --> LockTTL
        LockTTL --> MemoryLockFactory
        MemoryLockFactory --> LockReturn["Return LockPort"]
    end

    subgraph datasource_bootstrap["create_data_source() Details"]
        direction TB

        Registry["PipelineRegistry.get(pipeline_name)"]
        Provider["Get provider from pipeline_config"]
        HTTPClient["HTTPClientFactory.create(provider)"]

        ProviderFactory["Provider-specific factory:<br/>- ChemblAdapter<br/>- PubChemAdapter<br/>- UniProtAdapter<br/>etc."]

        Registry --> Provider
        Provider --> HTTPClient
        HTTPClient --> ProviderFactory
        ProviderFactory --> DataSourceReturn["Return DataSourcePort"]
    end

    subgraph transformer_bootstrap["create_transformer() Details"]
        direction TB

        TransformerClass["Get transformer_class from config"]
        TransformerFactory["TransformerFactory.create(transformer_class)"]
        InjectDeps["Inject dependencies:<br/>- data_normalization_service<br/>- identity_service<br/>- unit_converter"]

        TransformerClass --> TransformerFactory
        TransformerFactory --> InjectDeps
        InjectDeps --> TransformerReturn["Return BaseTransformer"]
    end

    subgraph services_assembly["Assemble Services Bundle"]
        direction TB

        CreateBundle["PipelineServices(<br/>  data_source=data_source,<br/>  storage=storage,<br/>  lock=lock,<br/>  checkpoint=checkpoint,<br/>  quarantine=quarantine,<br/>  observer=PipelineObserver(...),<br/>  metrics=metrics,<br/>  logger=logger,<br/>  tracer=tracer<br/>)"]

        CreateBundle --> ServicesReturn["Return PipelineServices"]
    end

    subgraph runner_factory["create_runner() Details"]
        direction TB

        RunnerClass["RunnerFactory.create(<br/>  services=services,<br/>  config=pipeline_config,<br/>  runtime_config=runtime_config<br/>)"]

        RunnerClass --> RunnerReturn["Return PipelineRunner"]
    end

    %% Detailed bootstrap flows
    Observability -.-> obs_bootstrap
    Storage -.-> storage_bootstrap
    Checkpoint -.-> checkpoint_bootstrap
    Quarantine -.-> quarantine_bootstrap
    Lock -.-> lock_bootstrap
    DataSource -.-> datasource_bootstrap
    Transformer -.-> transformer_bootstrap
    Services -.-> services_assembly
    Runner -.-> runner_factory

    %% Final flow
    Return --> Execute["Execute runner.run()"]
    Execute --> Success["Pipeline Complete"]

    classDef entrypointStyle fill:#fce4ec,stroke:#880e4f,stroke-width:2px
    classDef bootstrapStyle fill:#e3f2fd,stroke:#1565c0,stroke-width:3px
    classDef factoryStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef returnStyle fill:#fff9c4,stroke:#f57f17,stroke-width:2px

    class CLI,Entrypoint entrypointStyle
    class bootstrap,Start,Observability,Storage,Checkpoint,Quarantine,Lock,Lifecycle,DataSource,Transformer,Services,Runner bootstrapStyle
    class obs_bootstrap,storage_bootstrap,checkpoint_bootstrap,quarantine_bootstrap,lock_bootstrap,datasource_bootstrap,transformer_bootstrap,services_assembly,runner_factory factoryStyle
    class Return,ObsReturn,StorageReturn,CheckpointReturn,QuarantineReturn,LockReturn,DataSourceReturn,TransformerReturn,ServicesReturn,RunnerReturn,Success returnStyle
