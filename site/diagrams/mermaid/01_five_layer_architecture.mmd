%%{init: {'theme':'base', 'themeVariables': { 'fontSize':'16px'}}}%%
graph TB
    subgraph "BioETL Architecture - Five Layers"

        subgraph interfaces["<b>INTERFACES LAYER</b><br/>Entry Points"]
            CLI["CLI Commands<br/>(Click)"]
            RunCmd["run"]
            RunAllCmd["run_all"]
            ExportCmd["export"]
            QuarantineCmd["quarantine"]
            HealthCmd["health"]
        end

        subgraph composition["<b>COMPOSITION LAYER</b><br/>Dependency Injection & Assembly"]
            Bootstrap["bootstrap_pipeline()"]
            Factories["Factories"]
            Registry["PipelineRegistry"]

            PipelineFactory["PipelineFactory"]
            RunnerFactory["RunnerFactory"]
            ServicesFactory["ServicesFactory"]
            StorageFactory["StorageFactory"]
        end

        subgraph application["<b>APPLICATION LAYER</b><br/>Use Cases & Orchestration"]
            Core["Core Components"]
            Pipelines["Pipeline Implementations"]
            Services["Application Services"]

            PipelineRunner["PipelineRunner"]
            BatchExecutor["BatchExecutor"]
            RecordProcessor["RecordProcessor"]
            BatchTransformer["BatchTransformer"]
            BatchWriter["BatchWriter"]

            ChemblPipelines["ChEMBL Pipelines (13)"]
            PubChemPipeline["PubChem Pipeline"]
            UniProtPipeline["UniProt Pipeline"]

            MedallionService["MedallionLifecycleService"]
            PostrunService["PostrunService"]
            DQReportService["DQReportService"]
        end

        subgraph domain["<b>DOMAIN LAYER</b><br/>Business Logic & Contracts (Pure - No I/O)"]
            Aggregates["DDD Aggregates"]
            Ports["Ports (26)"]
            Entities["Entities"]
            ValueObjects["Value Objects"]
            DomainServices["Domain Services"]

            PipelineRun["PipelineRun"]
            Batch["Batch"]
            QuarantineEntry["QuarantineEntry"]

            StoragePort["StoragePort"]
            DataSourcePort["DataSourcePort"]
            LockPort["LockPort"]
            TracingPort["TracingPort"]
            MetricsPort["MetricsPort"]

            Activity["Activity"]
            DQMetrics["DQMetrics"]
            RunContext["RunContext"]

            DataNormService["DataNormalizationService"]
            IdentityService["IdentityService"]
        end

        subgraph infrastructure["<b>INFRASTRUCTURE LAYER</b><br/>Adapters & External Integrations"]
            Storage["Storage"]
            HTTPClient["HTTP Infrastructure"]
            ProviderAdapters["Provider Adapters"]

            BronzeWriter["BronzeWriter<br/>(JSONL+zstd)"]
            SilverWriter["SilverWriter<br/>(Delta Lake)"]
            GoldWriter["GoldWriter<br/>(Validated Delta)"]

            UnifiedHTTPClient["UnifiedHTTPClient"]
            RateLimiter["RateLimiter"]
            CircuitBreaker["CircuitBreaker"]

            ChemblAdapter["ChemblAdapter"]
            PubChemAdapter["PubChemAdapter"]
            UniProtAdapter["UniProtAdapter"]
            CrossRefAdapter["CrossRefAdapter"]
        end

    end

    %% Layer Dependencies (ALLOWED imports)
    interfaces -->|Uses| composition
    interfaces -->|Uses| application
    interfaces -->|Uses| domain

    composition -->|Creates| infrastructure
    composition -->|Creates| application
    composition -->|Uses| domain

    application -->|Uses| domain

    infrastructure -->|Implements| domain

    %% FORBIDDEN dependencies (shown in red)
    domain -.->|"❌ FORBIDDEN"| application
    domain -.->|"❌ FORBIDDEN"| composition
    domain -.->|"❌ FORBIDDEN"| infrastructure

    application -.->|"❌ FORBIDDEN"| composition
    application -.->|"❌ FORBIDDEN"| infrastructure

    infrastructure -.->|"❌ FORBIDDEN"| application
    infrastructure -.->|"❌ FORBIDDEN"| composition

