# BioETL Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: dev | staging | prod
BIOETL_ENV=dev

# =============================================================================
# DATA STORAGE (Local Filesystem)
# =============================================================================
# Base directory for all data (Bronze/Silver/Gold/Checkpoints)
BIOETL_DATA_DIR=data

# =============================================================================
# PIPELINE CONFIGURATION
# =============================================================================
# Batch size (1-10000)
BIOETL_PIPELINE__BATCH_SIZE=100
# Checkpoint interval (minimum 100)
BIOETL_PIPELINE__CHECKPOINT_INTERVAL=1000
# Max concurrent batches (1-16)
BIOETL_PIPELINE__MAX_CONCURRENT_BATCHES=4
# Heartbeat interval in seconds (5-60, default: 30)
BIOETL_PIPELINE__HEARTBEAT_INTERVAL=30

# =============================================================================
# PROVIDER API KEYS (RULES.md Appendix A)
# =============================================================================

# ChEMBL (Public API - no key required)
# BIOETL_CHEMBL_API_BASE=https://www.ebi.ac.uk/chembl/api/data

# PubChem (Public API - no key required, but rate limited)
# BIOETL_PUBCHEM_API_BASE=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# UniProt (Recommended to use API key for higher rate limits)
BIOETL_UNIPROT_API_KEY=your_uniprot_api_key_here
# BIOETL_UNIPROT_API_BASE=https://rest.uniprot.org

# OpenAlex (Polite pool requires email)
BIOETL_OPENALEX_EMAIL=your_email@example.com
# BIOETL_OPENALEX_API_BASE=https://api.openalex.org

# Semantic Scholar (API key for higher rate limits)
BIOETL_SEMANTICSCHOLAR_API_KEY=your_semantic_scholar_api_key_here
# BIOETL_SEMANTICSCHOLAR_API_BASE=https://api.semanticscholar.org

# PubMed (NCBI E-utilities)
BIOETL_PUBMED_API_KEY=your_ncbi_api_key_here
BIOETL_PUBMED_EMAIL=your_email@example.com
# BIOETL_PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# Crossref (Polite pool requires email)
BIOETL_CROSSREF_EMAIL=your_email@example.com
# BIOETL_CROSSREF_API_BASE=https://api.crossref.org

# =============================================================================
# SECURITY (RULES.md §5.4)
# =============================================================================
# Salt for PII hashing (rotate periodically)
BIOETL_PII_SALT_CURRENT=change_me_to_random_64_char_string_abc123xyz789
# Leave empty unless rotating
BIOETL_PII_SALT_NEXT=

# Salt rotation state
BIOETL_SALT_ROTATION_ACTIVE=false
# Start date in YYYY-MM-DD format
BIOETL_SALT_ROTATION_START_DATE=

# =============================================================================
# NEO4J GRAPH DATABASE (Memory Configuration)
# =============================================================================
# Neo4j version to use
NEO4J_VERSION=5.15-community
# HTTP port for browser
NEO4J_HTTP_PORT=7474
# Bolt protocol port (default: 7687)
NEO4J_BOLT_PORT=7687

# Memory Configuration (Critical for Performance)
# Adjust based on available host memory:
# - Development (4GB host): heap=512m, pagecache=1g, tx_max=2g
# - Production (16GB+ host): heap=4g, pagecache=4g, tx_max=8g
#
# Initial heap size (recommend 1/4 of heap_max)
NEO4J_HEAP_INITIAL=512m
# Maximum heap size (25-40% of available RAM)
NEO4J_HEAP_MAX=2g
# Page cache for graph data (40-50% of available RAM)
NEO4J_PAGECACHE=1g
# Max per-transaction memory
NEO4J_TX_MAX_SIZE=2g
# Global transaction limit
NEO4J_GLOBAL_TX_MAX=20g

# Authentication
# Format: username/password (CHANGE THIS!)
NEO4J_AUTH=neo4j/bioetl_secure_password

# Default database name
NEO4J_DEFAULT_DB=neo4j

# Performance Tuning
# Transaction log rotation policy
NEO4J_LOG_ROTATION=7d
# Garbage collector options
NEO4J_JVM_OPTS=-XX:+UseG1GC -XX:G1HeapRegionSize=16m

# =============================================================================
# OBSERVABILITY (RULES.md §3.2)
# =============================================================================
# Grafana (docker-compose.monitoring.yml)
GF_SECURITY_ADMIN_PASSWORD=change_me
BIOETL_ENABLE_TRACING_DATASOURCES=false

# Logging
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
BIOETL_LOG_LEVEL=INFO
# Options: json | text
BIOETL_LOG_FORMAT=json
BIOETL_LOG_FILE=logs/bioetl.log

# Metrics (Prometheus) — top-level settings
# Prometheus HTTP server port (default: 8000)
BIOETL_METRICS_PORT=8000
BIOETL_METRICS_ENABLED=true

# --- Nested observability settings (env_nested_delimiter="__") ---
# Metrics
BIOETL_OBSERVABILITY__METRICS_ENABLED=true
BIOETL_OBSERVABILITY__METRICS_SERVER_ENABLED=true
BIOETL_OBSERVABILITY__METRICS_FAIL_FAST=false
# BIOETL_OBSERVABILITY__METRICS_RETRY_COUNT=3
# BIOETL_OBSERVABILITY__METRICS_RETRY_DELAY=1.0

# Tracing (OpenTelemetry — disabled by default, see ADR-022)
BIOETL_OBSERVABILITY__TRACING_ENABLED=false

# Data Quality Monitor
BIOETL_OBSERVABILITY__DQ_MONITOR_ENABLED=false
# BIOETL_OBSERVABILITY__DQ_BASELINE_WINDOW=7
# BIOETL_OBSERVABILITY__DQ_Z_SCORE_THRESHOLD=2.5
# BIOETL_OBSERVABILITY__DQ_MIN_BASELINE_SAMPLES=3
# BIOETL_OBSERVABILITY__DQ_COLD_START_RUNS=5
# BIOETL_OBSERVABILITY__DQ_ERROR_RATE_MAX=0.10
# BIOETL_OBSERVABILITY__DQ_QUALITY_SCORE_MIN=0.80

# =============================================================================
# DATA QUALITY (RULES.md §3.1.2)
# =============================================================================
# Error thresholds
# 5% - Warning
BIOETL_DQ_SOFT_THRESHOLD=0.05
# 20% - Fail batch
BIOETL_DQ_HARD_THRESHOLD=0.20

# Anomaly detection (RULES.md §3.4.1)
BIOETL_DQ_BASELINE_DAYS=30
BIOETL_DQ_ANOMALY_WARNING_MULTIPLIER=2.0
BIOETL_DQ_ANOMALY_CRITICAL_MULTIPLIER=5.0

# =============================================================================
# CIRCUIT BREAKER (RULES.md §3.1.4)
# =============================================================================
# Number of consecutive errors
BIOETL_CB_FAILURE_THRESHOLD=5
# Recovery timeout: 5 minutes in seconds
BIOETL_CB_RECOVERY_TIMEOUT=300
# Alert if open > 10 minutes
BIOETL_CB_OPEN_ALERT_THRESHOLD=600

# =============================================================================
# RETRY POLICY (RULES.md §3.1.3)
# =============================================================================
BIOETL_RETRY_MAX_ATTEMPTS=3
BIOETL_RETRY_MULTIPLIER=2.0
BIOETL_RETRY_JITTER_MIN=0.1
BIOETL_RETRY_JITTER_MAX=0.5

# =============================================================================
# DELTA LAKE (RULES.md §2.1.1)
# =============================================================================
# Retention in days
BIOETL_DELTA_VACUUM_RETENTION=7
# Forensic retention in days (30 for critical tables)
BIOETL_DELTA_FORENSIC_RETENTION=7

# =============================================================================
# PARTITIONING (RULES.md §2.5)
# =============================================================================
BIOETL_PARTITION_WARNING_THRESHOLD=10000
BIOETL_PARTITION_HARD_LIMIT=50000
BIOETL_FILES_PER_PARTITION_WARNING=100

# =============================================================================
# QUARANTINE (RULES.md §2.6)
# =============================================================================
BIOETL_QUARANTINE_RETENTION_DAYS=30
# 64KB
BIOETL_QUARANTINE_PAYLOAD_MAX_SIZE=65536

# =============================================================================
# PERFORMANCE
# =============================================================================
# JSON serialization encoder (optional, for high-throughput pipelines)
# Options: orjson (high-performance, requires pip install bioetl[performance])
#          stdlib (standard library json, always available)
# Default: orjson if installed, otherwise stdlib
# BIOETL_JSON_ENCODER=orjson

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Set to true to enable debug features
BIOETL_DEBUG=false

# Test mode (uses fixtures instead of real APIs)
BIOETL_TEST_MODE=false
