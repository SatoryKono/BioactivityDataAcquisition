# BioETL local environment template
# Copy needed values into your shell profile or a local untracked .env file.

# GitHub MCP
GITHUB_PERSONAL_ACCESS_TOKEN=

# Docker-backed MCP: Prometheus
PROMETHEUS_URL=http://host.docker.internal:9090

# Docker-backed MCP: Grafana
GRAFANA_URL=http://host.docker.internal:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
GRAFANA_ORG_ID=

# Grafana Quarantine Explorer datasource backend
BIOETL_QUARANTINE_EXPLORER_URL=http://host.docker.internal:8081

# Docker-backed MCP: Brave Search
BRAVE_API_KEY=

# Docker-backed MCP: Docker Hub
DOCKERHUB_USERNAME=
HUB_PAT_TOKEN=

# Remote HTTP MCP: Needle
NEEDLE_API_KEY=

# Neo4j-backed MCP: Memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_AUTH=neo4j/bioetl_secure_password
NEO4J_AUTH_USERNAME=
NEO4J_AUTH_PASSWORD=
