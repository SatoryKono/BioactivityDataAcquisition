# BioETL local environment template
# Copy needed values into your shell profile or a local untracked .env file.
# Token status markers:
# - required-local: required for the named MCP when you enable that server locally
# - optional-local: used only when the local service needs authentication
# - runtime-optional: provider/runtime key outside the MCP token validation path
# Never commit real token values to this file.

# GitHub MCP
# Source: GitHub fine-grained PAT or classic PAT.
# Minimum local scope: repository read access needed by the MCP use case.
# Rotation: 90 days or immediately after operator/workstation change.
# Status: required-local for github MCP.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Docker-backed MCP: Prometheus
# Source: local Prometheus auth token only when the endpoint is protected.
# Rotation: 90 days for shared service accounts.
# Status: optional-local.
PROMETHEUS_URL=http://host.docker.internal:9090
PROMETHEUS_TOKEN=
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=

# Docker-backed MCP: Grafana
# Source: Grafana service account token preferred; username/password is local fallback.
# Rotation: 90 days for service accounts.
# Status: optional-local unless Grafana requires authentication.
GRAFANA_URL=http://host.docker.internal:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
GRAFANA_ORG_ID=

# Grafana Quarantine Explorer datasource backend
# Recommended launcher: `bioetl quarantine serve --port 8081`
BIOETL_QUARANTINE_EXPLORER_URL=http://host.docker.internal:8081

# Docker-backed MCP: Brave Search
# Source: Brave Search API key from the Brave API console.
# Scope/limit: web search API quota assigned by Brave.
# Rotation: 90 days or immediately after suspected exposure.
# Status: required-local for brave-search MCP.
BRAVE_API_KEY=

# Docker-backed MCP: Docker Hub
# Source: Docker Hub personal access token.
# Scope: read-only pull access unless publishing images is explicitly required.
# Rotation: 90 days for shared accounts.
# Status: optional-local for Docker Hub-backed MCP use.
DOCKERHUB_USERNAME=
HUB_PAT_TOKEN=

# Remote HTTP MCP: Needle
# Source: Needle token, retained only for compatibility windows while registered.
# Status: optional-local / retired-wrapper compatibility.
NEEDLE_API_KEY=

# DeepWiki MCP
# Source: DeepWiki API key for wiki generation and private mode access.
# Scope: repository documentation generation and private mode features.
# Rotation: 90 days or immediately after suspected exposure.
# Status: required-local for DeepWiki MCP private mode features.
DEEPWIKI_API_KEY=
DEEPWIKI_ORGANISATION_ID=

# Optional provider API keys for BioETL runtime
BIOETL_OBSERVABILITY__DQ_MONITOR_ENABLED=true
BIOETL_UNIPROT_API_KEY=
BIOETL_OPENALEX_API_KEY=
BIOETL_OPENALEX_EMAIL=
BIOETL_PUBMED_API_KEY=
BIOETL_PUBMED_EMAIL=
BIOETL_SEMANTICSCHOLAR_API_KEY=
BIOETL_CROSSREF_EMAIL=

# Neo4j-backed MCP: Memory
# Source: local Neo4j memory instance credentials.
# Scope: local memory database only; do not reuse production credentials.
# Rotation: rotate default local password before shared-host use.
# Status: optional-local for Neo4j MCPs.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_AUTH=neo4j/bioetl_secure_password
NEO4J_AUTH_USERNAME=
NEO4J_AUTH_PASSWORD=
NEO4J_AUDIT_URI=bolt://localhost:7688
NEO4J_AUDIT_USERNAME=neo4j
NEO4J_AUDIT_PASSWORD=
NEO4J_AUDIT_DATABASE=neo4j
NEO4J_AUDIT_HTTP_URI=http://localhost:7475

# Redis
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO S3 Storage
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET_DATA=bioetl-data
MINIO_BUCKET_REPORTS=bioetl-reports
MINIO_BUCKET_BACKUPS=bioetl-backups
MINIO_BUCKET_CONFIGS=bioetl-configs

# SonarQube
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=
SONARQUBE_SYSTEM_PASSCODE=
SONARQUBE_ADMIN_USERNAME=admin
SONARQUBE_ADMIN_PASSWORD=
SONARQUBE_URL=http://localhost:9000
SONAR_LOGIN=
SONAR_PASSWORD=
SONAR_HOST_URL=http://localhost:9000

# AlertManager
ALERTMANAGER_URL=http://localhost:9093
SLACK_WEBHOOK_URL=
PAGERDUTY_KEY=

# Grafana Alerting
GF_SECURITY_ADMIN_PASSWORD=
# Do not set GF_INSTALL_PLUGINS — bootstrap owns Infinity install and pins a
# Grafana 12.0.0-compatible version (default 3.8.0). Newer Infinity (3.11.x)
# fails frontend load with "Datasource: bioetl-ops-http was not found".
BIOETL_INFINITY_PLUGIN_VERSION=3.8.0
BIOETL_ENABLE_TRACING_DATASOURCES=auto
