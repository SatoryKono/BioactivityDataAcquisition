# BioETL Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# =============================================================================
# ENVIRONMENT
# =============================================================================
BIOETL_ENV=dev  # dev | staging | prod

# =============================================================================
# STORAGE (S3 / MinIO)
# =============================================================================
# For local dev (Docker MinIO)
AWS_ACCESS_KEY_ID=bioetl
AWS_SECRET_ACCESS_KEY=bioetl_minio_pass
AWS_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1

# For production (AWS S3)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1

# Bucket names
BIOETL_S3_BUCKET_BRONZE=bioetl-bronze
BIOETL_S3_BUCKET_SILVER=bioetl-silver
BIOETL_S3_BUCKET_GOLD=bioetl-gold
BIOETL_S3_BUCKET_CHECKPOINTS=bioetl-checkpoints

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
BIOETL_DB_HOST=localhost
BIOETL_DB_PORT=5432
BIOETL_DB_NAME=bioetl
BIOETL_DB_USER=bioetl
BIOETL_DB_PASSWORD=bioetl_dev_pass

# Connection pool
BIOETL_DB_POOL_SIZE=10
BIOETL_DB_MAX_OVERFLOW=20

# =============================================================================
# REDIS (Distributed Locking)
# =============================================================================
BIOETL_REDIS_HOST=localhost
BIOETL_REDIS_PORT=6379
BIOETL_REDIS_PASSWORD=bioetl_redis_pass
BIOETL_REDIS_DB=0

# Lock configuration (RULES.md §3.3)
BIOETL_LOCK_TTL=60  # seconds
BIOETL_LOCK_HEARTBEAT_INTERVAL=20  # seconds
BIOETL_LOCK_MAX_DURATION=14400  # 4 hours in seconds

# =============================================================================
# PROVIDER API KEYS (RULES.md Appendix A)
# =============================================================================

# ChEMBL (Public API - no key required)
# BIOETL_CHEMBL_API_BASE=https://www.ebi.ac.uk/chembl/api/data

# PubChem (Public API - no key required, but rate limited)
# BIOETL_PUBCHEM_API_BASE=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# UniProt (Recommended to use API key for higher rate limits)
BIOETL_UNIPROT_API_KEY=your_uniprot_api_key_here
# BIOETL_UNIPROT_API_BASE=https://rest.uniprot.org

# OpenAlex (Polite pool requires email)
BIOETL_OPENALEX_EMAIL=your_email@example.com
# BIOETL_OPENALEX_API_BASE=https://api.openalex.org

# Semantic Scholar (API key for higher rate limits)
BIOETL_SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
# BIOETL_SEMANTIC_SCHOLAR_API_BASE=https://api.semanticscholar.org

# PubMed (NCBI E-utilities)
BIOETL_PUBMED_API_KEY=your_ncbi_api_key_here
BIOETL_PUBMED_EMAIL=your_email@example.com
# BIOETL_PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# Crossref (Polite pool requires email)
BIOETL_CROSSREF_EMAIL=your_email@example.com
# BIOETL_CROSSREF_API_BASE=https://api.crossref.org

# =============================================================================
# SECURITY (RULES.md §5.4)
# =============================================================================
# Salt for PII hashing (rotate periodically)
BIOETL_PII_SALT_CURRENT=change_me_to_random_64_char_string_abc123xyz789
BIOETL_PII_SALT_NEXT=  # Leave empty unless rotating

# Salt rotation state
BIOETL_SALT_ROTATION_ACTIVE=false
BIOETL_SALT_ROTATION_START_DATE=  # YYYY-MM-DD

# =============================================================================
# OBSERVABILITY (RULES.md §3.2)
# =============================================================================
# Logging
BIOETL_LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
BIOETL_LOG_FORMAT=json  # json | text
BIOETL_LOG_FILE=logs/bioetl.log

# Metrics (Prometheus)
BIOETL_METRICS_PORT=9090
BIOETL_METRICS_ENABLED=true

# =============================================================================
# DATA QUALITY (RULES.md §3.1.2)
# =============================================================================
# Error thresholds
BIOETL_DQ_SOFT_THRESHOLD=0.05  # 5% - Warning
BIOETL_DQ_HARD_THRESHOLD=0.20  # 20% - Fail batch

# Anomaly detection (RULES.md §3.4.1)
BIOETL_DQ_BASELINE_DAYS=30
BIOETL_DQ_ANOMALY_WARNING_MULTIPLIER=2.0
BIOETL_DQ_ANOMALY_CRITICAL_MULTIPLIER=5.0

# =============================================================================
# CIRCUIT BREAKER (RULES.md §3.1.4)
# =============================================================================
BIOETL_CB_FAILURE_THRESHOLD=5  # Number of consecutive errors
BIOETL_CB_RECOVERY_TIMEOUT=300  # 5 minutes in seconds
BIOETL_CB_OPEN_ALERT_THRESHOLD=600  # Alert if open > 10 minutes

# =============================================================================
# RETRY POLICY (RULES.md §3.1.3)
# =============================================================================
BIOETL_RETRY_MAX_ATTEMPTS=3
BIOETL_RETRY_MULTIPLIER=2.0
BIOETL_RETRY_JITTER_MIN=0.1
BIOETL_RETRY_JITTER_MAX=0.5

# =============================================================================
# DELTA LAKE (RULES.md §2.1.1)
# =============================================================================
BIOETL_DELTA_VACUUM_RETENTION=7  # days
BIOETL_DELTA_FORENSIC_RETENTION=7  # days (30 for critical tables)

# =============================================================================
# PARTITIONING (RULES.md §2.5)
# =============================================================================
BIOETL_PARTITION_WARNING_THRESHOLD=10000
BIOETL_PARTITION_HARD_LIMIT=50000
BIOETL_FILES_PER_PARTITION_WARNING=100

# =============================================================================
# QUARANTINE (RULES.md §2.6)
# =============================================================================
BIOETL_QUARANTINE_RETENTION_DAYS=30
BIOETL_QUARANTINE_PAYLOAD_MAX_SIZE=65536  # 64KB

# =============================================================================
# DISASTER RECOVERY (RULES.md §5.5)
# =============================================================================
BIOETL_DR_RPO_HOURS=24
BIOETL_DR_RTO_HOURS=4
BIOETL_DR_BACKUP_ENABLED=true

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Set to true to enable debug features
BIOETL_DEBUG=false

# Test mode (uses fixtures instead of real APIs)
BIOETL_TEST_MODE=false
