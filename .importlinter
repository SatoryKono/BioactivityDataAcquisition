[importlinter]
root_package = bioetl

# =============================================================================
# Hexagonal Architecture Layer Contracts
# =============================================================================
# Dependency direction: interfaces -> application -> domain <- infrastructure
#
# - Domain: Pure business logic, no external dependencies
# - Application: Orchestration, uses domain types and ports (interfaces)
# - Infrastructure: Implements ports, adapts external systems
# - Interfaces: Composition root, CLI, wires everything together
# =============================================================================

[contract:domain_purity]
name = Domain layer has no dependencies on other layers
type = forbidden
source_modules =
    bioetl.domain
forbidden_modules =
    bioetl.application
    bioetl.infrastructure
    bioetl.interfaces

[contract:application_no_infrastructure]
name = Application layer cannot import infrastructure directly
type = forbidden
source_modules =
    bioetl.application
forbidden_modules =
    bioetl.infrastructure
ignore_imports =
    # Legacy: Lazy import for backward compatibility (deprecation warning issued)
    # Tracked for removal - see test_application_has_no_runtime_infrastructure_imports
    bioetl.application.orchestrator -> bioetl.infrastructure.provider_registry

[contract:application_no_interfaces]
name = Application layer cannot depend on interfaces layer
type = forbidden
source_modules =
    bioetl.application
forbidden_modules =
    bioetl.interfaces

[contract:infrastructure_no_application]
name = Infrastructure cannot depend on application layer
type = forbidden
source_modules =
    bioetl.infrastructure
forbidden_modules =
    bioetl.application

[contract:infrastructure_no_interfaces]
name = Infrastructure cannot depend on interfaces layer
type = forbidden
source_modules =
    bioetl.infrastructure
forbidden_modules =
    bioetl.interfaces

# =============================================================================
# Implementation Isolation Contracts
# =============================================================================

[contract:no_direct_impl_imports]
name = Application must not import concrete implementations
type = forbidden
source_modules =
    bioetl.application
forbidden_modules =
    # HTTP client implementations
    bioetl.infrastructure.clients.chembl.impl
    bioetl.infrastructure.clients.base.impl
    # Logging implementations
    bioetl.infrastructure.logging.impl
    # Config implementations
    bioetl.infrastructure.config.loader
    bioetl.infrastructure.config.migration

[contract:interfaces_controls_wiring]
name = Interfaces layer controls all wiring and composition
type = forbidden
source_modules =
    bioetl.domain
    bioetl.application
forbidden_modules =
    # Only interfaces layer should do composition
    bioetl.interfaces.composition_root
    bioetl.interfaces.factories
