+++ b/public/app/features/alerting/unified/rule-list/components/AlertRuleListItem.instances.test.tsx
@@ -0,0 +1,16 @@
+import { withInstancesTab } from './alertRuleLinks';
+
+describe('alert instance navigation', () => {
+  it.each([
+    '/alerting/prometheus/rule/view',
+    '/grafana/alerting/prometheus/rule/view?returnTo=%2Falerting%2Flist%3Fview%3Dgrouped',
+    '/alerting/prometheus/rule/view?returnTo=%2Falerting%2Flist&tab=query#details',
+  ])('selects Instances without corrupting context: %s', (href) => {
+    const before = new URL(href, window.location.origin);
+    const after = new URL(withInstancesTab(href), window.location.origin);
+    expect(after.pathname).toBe(before.pathname);
+    expect(after.hash).toBe(before.hash);
+    expect(after.searchParams.get('returnTo')).toBe(before.searchParams.get('returnTo'));
+    expect(after.searchParams.getAll('tab')).toEqual(['instances']);
+  });
+});
