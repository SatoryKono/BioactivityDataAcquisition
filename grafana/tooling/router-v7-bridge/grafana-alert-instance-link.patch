@@ -0,0 +1,6 @@
+/** Preserve return context, subpaths and fragments when opening Instances. */
+export function withInstancesTab(href: string): string {
+  const url = new URL(href, window.location.origin);
+  url.searchParams.set('tab', 'instances');
+  return url.origin === window.location.origin ? `${url.pathname}${url.search}${url.hash}` : url.href;
+}
diff --git a/public/app/features/alerting/unified/rule-list/components/AlertRuleListItem.instances.test.tsx b/public/app/features/alerting/unified/rule-list/components/AlertRuleListItem.instances.test.tsx
