+      code: ts.transpileModule(source, {
+        // TypeScript preserves ESM for .mjs even with module: CommonJS.
+        fileName: filename.replace(/\.mjs$/, '.js'),
+        compilerOptions: {
+          allowJs: true,
+          module: ts.ModuleKind.CommonJS,
+          target: ts.ScriptTarget.ES2022,
