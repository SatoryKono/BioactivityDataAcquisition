{
  "name": "@bioetl/grafana-router-v7-bridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    }
  },
  "scripts": {
    "test": "node --test bridge.test.mjs",
    "build": "esbuild index.mjs --bundle --platform=browser --outfile=dist/bridge.js",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck typecheck.test.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react-router-v7": "npm:react-router@7.18.4",
    "react-router-dom-v5": "npm:react-router-dom@5.3.4",
    "@types/react-router-dom-v5": "npm:@types/react-router-dom@5.3.3"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3"
  },
  "types": "./index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts"
  ]
}
