    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "options": {
        "bioetlDisplayTitle": "Understand Run Scope",
        "mode": "html",
        "content": "<div style=\"padding:4px 10px;border-left:4px solid #6b7280;font-size:16px;line-height:1.2;white-space:normal;overflow-wrap:anywhere;max-width:96ch\">BROWSE last 10 launches, newest start first; not this time range.<br>Pipeline: ${pipeline:text}. SELECTED RUN: $run_id.<br><a href=\"/d/bioetl-run-explorer-v1/0-run-explorer?var-workflow=$__all&amp;var-pipeline=$__all&amp;var-run_type=$__all&amp;var-run_id=-&amp;var-lookup_run_id=&amp;${__url_time_range}\">All pipelines · clear search</a> · Open Report for persisted evidence.</div>"
      },
      "description": "Browse the latest 10 launches across All pipelines by start time. Workflow and Run Type filter the list. The dashboard time picker does not filter this table. Running means a recorded start without a terminal event, not a live health probe. REPORT MISSING means no final report is available. Defaults All / All / All and run_id=- select no exact run. Effective refresh: 60s; timezone: browser.",
      "links": [
        {
          "title": "Run-manifest inspection runbook",
          "url": "https://github.com/SatoryKono/BioactivityDataAcquisition/blob/main/docs/05-operations/runbooks/run-manifest-inspection.md",
          "targetBlank": true,
          "includeVars": false
        }
      ]
    },
    {
      "id": 3010,
      "type": "table",
      "title": "Inspect Recent Runs (last 10)",
      "description": "BROWSE — Last 10 launches by started_at across the selected pipeline scope, after Workflow and Run Type filters. The dashboard time picker does not filter this table. Start time comes from ledger/report identity, with explicitly recorded manifest-created fallback; never file mtime. One row is one launch. Running is the last recorded lifecycle state, not live-process proof. REPORT MISSING distinguishes launches without a persisted report. Click a Run cell to select and mark that run, binding Workflow, Pipeline, Run Type and Run ID from that row. Pipeline and Workflow belong to each row. Older runs: use the Run ID catalog. limit=10 shows all ten rows together without pagination. VALID EMPTY means no matching launches; TREE_MISSING / LAYOUT_UNHEALTHY / IDENTITY_UNHEALTHY means a report bind failure. Backend failures are QUERY ERROR, not empty data. Run python scripts/ops/runtime/docker/verify_report_bind.py to diagnose the report bind. The matching SELECTED RUN row is marked; browse is not an exact-run snapshot. Report opens the row file in a new tab: Markdown when present, otherwise JSON. REPORT MISSING opens an explicit not-found response; it does not imply a persisted file. Find Run ID searches exact UUID before the ten-row limit. Duration needs valid start/end. Event age is the last ledger event for unfinished runs, not a heartbeat. Inspect a Run cell to copy its full UUID.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": "BioETL Ops HTTP",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "inspect": true,
            "minWidth": 50,
            "cellOptions": {
              "type": "auto",
              "wrapText": false
            }
          },
          "noValue": "VALID EMPTY — no matching launches in the report and control-plane catalogs.",
          "links": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(started_at|Started)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(completed_at|Completed)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "wrapText": false,
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "TREE_MISSING": {
                        "text": "TREE_MISSING",
                        "color": "red"
                      },
                      "LAYOUT_UNHEALTHY": {
                        "text": "LAYOUT_UNHEALTHY",
                        "color": "orange"
                      },
                      "IDENTITY_UNHEALTHY": {
                        "text": "IDENTITY_UNHEALTHY",
                        "color": "orange"
                      },
                      "success": {
                        "text": "success",
                        "color": "#166534"
                      },
                      "failed": {
                        "text": "failed",
                        "color": "red"
                      },
                      "partial": {
                        "text": "partial",
                        "color": "orange"
                      },
                      "shutdown": {
                        "text": "shutdown",
                        "color": "orange"
                      },
                      "dry_run": {
                        "text": "dry_run",
                        "color": "blue"
                      },
                      "fail": {
                        "text": "fail",
                        "color": "red"
                      },
                      "running": {
                        "text": "running",
                        "color": "blue"
                      },
                      "unknown": {
                        "text": "UNKNOWN",
                        "color": "gray"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Run"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Select this run",
                    "url": "/d/bioetl-run-explorer-v1/6-run-explorer?var-workflow=${__data.fields.workflow_scope}&var-pipeline=${__data.fields.Pipeline}&var-run_type=${__data.fields.run_type}&var-run_id=${__value.raw}&${__url_time_range}",
                    "targetBlank": false,
                    "includeVars": false
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": false
                }
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "run_type"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(workflow_run_id|Workflow run)$"
            },
            "properties": [
