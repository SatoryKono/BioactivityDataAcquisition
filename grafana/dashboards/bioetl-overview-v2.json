        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "L0 Overview decision dashboard. Current status (L0/L1) separated from Range Evidence (historical).",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "0. Control Plane",
      "tooltip": "Open with current pipeline/run_type and preserve the selected time range.",
      "type": "link",
      "url": "/d/bioetl-control-plane-v1/bioetl-control-plane-v1?var-pipeline=$pipeline&var-run_type=$run_type&${__url_time_range}"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "2. Runtime",
      "tooltip": "Open with current pipeline/run_type, reset stage to All, and preserve the selected time range.",
      "type": "link",
      "url": "/d/bioetl-runtime/bioetl-runtime?var-pipeline=$pipeline&var-run_type=$run_type&var-stage=All&${__url_time_range}"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "3. Provider Health",
      "tooltip": "Reset scope: open global target scope and preserve the selected time range.",
      "type": "link",
      "url": "/d/bioetl-provider-health-v2/bioetl-provider-health-v2?var-provider=All&var-adapter=All&${__url_time_range}"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "4. Data Quality",
      "tooltip": "Open with current pipeline/run_type, reset stage to All, and preserve the selected time range.",
      "type": "link",
      "url": "/d/bioetl-dq-v2/bioetl-dq-v2?var-pipeline=$pipeline&var-run_type=$run_type&var-stage=All&${__url_time_range}"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "5. Workflow",
      "tooltip": "Reset scope: open global target scope and preserve the selected time range.",
      "type": "link",
