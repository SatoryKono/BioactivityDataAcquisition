  "panels": [
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 99,
      "options": {
        "content": "<center><h2>BioETL Overview</h2><p><strong>Primary question:</strong> what is currently broken or degraded in BioETL, and where should the operator drill down first?</p><p><strong>Scope:</strong> pipeline=$pipeline, run_type=$run_type, selected Grafana time range. No green OK is shown without recent activity. Owner: sre-data-platform.</p></center>",
        "mode": "html"
      },
      "title": "L0 Overview Scope",
      "type": "text"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO DATA / UNKNOWN",
                  "color": "gray"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                },
                "2": {
                  "text": "DEGRADED",
                  "color": "orange"
                },
                "3": {
                  "text": "FAILING / BROKEN",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO DATA / UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "none",
          "links": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "id": 214,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "dataLinks": []
      },
      "targets": [
        {
          "expr": "max(bioetl_l0_status{pipeline=~\"$pipeline\",run_type=~\"$run_type\"})",
          "legendFormat": "System status: recording-rule blockers > warnings > activity",
          "refId": "A"
        }
      ],
      "title": "System Status",
      "type": "stat",
      "description": "Thresholds: BROKEN when runtime blocker>0, DQ hard fail>0, or control-plane blocker>0; DEGRADED on warning-only signals; UNKNOWN when no recent samples. Next action: open dashboard indicated by Next Action (Runtime first, then Control Plane, DQ, Provider, Workflow)."
    },
    {
      "id": 215,
      "type": "table",
      "title": "Next Action",
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "5": {
                  "text": "MONITOR",
                  "color": "gray"
                },
                "10": {
                  "text": "WORKFLOW",
                  "color": "green"
                },
                "20": {
                  "text": "PROVIDER",
                  "color": "orange"
                },
                "30": {
                  "text": "DQ",
                  "color": "orange"
                },
                "40": {
                  "text": "CONTROL PLANE",
                  "color": "red"
                },
                "50": {
                  "text": "RUNTIME",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO DATA / UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 10
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(1, bioetl_l0_next_action_route{pipeline=~\"$pipeline\"} > 0)",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "description": "Action route projection. The row exposes `action_target`, `action_reason`, and `action_dashboard_uid`; Runtime > Control Plane > DQ > Provider > Workflow > Monitor. Pipeline scope is explicit; DQ/provider routes remain broader than run_type when the underlying signal is global."
    },
