{
    "dashboard": {
        "title": "BioETL Pipeline Overview",
        "tags": [
            "bioetl",
            "etl",
            "overview"
        ],
        "timezone": "utc",
        "schemaVersion": 39,
        "refresh": "30s",
        "time": {
            "from": "now-6h",
            "to": "now"
        },
        "panels": [
            {
                "id": 1,
                "title": "Pipeline Success Rate",
                "type": "stat",
                "gridPos": {
                    "x": 0,
                    "y": 0,
                    "w": 6,
                    "h": 4
                },
                "targets": [
                    {
                        "expr": "sum(rate(bioetl_pipeline_runs_total{status=\"success\"}[5m])) / sum(rate(bioetl_pipeline_runs_total[5m])) * 100",
                        "legendFormat": "Success Rate %"
                    }
                ],
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ]
                    },
                    "unit": "percent",
                    "colorMode": "value",
                    "graphMode": "area",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "red"
                            },
                            {
                                "value": 80,
                                "color": "yellow"
                            },
                            {
                                "value": 95,
                                "color": "green"
                            }
                        ]
                    }
                }
            },
            {
                "id": 2,
                "title": "Records Processed (Last Hour)",
                "type": "stat",
                "gridPos": {
                    "x": 6,
                    "y": 0,
                    "w": 6,
                    "h": 4
                },
                "targets": [
                    {
                        "expr": "sum(increase(bioetl_records_processed_total{status=\"success\"}[1h]))",
                        "legendFormat": "Total Records"
                    }
                ],
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ]
                    },
                    "unit": "short",
                    "colorMode": "value"
                }
            },
            {
                "id": 3,
                "title": "Error Rate",
                "type": "stat",
                "gridPos": {
                    "x": 12,
                    "y": 0,
                    "w": 6,
                    "h": 4
                },
                "targets": [
                    {
                        "expr": "sum(rate(bioetl_errors_total[5m]))",
                        "legendFormat": "Errors/sec"
                    }
                ],
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ]
                    },
                    "unit": "short",
                    "colorMode": "value",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "green"
                            },
                            {
                                "value": 1,
                                "color": "yellow"
                            },
                            {
                                "value": 5,
                                "color": "red"
                            }
                        ]
                    }
                }
            },
            {
                "id": 4,
                "title": "Active Pipelines",
                "type": "stat",
                "gridPos": {
                    "x": 18,
                    "y": 0,
                    "w": 6,
                    "h": 4
                },
                "targets": [
                    {
                        "expr": "count(bioetl_lock_held_seconds > 0)",
                        "legendFormat": "Active"
                    }
                ],
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ]
                    },
                    "unit": "short",
                    "colorMode": "value"
                }
            },
            {
                "id": 5,
                "title": "Records Processed by Layer",
                "type": "timeseries",
                "gridPos": {
                    "x": 0,
                    "y": 4,
                    "w": 12,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "sum(rate(bioetl_records_processed_total{status=\"success\"}[5m])) by (layer)",
                        "legendFormat": "{{layer}}"
                    }
                ],
                "options": {
                    "tooltip": {
                        "mode": "multi"
                    },
                    "legend": {
                        "displayMode": "list",
                        "placement": "bottom"
                    }
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "ops",
                        "custom": {
                            "lineWidth": 2,
                            "fillOpacity": 10
                        }
                    }
                }
            },
            {
                "id": 6,
                "title": "Pipeline Duration",
                "type": "timeseries",
                "gridPos": {
                    "x": 12,
                    "y": 4,
                    "w": 12,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(bioetl_pipeline_duration_seconds_bucket[5m])) by (le, pipeline))",
                        "legendFormat": "{{pipeline}} (p95)"
                    },
                    {
                        "expr": "histogram_quantile(0.50, sum(rate(bioetl_pipeline_duration_seconds_bucket[5m])) by (le, pipeline))",
                        "legendFormat": "{{pipeline}} (p50)"
                    }
                ],
                "options": {
                    "tooltip": {
                        "mode": "multi"
                    },
                    "legend": {
                        "displayMode": "list",
                        "placement": "bottom"
                    }
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "s",
                        "custom": {
                            "lineWidth": 2
                        }
                    }
                }
            },
            {
                "id": 7,
                "title": "Error Distribution",
                "type": "piechart",
                "gridPos": {
                    "x": 0,
                    "y": 12,
                    "w": 8,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "sum(increase(bioetl_errors_total[1h])) by (error_code)",
                        "legendFormat": "{{error_code}}"
                    }
                ],
                "options": {
                    "legend": {
                        "displayMode": "table",
                        "placement": "right"
                    },
                    "pieType": "donut"
                }
            },
            {
                "id": 8,
                "title": "Circuit Breaker States",
                "type": "timeseries",
                "gridPos": {
                    "x": 8,
                    "y": 12,
                    "w": 8,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "bioetl_circuit_breaker_state",
                        "legendFormat": "{{provider}}"
                    }
                ],
                "options": {
                    "tooltip": {
                        "mode": "multi"
                    },
                    "legend": {
                        "displayMode": "list",
                        "placement": "bottom"
                    }
                },
                "fieldConfig": {
                    "defaults": {
                        "custom": {
                            "lineWidth": 2,
                            "fillOpacity": 0
                        },
                        "mappings": [
                            {
                                "value": 0,
                                "text": "CLOSED",
                                "color": "green"
                            },
                            {
                                "value": 1,
                                "text": "OPEN",
                                "color": "red"
                            },
                            {
                                "value": 2,
                                "text": "HALF_OPEN",
                                "color": "yellow"
                            }
                        ]
                    }
                }
            },
            {
                "id": 9,
                "title": "Data Quality Score",
                "type": "gauge",
                "gridPos": {
                    "x": 16,
                    "y": 12,
                    "w": 8,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "avg(bioetl_data_quality_score) by (layer)",
                        "legendFormat": "{{layer}}"
                    }
                ],
                "options": {
                    "showThresholdLabels": true,
                    "showThresholdMarkers": true,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": 0,
                                "color": "red"
                            },
                            {
                                "value": 0.7,
                                "color": "yellow"
                            },
                            {
                                "value": 0.9,
                                "color": "green"
                            }
                        ]
                    }
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "percentunit",
                        "min": 0,
                        "max": 1
                    }
                }
            },
            {
                "id": 10,
                "title": "API Request Rates by Provider",
                "type": "timeseries",
                "gridPos": {
                    "x": 0,
                    "y": 20,
                    "w": 12,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "sum(rate(bioetl_api_requests_total[5m])) by (provider)",
                        "legendFormat": "{{provider}}"
                    }
                ],
                "options": {
                    "tooltip": {
                        "mode": "multi"
                    },
                    "legend": {
                        "displayMode": "list",
                        "placement": "bottom"
                    }
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "reqps",
                        "custom": {
                            "lineWidth": 2,
                            "fillOpacity": 10
                        }
                    }
                }
            },
            {
                "id": 11,
                "title": "API Request Duration (p95)",
                "type": "timeseries",
                "gridPos": {
                    "x": 12,
                    "y": 20,
                    "w": 12,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(bioetl_api_request_duration_seconds_sum[5m])) by (le, provider))",
                        "legendFormat": "{{provider}}"
                    }
                ],
                "options": {
                    "tooltip": {
                        "mode": "multi"
                    },
                    "legend": {
                        "displayMode": "list",
                        "placement": "bottom"
                    }
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "s",
                        "custom": {
                            "lineWidth": 2
                        }
                    }
                }
            },
            {
                "id": 12,
                "title": "Checkpoint Age",
                "type": "timeseries",
                "gridPos": {
                    "x": 0,
                    "y": 28,
                    "w": 12,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "bioetl_checkpoint_age_seconds",
                        "legendFormat": "{{pipeline}}"
                    }
                ],
                "options": {
                    "tooltip": {
                        "mode": "multi"
                    },
                    "legend": {
                        "displayMode": "list",
                        "placement": "bottom"
                    }
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "s",
                        "custom": {
                            "lineWidth": 2
                        },
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "green"
                                },
                                {
                                    "value": 3600,
                                    "color": "yellow"
                                },
                                {
                                    "value": 7200,
                                    "color": "red"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 13,
                "title": "Quarantine Records",
                "type": "table",
                "gridPos": {
                    "x": 12,
                    "y": 28,
                    "w": 12,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "sum(increase(bioetl_quarantine_records_total[1h])) by (pipeline, error_code)",
                        "format": "table"
                    }
                ],
                "transformations": [
                    {
                        "id": "organize",
                        "options": {
                            "excludeByName": {
                                "Time": true
                            },
                            "indexByName": {
                                "pipeline": 0,
                                "error_code": 1,
                                "Value": 2
                            },
                            "renameByName": {
                                "pipeline": "Pipeline",
                                "error_code": "Error Code",
                                "Value": "Count (1h)"
                            }
                        }
                    }
                ],
                "options": {
                    "showHeader": true,
                    "sortBy": [
                        {
                            "displayName": "Count (1h)",
                            "desc": true
                        }
                    ]
                }
            }
        ]
    }
}
