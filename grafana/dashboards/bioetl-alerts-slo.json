      "id": 1001,
      "options": {
        "content": "<h2>BioETL Alerts & SLO</h2><p>First-class alert surface for active Prometheus alert state and SLO/SLA-oriented incident triage. This dashboard reads alerting evidence only; it does not implement alert logic or duplicate DQ validation.</p>",
        "mode": "html"
      },
      "pluginVersion": "12.2.0",
      "title": "Scope",
      "type": "text",
      "description": "Scope banner for alert and SLO triage. Workflow, pipeline, and run_type are alert evidence scope only; this dashboard intentionally has no run_id selector."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "text": "OK"
                },
                "1": {
                  "color": "red",
                  "text": "FIRING"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "expr": "clamp_max(sum(ALERTS{alertstate=\"firing\"}), 1)",
          "legendFormat": "firing alerts",
          "refId": "A"
        }
      ],
      "title": "Active Alert Status",
      "type": "stat",
      "description": "Fail-closed firing-alert status from ALERTS. Null/no data remains UNKNOWN because absence of the ALERTS series may mean alertmanager/Prometheus telemetry is unavailable, not zero active alerts."
