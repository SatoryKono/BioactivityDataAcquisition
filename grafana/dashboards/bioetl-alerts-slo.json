      "pluginVersion": "12.2.0",
      "title": "Scope",
      "type": "text",
      "description": "Scope banner for alert and SLO triage. Workflow, pipeline, and run_type are alert evidence scope only; this dashboard intentionally has no run_id selector."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "text": "OK"
                },
                "1": {
                  "color": "red",
                  "text": "FIRING"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
