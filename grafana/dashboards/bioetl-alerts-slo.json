      "options": {
        "content": "<h2>BioETL Alerts & SLO</h2><p><b>Row scope is explicit:</b> GLOBAL, PIPELINE or RUN. Dashboard selectors are context; GLOBAL alerts remain visible and cannot be attributed to the selected pipeline.</p>",
        "mode": "html"
