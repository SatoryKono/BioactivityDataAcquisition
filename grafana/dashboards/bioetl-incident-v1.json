    {
      "id": 9400,
      "type": "text",
      "title": "Provenance",
      "description": "Incident scope. Variables are filters; suspects use fleet metrics. role=scope_provenance; scope=pipeline,run_type,provider",
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 0,
        "y": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Incident scope\n- workflow=`$workflow` pipeline=`$pipeline` run_type=`$run_type`\n- provider filter=`$provider` (optional)\n- Deep identity → Run Explorer; resume safety → Trust"
      }
    },
    {
      "id": 9401,
      "type": "stat",
      "title": "Status",
      "description": "Worst-of L0 status for selected pipeline/run_type (bioetl_l0_status). Confidence is low when series absent.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(bioetl_l0_status{pipeline=~\"$pipeline\",run_type=~\"$run_type\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "WARN",
                  "color": "orange"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "CRIT",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 2001,
      "type": "text",
      "title": "Next Best Actions",
      "description": "≤4 CTAs; preserve time range.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "options": {
        "mode": "html",
        "content": "<p><b>1.</b> Ranked suspects below → open matching explorer. <b>2.</b> Pipeline Diagnostics for blockers. <b>3.</b> Provider Explorer for GLOBAL causes. <b>4.</b> Trust if resume/replay risk.</p>"
      },
      "links": [
        {
          "title": "3. Provider Health",
          "url": "/d/bioetl-provider-health-v2/bioetl-provider-health-v2?var-pipeline=$pipeline&var-run_type=$run_type&var-provider=unknown&var-pipeline_context=unknown&var-adapter=unknown&${__url_time_range}&var-workflow=$workflow&var-run_id=$run_id",
          "type": "link",
          "icon": "dashboard",
          "targetBlank": false,
          "keepTime": false,
          "includeVars": false
        },
        {
          "title": "Run Explorer",
          "url": "/d/bioetl-run-explorer-v1/bioetl-run-explorer-v1?var-pipeline=$pipeline&var-run_type=$run_type&${__url_time_range}&var-workflow=$workflow&var-run_id=$run_id",
          "type": "link",
          "icon": "dashboard",
          "targetBlank": false,
          "keepTime": false,
          "includeVars": false
        }
      ]
    },
    {
      "id": 2002,
      "type": "table",
      "title": "Ranked Suspects",
      "description": "Union-style suspect view over existing cause/blocker/reason series. No invented metrics. Empty = VALID EMPTY.",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, bioetl_provider_current_cause > 0) or topk(10, bioetl_runtime_current_blocker_reason > 0) or topk(10, bioetl_dq_current_reason > 0)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "VALID EMPTY — no active suspects in scope",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2003,
      "type": "table",
      "title": "Alert / Event Timeline (range)",
      "description": "Prometheus ALERTS timeline support. Does not implement alert business logic. Platform-agnostic incident surface.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count by (alertname, alertstate, severity) (ALERTS{alertstate=~\"firing|pending\"} * on() group_left() (bioetl_l0_status{pipeline=~\"$pipeline\",run_type=~\"$run_type\"} or on() vector(1))) or count by (alertname, alertstate) (ALERTS{alertstate=~\"firing|pending\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "VALID EMPTY — no active suspects in scope",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
