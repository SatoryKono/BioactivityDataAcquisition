{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "BioETL Workspaces (Shadow)",
  "id": "bioetl-scenes-app",
  "info": {
    "keywords": ["bioetl", "scenes", "observability", "read-only"],
    "description": "Optional read-only task routes over existing BioETL evidence contracts.",
    "author": {
      "name": "BioETL Team"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Operations Home",
      "path": "/a/%PLUGIN_ID%/operations-home",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "Pipeline Flow",
      "path": "/a/%PLUGIN_ID%/pipeline-flow",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Dependency Health",
      "path": "/a/%PLUGIN_ID%/dependency-health",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Incident Console",
      "path": "/a/%PLUGIN_ID%/incident-console",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Data Trust & Recovery",
      "path": "/a/%PLUGIN_ID%/data-trust-recovery",
      "addToNav": true
    },
    {
      "type": "page",
      "name": "Run Explorer",
      "path": "/a/%PLUGIN_ID%/run-explorer",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  }
}
