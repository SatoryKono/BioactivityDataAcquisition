{
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true
  },
  "mcpServers": {
    "docker": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-docker"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN_HERE" }
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": { "MEMORY_FILE_PATH": "E:/g-drive/05_AI/github/BioactivityDataAcquisition2/.ai/mcp/memory/memory.json" }
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "arxiv": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-arxiv"]
    }
  },
  "hooks": {
    "grafana_config_health": { "command": "pytest", "args": ["tests/integration/test_grafana_config.py", "--quiet", "--no-header"], "description": "Grafana config health" },
    "git_branch": { "command": "git", "args": ["rev-parse", "--abbrev-ref", "HEAD"], "description": "Current branch" },
    "git_status_brief": { "command": "git", "args": ["status", "--short"], "description": "Brief git status" },
    "git_last_commit": { "command": "git", "args": ["log", "-1", "--format=%h %an: %s"], "description": "Last commit" },
    "docker_monitoring": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "docker ps --filter 'name=bioetl' --format '{{.Names}}: {{.Status}}'"], "description": "BioETL containers" },
    "metrics_port_check": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if ((Test-NetConnection -ComputerName localhost -Port 8000 -InformationLevel Quiet)) { '8000: OPEN' } else { '8000: CLOSED' }"], "description": "Port 8000" },
    "venv_status": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if ($env:VIRTUAL_ENV) { 'Venv: OK' } else { 'Venv: NO' }"], "description": "Venv status" },
    "python_version": { "command": "python", "args": ["--version"], "description": "Python version" },
    "env_health": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path .env) { 'Env: OK' } else { 'Env: NO' }"], "description": "Env status" },
    "disk_usage": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "\"C: {0:N1}GB free\" -f ((Get-PSDrive C).Free / 1GB)"], "description": "Disk space" },
    "log_errors": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path logs/bioetl.log) { (Select-String -Path logs/bioetl.log -Pattern 'ERROR').Count } else { 0 }"], "description": "Log errors" },
    "quarantine_count": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path data/quarantine) { (Get-ChildItem data/quarantine -Recurse -File).Count } else { 0 }"], "description": "Quarantine" },
    "checkpoints_count": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path data/checkpoints) { (Get-ChildItem data/checkpoints -File).Count } else { 0 }"], "description": "Checkpoints" },
    "ruff_lint": { "command": "ruff", "args": ["check", "--quiet", "--exit-zero"], "description": "Ruff lint" },
    "mypy_lint": { "command": "mypy", "args": ["src", "--quiet", "--no-error-summary"], "description": "Mypy lint" },
    "root_clean": { "command": "python", "args": ["scripts/audit_root_cleanliness.py", "--quiet"], "description": "Root cleanliness" },
    "ast_inventory": { "command": "python", "args": ["scripts/ast_inventory.py", "--summary"], "description": "AST inventory" },
    "doc_links": { "command": "python", "args": ["scripts/check_doc_links.py", "--quiet"], "description": "Doc links" },
    "pipeline_configs": { "command": "python", "args": ["scripts/validate_pipeline_configs.py", "--quiet"], "description": "Pipeline configs" },
    "naming_audit": { "command": "python", "args": ["scripts/naming_audit.py", "--summary"], "description": "Naming audit" },
    "config_gaps": { "command": "python", "args": ["scripts/config_gap_analysis.py", "--summary"], "description": "Config gaps" },
    "schema_artifacts": { "command": "python", "args": ["scripts/generate_schema_artifacts.py", "--check-only"], "description": "Schema artifacts" },
    "checksum_verify": { "command": "python", "args": ["scripts/verify_checksums.py", "--quiet"], "description": "Checksums" },
    "todo_count": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "(Get-ChildItem src -Recurse | Select-String -Pattern 'TODO|FIXME').Count"], "description": "TODO count" },
    "log_file_size": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path logs/bioetl.log) { \"{0:N1}MB\" -f ((Get-Item logs/bioetl.log).Length / 1MB) } else { '0MB' }"], "description": "Log size" },
    "vcr_cassettes": { "command": "python", "args": ["scripts/check_root_vcr_cassettes.py", "--summary"], "description": "VCR cassettes" },
    "naming_exceptions": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path configs/naming_exceptions.yaml) { 'Naming Exc: OK' } else { 'Naming Exc: NO' }"], "description": "Naming exceptions" },
    "active_pipelines": { "command": "bioetl", "args": ["list-pipelines"], "description": "Active pipelines" },
    "johnny_decimal": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "Get-ChildItem docs -Directory | ForEach-Object { if ($_.Name -match '^\\d{2}-') { $true } } | Measure-Object | Select-Object -ExpandProperty Count"], "description": "Johnny.Decimal" },
    "audit_score": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path AUDIT_REPORT.md) { Select-String -Path AUDIT_REPORT.md -Pattern 'Score: (\\d+\\.\\d+)' | ForEach-Object { $_.Matches.Value } } else { 'Score: N/A' }"], "description": "Audit score" },
    "delta_tables": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path data/output/silver) { (Get-ChildItem data/output/silver -Directory).Count } else { 0 }"], "description": "Silver tables" },
    "bronze_data": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path data/output/bronze) { (Get-ChildItem data/output/bronze -Recurse -File).Count } else { 0 }"], "description": "Bronze items" },
    "gold_data": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path data/output/gold) { (Get-ChildItem data/output/gold -Directory).Count } else { 0 }"], "description": "Gold tables" },
    "schema_registry": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path configs/schemas) { (Get-ChildItem configs/schemas -File).Count } else { 0 }"], "description": "Schemas" },
    "import_linter": { "command": "import-linter", "args": ["check", "--quiet"], "description": "Import linter" },
    "diagrams_count": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "(Get-ChildItem docs -Recurse -Include *.puml,*.mermaid).Count"], "description": "Diagrams count" },
    "makefile_health": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path Makefile) { 'Makefile: OK' } else { 'Makefile: NO' }"], "description": "Makefile" },
    "precommit_health": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path .pre-commit-config.yaml) { 'Pre-commit: OK' } else { 'Pre-commit: NO' }"], "description": "Pre-commit" },
    "gitleaks_health": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path .gitleaks.toml) { 'Gitleaks: OK' } else { 'Gitleaks: NO' }"], "description": "Gitleaks" },
    "editorconfig": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path .editorconfig) { 'EditorConfig: OK' } else { 'EditorConfig: NO' }"], "description": "EditorConfig" },
    "license_file": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path LICENSE) { 'License: OK' } else { 'License: NO' }"], "description": "License" },
    "readme_health": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path README.md) { 'Readme: OK' } else { 'Readme: NO' }"], "description": "Readme" },
    "changelog_health": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path CHANGELOG.md) { 'Changelog: OK' } else { 'Changelog: NO' }"], "description": "Changelog" },
    "pytest_cache": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path .pytest_cache) { 'Pytest Cache: OK' } else { 'NO' }"], "description": "Pytest cache" },
    "mypy_cache": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path .mypy_cache) { 'Mypy Cache: OK' } else { 'NO' }"], "description": "Mypy cache" },
    "ruff_cache": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path .ruff_cache) { 'Ruff Cache: OK' } else { 'NO' }"], "description": "Ruff cache" },
    "data_dir_size": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path data) { \"{0:N1}MB\" -f ((Get-ChildItem data -Recurse | Measure-Object -Property Length -Sum).Sum / 1MB) } else { '0MB' }"], "description": "Data dir size" },
    "configs_count": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "(Get-ChildItem configs -Recurse -File).Count"], "description": "Configs count" },
    "src_files_count": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "(Get-ChildItem src -Recurse -Include *.py).Count"], "description": "Source files count" },
    "tests_files_count": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "(Get-ChildItem tests -Recurse -Include *.py).Count"], "description": "Test files count" },
    "api_keys_in_env": { "command": "powershell.exe", "args": ["-NoProfile", "-Command", "if (Test-Path .env) { (Select-String -Path .env -Pattern '_API_KEY').Count } else { 0 }"], "description": "API keys count" }
  }
}
