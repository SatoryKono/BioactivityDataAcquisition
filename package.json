{
  "name": "bioactivitydataacquisition",
  "version": "1.0.0",
  "description": "BioETL is a data processing framework for acquiring, normalizing, and validating bioactivity-related datasets from multiple external sources.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "python -m pytest -m unit --ignore=tests/integration --ignore=tests/golden -q",
    "test:unit": "python -m pytest -m unit --ignore=tests/integration --ignore=tests/golden -q",
    "test:integration": "python -m pytest -m integration tests/integration -q",
    "test:golden": "python -m pytest -m golden tests/golden -q",
    "test:all": "python -m pytest tests/ -q",
    "test:coverage": "python -m pytest --cov=src/bioetl --cov-report=term-missing --cov-report=html --cov-fail-under=85 -q",
    "test:verbose": "python -m pytest -m unit --ignore=tests/integration --ignore=tests/golden -v",
    "diagrams:render": "python tools/render_diagrams.py --root docs --background white --scale 10 --theme default"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SatoryKono/BioactivityDataAcquisition.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/SatoryKono/BioactivityDataAcquisition/issues"
  },
  "homepage": "https://github.com/SatoryKono/BioactivityDataAcquisition#readme",
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "mermaid": "^11.12.2"
  }
}
