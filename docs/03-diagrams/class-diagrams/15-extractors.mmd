%% BioETL — Class Diagram: Field Extractors
%% Extractor pattern used in transformers.

classDiagram
    class BaseFieldExtractor {
        <<ABC>>
        +extract(record: dict) dict*
    }

    note for BaseFieldExtractor "Strategy pattern for\nextracting fields from\nraw API records"

    class AbstractExtractor {
        PubMed abstract text
        +extract(record) dict
    }

    class AuthorExtractor {
        Author name normalization
        +extract(record) dict
    }

    class DateExtractor {
        Publication date parsing
        +extract(record) dict
    }

    class ClassificationExtractor {
        Publication type classification
        +extract(record) dict
    }

    class IdentifierExtractor {
        DOI, PMID, etc.
        +extract(record) dict
    }

    class TaxonomyExtractor {
        UniProt organism/taxonomy
        +extract(record) dict
    }

    class GeneExtractor {
        UniProt gene information
        +extract(record) dict
    }

    class FeatureExtractor {
        UniProt protein features
        +extract(record) dict
    }

    class CrossRefExtractor {
        UniProt cross-references
        +extract(record) dict
    }

    class CommentExtractor {
        UniProt protein comments
        +extract(record) dict
    }

    class MedlineDateParser {
        Parses various date formats
        +parse(date_str) date | None
    }

    BaseFieldExtractor <|-- AbstractExtractor
    BaseFieldExtractor <|-- AuthorExtractor
    BaseFieldExtractor <|-- DateExtractor
    BaseFieldExtractor <|-- ClassificationExtractor
    BaseFieldExtractor <|-- IdentifierExtractor
    BaseFieldExtractor <|-- TaxonomyExtractor
    BaseFieldExtractor <|-- GeneExtractor
    BaseFieldExtractor <|-- FeatureExtractor
    BaseFieldExtractor <|-- CrossRefExtractor
    BaseFieldExtractor <|-- CommentExtractor

    DateExtractor --> MedlineDateParser : uses

    note "PubMed Extractors" as N1
    AbstractExtractor .. N1
    AuthorExtractor .. N1
    DateExtractor .. N1
    ClassificationExtractor .. N1
    IdentifierExtractor .. N1

    note "UniProt Extractors" as N2
    TaxonomyExtractor .. N2
    GeneExtractor .. N2
    FeatureExtractor .. N2
    CrossRefExtractor .. N2
    CommentExtractor .. N2
