%% BioETL — Bootstrap / DI Container (Composition Root)
%% Shows how dependencies are assembled and wired together.

graph TB
    subgraph Entry["Entry Points"]
        CLI["CLI Commands<br/>(Click)"]
        HTTP["HTTP Interface"]
    end

    subgraph Composition["composition layer"]
        subgraph Bootstrap["Bootstrap Assembly"]
            RA["RuntimeAssembly<br/>━━━━━━━━━━━━━━━━━<br/>Central DI wiring point.<br/>Creates all infrastructure<br/>and application components."]
            RBA["RunnerBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_runner()"]
            SBA["StorageBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_storage()"]
            HBA["HealthBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_health()"]
            CBA["CheckpointBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_checkpoint()"]
            LBA["LockBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_lock()"]
        end

        subgraph Factories["Factories"]
            DSR["DataSourceRegistry<br/>━━━━━━━━━━━━━━━━━<br/>Maps provider+entity →<br/>DataSourcePort factory"]
            TF["TransformerFactory<br/>━━━━━━━━━━━━━━━━━<br/>Maps provider+entity →<br/>BaseTransformer factory"]
            RF["RunnerFactory<br/>━━━━━━━━━━━━━━━━━<br/>+ create_runner()"]
            DQF["DQFactory<br/>━━━━━━━━━━━━━━━━━<br/>+ create_dq_analyzers()"]
        end

        subgraph Providers["Provider Registry"]
            PR["ProviderRegistry<br/>━━━━━━━━━━━━━━━━━<br/>Registers all provider<br/>pipelines and their<br/>extraction params"]
            EP["ExtractionParams<br/>Registration"]
        end

        subgraph Builders["Runtime Builders"]
            RB["RunnerBuilder<br/>━━━━━━━━━━━━━━━━━<br/>Fluent builder for<br/>PipelineRunner creation"]
        end
    end

    subgraph Created["Created Components"]
        subgraph InfraCreated["Infrastructure"]
            ADAPTER["Provider Adapter<br/>(DataSourcePort)"]
            STORAGE["BronzeWriter +<br/>SilverWriter +<br/>GoldWriter"]
            LOGGER["UnifiedLogger<br/>(LoggerPort)"]
            METRICS["PrometheusMetrics<br/>(MetricsPort)"]
            TRACER["OpenTelemetryTracer<br/>(TracingPort)"]
            LOCK["MemoryLock<br/>(LockPort)"]
            CHKPT["LocalCheckpoint<br/>(CheckpointPort)"]
            QUAR["UnifiedQuarantine<br/>(QuarantinePort)"]
            AUDIT["FileAuditAdapter<br/>(AuditPort)"]
            PII["Sha256PiiHasher<br/>(PiiHasherPort)"]
        end

        subgraph AppCreated["Application"]
            PS["PipelineServices<br/>(frozen dataclass<br/>with all injected ports)"]
            RUNNER["PipelineRunner"]
            TRANSFORMER["BaseTransformer<br/>(provider-specific)"]
            OBSERVER["PipelineObserver"]
        end
    end

    %% Entry → Composition
    CLI --> RA
    HTTP --> RA

    %% Assembly wiring
    RA --> RBA
    RA --> SBA
    RA --> HBA
    RA --> CBA
    RA --> LBA

    %% Factories
    RA --> DSR
    RA --> TF
    RA --> RF
    RA --> DQF

    %% Provider registration
    PR --> DSR
    PR --> TF
    EP --> PR

    %% Builder
    RF --> RB

    %% Created components
    DSR -->|creates| ADAPTER
    SBA -->|creates| STORAGE
    RA -->|creates| LOGGER
    RA -->|creates| METRICS
    RA -->|creates| TRACER
    LBA -->|creates| LOCK
    CBA -->|creates| CHKPT
    RA -->|creates| QUAR
    RA -->|creates| AUDIT
    RA -->|creates| PII

    TF -->|creates| TRANSFORMER
    RBA -->|creates| RUNNER

    %% PipelineServices aggregation
    ADAPTER --> PS
    STORAGE --> PS
    LOGGER --> PS
    METRICS --> PS
    TRACER --> PS
    LOCK --> PS
    CHKPT --> PS
    QUAR --> PS

    PS --> RUNNER
    TRANSFORMER --> RUNNER
    OBSERVER --> RUNNER

    classDef entry fill:#fce4ec,stroke:#b71c1c,stroke-width:2px
    classDef comp fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef factory fill:#e3f2fd,stroke:#1565c0
    classDef infra fill:#fff3e0,stroke:#e65100
    classDef app fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px

    class CLI,HTTP entry
    class RA,RBA,SBA,HBA,CBA,LBA comp
    class DSR,TF,RF,DQF,PR,EP,RB factory
    class ADAPTER,STORAGE,LOGGER,METRICS,TRACER,LOCK,CHKPT,QUAR,AUDIT,PII infra
    class PS,RUNNER,TRANSFORMER,OBSERVER app
