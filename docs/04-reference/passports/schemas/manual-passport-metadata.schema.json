{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioetl.local/schemas/manual-passport-metadata.schema.json",
  "title": "BioETL passport manual metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner", "owner_approved"],
  "properties": {
    "owner": {"type": "string", "minLength": 1},
    "owner_approved": {"const": true},
    "purpose": {"type": "string"},
    "business_context": {"type": "string"},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string"},
    "curated_field_groups": {
      "type": "array",
      "items": {"type": "string"}
    },
    "operator_notes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "additional_diagram": {
      "type": "string",
      "enum": ["field_lineage", "validation_flow", "nested_projection"]
    },
    "approved_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "decision_ref", "review_by"],
        "properties": {
          "description": {"type": "string"},
          "decision_ref": {"type": "string"},
          "review_by": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
