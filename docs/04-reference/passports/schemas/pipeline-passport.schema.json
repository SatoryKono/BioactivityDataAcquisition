{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioetl.local/schemas/pipeline-passport.schema.json",
  "title": "BioETL pipeline passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passport_schema_version",
    "kind",
    "identity",
    "provenance",
    "source_references",
    "summary",
    "extraction",
    "execution",
    "operator_commands",
    "diagrams",
    "observability",
    "diagnostics"
  ],
  "properties": {
    "passport_schema_version": {"const": "1.0.0"},
    "kind": {"const": "pipeline"},
    "identity": {
      "type": "object",
      "required": ["typed_id", "pipeline_id", "pipeline_type", "status"],
      "properties": {
        "typed_id": {"type": "string", "pattern": "^(pipeline|composite):"},
        "pipeline_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string"},
        "entity": {"type": "string"},
        "pipeline_type": {"enum": ["provider_entity", "composite"]},
        "status": {"const": "active"},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "derived_source_identity": {
          "type": "object",
          "properties": {
            "provider": {"type": ["string", "null"]},
            "entity": {"type": ["string", "null"]},
            "data_source_provider": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "source_references": {"$ref": "#/$defs/sourceReferences"},
    "summary": {
      "type": "object",
      "required": ["sentences", "source_description", "query_filter_summary", "field_selection_summary", "silver_processing_summary", "validation_summary", "excluded_data_summary"],
      "properties": {
        "sentences": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "minLength": 20}},
        "source_description": {"type": "string"},
        "query_filter_summary": {"type": "string"},
        "field_selection_summary": {"type": "string"},
        "silver_processing_summary": {"type": "string"},
        "validation_summary": {"type": "string"},
        "excluded_data_summary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "required": ["source_kind", "source_resource", "source_tables", "source_collections", "filters", "selected_fields", "field_groups"],
      "properties": {
        "source_kind": {"enum": ["http_api", "database", "cached_bronze", "derived", "composite"]},
        "source_resource": {"type": ["string", "null"]},
        "method": {"type": ["string", "null"]},
        "endpoint_template": {"type": ["string", "null"]},
        "source_tables": {"type": "array", "items": {"type": "string"}},
        "source_collections": {"type": "array", "items": {"type": "string"}},
        "filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
        "selected_fields": {"type": "array", "items": {"$ref": "#/$defs/selectedField"}},
        "field_groups": {"type": "array", "items": {"$ref": "#/$defs/fieldGroup"}}
      },
      "additionalProperties": false
    },
    "bronze": {"type": "object"},
    "silver": {"type": "object"},
    "gold": {"type": "object"},
    "composite": {"type": "object"},
    "execution": {"type": "object"},
    "operator_commands": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/operatorCommand"}
    },
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/diagram"}
    },
    "observability": {"$ref": "#/$defs/observability"},
    "diagnostics": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "filter": {
      "type": "object",
      "required": ["name", "source", "required", "description"],
      "properties": {
        "name": {"type": "string"},
        "source": {"enum": ["config", "cli", "adapter", "dependency"]},
        "required": {"type": "boolean"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "selectedField": {
      "type": "object",
      "required": ["name", "source_object", "target_group", "required"],
      "properties": {
        "name": {"type": "string"},
        "source_object": {"type": "string"},
        "target_group": {"enum": ["system", "business", "dq"]},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "fieldGroup": {
      "type": "object",
      "required": ["name", "fields", "field_count"],
      "properties": {
        "name": {"type": "string"},
        "fields": {"type": "array", "items": {"type": "string"}},
        "field_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "operatorCommand": {
      "type": "object",
      "required": ["task", "command", "result", "source_ref"],
      "properties": {
        "task": {"type": "string"},
        "command": {"type": "string", "pattern": "^bioetl "},
        "result": {"type": "string"},
        "source_ref": {"type": "string"}
      },
      "additionalProperties": false
    },
    "diagram": {
      "type": "object",
      "required": ["diagram_id", "kind", "mermaid"],
      "properties": {
        "diagram_id": {"type": "string"},
        "kind": {"const": "flowchart"},
        "mermaid": {"type": "string", "pattern": "^flowchart "}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_revision", "projector_version", "semantic_content_hash"],
      "properties": {
        "source_revision": {"type": "string", "minLength": 7},
        "projector_version": {"type": "string"},
        "semantic_content_hash": {"type": "string", "pattern": "^sha256:"}
      },
      "additionalProperties": false
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "path"],
        "properties": {
          "role": {"type": "string"},
          "path": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "observability": {
      "type": "object",
      "required": ["metric_labels", "correlation_fields"],
      "properties": {
        "metric_labels": {
          "type": "array",
          "not": {
            "contains": {
              "enum": ["run_id", "manifest_id", "payload_hash", "record_id"]
            }
          }
        },
        "correlation_fields": {"type": "array"}
      },
      "additionalProperties": false
    }
  }
}
