%% BioETL Layer Interaction Diagram
%% Shows how layers communicate following Hexagonal Architecture

flowchart TB
    subgraph Interfaces["Interfaces Layer"]
        CLI[CLI Entry Point]
    end

    subgraph Composition["Composition Layer"]
        Bootstrap[bootstrap_pipeline]
        Registry[PipelineRegistry]
        Factories[Factories]

        Bootstrap --> Registry
        Bootstrap --> Factories
    end

    subgraph Application["Application Layer"]
        Runner[PipelineRunner]
        Executor[PipelineExecutor]
        Transformer[BaseTransformer]
        Services[PipelineServices]

        Runner --> Executor
        Executor --> Transformer
        Runner --> Services
    end

    subgraph Domain["Domain Layer"]
        Ports[Port Interfaces]
        Types[Core Types]
        Entities[Domain Entities]
        Exceptions[Exception Hierarchy]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        Adapters[Data Source Adapters]
        Storage[Storage Writers]
        Observability[Metrics & Tracing]
        Locking[Locks & Checkpoints]
    end

    %% Layer Dependencies
    CLI --> Bootstrap
    Factories --> Runner
    Application --> Ports
    Adapters -.->|implements| Ports
    Storage -.->|implements| Ports
    Observability -.->|implements| Ports

    %% Styling
    classDef domainStyle fill:#e1f5fe,stroke:#0288d1
    classDef appStyle fill:#e8f5e9,stroke:#388e3c
    classDef infraStyle fill:#fff3e0,stroke:#f57c00
    classDef compStyle fill:#f3e5f5,stroke:#7b1fa2
    classDef ifaceStyle fill:#fce4ec,stroke:#c2185b

    class Domain domainStyle
    class Application appStyle
    class Infrastructure infraStyle
    class Composition compStyle
    class Interfaces ifaceStyle
