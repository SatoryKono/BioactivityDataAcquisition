%% BioETL — Idempotent Processing Guards
%% Shows how locks, checkpoint identity, and publication guards make reruns/resume safe.

%% @version 1.0.0
%% @date    2026-03-28
%% @type    sequenceDiagram
%% @level   Runtime / Control Plane
%% @nodes   10
%% @reference  Complements 18-lock-checkpoint-shutdown, 20-data-traceability-runtime, and ADR-014 deterministic writes

sequenceDiagram
    autonumber
    actor Caller as CLI run / scheduler
    participant LC as LockRuntimeService
    participant LP as LockPort
    participant HB as HeartbeatTask
    participant CCS as CompositeCheckpointService
    participant CLS as CheckpointLoadService
    participant CPS as CheckpointPersistenceService
    participant COMP as CheckpointCompatibilityService
    participant RUN as PipelineRunner / CompositeRunner
    participant PUB as Writers / artifact publication

    Caller->>LC: acquire(run_id, pipeline)
    LC->>LP: acquire(owner=run_id)
    LP-->>LC: fencing token
    LC->>HB: start(interval)

    alt resume disabled
        LC->>CCS: load()
        CCS->>CLS: create fresh state
        CLS-->>CCS: empty checkpoint state
    else resume enabled
        LC->>CCS: load()
        CCS->>CLS: load latest / run-specific checkpoint
        CLS->>COMP: compare(current identity, checkpoint metadata)
        COMP-->>CLS: compatible / incompatible + disposition

        alt compatible checkpoint
            CLS-->>CCS: resume state
        else incompatible + observe
            CLS-->>CCS: warn and continue with fresh state
        else incompatible + soft_fail / hard_fail
            CCS-->>Caller: block resume / raise error
        end
    end

    Caller->>RUN: execute batches with state
    loop before write / publish
        RUN->>LC: validate lock ownership
        LC->>LP: validate_owner + validate_token
        LP-->>LC: lock still held
        RUN->>PUB: write deterministic layer output
    end

    RUN->>CCS: save(updated state)
    CCS->>CPS: atomic checkpoint write
    CPS-->>CCS: persisted

    alt graceful shutdown
        RUN->>CCS: save(final resumable state)
        RUN->>HB: stop()
        RUN->>LC: release()
    else successful finish
        RUN->>CCS: delete()
        RUN->>HB: stop()
        RUN->>LC: release()
    end

    Note over COMP,PUB: Idempotency here means safe rerun/resume: one active owner, identity-aware resume, and duplicate-safe publication guarded by lock validation.
