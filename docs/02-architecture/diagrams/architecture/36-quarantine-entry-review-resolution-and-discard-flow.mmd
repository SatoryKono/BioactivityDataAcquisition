%% Title: Quarantine Entry Review And Resolution Flow
%% @version 1.1.0
%% @date    2026-07-06
%% @type    stateDiagram
%% @level   Domain / Aggregate
%% RULES: RULES.md §2.3, ADR-021
stateDiagram-v2
    [*] --> NEW
    NEW --> UNDER_REVIEW: start_review()
    NEW --> IGNORED: mark_ignored()
    NEW --> REPROCESSED: mark_reprocessed(new_record_id)
    NEW --> EXPIRED: mark_expired()
    UNDER_REVIEW --> IGNORED: mark_ignored()
    UNDER_REVIEW --> REPROCESSED: mark_reprocessed(new_record_id)
    UNDER_REVIEW --> EXPIRED: mark_expired()
    IGNORED --> [*]
    REPROCESSED --> [*]
    EXPIRED --> [*]

    note right of NEW
      Entries originate from validation, DQ, or runtime quarantine routing.
    end note

    note right of UNDER_REVIEW
      Review state captures analyst intervention before a terminal disposition is chosen.
    end note
