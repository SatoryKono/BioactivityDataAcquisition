%% Title: CrossRef Publication Search Fallback And Batch DOI Fetch
%% @version 1.0.0
%% @date    2026-05-12
%% @type    sequenceDiagram
%% @level   Provider / Interaction
%% RULES: RULES.md §2.1, ADR-030, ADR-033
sequenceDiagram
    autonumber
    participant Runner as publication pipeline
    participant Adapter as CrossRefAdapter
    participant Query as query_builder.py
    participant Fetch as fetch_flow.py
    participant Fallback as fallback.py
    participant Batch as batch.py
    participant Map as response_mapper.py

    Runner->>Adapter: fetch_multi_filtered(...)
    Adapter->>Query: build search params
    Query-->>Adapter: request params
    Adapter->>Fetch: execute request
    alt direct fetch succeeds
        Fetch-->>Adapter: response payload
    else transient or empty path
        Adapter->>Fallback: resolve fallback strategy
        Fallback-->>Adapter: alternate search path
        Adapter->>Batch: issue DOI batch fetch
        Batch-->>Adapter: batch response payload
    end
    Adapter->>Map: normalize publication records
    Map-->>Runner: mapped publication entities
