%% Title: Reproducible Run Contract Across Manifest Ledger And Output Metadata
%% @version 1.0.0
%% @date    2026-05-12
%% @type    flowchart
%% @level   System / Control Plane
%% RULES: RULES.md §2.1, §2.8, ADR-014, ADR-044, ADR-046
flowchart LR
    manifest[RunManifest]
    ledger[RunLedgerEntry]
    effcfg[EffectiveConfigArtifact]
    context[run_id / manifest_id / batch_id]
    bronze_meta[bronze metadata yaml]
    silver_meta[silver metadata yaml]
    gold_meta[gold metadata yaml]
    batch[Batch aggregate]
    lineage[lineage graph + refs]
    replay[replay policy / exact replay]
    inspect[inspection + diagnostics]

    manifest ==> context
    ledger ==> context
    effcfg ==> context
    context --> batch
    context ==> bronze_meta
    context ==> silver_meta
    context ==> gold_meta
    bronze_meta --> lineage
    silver_meta --> lineage
    gold_meta --> lineage
    batch --> lineage
    lineage --> replay
    manifest -.-> replay
    ledger -.-> replay
    effcfg -.-> replay
    replay --> inspect

    class manifest,ledger,effcfg,context,batch,lineage domain;
    class bronze_meta bronze;
    class silver_meta silver;
    class gold_meta gold;
    class replay,inspect app;
