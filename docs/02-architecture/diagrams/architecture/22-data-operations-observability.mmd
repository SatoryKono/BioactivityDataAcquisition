flowchart LR
    subgraph Runtime["Runtime event producers"]
        OBS["PipelineObserver"]:::app
        RUN["PipelineRunner / CompositeRunner"]:::app
        HTTP["HTTP adapters + health checks"]:::app
        CTRL["Manifest / ledger / lineage events"]:::app
    end

    subgraph Contracts["Application observability contracts"]
        LOGP["LoggerPort"]:::port
        METP["MetricsPort"]:::port
        TRCP["TracingPort"]:::port
        CORR["Correlation anchors<br/>run_id + pipeline + stage"]:::artifact
    end

    subgraph Infra["Infrastructure observability"]
        ULOG["UnifiedLogger / structlog"]:::infra
        PMET["PrometheusMetrics"]:::infra
        OTR["OpenTelemetryTracer"]:::infra
    end

    subgraph Signals["Published signals"]
        LOGS["Structured logs<br/>timestamp + event + trace_id/span_id"]:::artifact
        METRICS["Low-cardinality metrics<br/>pipeline / run_type / status / layer"]:::artifact
        TRACES["Trace spans + span events"]:::artifact
    end

    subgraph Ops["Monitoring and diagnosis"]
        PROM["Prometheus scrape"]:::iface
        GRAF["Grafana / alerts / runbooks"]:::iface
        CLI["run-manifest + lineage inspection"]:::iface
    end

    RUN --> OBS
    HTTP --> OBS
    CTRL --> OBS

    OBS --> LOGP --> ULOG --> LOGS
    OBS --> METP --> PMET --> METRICS
    OBS --> TRCP --> OTR --> TRACES
    OBS --> CORR
    CORR --> LOGS
    CORR -.->|"run-level drill-down"| CLI

    METRICS --> PROM --> GRAF
    LOGS --> GRAF
    TRACES --> GRAF

