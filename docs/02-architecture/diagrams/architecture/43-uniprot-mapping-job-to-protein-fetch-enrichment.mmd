%% @type    flowchart
%% @level   Provider / Component
%% @nodes   11
%% RULES: RULES.md §2.1, ADR-009, ADR-031
flowchart TB
    seed[seed ids or accessions]
    adapter[UniProtAdapter]
    idmap[UniProtIDMappingClient]
    job[start idmapping job]
    poll[poll job status]
    mapped[mapped accession set]
    protein[protein fetch adapter mixin]
    features[feature sequence adapter mixin]
    models[BronzeRecord dictionaries]
    bronze[Bronze artifact publication]
    silver[silver protein output]

    seed --> idmap
    seed -->|direct accessions| adapter
    idmap --> job
    job --> poll
    poll ==> mapped
    mapped -.->|caller may use mapped accessions| adapter
    adapter -->|protein entity| protein
    adapter -->|feature or sequence entity| features
    protein ==> models
    features ==> models
    models ==> bronze
    bronze ==> silver

    class seed ext;
    class adapter infra;
    class idmap,job,poll,protein,features infra;
    class mapped,models infra;
    class bronze bronze;
    class silver silver;
