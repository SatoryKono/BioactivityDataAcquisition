graph TB
    subgraph InfraLogging["Infrastructure: Logging"]
        UL["UnifiedLogger<br/>(impl LoggerPort)"]:::size-sm
        NOL["NoOpLogger<br/>(compat fallback)"]:::size-sm
    end

    subgraph InfraMetrics["Infrastructure: Metrics"]
        PM["PrometheusMetrics<br/>(impl MetricsPort)"]:::size-sm
        MSA["MetricsServerAdapter<br/>(MetricsServerPort seam)"]:::size-sm
        MPA["MetricsPublisherAdapter<br/>(MetricsPublisherPort seam)"]:::size-sm
        MC["MetricsCollector<br/>(compat convenience wrapper)"]:::size-sm
        NOM["NoOpMetrics"]:::size-sm
    end

    subgraph InfraTracing["Infrastructure: Tracing"]
        OTT["OpenTelemetryTracer<br/>(impl TracingPort)"]:::size-sm
        NOT["NoOpTracing"]:::size-sm
    end

    subgraph InfraAnomaly["Infrastructure: Anomaly Detection"]
        DQM["DataQualityMonitorService<br/>(impl DQMonitorPort)"]:::size-sm
    end

    subgraph External["External Systems"]
        PROM["Prometheus + Grafana"]:::size-sm
        OTEL_COL["OTLP collector / console exporter"]:::size-sm
    end

    %% Metrics to external
    PM --> MSA --> PROM
    MPA --> PROM
    MC -.compat helper over exported metric families.-> PM

    %% Tracing to external
    OTT --> OTEL_COL

