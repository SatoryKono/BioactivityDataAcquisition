graph LR
    TERM["Terminal user"]:::size-md

    subgraph CLI["interfaces/cli"]
        MAIN["cli.main<br/>Click group"]:::size-md
        REG["registry_helpers<br/>fresh explicit PipelineRegistry"]:::size-md
        RUN["run / run-all"]:::size-md
        RC["run-composite"]:::size-md
        INS["run-manifest / lineage"]:::size-md
        OPS["checkpoint / config / dq / lock<br/>health / export / quarantine / maintenance"]:::size-lg
    end

    subgraph Composition["composition boundary"]
        EXEC["execution_api<br/>run / composite runtime"]:::size-md
        SVC["services_api<br/>runner + inspection + admin services"]:::size-md
        RES["resources_api<br/>cleanup / quarantine / lifecycle"]:::size-md
        ENTRY["entrypoints<br/>retained broad public seam"]:::size-md
        PIPE["PipelineRegistry"]:::size-md
    end

    subgraph Runtime["Created runtime services"]
        PRUN["PipelineRunnerService"]:::size-md
        CRUN["CompositePipelineRunner"]:::size-md
        ISVC["Inspection services<br/>run-manifest / lineage"]:::size-md
        ASVC["Admin services<br/>health / export / checkpoint / vacuum"]:::size-md
        HSRV["HTTP HealthServer<br/>optional command mode"]:::size-md
    end

    TERM --> MAIN
    MAIN --> RUN
    MAIN --> RC
    MAIN --> INS
    MAIN --> OPS

    RUN --> REG --> PIPE
    RUN --> EXEC
    RUN --> SVC
    RC --> EXEC
    INS --> SVC
    OPS --> SVC
    OPS --> RES

    EXEC --> PRUN
    EXEC --> CRUN
    SVC --> PRUN
    SVC --> ISVC
    SVC --> ASVC
    RES --> ASVC
    OPS -.->|"server mode"| HSRV
    SVC -.->|"health deps"| HSRV

    NOTE["CLI prefers narrow APIs.<br/>Use execution_api, services_api,<br/>and resources_api for command paths.<br/>entrypoints kept for broad callers/tests."]:::size-md
    ENTRY -.-> NOTE
    REG -.-> NOTE

    classDef user fill:#f1f5f9,stroke:#64748b
    classDef cli fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    classDef comp fill:#fff7ed,stroke:#f59e0b
