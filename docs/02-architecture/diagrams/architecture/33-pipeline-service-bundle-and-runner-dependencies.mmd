%% Title: Pipeline Service Bundle And Runner Dependencies
%% @version 1.0.0
%% @date    2026-05-12
%% @type    classDiagram
%% @level   Application / Component
%% RULES: RULES.md §2.2, §2.7, ADR-015
classDiagram
    class PipelineRunner {
        +logger
        +shutdown_signal
        +run_id
        +manifest_id
        +services
        +attach_run_ledger_service(service)
        +execution_metrics()
        +execution_diagnostics()
    }
    class PipelineService
    class PipelineStorageProtocol
    class BatchExecutor
    class RecordProcessor
    class BatchWriter
    class BatchMetrics
    class QuarantineManager
    class PipelineRunnerSupportMixin

    PipelineRunner --|> PipelineRunnerSupportMixin
    PipelineRunner --> PipelineService : uses
    PipelineService --> PipelineStorageProtocol : depends on
    PipelineService --> BatchExecutor : orchestrates
    PipelineService --> RecordProcessor : normalizes
    PipelineService --> BatchWriter : publishes
    PipelineService --> BatchMetrics : records
    PipelineService --> QuarantineManager : routes invalid rows
    BatchExecutor --> RecordProcessor : delegates
    BatchExecutor --> BatchWriter : delegates

    note for PipelineStorageProtocol "Protocol combines BronzeStoragePort,<br/>SilverStoragePort, GoldStoragePort,<br/>MergedStoragePort, StorageMaintenancePort,<br/>and StorageLifecyclePort."
