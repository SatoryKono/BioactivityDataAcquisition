%% @uniform width=256 height=126 max_title_len=27 max_desc_lines=5
graph TB
    subgraph Config["Composite Configuration"]
        CC["CompositeConfig"]:::size-lg
        SC["SeedConfig"]:::size-lg
        DC["DependencyConfig"]:::size-lg
        EC["EnricherConfig"]:::size-lg
        MC["MergeConfig"]:::size-lg
        NoteConfig["Config overview<br/>seed + dependencies<br/>enrichers + merge"]:::size-lg
        CC -.- NoteConfig
    end

    CC --> SC
    CC --> DC
    CC --> EC
    CC --> MC

    subgraph Runner["CompositePipelineRunner"]
        CPR["CompositePipelineRunner"]:::size-lg
        NoteRunner["Orchestrates full<br/>composite execution"]:::size-lg
        CPR -.- NoteRunner
    end

    subgraph FSM["State Machine"]
        INIT["INIT"]:::size-lg
        SEED_RUN["SEED_RUNNING"]:::size-lg
        DEP_RUN["DEPS_RUNNING"]:::size-lg
        ENR_RUN["ENRICHERS_RUNNING"]:::size-lg
        MERGE_RUN["MERGING"]:::size-lg
        DONE["COMPLETED"]:::size-lg
        FAILED["FAILED"]:::size-lg
        INIT --> SEED_RUN
        SEED_RUN --> DEP_RUN
        DEP_RUN --> ENR_RUN
        ENR_RUN --> MERGE_RUN
        MERGE_RUN --> DONE
        SEED_RUN --> FAILED
        DEP_RUN --> FAILED
        ENR_RUN --> FAILED
        MERGE_RUN --> FAILED
    end

    subgraph Execution["Execution Components"]
        SEED["Seed Pipeline"]:::size-lg
        subgraph DepsBlock["Dependencies (Sequential)"]
            DEP_COORD["DependencyCoordinator"]:::size-lg
            DEP1["Dependency 1"]:::size-lg
        end

        subgraph EnrichBlock["Enrichers (Parallel Fan-Out)"]
            ENR_COORD["EnrichmentCoordinator"]:::size-lg
            ENR1["Enricher 1"]:::size-lg
            ENR2["Enricher 2"]:::size-lg
            ENR3["Enricher 3"]:::size-lg
            ENR4["Enricher 4"]:::size-lg
        end

        subgraph MergeBlock["Merge Phase"]
            MS["MergeService"]:::size-lg
            DEDUP["EnricherDeduplicator"]:::size-lg
            AGG["EnricherAggregator"]:::size-lg
            REN["ColumnRenamer"]:::size-lg
        end
    end

    subgraph CrossVal["Cross-Validation"]
        CV["EnrichmentCrossValidator"]:::size-lg
    end

    subgraph Checkpoint["Checkpoint"]
        CCM["CompositeCheckpointService"]:::size-lg
    end

    subgraph Preflight["Preflight"]
        CPV["CompositePreflightValidationService"]:::size-lg
    end

    subgraph Results["Results"]
        ER["EnrichmentResult"]:::size-lg
        MR["MergeResult"]:::size-lg
        CR["CompositeResult"]:::size-lg
    end

    %% Flow
    CPR ==> CPV
    CPR --> SEED
    CPR --> DEP_COORD
    CPR --> ENR_COORD
    CPR --> MS
    CPR --> CCM
    CPR --> CV

    DEP_COORD --> DEP1 --> DEP2

    SEED -->|"entity keys"| ENR_COORD
    ENR_COORD --> ENR1 & ENR2 & ENR3 & ENR4

    ENR1 --> ER
    ENR2 --> ER
    ENR3 --> ER
    ENR4 --> ER

    MS --> DEDUP --> AGG --> REN --> ORD
    MS --> MR

    CPR --> CR

    classDef config fill:#f5f3ff,stroke:#7c3aed
    classDef runner fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef exec fill:#fff7ed,stroke:#f59e0b
    classDef merge fill:#f5f3ff,stroke:#7c3aed
    classDef result fill:#f0fdf4,stroke:#16a34a
    classDef fsm fill:#f1f5f9,stroke:#64748b
    classDef check fill:#ffe4e6,stroke:#dc2626

    class CC,SC,DC,EC,MC config
    class CPR runner
    class SEED,DEP_COORD,DEP1,DEP2,ENR_COORD,ENR1,ENR2,ENR3,ENR4 exec
    class MS,DEDUP,AGG,REN,ORD merge
    class ER,MR,CR result
    class INIT,SEED_RUN,DEP_RUN,ENR_RUN,MERGE_RUN,DONE,FAILED fsm
    class CCM,CPV,CV check
