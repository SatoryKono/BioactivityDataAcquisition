%% BioETL — Locking, Checkpoint, and Graceful Shutdown
%% Distinguishes general pipeline lifecycle from the newer composite checkpoint facade and resume semantics.

%% @version 1.3.0
%% @date    2026-09-03
%% @type    flowchart
%% @level   System / Component
%% @nodes   22
%% @reference  Decomposed into 18a-lock-system, 18b-checkpoint-shutdown

%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
%% @uniform width=264 height=216 max_title_len=28 max_desc_lines=10
graph TB
%% keep-orphan: LNHE, SHP
    subgraph Ports["Domain Ports"]
        LKP["LockPort (Protocol)<br/>acquire/release/heartbeat<br/>validate_owner + validate_token"]:::size-lg
        CKP["CheckpointPort (Protocol)<br/>save/load/list/delete"]:::size-lg
        CCP["CompositeCheckpointPort<br/>(composite phase checkpoints)"]:::size-lg
        SHP["ShutdownPort<br/>(Protocol)"]:::size-lg
    end

    subgraph DomainLock["Domain Lock Types"]
        LTYPE["FencingToken +<br/>LockNotHeldError"]:::size-lg
    end

    subgraph AppLock["Application: LockRuntimeService"]
        LM["LockRuntimeService<br/>lock + run_id + shutdown_signal<br/>acquire/release/validate"]:::size-lg
        HB["HeartbeatTask<br/>━━━━━━━━━━━━━━━━━<br/>Background async task<br/>periodically calls<br/>lock.heartbeat()"]:::size-lg
    end

    subgraph AppCheckpoint["Application: Checkpoint Services"]
        CM["CheckpointRuntimeService<br/>standard pipeline checkpoints"]:::size-lg
        CCS["CompositeCheckpointService<br/>thin facade for composite persistence"]:::size-lg
        CLOAD["CompositeCheckpointLoadService<br/>current run-id or latest matching<br/>checkpoint + stale resume guard"]:::size-lg
        CPERSIST["CompositeCheckpointPersistenceService<br/>atomic save/list/delete/orphan cleanup"]:::size-lg
        CCTX["Expected checkpoint context<br/>effective-config + contract anchors"]:::size-lg
    end

    subgraph AppShutdown["Application: Shutdown"]
        SHUT["Shutdown control<br/>signal + reason enum"]:::size-lg
    end

    subgraph InfraLock["Infrastructure: MemoryLock"]
        ML["MemoryLock<br/>in-memory lock store<br/>acquire/release/heartbeat<br/>validate owner + token"]:::size-lg
    end

    subgraph InfraCheckpoint["Infrastructure: LocalCheckpointAdapter"]
        LCP["LocalCheckpointAdapter<br/>base_path + atomic save/load<br/>exists + delete"]:::size-lg
    end

    subgraph SafetyGuard["Safety Guard Pattern"]
        SG["validate_lock()<br/>pre-write lock+token check<br/>raise LockNotHeldError<br/>prevent split-brain"]:::size-lg
    end

    subgraph CompositePath["Composite runtime caveat"]
        CPR["CompositePipelineRunner"]:::size-lg
        NOTE["Composite path acquires LockPort directly<br/>and does not use LockRuntimeService heartbeat"]:::size-lg
    end

    subgraph Lifecycle["Pipeline Lifecycle Integration"]
        direction LR
        START["Pipeline start"]:::size-lg
        RUN["Acquire lock + heartbeat<br/>execute batches + save checkpoints"]:::size-lg
        STOP["Graceful shutdown / release lock<br/>or clean finish + checkpoint cleanup"]:::size-lg
        END["Pipeline End"]:::size-lg
        START --> RUN --> STOP --> END
    end

    %% Port implementations
    LKP -.-> ML
    CKP -.-> LCP
    CCP -.-> LCP

    %% Application composition
    LM --> LKP
    LM --> HB
    LM --> LTYPE
    CM --> CKP
    CCS --> CCP
    CCS --> CLOAD
    CCS --> CPERSIST
    CCS --> CCTX
    CLOAD --> CCP
    CPERSIST --> CCP
    CPR --> LKP
    CPR --> CCS
    CPR -.-> NOTE

    %% Shutdown
    SHUT --> LM

    %% Safety guard
    SG --> LM

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef domain fill:#f5f3ff,stroke:#7c3aed
    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef infra fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef safety fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef lifecycle fill:#f1f5f9,stroke:#64748b

    class LKP,CKP,CCP,SHP port
    class LTYPE domain
    class LM,HB,CM,CCS,CLOAD,CPERSIST,CCTX,SHUT,CPR app
    class ML,LCP infra
    class SG,NOTE safety
    class START,RUN,STOP,END lifecycle
