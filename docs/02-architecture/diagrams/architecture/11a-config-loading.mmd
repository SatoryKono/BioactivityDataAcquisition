graph LR
    subgraph YAML["YAML Config Files"]
        BASE_YAML["configs/base/*.yaml"]:::size-sm
        PROV_YAML["configs/providers/*.yaml"]:::size-sm
        PC_YAML["configs/entities/*/*.yaml"]:::size-sm
        COMP_YAML["configs/composites/*.yaml"]:::size-sm
    end

    subgraph Loaders["Infrastructure Config Loaders"]
        BCL["BaseConfigLoader"]:::size-sm
        PCL["PipelineConfigLoader"]:::size-sm
        DQCL["DQConfigLoader"]:::size-sm
        FCL["FilterConfigLoader"]:::size-sm
    end

    subgraph InfraSchemas["Infrastructure Schemas (Pydantic)"]
        PYC["PipelineYamlConfig"]:::size-sm
        DQF["DQConfigFile"]:::size-sm
        FFG["FilterConfigFile"]:::size-sm
    end

    %% YAML → Loaders
    BASE_YAML --> PCL
    BASE_YAML --> DQCL
    BASE_YAML --> FCL
    PROV_YAML --> PCL
    PROV_YAML --> DQCL
    PROV_YAML --> FCL
    PC_YAML --> PCL
    PC_YAML --> DQCL
    PC_YAML --> FCL
    COMP_YAML --> PCL

    %% Loaders inheritance
    BCL -.->|"inherits"| PCL
    BCL -.->|"inherits"| DQCL
    BCL -.->|"inherits"| FCL

    %% Loaders → Schemas (validation)
    PCL --> PYC
    DQCL --> DQF
    FCL --> FFG

    classDef yaml fill:#fefce8,stroke:#ca8a04,stroke-width:2px
    classDef loader fill:#fff7ed,stroke:#f59e0b
    classDef schema fill:#ffe4e6,stroke:#dc2626

    class BASE_YAML,PROV_YAML,PC_YAML,COMP_YAML yaml
    class BCL,PCL,DQCL,FCL loader
    class PYC,DQF,FFG schema
