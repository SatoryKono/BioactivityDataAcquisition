%% BioETL — Data Traceability Runtime Path
%% Shows how one pipeline run becomes inspectable through manifest, ledger, lineage, and artifact identity anchors.

%% @version 1.0.0
%% @date    2026-09-03
%% @type    flowchart
%% @level   System / Runtime
%% @nodes   20
%% @adr     ADR-044
%% @reference  Complements 19-control-plane-artifacts, 18-lock-checkpoint-shutdown, and 38-runtime-assembly-sequence

%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
%% @uniform width=252 height=132 max_title_len=26 max_desc_lines=5
flowchart LR
    CALLER["CLI run / scheduler caller"]:::iface
    INSPECT["run-manifest + lineage CLI"]:::iface

    subgraph Assembly["Composition runtime assembly"]
        BUILD["build_pipeline_runner"]:::comp
        INPUTS["prepare_runner_inputs"]:::comp
        CTRL["create_run_manifest_with_effective_config"]:::comp
    end

    subgraph Services["Application control-plane services"]
        ECFG["EffectiveConfigService"]:::app
        MANIFEST["RunManifestService"]:::app
        LEDGER["RunLedgerService"]:::app
        MINSP["RunManifestInspectionService"]:::app
        LINSP["LineageInspectionService"]:::app
    end

    subgraph Stores["Infrastructure stores"]
        ECFGS["FileEffectiveConfigArtifactStore"]:::infra
        MSTORE["FileRunManifestStore"]:::infra
        LSTORE["FileRunLedgerStore"]:::infra
        NSTORE["FileLineageStore"]:::infra
    end

    subgraph Runtime["Execution + publication"]
        RUNNER["PipelineRunner"]:::app
        WRITERS["Bronze / Silver / Gold writers"]:::app
    end

    subgraph Anchors["Traceability anchors"]
        RUNID["run_id"]:::artifact
        MANID["manifest_id"]:::artifact
        CFGID["effective_config_artifact_id"]:::artifact
        DATASET["dataset_ref"]:::artifact
        FRAGID["lineage_fragment_id"]:::artifact
    end

    CALLER ==> BUILD ==> INPUTS ==> CTRL
    CTRL --> ECFG --> ECFGS
    CTRL --> MANIFEST --> MSTORE
    CTRL --> LEDGER --> LSTORE

    ECFG --> CFGID
    MANIFEST --> RUNID
    MANIFEST --> MANID
    LEDGER --> RUNID
    LEDGER --> MANID

    CTRL ==> RUNNER
    RUNNER -->|"lifecycle events"| LEDGER
    RUNNER ==> WRITERS
    WRITERS ==>|"artifact publication"| DATASET
    WRITERS -->|"persist lineage fragments"| NSTORE
    NSTORE --> FRAGID
    LEDGER -->|"artifact_published / lineage"| DATASET
    LEDGER -->|"fragment linkage"| FRAGID

    INSPECT --> MINSP -.-> MSTORE
    MINSP -.-> LSTORE
    INSPECT --> LINSP -.-> NSTORE
    MINSP -.->|"resolve by run_id or manifest_id"| RUNID
    MINSP -.->|"show manifest + ledger history"| MANID
    LINSP -.->|"trace produced dataset"| DATASET
    LINSP -.->|"show fragment / explain run"| FRAGID

    classDef iface fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    classDef comp fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef infra fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef artifact fill:#f1f5f9,stroke:#64748b,stroke-width:2px

    class CALLER,INSPECT iface
    class BUILD,INPUTS,CTRL comp
    class ECFG,MANIFEST,LEDGER,MINSP,LINSP,RUNNER,WRITERS app
    class ECFGS,MSTORE,LSTORE,NSTORE infra
    class RUNID,MANID,CFGID,DATASET,FRAGID artifact
