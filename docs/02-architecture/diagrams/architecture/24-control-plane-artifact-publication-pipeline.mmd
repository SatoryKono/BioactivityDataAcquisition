    silver[Silver metadata]
    gold[Gold metadata]
    lineage[lineage metadata bundle]
    replay[HistoricalReplayUniverseService]
    inspect[run_manifest inspection CLI]

    cli --> bootstrap
    bootstrap --> runner
    runner --> bundle
    bundle --> write_artifacts
    write_artifacts --> manifest
    write_artifacts --> ledger
    write_artifacts --> effcfg
    write_artifacts --> wfmanifest
    runner -.-> metadata
