    cli --> bootstrap
    bootstrap --> runner
    bootstrap --> write_artifacts
    bootstrap --> bundle
    bundle -->|injected postrun collaborator| runner
    write_artifacts --> manifest
    write_artifacts --> ledger
    write_artifacts --> effcfg
    cli -->|workflow launch contract| wfmanifest
    runner -.->|storage publication / postrun layer metadata| metadata
    metadata ==> bronze
    metadata ==> silver
    metadata ==> gold
    metadata --> lineage
    manifest ==>|via retained corpus / diagnostics services| replay
    ledger ==>|via retained corpus evidence| replay
    effcfg -.->|referenced provenance| manifest
    replay --> inspect
    inspect --> cli

    class cli,inspect iface;
    class bootstrap,bundle comp;
    class runner app;
    class manifest,ledger,effcfg,wfmanifest,lineage domain;
    class metadata infra;
    class bronze bronze;
    class silver silver;
    class gold gold;
    class replay app;
