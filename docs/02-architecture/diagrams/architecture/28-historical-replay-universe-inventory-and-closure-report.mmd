%% @type    sequenceDiagram
%% @level   System / Interaction
%% @nodes   7
%% RULES: RULES.md §2.8, ADR-044, ADR-046, ADR-047
sequenceDiagram
    autonumber
    participant CLI as diagnostics / run_manifest command
    participant Service as HistoricalReplayUniverseService
    participant Corpus as HistoricalReplayCorpusService
    participant External as external archive records
    participant Inventory as HistoricalReplayUniverseInventorySnapshot
    participant Closure as HistoricalReplayUniverseClosureReportRecord
    participant Clock as RuntimeClockService.now

    CLI->>Service: build_universe_inventory(...)
    Service->>Corpus: build_certifiability_inventory()
    Corpus-->>Service: local certifiability records
    External-->>Service: explicitly supplied external_records
    Service->>Service: build local and external records, deduplicate and sort
    Service->>Inventory: materialize inventory snapshot
    Inventory-->>Service: counts + coverage gaps
    Service-->>CLI: inventory payload
    CLI->>Service: build_universe_closure_report(...)
    Service->>Service: build_universe_inventory(external_records)
    Service->>Service: build truth surface, coverage claims and governed gate
    Service->>Clock: now_factory()
    Clock-->>Service: generated_at for closure report only
    Service->>Closure: materialize closure report record
    Closure-->>CLI: closure report payload

    Note over Service,Clock: now_factory injection avoids nondeterministic datetime.now seams during replay-critical diagnostics.
