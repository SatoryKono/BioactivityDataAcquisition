%% BioETL — Composite Pipeline Execution
%% Runner orchestration: seed → deps → enrichers (parallel) → merge, with checkpointing and cross-validation.

%% @version 1.0.0
%% @date    2026-07-31
%% @type    flowchart
%% @level   System / Component
%% @view    composite-execution
%% @parent  08-composite-pipeline.mmd
%% @nodes   20
%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
graph TB
    subgraph Runner["CompositePipelineRunner"]
        CPR["CompositePipelineRunner<br/>orchestrates full execution"]:::size-sm
    end

    subgraph Preflight["Preflight"]
        CPV["PreflightValidator"]:::size-sm
    end

    subgraph Execution["Execution Components"]
        SEED["Seed Pipeline"]:::size-sm

        subgraph DepsBlock["Dependencies (Sequential)"]
            DEP_COORD["DependencyCoordinator"]:::size-sm
            DEP1["Dependency 1"]:::size-sm
        end

        subgraph EnrichBlock["Enrichers (Parallel Fan-Out)"]
            ENR_COORD["EnrichmentCoordinator"]:::size-sm
            ENR1["Enricher 1"]:::size-sm
            ENR2["Enricher 2"]:::size-sm
            ENR3["Enricher 3"]:::size-sm
            ENR4["Enricher 4"]:::size-sm
        end

        subgraph MergeBlock["Merge Phase"]
            MS["MergeService"]:::size-sm
            DEDUP["EnricherDeduplicator"]:::size-sm
            AGG["EnricherAggregator"]:::size-sm
            REN["ColumnRenamer"]:::size-sm
            ORD["ColumnOrderService"]:::size-sm
        end
    end

    subgraph CrossVal["Cross-Validation"]
        CV["EnrichmentCrossValidator"]:::size-sm
    end

    subgraph Checkpoint["Checkpoint"]
        CCM["CompositeCheckpointService"]:::size-sm
    end

    subgraph Results["Results"]
        ER["EnrichmentResult"]:::size-sm
        MR["MergeResult"]:::size-sm
        CR["CompositeResult"]:::size-sm
    end

    %% Runner orchestration
    CPR ==> CPV
    CPR --> SEED
    CPR --> DEP_COORD
    CPR --> ENR_COORD
    CPR --> MS
    CPR --> CCM
    CPR --> CV

    %% Dependencies
    DEP_COORD --> DEP1

    %% Enrichment fan-out
    SEED -->|"entity keys"| ENR_COORD
    ENR_COORD --> ENR1 & ENR2 & ENR3 & ENR4

    %% Enricher results
    ENR1 --> ER
    ENR2 --> ER
    ENR3 --> ER
    ENR4 --> ER

    %% Merge pipeline
    MS --> DEDUP --> AGG --> REN --> ORD
    MS --> MR

    %% Final result
    CPR --> CR

    classDef runner fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef exec fill:#fff7ed,stroke:#f59e0b
    classDef merge fill:#f5f3ff,stroke:#7c3aed
    classDef result fill:#f0fdf4,stroke:#16a34a
    classDef check fill:#ffe4e6,stroke:#dc2626

    class CPR runner
    class SEED,DEP_COORD,DEP1,ENR_COORD,ENR1,ENR2,ENR3,ENR4 exec
    class MS,DEDUP,AGG,REN,ORD merge
    class ER,MR,CR result
    class CCM,CPV,CV check
