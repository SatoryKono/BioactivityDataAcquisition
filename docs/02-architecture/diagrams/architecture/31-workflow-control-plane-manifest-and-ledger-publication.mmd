flowchart TB
    workflow_cmd[workflow CLI command]
    state[workflow execution state]
    step[WorkflowManifestStep]
    manifest[WorkflowManifest]
    ledger[WorkflowLedgerEntry]
    ledger_service[WorkflowLedgerService]
    ledger_port[WorkflowLedgerPort]
    run_refs[child run manifests]
    checkpoints[workflow checkpoints]
    diagnostics[workflow diagnostics]
    maintenance[maintenance commands]

    workflow_cmd --> state
    state --> step
    step ==> manifest
    step --> ledger_service
    manifest -->|record_manifest_created| ledger_service
    ledger_service -->|create WorkflowLedgerEntry| ledger
    ledger_service -->|"append(entry)"| ledger_port
    manifest -.-> run_refs
    ledger -.-> run_refs
    manifest --> checkpoints
    ledger --> diagnostics
    checkpoints --> maintenance
    run_refs --> diagnostics

    class workflow_cmd,diagnostics,maintenance iface;
    class state,step,manifest,ledger domain;
    class run_refs,checkpoints,ledger_service app;
