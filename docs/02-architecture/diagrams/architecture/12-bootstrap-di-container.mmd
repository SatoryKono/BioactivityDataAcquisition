graph TB
    CALLERS["Entry callers<br/>CLI + tests/scripts<br/>+ programmatic integrations"]:::size-md

    subgraph Public["Public composition seams"]
        ENTRY["composition.entrypoints<br/>run/build + service getters"]:::size-md
        BOOT["composition.bootstrap<br/>lower-level runtime / cli seam"]:::size-md
    end

    subgraph Composition["Internal composition modules"]
        subgraph Registries["Registries + factories"]
            PR["ProviderRegistry<br/>provider configs + creators"]:::size-md
            PIPE["PipelineRegistry<br/>pipeline definitions"]:::size-md
            DSF["DataSourceFactory<br/>canonical provider adapter path"]:::size-md
            PF["GenericPipelineFactory / RunnerFactory<br/>pipeline creation seams"]:::size-md
            SF["StorageFactory<br/>storage creation seam"]:::size-md
        end

        subgraph Runtime["Runtime bootstrap"]
            BPR["bootstrap_pipeline_runner<br/>runtime bootstrap entry"]:::size-md
            BUILDER["build_pipeline_runner<br/>runtime assembly leaf"]:::size-md
            RH["Composite runtime helpers<br/>RunnerFactoryBuilderService +<br/>CompositeSupportServicesFactory"]:::size-md
        end

        subgraph Admin["CLI/bootstrap services"]
            SUPPORT["bootstrap.cli + bootstrap.assembly<br/>admin commands + shared ports"]:::size-md
        end
    end

    subgraph Created["Created collaborators"]
        ADAPTER["Provider adapter<br/>DataSourcePort"]:::size-md
        STORAGE["StorageContext / StorageAdapter<br/>Bronze / Silver / Gold"]:::size-md
        OBS["Observability bundle<br/>logger / metrics / tracer"]:::size-md
        LOCK["LockPort + checkpoint / quarantine ports"]:::size-md
        RUNNER["PipelineRunner /<br/>PipelineRunnerService"]:::size-md
        COMPOSITE["CompositePipelineRunnerService"]:::size-md
        ADMINSVC["Admin services<br/>health / export / vacuum / checkpoint"]:::size-md
    end

