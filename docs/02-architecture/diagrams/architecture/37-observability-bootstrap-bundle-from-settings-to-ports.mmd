flowchart TB
    settings[Runtime settings]
    logger_fn[bootstrap_logger]
    tracer_fn[bootstrap_tracer]
    metrics_fn[bootstrap_metrics]
    dq_fn[bootstrap_dq_monitor]
    bundle_fn[bootstrap_observability_bundle]
    server_fn[maybe_start_metrics_server]
    logger[StructlogLogger]
    tracer[OpenTelemetryTracer / NoOp]
    metrics[Metrics port impl]
    dq[DQ monitor]
    server[metrics server]
    app[PipelineRunner / CompositePipelineRunner]

    settings --> logger_fn
    settings --> tracer_fn
    settings --> metrics_fn
    settings --> dq_fn
    logger_fn --> logger
    tracer_fn --> tracer
    metrics_fn --> metrics
    dq_fn --> dq
    logger -.-> bundle_fn
    tracer -.-> bundle_fn
    metrics -.-> bundle_fn
    dq -.-> bundle_fn
    settings --> server_fn
    server_fn --> server
    bundle_fn ==> app

    class settings comp;
    class logger_fn,tracer_fn,metrics_fn,dq_fn,bundle_fn,server_fn comp;
    class logger,tracer,metrics,dq,server infra;
    class app app;
