%% BioETL — Storage Writers
%% Bronze/Silver/Gold writers with Delta Lake base class, port contract, and file system layout.

%% @version 1.0.0
%% @date    2026-07-31
%% @type    flowchart
%% @level   System / Component
%% @view    storage-writers
%% @parent  06-storage-layer.mmd
%% @nodes   10
%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
graph TB
    subgraph Port["Domain Storage Ports"]
        SP["BronzeStoragePort / SilverStoragePort<br/>GoldStoragePort / MergedStoragePort"]:::size-sm
    end

    subgraph BronzeStorage["Bronze Storage"]
        BW["BronzeWriter<br/>write_bronze() / aclose()"]:::size-sm
        AWG["AtomicWriteGroup<br/>atomic multi-file writes"]:::size-sm
    end

    subgraph SilverStorage["Silver Storage"]
        BDW["BaseDeltaWriter<br/>get_table_path() / clear()"]:::size-sm
        SWR["SilverWriter<br/>write_silver() / merge_silver()"]:::size-sm
    end

    subgraph GoldStorage["Gold Storage"]
        GWR["GoldWriter<br/>write_gold() / clear_gold()"]:::size-sm
    end

    subgraph Reader["Delta Reader"]
        DR["DeltaReader<br/>read delta tables"]:::size-sm
    end

    subgraph FileSystem["File System Layout"]
        FS_B["bronze/<br/>{provider}/{entity}/{date}/"]:::size-sm
        FS_S["silver/<br/>{provider}_{entity}/_delta_log/"]:::size-sm
        FS_G["gold/<br/>{provider}_{entity}/_delta_log/"]:::size-sm
    end

    %% Inheritance
    BDW --> SWR
    BDW --> GWR

    %% Port implementations
    SP -.->|implements| BW
    SP -.->|implements| SWR
    SP -.->|implements| GWR
    SP -.->|implements| DR

    %% Composition
    BW --> AWG

    %% File system mapping
    BW -.-> FS_B
    SWR -.-> FS_S
    GWR -.-> FS_G

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef writer fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef fs fill:#f1f5f9,stroke:#64748b

    class SP port
    class BW,AWG,BDW,SWR,GWR,DR writer
    class FS_B,FS_S,FS_G fs
