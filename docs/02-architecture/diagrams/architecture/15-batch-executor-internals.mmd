%% BioETL — BatchExecutor Internal Architecture
%% Shows the current decomposition of BatchExecutor runtime orchestration.

%% @version 1.1.0
%% @date    2026-08-21
%% @type    flowchart
%% @level   Component / Service
%% @nodes   16
%% @allow-polyline-routing
%% @uniform width=280 height=256 max_title_len=20 max_desc_lines=12

%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
graph TB
    subgraph Executor["BatchExecutor Shell"]
        BE["BatchExecutor<br/>services + context + config<br/>dependencies + FSM state<br/>execute() + process()<br/>get_run_statistics()"]:::size-md
        DEP["BatchExecutorDependencies<br/>--------<br/>memory_manager<br/>execution_run_service<br/>extraction_loop_service<br/>processing_port + state_service + fsm"]:::size-md
        CTX["prepare_execution_context()<br/>--------<br/>BatchExecutionContext<br/>limit + query + offset<br/>resume_offset"]:::size-md
        FSM["BatchExecutionFSM<br/>--------<br/>RUN_STARTED / BATCH_ASSEMBLED<br/>PROCESS_SUCCEEDED / FAILED<br/>STATE_COMMITTED"]:::size-md
    end

    subgraph Runtime["Run Orchestration"]
        RUN["BatchExecutionRunService<br/>--------<br/>start + loop + finalize policy<br/>success / shutdown / error paths"]:::size-md
        LIFE["BatchExecutionLifecycleService<br/>--------<br/>initialize progress + root span<br/>save checkpoint on shutdown/error<br/>finalize execution stats"]:::size-md
        LOOP["BatchExtractionLoopService<br/>--------<br/>extract_records() loop<br/>adaptive batch sizing<br/>flush remaining batch"]:::size-md
        MEM["BatchMemoryManagerService<br/>--------<br/>check interval<br/>check_pressure()<br/>maybe_recover()"]:::size-md
    end

    subgraph Contracts["Processing And State Contracts"]
        PROC["PipelineProcessingPort<br/>--------<br/>process_batch(records, start_index, query)<br/>canonical impl: BatchProcessingService"]:::size-md
        STATE["BatchStateCommitProtocol<br/>--------<br/>commit_successful_batch()<br/>build_batch_result()<br/>build_run_statistics()"]:::size-md
    end

    subgraph Processing["BatchProcessingService Internals"]
        DS["PipelineService.data_source.fetch()<br/>--------<br/>async extraction source<br/>limit / query / offset aware"]:::size-md
        TRACE["BatchTracingManagerService<br/>--------<br/>root + batch spans<br/>execution stats finalization"]:::size-md
        MET["BatchMetricsRecorderService<br/>--------<br/>batch size / processed / errors<br/>DQ validation failures"]:::size-md
        TRANS["BatchTransformer<br/>--------<br/>transform_batch()<br/>quarantine + DQ thresholds"]:::size-md
        WRITE["BatchWriter<br/>--------<br/>write_bronze/silver/gold<br/>lock-safe validation path"]:::size-md
        QM["QuarantineRuntimeService<br/>--------<br/>quarantine_record()<br/>quarantine_records()"]:::size-md
        OUT["BatchProcessingOutcome<br/>--------<br/>batch_id + bronze_result<br/>silver/gold records<br/>quarantined + filtered counts"]:::size-md
    end

    BE --> DEP
    BE --> CTX
    BE --> FSM
    BE --> RUN
    BE --> LOOP
    BE --> PROC
    BE --> STATE

    CTX --> RUN
    RUN --> LIFE
    RUN --> LOOP
    LOOP --> DS
    LOOP --> MEM
    LOOP -->|"assembled batch callback"| BE

    BE -->|"advance events"| FSM
    BE -->|"process_batch(...)"| PROC
    PROC --> TRACE
    PROC --> MET
    PROC --> TRANS
    PROC --> WRITE
    TRANS --> QM
    WRITE --> OUT
    PROC --> OUT
    BE -->|"commit_successful_batch()"| STATE
    STATE -->|"update counters / build stats"| BE
    LIFE -.->|"root span + finalize stats"| TRACE

    classDef executor fill:#eff6ff,stroke:#2563eb,stroke-width:3px
    classDef helper fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
    classDef data fill:#f0fdf4,stroke:#16a34a
    classDef result fill:#f5f3ff,stroke:#7c3aed
    classDef error fill:#fff1f2,stroke:#dc2626

    class BE,DEP executor
    class RUN,LIFE,LOOP,MEM,PROC,STATE,TRACE,MET,TRANS,WRITE,QM helper
    class CTX,DS data
    class OUT result
    class FSM error

    %% Link styles (LBP-005)
    linkStyle 0,1,2,3,4,5,6,13,14,20 stroke:#1E293B,stroke-width:3px
    linkStyle 7,8,9,10,11,12,15,16,17,18,19 stroke:#16a34a,stroke-width:2px
    linkStyle 21 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
