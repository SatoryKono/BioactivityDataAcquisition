flowchart TB
    subgraph Init["Phase 1: Initialization"]
        CFG["[S] Load CompositeConfig<br/>from YAML<br/><br/>"]
        PFV["[S] CompositePreflightValidationService<br/>• validate seed<br/>• validate enrichers<br/>• check silver tables"]
        BOOT["[S] bootstrap_composite_runner()<br/>runtime assembly composes runner factories<br/>+ support services + manifest/ledger"]
    end

    subgraph Seed["Phase 2: Seed Pipeline"]
        SP["[S] Run seed PipelineRunner<br/>(e.g., chembl_publication)<br/>"]
        SB[("[D] Seed Silver Table<br/>silver/chembl/publication/"<br/>)]
    end

    subgraph Deps["Phase 3: Dependencies"]
        DC["[S] DependencyCoordinatorService<br/>• run_dependencies()<br/>"]
        DOUT[("[D] Dependency silver outputs<br/>(optional)")]
    end

    subgraph Keys["Phase 3.5: Key Extraction"]
        KE["[S] KeyExtractorService<br/>• extract_keys(seed_silver,<br/>join_keys=[doi, pmid])<br/>"]
        KEYS["[D] Filter Keys<br/>(DOIs, PMIDs)<br/><br/>"]
    end

    subgraph Enrich["Phase 4: Fan-Out Enrichment"]
        direction LR
        EC["[S] EnrichmentCoordinator<br/>• asyncio.gather(*enrichers,<br/>return_exceptions=True)<br/>"]
        ER["[S] Enricher runners<br/>CrossRef + PubMed + OpenAlex +<br/>SemanticScholar"]:::size-md
        ES[("[D] Enriched silver outputs<br/>crossref/pubmed/openalex/<br/>semanticscholar publication tables")]:::size-md
    end

    subgraph Merge["Phase 5: Merge"]
        direction LR
        MS["[S] MergeService<br/>• deduplicate + LEFT OUTER JOIN<br/>• conflict resolution"]:::size-md
        SHAPE["[S] Output shaping<br/>column ordering + qualified renames"]:::size-md
    end

    subgraph Gold["Phase 6: Gold Write"]
        direction LR
        GW["[S] Gold validation + version-aware write<br/>contract/schema aware routing<br/>GoldWriter.write_gold()"]:::size-md
        GT[("[D] Gold Table<br/>gold/composite/publication/"<br/>)]
    end

    subgraph CKP["Checkpointing (each phase)"]
        LOAD["[S] Resume gate<br/>load checkpoint + validate anchors +<br/>replay ledger suffix after last_event_id"]:::size-md
        SAVE["[S] Checkpoint snapshot save<br/>state + phase results + anchors +<br/>last_event_id watermark"]:::size-md
        LEDGER["[S] Control-plane ledger<br/>run_* + stage_started /<br/>stage_completed events"]:::size-md
    end

    %% Flow
    CFG ==> PFV ==> BOOT
    BOOT ==> LOAD ==> SP ==> SB

    SB -.-> DC ==> DOUT

    SB ==> KE
    KE ==> KEYS

    KEYS ==> EC
    EC ==> ER ==> ES

    ES ==> MS
    SB -.->|"seeds"| MS
    MS ==> SHAPE

    SHAPE ==> GW ==> GT

    SAVE -.->|"persist phase snapshot"| SP
    SAVE -.-> DC
    SAVE -.-> EC
    SAVE -.-> MS
    SAVE -.-> GW
    LEDGER -.->|"emit lifecycle + phase events"| SP
    LEDGER -.-> DC
    LEDGER -.-> EC
    LEDGER -.-> MS
    LEDGER -.-> GW
    LOAD -.->|"resume branch"| DC
    LOAD -.-> EC
    LOAD -.-> MS
    LOAD -.-> GW

