flowchart TB
    ProviderAPIs["🌐 Provider APIs<br/>ChEMBL + PubChem + UniProt + PubMed"]:::size-md

    subgraph Local["Local Machine (Single Instance)"]
        subgraph Orchestration["CLI Execution"]
            CLI["🖥️ CLI / Manual run<br/>PipelineRunner"]
            Schedule["⏰ Local scheduler<br/>(cron/systemd)"]
        end

        subgraph Runtime["Local Pipeline Workers"]
            Workers["📦 Local pipelines<br/>chembl_* + pubchem_compound +<br/>uniprot_protein"]:::size-md
        end

        subgraph Locking["In-Process Locking"]
            MemoryLock["MemoryLock<br/>in-process only<br/>no cross-process coordination"]
        end

        subgraph Data["Local filesystem (data/)"]
            Bronze[("📁 bronze/<br/>JSONL+zstd")]
            Silver[("📁 silver/<br/>Delta Lake")]
            Gold[("📁 gold/<br/>Delta")]
            Quarantine[("📁 quarantine/<br/>Delta")]
            Checkpoints[("📁 checkpoints/<br/>JSON")]
            Lineage[("📁 lineage/<br/>JSONL")]
        end

        subgraph Observability["Local Observability"]
            Logs["📋 Local logs<br/>stdout/file"]
            Metrics["📊 In-process metrics<br/>"]
        end
    end

    %% External API connections
    ProviderAPIs --> Workers

    %% Orchestration to runtime
    CLI --> Workers
    Schedule --> CLI

    %% Runtime to MemoryLock
    Workers -.->|lock| MemoryLock

    %% Runtime to local filesystem
    Workers --> Bronze
    Workers --> Silver
    Workers --> Gold
    Workers --> Quarantine
    Workers --> Checkpoints
    Workers --> Lineage

    %% Runtime to local observability
    Workers --> Logs
    Workers --> Metrics

