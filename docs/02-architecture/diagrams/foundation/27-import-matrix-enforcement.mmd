        COMP["<b>Composition Layer</b><br/>Factories + registries<br/><i>src/bioetl/composition/</i>"]
        APP["<b>Application Layer</b><br/>Runner + executor + services<br/><i>src/bioetl/application/</i>"]
        INFRA["<b>Infrastructure Layer</b><br/>Adapters + storage + observability<br/><i>src/bioetl/infrastructure/</i>"]
        DOM["<b>Domain Layer</b><br/>Ports + entities + types<br/><i>src/bioetl/domain/</i>"]
    end

    %% Allowed imports (solid green arrows)
    INT -->|"✅ imports"| COMP
    INT -->|"✅ imports"| APP
    INT -->|"✅ imports"| INFRA
    INT -->|"✅ imports"| DOM

    COMP -->|"✅ imports"| APP
