    Compound {
        string compound_id PK "PubChem CID"
        string iupac_name "IUPAC name"
        string canonical_smiles "Canonical SMILES"
        string isomeric_smiles "Isomeric SMILES"
        string inchi "InChI string"
        string inchikey "InChIKey"
        float molecular_weight "Molecular weight"
        string molecular_formula "Chemical formula"
        float xlogp "Calculated LogP"
        int h_bond_donor_count "H-bond donors"
        int h_bond_acceptor_count "H-bond acceptors"
