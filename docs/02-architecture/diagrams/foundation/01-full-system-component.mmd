        CLI["CLI run / run-all / run-composite"]
        InspectCLI["CLI run-manifest / lineage / checkpoint"]
        Signals["Signal orchestration"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        ExecAPI["execution_api"]
        ControlPlaneAPI["control_plane_api"]
        HealthAPI["health_api"]
        MaintenanceAPI["maintenance_api"]
        ResourcesAPI["resources_api"]
        BuildRunner["build_pipeline_runner"]
        Registry["PipelineRegistry"]
        PipelineFactory["GenericPipelineFactory"]
        StorageFactory["StorageFactory"]
        Assembly["service + runner assembly"]
        ControlPlaneBuild["Control-plane runner assembly"]
    end

    subgraph Application["Application Layer"]
        direction TB
        RunnerService["PipelineRunnerService"]
        PipelineRunner["PipelineRunner"]
        RunnerDeps["PipelineRunnerDependencies"]
        BatchExecutor["BatchExecutor"]
        BatchProcessing["BatchProcessingService"]
        TransformWrite["BatchTransformer / BatchWriter"]
        PipelineServices["PipelineService"]
        Lifecycle["Preflight / Postrun / MedallionLifecycle"]
        CompositeRuntime["Composite runtime"]
        ControlPlaneServices["RunManifestService / RunLedgerService /<br/>EffectiveConfigService"]
        InspectionServices["RunManifestInspectionService /<br/>LineageInspectionService"]
    end

    subgraph Domain["Domain Layer"]
        direction TB
        Ports["Port facades"]
        Models["Entities / value objects"]
        RuntimeConfig["Pipeline + runtime config"]
        Errors["Errors / events"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        ProviderAdapters["Provider adapters"]
        HTTPStack["Unified HTTP stack"]
        StorageRuntime["Bronze / Delta / Gold storage"]
        StateAdapters["Lock / checkpoint adapters"]
        ControlPlaneStores["FileRunManifestStore / FileRunLedgerStore /<br/>FileLineageStore"]
        Observability["Metrics / tracing adapters"]
    end

    subgraph DataLake["Data Lake / State"]
        direction LR
        Bronze[("Bronze")]
        Silver[("Silver Delta")]
        Gold[("Gold Delta")]
        ControlPlane[("Quarantine / checkpoints /<br/>run_manifest / run_ledger / lineage")]
        ConfigArtifacts[("Effective-config artifacts")]
    end

    BioactivityAPIs --> ProviderAdapters
    PublicationAPIs --> ProviderAdapters

    CLI ==> ExecAPI
    InspectCLI ==> ControlPlaneAPI
    InspectCLI ==> HealthAPI
    InspectCLI ==> MaintenanceAPI
    InspectCLI ==> ResourcesAPI
    Signals --> RunnerService

    ExecAPI --> BuildRunner
    BuildRunner --> Registry --> PipelineFactory
    PipelineFactory --> Assembly
    Assembly --> StorageFactory
    Assembly --> RunnerService
    Assembly --> PipelineRunner
    Assembly --> ControlPlaneBuild
    ControlPlaneAPI --> InspectionServices
    HealthAPI --> Lifecycle
    MaintenanceAPI --> Lifecycle
    ResourcesAPI --> Lifecycle

    RunnerService ==> PipelineRunner
    PipelineRunner --> RunnerDeps
    RunnerDeps ==> BatchExecutor
    PipelineRunner --> PipelineServices
    PipelineRunner --> Lifecycle
    PipelineRunner --> ControlPlaneServices
    BatchExecutor ==> BatchProcessing
    BatchProcessing --> TransformWrite
    BatchProcessing --> PipelineServices
    CompositeRuntime -.->|"delegates"| PipelineRunner

    PipelineRunner -.-> Ports
    PipelineServices -.-> Ports
    Lifecycle -.-> Ports
    BatchProcessing --> Models
    PipelineRunner --> RuntimeConfig
    PipelineRunner --> Errors

    ProviderAdapters -.->|"implement"| Ports
    StorageRuntime -.->|"implement"| Ports
    StateAdapters -.->|"implement"| Ports
    ControlPlaneStores -.->|"implement"| Ports
    Observability -.->|"implement"| Ports

    ProviderAdapters --> HTTPStack
    StorageFactory --> StorageRuntime
    BuildRunner --> StateAdapters
    ControlPlaneBuild --> ControlPlaneStores
    BuildRunner --> Observability

    StorageRuntime ==> Bronze
    StorageRuntime ==> Silver
    StorageRuntime ==> Gold
    StateAdapters --> ControlPlane
    StorageRuntime -.-> ControlPlane
    ControlPlaneStores --> ControlPlane
    ControlPlaneServices --> ConfigArtifacts

