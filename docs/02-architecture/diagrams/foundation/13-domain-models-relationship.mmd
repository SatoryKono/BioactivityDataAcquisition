%% Title: Domain Models Relationship Hierarchy
%% Covers: RULES.md §1.3 (Domain Entities), §1.1 (Domain Layer)
%% Updated: 2026-02-17
%% Components: BaseEntity, Activity, Assay, Target, Molecule, Publication, Lineage fields

%% @version 1.0.0
%% @date    2026-02-24
%% @type    classDiagram
%% @level   Mixed (System / Component / Class)
%% @nodes   15
%% @uniform class width=248 height=240 max_title_len=26 max_desc_lines=22
%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
classDiagram
    direction TB

    class BaseEntity {
        <<abstract>>
        +entity_id: EntityID
        +content_hash: ContentHash
        +run_id: RunID
        +run_type: RunType
        +ingestion_ts: datetime
        +source_batch_id: BatchID
