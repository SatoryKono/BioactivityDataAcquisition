    subgraph Hexagon["Domain Layer — Ports (Protocol)"]
        direction TB

        subgraph DataPorts["Data Ports"]
            DSP["DataSourcePort<br/>• fetch() → AsyncIterator<br/>• health_check() → HealthStatus"]
