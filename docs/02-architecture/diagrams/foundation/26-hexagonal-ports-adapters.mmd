            QP["QuarantinePort<br/>• write()<br/>• read_sample()<br/>• purge()"]
        end

        subgraph ObsPorts["Observability Ports"]
            LGP["LoggerPort<br/>• info() / warning()<br/>• error() / debug()<br/>• bind()"]
