            TP["TracingPort<br/>• get_tracer()<br/>• start_span()"]
            DQM["DQMonitorPort<br/>• record_metrics()"]
        end

        subgraph QualityPorts["Quality & Security Ports"]
            SVP["SilverValidatorPort<br/>• validate()"]
            GVP["GoldValidatorPort<br/>• validate()"]
            PIIP["PiiHasherPort<br/>• hash_field()"]
            INP["InputFilterPort<br/>• filter()"]
        end

        subgraph MetaPorts["Metadata & Config Ports"]
