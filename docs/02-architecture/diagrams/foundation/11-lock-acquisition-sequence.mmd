%% Title: Lock Acquisition Sequence (Two Workers)
%% Covers: RULES.md §3.3 (Locking), ADR-010
%% Updated: 2026-02-17
%% Components: MemoryLock, LockPort, LockRuntimeService, Heartbeat

%% @version 1.0.0
%% @date    2026-02-24
%% @type    sequenceDiagram
%% @level   Mixed (System / Component / Class)
%% @nodes   5
%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform sequence width=224 max_title_len=23
sequenceDiagram
    autonumber
    participant WorkerA as Worker A (owner_a_uuid)
    participant WorkerB as Worker B (owner_b_uuid)
    participant Lock as MemoryLock
    participant HeartbeatA as Heartbeat Thread A
    participant Storage as SilverWriter

    Note over Lock: Lock Key: lock:chembl_activity, TTL: 90s, Heartbeat: 30s

    rect rgb(230, 255, 230)
        Note over WorkerA,Lock: Worker A acquires lock successfully
        WorkerA->Lock: acquire(key, owner_id, ttl=90s, wait=False)
        Lock->Lock: Check key not exists
        Lock->Lock: Store (owner, expires_at=now+90s)
        Lock-->WorkerA: True (acquired)

        WorkerA->HeartbeatA: start(interval=30s)
        activate HeartbeatA
    end

    rect rgb(255, 230, 230)
        Note over WorkerB,Lock: Worker B fails to acquire (lock held)
        WorkerB->Lock: acquire(key, owner_id, ttl=90s, wait=False)
        Lock->Lock: Check key exists
        Lock->Lock: Owner != worker_b_uuid
        Lock-->WorkerB: False (not acquired)

        Note over WorkerB: Worker B can wait=True or exit with error
    end

    rect rgb(240, 248, 255)
        Note over HeartbeatA,Lock: Heartbeat keeps lock alive
        loop Every 30 seconds
            HeartbeatA->Lock: heartbeat(key, owner_id)
            Lock->Lock: Verify owner == worker_a_uuid
            Lock->Lock: Update expires_at = now + 90s
            Lock-->HeartbeatA: True (refreshed)
        end
    end

    rect rgb(255, 250, 205)
        Note over WorkerA,Storage: Worker A performs safe write
        WorkerA->Lock: validate_owner(key, owner_id)
        Lock->Lock: Check owner == worker_a_uuid
        Lock->Lock: Check not expired
        Lock-->WorkerA: True (valid)

        WorkerA->Storage: merge(records, table)
        activate Storage
        Note over Storage: Delta Lake ACID transaction
        Storage-->WorkerA: WriteResult(success=true)
        deactivate Storage

        WorkerA->Lock: validate_owner(key, owner_id)
        Lock-->WorkerA: True (still valid, post-write check)
    end

    rect rgb(230, 255, 230)
        Note over WorkerA,Lock: Worker A releases lock
        WorkerA->HeartbeatA: stop()
        deactivate HeartbeatA

        WorkerA->Lock: release(key, owner_id)
        Lock->Lock: Verify owner == worker_a_uuid
        Lock->Lock: Delete lock entry
        Lock-->WorkerA: True (released)
    end

    rect rgb(255, 240, 245)
        Note over Lock: TTL Expiration (failure scenario)
        Note right of Lock: If Worker A crashes: heartbeat stops, TTL expires after 90s, lock becomes available
    end

    rect rgb(230, 255, 230)
        Note over WorkerB,Lock: Worker B can now acquire
        WorkerB->Lock: acquire(key, owner_id, ttl=90s, wait=False)
        Lock->Lock: Key expired/deleted
        Lock-->>WorkerB: True (acquired)
    end
