    subgraph CLI["Interfaces Layer (Click)"]
        CMD["bioetl run ..."]
        INPUT["build_run_command_input()<br/>normalized RunCommandInput"]
        POLICY["run_command_flow()"]
    end

    subgraph Policy["CLI Policy / App Service"]
        DESTRUCT["handle_destructive_step()<br/>preview / confirm rebuilds"]
        PREP["CliRunOrchestrationService<br/>prepare_execution_request()"]
        EXEC["CliRunOrchestrationService<br/>execute_pipeline()"]
    end

    subgraph Runtime["Async Runtime Helper"]
        HEALTH["ensure_metrics_server_started()<br/>health_server_context(...)"]
        SERVICE["get_pipeline_runner_service()"]
        RUN_ASYNC["run_pipeline_async()"]
    end

    subgraph Composition["Composition Layer"]
        BUILD["build_pipeline_runner()<br/>registry + config + observability"]
    end

    subgraph AppCore["Application Runtime"]
        RUNNER_SVC["PipelineRunnerService.run()<br/>build context + create runner"]
        EXEC_SVC["PipelineRunExecutionService.execute()<br/>runner.run() + extract metrics"]
        PIPELINE["PipelineRunner.run()<br/>preflight -> execution -> postrun"]
    end

    subgraph Result["Result & Exit"]
        RESULT["RunResult<br/>status + metrics + error details"]
        FINALIZE["_finalize_run_result()<br/>echo_run_result()"]
        EXIT["map_status_to_exit_code()<br/>process exit"]
    end

    CMD --> INPUT --> POLICY
    POLICY --> DESTRUCT --> PREP
    PREP ==> EXEC
    EXEC --> RUN_ASYNC
    RUN_ASYNC -.-> HEALTH
    RUN_ASYNC --> SERVICE --> RUNNER_SVC
    SERVICE -.-> BUILD
    RUNNER_SVC --> EXEC_SVC --> PIPELINE
    PIPELINE --> RESULT
    RESULT --> FINALIZE --> EXIT

