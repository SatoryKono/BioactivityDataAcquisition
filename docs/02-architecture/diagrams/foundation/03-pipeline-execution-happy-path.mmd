%% Title: Pipeline Execution — Happy Path
%% Covers: application/core/runner.py, batch_executor.py, batch_processing_service.py, preflight/service.py, postrun/service.py
%% Updated: 2026-03-24
%% Components: CLI, build_pipeline_runner, PipelineRunner, LockRuntimeService, PreflightService, MedallionLifecycleService, CheckpointRuntimeService, BatchExecutor, BatchProcessingService, PostrunService

%% @version 1.2.0
%% @date    2026-03-24
%% @type    sequenceDiagram
%% @level   Component / Class
%% @nodes   10
%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
%% @uniform sequence width=232 max_title_len=26
sequenceDiagram
    autonumber
    actor CLI as CLI
    participant Builder as build_pipeline_runner
    participant Runner as PipelineRunner
    participant LockMgr as LockRuntimeService
    participant Preflight as PreflightService
    participant Lifecycle as MedallionLifecycleService
    participant Checkpoint as CheckpointRuntimeService
    participant Executor as BatchExecutor
    participant Processing as BatchProcessingService
    participant Postrun as PostrunService

    CLI->>Builder: create runner for pipeline/runtime
    Builder-->>CLI: PipelineRunner

    rect rgb(240, 248, 255)
        Note over Runner,LockMgr: Phase 1: Managed startup
        CLI->>Runner: run()
        activate Runner
        Runner->>LockMgr: __aenter__() / acquire()
        activate LockMgr
        Runner->>Preflight: validate_infrastructure(services)
        Preflight-->>Runner: HealthReport
        Runner->>Lifecycle: prepare_for_run(config, runtime)
        Lifecycle-->>Runner: prepare result
    end

    rect rgb(240, 255, 240)
        Note over Runner,Processing: Phase 2: Batch execution
        Runner->>Checkpoint: load_checkpoint()
        Checkpoint-->>Runner: offset or None
        Runner->>Executor: execute(limit, query, offset)

        loop while source returns records
            Executor->>Processing: process_batch(records, start_index)
            Processing-->>Executor: batch outcome
            Executor->>Checkpoint: save_checkpoint(records_processed)
        end

        Executor-->>Runner: execution complete
    end

    rect rgb(255, 240, 245)
        Note over Runner,Postrun: Phase 3: Postrun finalization
        Runner->>Postrun: run(executor, dq_context)
        Postrun->>Lifecycle: finalize_run(config, runtime, metrics)
        Lifecycle-->>Postrun: vacuum result
        Postrun-->>Runner: postrun result
    end

    rect rgb(255, 250, 240)
        Note over Runner,LockMgr: Phase 4: Cleanup
        Runner->>Checkpoint: delete_checkpoint()
        Runner->>LockMgr: __aexit__() / release()
        deactivate LockMgr
        Runner-->>CLI: pipeline completed
        deactivate Runner
    end
