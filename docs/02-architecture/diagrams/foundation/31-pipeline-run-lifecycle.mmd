%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
stateDiagram-v2
    [*] --> PENDING: PipelineRun created

    PENDING --> LOCKING: runner.run()
    LOCKING --> LOCKED: LockRuntimeService.acquire()
    LOCKING --> FAILED: LockAcquisitionError

    LOCKED --> PREFLIGHT: PreflightService.run()
    PREFLIGHT --> PREFLIGHT_PASSED: all checks pass
    PREFLIGHT --> FAILED: preflight check failed

    PREFLIGHT_PASSED --> CLEARING: RunType == REBUILD/BACKFILL
    PREFLIGHT_PASSED --> EXTRACTING: RunType == INCREMENTAL
    CLEARING --> EXTRACTING: MedallionLifecycleService\nclear_silver() + clear_gold()

    state BatchLoop {
        EXTRACTING --> TRANSFORMING: BatchExecutor._extract()
        TRANSFORMING --> VALIDATING: BatchTransformer.transform()
        VALIDATING --> WRITING: PanderaSilverValidator.validate()
        VALIDATING --> QUARANTINING: DQ error rate > threshold
        QUARANTINING --> WRITING: QuarantineManager.route()
        WRITING --> CHECKPOINTING: BatchWriter.write()
        CHECKPOINTING --> EXTRACTING: CheckpointRuntimeService.save()\nmore batches
        CHECKPOINTING --> BATCH_DONE: no more batches
    }

    BATCH_DONE --> POSTRUN: PostrunService.run()
    POSTRUN --> COMPLETED: vacuum + DQ report\n+ metrics publish

    EXTRACTING --> DRAINING: SIGTERM received
    TRANSFORMING --> DRAINING: ShutdownService detected
    DRAINING --> CHECKPOINT_SAVED: finish current batch\nsave checkpoint
    CHECKPOINT_SAVED --> CANCELLED: release lock\nexit(0)

    WRITING --> FAILED: LockLostError\n(safety guard)
    EXTRACTING --> FAILED: CircuitBreakerOpenError\nRetryExhaustedError

    COMPLETED --> RELEASING: success
    FAILED --> RELEASING: error path
    CANCELLED --> [*]
    RELEASING ==> [*]: LockRuntimeService.release()\nHeartbeatTask.stop()

    note right of LOCKED
        HeartbeatTask starts
        every 30s renews TTL (90s)
    end note

    note right of COMPLETED
        PipelineRunState.COMPLETED
        PipelineObserver records duration
    end note

    note right of FAILED
        PipelineRunState.FAILED
        StageResult captures error
    end note
