%% Title: Circuit Breaker State Machine
%% Covers: RULES.md §3.6 (Resilience), ADR-007
%% Updated: 2026-07-31
%% Components: CircuitBreaker, CircuitBreakerPort, CircuitState enum

%% @version 1.0.0
%% @date    2026-02-24
%% @type    stateDiagram
%% @level   Mixed (System / Component / Class)
%% @nodes   3
%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
stateDiagram-v2
    [*] --> CLOSED

    state CLOSED {
        [*] --> Operational
        Operational: failure_count = 0
        Operational: Accept all requests
        Operational: metric circuit_breaker_state = 0

        state "Request Handling" as CH {
            [*] --> ProcessRequest
            ProcessRequest --> Success: 2xx response
            ProcessRequest --> Failure: 5xx / timeout
            Success --> RecordSuccess
            Failure --> RecordFailure
            RecordSuccess: failure_count = 0
            RecordFailure: failure_count += 1
        }
    }

    CLOSED --> OPEN: failure_count >= 5\n(5 consecutive failures)

    state OPEN {
        [*] --> Blocking
        Blocking: Reject ALL requests immediately
        Blocking: Return CircuitOpenError
        Blocking: metric circuit_breaker_state = 2
        Blocking: metric circuit_breaker_trips_total += 1

        state "Timer" as OT {
            [*] --> Waiting
            Waiting: recovery_timeout = 300s
            Waiting: (5 minutes)
            Waiting --> Expired: timeout elapsed
        }
    }

    OPEN --> HALF_OPEN: After 300s recovery_timeout

    state HALF_OPEN {
        [*] --> Probing
        Probing: Allow exactly 1 test request
        Probing: metric circuit_breaker_state = 1

        state "Probe Request" as HP {
            [*] --> SendProbe
            SendProbe --> ProbeSuccess: 2xx response
            SendProbe --> ProbeFailure: 5xx / timeout
        }
    }

    HALF_OPEN --> CLOSED: Probe success\nfailure_count = 0
    HALF_OPEN ==> OPEN: Probe failure\nRestart recovery_timeout

    note right of CLOSED
        Parameters (from CircuitBreaker):
        • failure_threshold: 5
        • recovery_timeout: 300s
        • provider: str (used as 'adapter' label in metrics)
    end note

    note right of OPEN
        Metrics Emitted:
        • circuit_breaker_state{adapter}
        • circuit_breaker_trips_total{adapter}
        • circuit_breaker_success_total{adapter}
        • circuit_breaker_failure_total{adapter}
    end note

    note left of HALF_OPEN
        Single probe strategy:
        Only 1 request allowed to test
        if backend has recovered
    end note
