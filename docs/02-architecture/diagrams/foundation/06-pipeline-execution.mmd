%% Title: Pipeline Execution Sequence — Runner to Postrun
%% Covers: application/core/{runner,batch_executor,batch_processing_service}.py, preflight/service.py, postrun/service.py
%% Updated: 2026-03-24
%% Components: CLI, build_pipeline_runner, PipelineRunner, PipelineService, LockRuntimeService, PreflightService, MedallionLifecycleService, CheckpointRuntimeService, BatchExecutor, BatchProcessingService, BaseTransformer, SilverStoragePort, GoldStoragePort, PostrunService

%% @version 1.1.0
%% @date    2026-03-24
%% @type    sequenceDiagram
%% @level   Component / Class
%% @nodes   13
%% @uniform sequence width=176 max_title_len=18

sequenceDiagram
    autonumber
    actor CLI as CLI
    participant Builder as build_pipeline_runner
    participant Runner as PipelineRunner
    participant Services as PipelineService
    participant Lock as LockRuntimeService
    participant Preflight as PreflightService
    participant Lifecycle as MedallionLifecycleService
    participant Checkpoint as CheckpointRuntimeService
    participant Executor as BatchExecutor
    participant Processing as BatchProcessingService
    participant Transformer as BaseTransformer
    participant Storage as SilverStoragePort / GoldStoragePort
    participant Postrun as PostrunService

    CLI->>Builder: create runner for pipeline/runtime
    Builder-->>CLI: PipelineRunner

    CLI->>Runner: run()
    activate Runner
    Runner->>Services: __aenter__()
    Runner->>Lock: __aenter__() / acquire()
    Runner->>Preflight: validate_infrastructure(services)
    Preflight-->>Runner: HealthReport
    Runner->>Lifecycle: prepare_for_run(config, runtime)
    Lifecycle-->>Runner: prepare result
    Runner->>Checkpoint: load_checkpoint()
    Checkpoint-->>Runner: offset or None

    Runner->>Executor: execute(limit, query, offset)
    activate Executor

    loop while source returns records
        Executor->>Processing: process_batch(records, start_index)
        activate Processing
        Processing->>Storage: write_bronze(records)
        Processing->>Transformer: transform_batch(records)
        Transformer-->>Processing: transformed outcome
        par silver and gold persistence
            Processing->>Storage: write_silver(...)
        and
            Processing->>Storage: write_gold(...)
        end
        Processing-->>Executor: batch outcome
        deactivate Processing

        Executor->>Checkpoint: save_checkpoint(records_processed)
    end

    Executor-->>Runner: execution complete
    deactivate Executor

    Runner->>Postrun: run(executor, dq_context)
    activate Postrun
    Postrun->>Postrun: run_silver_compact_if_needed()
    Postrun->>Postrun: run_dq_checks(executor)
    Postrun->>Lifecycle: finalize_run(config, runtime, metrics)
    Lifecycle-->>Postrun: vacuum result
    Postrun-->>Runner: postrun result
    deactivate Postrun

    Runner->>Checkpoint: delete_checkpoint()
    Runner->>Lock: __aexit__() / release()
    Runner->>Services: __aexit__() / aclose()
    Runner-->>CLI: pipeline completed
    deactivate Runner
