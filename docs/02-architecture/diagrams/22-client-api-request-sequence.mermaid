%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
sequenceDiagram
    autonumber
    participant Executor as PipelineExecutor
    participant Adapter as ChemblAdapter
    participant CB as CircuitBreaker
    participant RL as TokenBucket (RateLimiter)
    participant HTTP as UnifiedHTTPClient
    participant API as ChEMBL API

    Note over Executor,Adapter: Phase 1: Request Initiation

    Executor->>Adapter: fetch(query)
    activate Adapter

    Adapter->>CB: check_state()
    activate CB

    alt Circuit OPEN
        CB-->>Adapter: State.OPEN
        Adapter-->>Executor: raise CircuitOpenError
        Note right of CB: Circuit opened: 5 consecutive failures, recovery timeout: 300s
    else Circuit CLOSED or HALF_OPEN
        CB-->>Adapter: State.CLOSED (or HALF_OPEN)
        deactivate CB

        Note over Adapter,RL: Phase 2: Rate Limiting

        Adapter->>RL: acquire()
        activate RL
        Note right of RL: Token Bucket Algorithm (ChEMBL: unlimited, PubChem: 5 req/sec)
        RL->>RL: Wait for token if needed
        RL-->>Adapter: Token acquired
        deactivate RL

        Note over Adapter,API: Phase 3: HTTP Request with Retry

        loop Retry loop (max 3 attempts)
            Adapter->>HTTP: request(method="GET", url="/activities", params)
            HTTP->>API: GET /chembl/api/data/activity.json?...

            alt 200 OK
                API-->>HTTP: JSON response
                HTTP-->>Adapter: Response(status=200, data)

                Adapter->>CB: record_success()
                Note right of CB: failure_count = 0

                Adapter-->>Executor: AsyncIterator[BronzeRecord]

            else 429 Rate Limited
                API-->>HTTP: 429 + Retry-After header
                HTTP-->>Adapter: Response(status=429)

                Note right of Adapter: Extract Retry-After value (default: 60 seconds)
                Adapter->>Adapter: await asyncio.sleep(retry_after)

            else 5xx Server Error (500, 502, 503, 504)
                API-->>HTTP: 5xx error
                HTTP-->>Adapter: Response(status=5xx)

                Adapter->>CB: record_failure()
                Note right of CB: failure_count += 1

                Note over Adapter: Calculate backoff delay
                Note right of Adapter: Exponential backoff with jitter (~2s, ~4s, ~8s)

                Adapter->>Adapter: await asyncio.sleep(delay)

            else Connection Error / Timeout
                HTTP-->>Adapter: raise ConnectionError

                Adapter->>CB: record_failure()
                Adapter->>Adapter: await asyncio.sleep(delay)
            end
        end

        alt Max retries exceeded
            Adapter->>CB: record_failure()

            opt failure_count >= 5
                CB->>CB: transition to OPEN
                Note right of CB: Circuit tripped! (circuit_breaker_trips_total += 1)
            end

            Adapter-->>Executor: raise RetryExhaustedError
        end
    end

    deactivate Adapter

    rect rgb(255, 250, 205)
        Note over CB: Circuit Breaker Parameters
        Note right of CB: failure_threshold: 5, recovery_timeout: 300s
    end

    rect rgb(240, 255, 240)
        Note over RL: Rate Limiter Parameters
        Note right of RL: ChEMBL: No limit, PubChem: 5/s, UniProt: 100/s, PubMed: 3/s
    end

    rect rgb(240, 248, 255)
        Note over HTTP: Retry Policy
        Note right of HTTP: max_retries: 3, backoff_factor: 2.0, jitter: 0.1-0.5
    end
