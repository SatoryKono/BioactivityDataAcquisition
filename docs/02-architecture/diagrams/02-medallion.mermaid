graph TD
    subgraph "Bronze Layer (Raw Data)"
        A[Source API Data]
    end

    subgraph "Silver Layer (Cleaned & Conformed)"
        B[Standardized Schemas]
        C[Deduplicated Records]
    end

    subgraph "Gold Layer (Aggregated & Enriched)"
        D[Bioactivity Aggregates]
        E[Molecule-Target Links]
    end

    subgraph "Quarantine"
        F[Validation Failures]
    end

    A -- "Validation & Schema Enforcement" --> B
    B -- "Deduplication" --> C
    C -- "Business Logic & Aggregation" --> D
    D -- "Enrichment" --> E
    A -- "Failed Validation" --> F
    B -- "Failed Transformation" --> F
