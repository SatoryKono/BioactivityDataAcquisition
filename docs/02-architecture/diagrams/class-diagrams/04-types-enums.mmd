    }

    class ShutdownReason {
        <<StrEnum>>
        SIGINT
        SIGTERM
        LOCK_LOST
        MEMORY_PRESSURE
        DQ_THRESHOLD


    }

    class AggregationFunction {
        <<StrEnum>>
        FIRST
        LAST
        COLLECT
        COUNT



    }

    class EnricherCardinality {
        <<StrEnum>>
        ONE_TO_ONE
        ONE_TO_MANY





    }

    class MergeStrategy {
        <<StrEnum>>
        LEFT_JOIN
        OUTER_JOIN





    }

    class ConflictResolution {
        <<StrEnum>>
        SEED_WINS
        ENRICHER_WINS
        LATEST_WINS




    }

    class CompositeState {
        <<StrEnum>>
        INIT
        SEED_RUNNING
        DEPS_RUNNING
        ENRICHERS_RUNNING
        MERGING
        COMPLETED
        FAILED
    }

