classDiagram
    direction TB
    class RunID {
        <<NewType>>
        UUID
    }

    class EntityID {
        <<NewType>>
        str
    }

    class ContentHash {
        <<NewType>>
        str
    }

    class BatchID {
        <<NewType>>
        UUID
    }

    class RunType {
        <<StrEnum>>
        INCREMENTAL
        BACKFILL
        REBUILD




    }

    class PublicationType {
        <<StrEnum>>
        JOURNAL_ARTICLE
        BOOK
        DATASET
        PATENT
        REVIEW
        LETTER
        EDITORIAL
        CLINICAL_TRIAL
        META_ANALYSIS
        CASE_REPORTS
        COMPARATIVE_STUDY
        EVALUATION_STUDY
        BOOK_CHAPTER
        PROCEEDINGS_ARTICLE
        POSTED_CONTENT
        REPORT
        STANDARD
        DISSERTATION
        PREPRINT
        OTHER
    }

    class HealthStatus {
        <<StrEnum>>
        HEALTHY
        DEGRADED
        UNHEALTHY




    }

    class CircuitBreakerState {
        <<StrEnum>>
        CLOSED
        OPEN
        HALF_OPEN




    }

    class ExecutionContext {
        <<StrEnum>>
        ISOLATED
        ENRICHER
        DEPENDENCY




    }

    class DriftLevel {
        <<StrEnum>>
        INFO
        CRITICAL





    }

    class MedallionLayer {
        <<StrEnum>>
        BRONZE
        SILVER
        GOLD




    }

    class LoadingStrategy {
        <<StrEnum>>
        FULL_SCAN_ONLY






    }

    class QuarantineRecordStatus {
        <<Enum>>
        QUARANTINED
        REPLAYED
