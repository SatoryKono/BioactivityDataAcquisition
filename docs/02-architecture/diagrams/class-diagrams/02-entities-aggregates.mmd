%% BioETL — Class Diagram: Entities & Aggregates
%% Domain entities, aggregate roots, and their relationships.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    classDiagram
%% @level   Class / Interface
%% @nodes   13
%% @uniform class width=168 height=240 max_title_len=16 max_desc_lines=14

classDiagram
    direction TB
    class BaseEntity {
        <<frozen dataclass>>
        +entity_id: EntityID
        +content_hash: ContentHash
        +run_id: RunID
        +run_type: RunType
        +ingestion_ts: datetime
        +_index: int
        +source_batch_id: BatchID | None
        +_dq_warn: bool
        +_dq_error: bool
        +\_\_post_init\_\_()



    }

    class Bioactivity {
        <<frozen dataclass>>
        +activity_id: str
        +molecule_id: str
        +target_id: str | None
        +assay_id: str | None
        +canonical_smiles: str | None
        +standard_type: str | None
        +standard_value: float | None
        +standard_units: str | None
        +pchembl_value: float | None
        +publication_doi: str | None
        +_state: BioactivityState
        +from_raw(): Bioactivity
        +with_state(state): Bioactivity
    }

    class BioactivityState {
        <<StrEnum>>
        RAW
        NORMALIZED
        VALIDATED










    }

    class PublicationBase {
        <<frozen dataclass>>
        +doi: str | None
        +pmid: str | None
        +title: str | None
        +authors: list~str~
        +journal: str | None
        +year: int | None
        +publication_type: PublicationType
        +abstract_text: str | None





    }

    class Batch {
        <<Aggregate Root>>
        -_batch_id: BatchID
        -_status: BatchStatus
        -_records: list~BatchRecord~
        -_invalid_records: list~BatchRecord~
        +create(batch_id): Batch
        +add_record(record): None
        +seal(): None
        +collect_events(): list~DomainEvent~





    }

    class BatchRecord {
        <<frozen dataclass>>
        +index: int
        +entity_id: EntityID | None
        +content_hash: ContentHash | None
        +data: dict
        +is_valid: bool
        +error: str | None
        +error_code: str | None
        +with_validation_error(msg, code): BatchRecord





    }

    class BatchStatus {
        <<StrEnum>>
        OPEN
        SEALED
        WRITING
        COMMITTED
        FAILED








    }

    class PipelineRun {
        <<Aggregate Root>>
        -_run_id: RunID
        -_state: PipelineRunState
        -_stages: dict~str, StageResult~
        +start_stage(name): None
        +complete_stage(name, result): None
        +fail_stage(name, error): None







    }

    class StageResult {
        <<frozen dataclass>>
        +stage: str
        +status: StageStatus
        +started_at: datetime
        +completed_at: datetime | None
        +result: Any
        +error: str | None
        +records_processed: int
        +duration_seconds: float





    }

    class PipelineRunState {
        <<StrEnum>>
        PENDING
        RUNNING
        COMPLETED
        FAILED
        SHUTDOWN








    }

    class StageStatus {
        <<StrEnum>>
        PENDING
        RUNNING
        SUCCESS
        FAILED
        SKIPPED








    }

    class QuarantineEntry {
        <<dataclass>>
        +payload_hash: str
        +pipeline: str
        +error_code: str
        +created_at: datetime
        +status: QuarantineRecordStatus








    }

    class DomainEvent {
        <<base class>>
        +event_id: UUID
        +occurred_at: datetime











    }

    BaseEntity <|-- Bioactivity
    BaseEntity <|-- PublicationBase

    Bioactivity --> BioactivityState

    Batch *-- BatchRecord : contains
    Batch --> BatchStatus
    Batch --> DomainEvent : collects

    PipelineRun *-- StageResult : tracks
    PipelineRun --> PipelineRunState
    StageResult --> StageStatus
