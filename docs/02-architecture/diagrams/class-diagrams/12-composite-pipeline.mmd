%% BioETL — Class Diagram: Composite Pipeline Components
%% Runner, coordinators, merge service, and FSM.

%% @version 1.1.0
%% @date    2026-03-01
%% @type    classDiagram
%% @level   Class / Interface
%% @nodes   14

%% @uniform class width=264 height=156 max_title_len=27 max_desc_lines=6
classDiagram
    direction LR
    class CompositePipelineRunner {
        -_config
        -_runtime
        -_seed_runner
        -_enrichment_coordinator
        -_dependency_coordinator
        -_merge_service
        +run()
        +... : checkpoint and validation flow
    }

    class CompositeRuntimeConfig {
        <<dataclass>>
        +resume
        +dry_run
        +enrich_only
        +cached_bronze
    }

    class EnrichmentCoordinator {
        +logger
        +dq_config
        +max_concurrency
        +run_enrichers(keys, enrichers)
    }

    class DependencyCoordinator {
        -_logger
        -_delta_reader
        +run_dependencies(keys, deps)
    }

    class MergeService {
        -_deduplicator
        -_aggregator
        -_renamer
        -_orderer
        +merge(seed_table, enrichers, results)
    }

    class EnricherAggregator {
        +aggregate(df, config, enricher_name)
    }

    class EnricherDeduplicator {
        +deduplicate(df, config)
    }

    class ColumnRenamer {
        +rename_columns(df, rename_map)
    }

    class ColumnOrderService {
        +order_column_names(columns)
    }

    class KeyExtractorService {
        +extract_keys(df, key_column)
    }

    class CompositeCheckpointService {
        +save_state(stage, data)
        +load_state()
        +get_completed_stages()
    }

    class CompositePreflightValidator {
        +validate(config)
    }

    class FSMStateHelper {
        +transition(current, event)
        +is_terminal(state)
    }

    class EnrichmentCrossValidator {
        +validate(results)
    }

    CompositePipelineRunner *-- EnrichmentCoordinator
    CompositePipelineRunner *-- DependencyCoordinator
    CompositePipelineRunner *-- MergeService
    CompositePipelineRunner *-- CompositeCheckpointService
    CompositePipelineRunner *-- CompositePreflightValidator
    CompositePipelineRunner o-- CompositeRuntimeConfig

    MergeService *-- EnricherDeduplicator
    MergeService *-- EnricherAggregator
    MergeService *-- ColumnRenamer
    MergeService *-- ColumnOrderService

    CompositePipelineRunner --> FSMStateHelper
    CompositePipelineRunner --> EnrichmentCrossValidator
    CompositePipelineRunner --> KeyExtractorService
