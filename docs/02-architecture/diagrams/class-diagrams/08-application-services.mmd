%% BioETL — Class Diagram: Application Services
%% High-level application services.

%% @version 1.1.0
%% @date    2026-07-31
%% @type    classDiagram
%% @level   Class / Interface
%% @nodes   19
%% @uniform-group rich    nodes=PipelineObserver,DataQualityService,MedallionLifecycleService
%% @uniform-group medium  nodes=LifecyclePhase,VacuumService,QuarantineService,BronzeDQAnalyzer,SilverDQAnalyzer,GoldDQAnalyzer
%% @uniform-group simple  nodes=DQReportService,HealthService,ConfigService,ExportService,CheckpointService,MetricsService,ShutdownService,BronzeCleanupService,LockService,PipelineRunnerService

%% @uniform-width group
%% @uniform class width=344 groups=3 width_strategy=group
%% @uniform-stats rich         width=336 height=312 max_desc_lines=15
%% @uniform-stats medium       width=224 height=168 max_desc_lines=7
%% @uniform-stats simple       width=344 height=72 max_desc_lines=2
classDiagram
    direction TB
    namespace Core_Application {
        class DataQualityService {
            -_dq_monitor: DQMonitorPort | None
            -_config: DQConfig
            -_logger: LoggerPort
            -_metrics: MetricsPort | None
            -_pipeline_name: str
            -_entity_type: str
            +evaluate(context, executor): DQResult
        }

        class DQReportService {
            +generate_reports(context): DQReportResult
        }

        class MedallionLifecycleService {
            <<dataclass>>
            +storage: MedallionStorageProtocol
            +logger: LoggerPort
            +prepare_for_run(config, runtime): PrepareResult
            +finalize_run(config, runtime): VacuumResult
        }

        class VacuumService {
            <<dataclass>>
            +lifecycle: MedallionLifecycleService
            +logger: LoggerPort
            +vacuum_all(): None
        }

        class PipelineObserver {
            -_pipeline_name: str
            -_run_id: RunID
            -_run_type: RunType
            -_metrics: MetricsPort
            -_logger: LoggerPort
            -_tracer: TracingPort | None
            -_start_time: float
            -_root_span: Span | None
            -_phase: LifecyclePhase | None
            +\_\_enter\_\_(): Self
            +\_\_exit\_\_(...): None
            +emit_event(event): None
        }

        class LifecyclePhase {
            <<StrEnum>>
            STARTUP
            PREFLIGHT
            LIFECYCLE_CLEAR
            EXECUTION
            POSTRUN
            CLEANUP
        }
    }

    namespace Operational_Services {
        class HealthService {
            +check_provider(provider, factory): HealthResult
            +check_all(factory): HealthCheckSummary
        }

        class ConfigService {
            +list_pipelines(): list
            +get_pipeline(name): PipelineConfig
        }

        class ExportService {
            +export(table_name, format, options): ExportResult
        }

        class CheckpointService {
            +list_checkpoints(): list
        }

        class MetricsService {
            +start_server(): None
        }

        class ShutdownService {
            +shutdown(reason, grace_period): None
        }

        class QuarantineService {
            +inspect(pipeline, limit): list
            +replay(pipeline): int
        }

        class BronzeCleanupService {
            +cleanup(config, dry_run): BronzeCleanupResult
        }

        class LockService {
            +get_lock_info(key): dict | None
        }

        class PipelineRunnerService {
            +run_pipeline(config, runtime): None
        }
    }

    namespace DQ_Analyzers {
        class BronzeDQAnalyzer {
            +analyze(records): DQMetrics
        }

        class SilverDQAnalyzer {
            +analyze(delta_table): DQMetrics
        }

        class GoldDQAnalyzer {
            +analyze(delta_table): DQMetrics
        }
    }

    PipelineObserver --> LifecyclePhase
    DQReportService --> BronzeDQAnalyzer
    DQReportService --> SilverDQAnalyzer
    DQReportService --> GoldDQAnalyzer

    note for PipelineObserver "L2 detail: 08a operation catalog"
    note for QuarantineService "See 08a for get_stats/purge"
    note for BronzeDQAnalyzer "See 08a for rule-level checks"
