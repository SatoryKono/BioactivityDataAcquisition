%% BioETL — Class Diagram: Domain Services
%% Pure domain services without I/O.

%% @version 1.0.0
%% @date    2026-07-31
%% @type    classDiagram
%% @level   Class / Interface
%% @nodes   10
%% @uniform class width=248 height=72 max_title_len=26 max_desc_lines=2

classDiagram
    direction LR
    class IdentityService {
        +compute_entity_id(provider, entity_type, source_id, record): EntityID
        +compute_content_hash(provider, record): ContentHash
    }

    class NormalizationService {
        +normalize_text(text): str
        +normalize_values(values): dict
    }

    class DataNormalizationService {
        +normalize_field(value, field_type): Any

    }

    class AuthorNormalizationService {
        +normalize_author_name(name): str
        +normalize_author_list(authors): list~str~
    }

    class ActivityAggregator {
        +aggregate(activities): AggregatedActivity

    }

    class UnitConverter {
        +convert(value, from_unit, to_unit): float
        +normalize_unit(unit): str
    }

    class ValueValidator {
        +validate(value, constraints): ValidationResult

    }

    class TextSimilarity {
        +similarity_score(text1, text2): float
        +is_similar(text1, text2, threshold): bool
    }

    class DQMetricsCalculator {
        +calculate(records, config): DQMetrics

    }

    class DQSerializer {
        +serialize(metrics): dict
        +deserialize(data): DQMetrics
    }

    note for IdentityService "Deterministic IDs and content hashes"
    note for UnitConverter "Bioactivity unit conversion (nM/uM)"
    note for TextSimilarity "Title similarity for enrichment"

    style IdentityService fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style NormalizationService fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style DataNormalizationService fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style AuthorNormalizationService fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style ActivityAggregator fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style UnitConverter fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style ValueValidator fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style TextSimilarity fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style DQMetricsCalculator fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style DQSerializer fill:#eff6ff,stroke:#2563eb,stroke-width:2px
