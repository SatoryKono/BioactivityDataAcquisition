%% BioETL — Class Diagram: Infrastructure Adapters
%% HTTP adapter class hierarchy with mixins.

%% @version 1.2.0
%% @date    2026-03-08
%% @type    classDiagram
%% @level   Class / Interface
%% @nodes   18
%% @uniform-group mixin     nodes=HealthCheckMixin,HealthCheckProviderMixin
%% @uniform-group base      nodes=BaseHttpAdapter,BaseSyncAdapter,UnifiedHTTPClient
%% @uniform-group adapter   nodes=ChemblAdapter,PubMedAdapter,UniProtAdapter,CrossRefAdapter,OpenAlexAdapter,SemanticScholarAdapter,PubChemAdapter
%% @uniform-group util      nodes=CircuitBreaker,TokenBucket,AdapterMetrics
%% @uniform-group decorator nodes=CircuitBreakerDataSourceDecorator,RetryingDataSourceDecorator,CachedBronzeDataSource

%% @uniform-width group
%% @uniform class width=416 groups=5 width_strategy=group
%% @uniform-stats mixin        width=416 height=144 max_desc_lines=6
%% @uniform-stats base         width=256 height=288 max_desc_lines=14
%% @uniform-stats adapter      width=360 height=128 max_desc_lines=5
%% @uniform-stats util         width=232 height=200 max_desc_lines=9
%% @uniform-stats decorator    width=336 height=72 max_desc_lines=2
classDiagram
    direction LR
    class HealthCheckMixin {
        <<Mixin>>
        #_start_health_check(...)
        #_handle_health_check_success(...)
        #_handle_health_check_failure(...)


    }

    class HealthCheckProviderMixin {
        <<Mixin>>
        +health_check()
        +check_health()
        #_probe_health()*
        +... : fallback policy
    }

    class BaseHttpAdapter {
        +http_client
        +logger
        +metrics
        +provider_name
        +\_\_aenter\_\_()
        +\_\_aexit\_\_(...)
        +aclose()

    }

    class BaseSyncAdapter {
        +logger
        +metrics
        +rate_limiter
        +circuit_breaker
        +thread_pool

    }

    class UnifiedHTTPClient {
        <<dataclass>>
        +rate_limiter
        +circuit_breaker
        +retry_config
        +timeout
        +user_agent
        +provider
        +get(url, params, headers)
        +post(url, data, headers)
        +... : request helpers
    }

    class ChemblAdapter {
        +fetch()
        +fetch_filtered(filter_ids)
        +... : extra filter variants
    }

    class PubMedAdapter {
        +email
        +api_key
        +batch_size


    }

    class UniProtAdapter {
        +api_key
        +base_url



    }

    class CrossRefAdapter {
        +mailto
        +batch_size



    }

    class OpenAlexAdapter {
        +mailto
        +batch_size



    }

    class SemanticScholarAdapter {
        +api_key
        +batch_size
        +fields


    }

    class PubChemAdapter {
        Uses pubchempy (sync)
        ThreadPoolExecutor wrapper



    }

    class CircuitBreaker {
        <<dataclass>>
        +provider
        +failure_threshold
        +recovery_timeout
        +metrics
        +call(fn)
        +get_state()
        +... : counters
    }

    class TokenBucket {
        <<dataclass>>
        +rate
        +capacity
        +provider
        +metrics
        +acquire(tokens)
        +try_acquire()
        +available_tokens()

    }

    class AdapterMetrics {
        +metrics
        +provider
        +measure_request()






    }

    class CircuitBreakerDataSourceDecorator {
        <<Decorator>>
        wraps DataSourcePort
    }

    class RetryingDataSourceDecorator {
        <<Decorator>>
        data_source: DataSourcePort
        retry_config: RetryConfig
        logger: LoggerPort | None
        metrics: MetricsPort | None
        __post_init__()
        fetch(entity_type, ...)
        health_check()
    }

    class CachedBronzeDataSource {
        <<Decorator>>
        wraps DataSourcePort
    }

    HealthCheckMixin <|-- HealthCheckProviderMixin
    HealthCheckProviderMixin <|-- BaseHttpAdapter
    HealthCheckProviderMixin <|-- BaseSyncAdapter

    BaseHttpAdapter <|-- ChemblAdapter
    BaseHttpAdapter <|-- PubMedAdapter
    BaseHttpAdapter <|-- UniProtAdapter
    BaseHttpAdapter <|-- CrossRefAdapter
    BaseHttpAdapter <|-- OpenAlexAdapter
    BaseHttpAdapter <|-- SemanticScholarAdapter

    BaseSyncAdapter <|-- PubChemAdapter

    BaseHttpAdapter o-- UnifiedHTTPClient
    UnifiedHTTPClient o-- CircuitBreaker
    UnifiedHTTPClient o-- TokenBucket
    BaseHttpAdapter o-- AdapterMetrics
