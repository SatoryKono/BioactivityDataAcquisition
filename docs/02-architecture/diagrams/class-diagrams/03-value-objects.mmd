classDiagram
    direction TB
    class BronzeWriteResult {
        <<frozen dataclass>>
        +batch_id: BatchID
        +relative_path: str
        +absolute_path: str
        +record_count: int
        +compressed_size: int
        +uncompressed_size: int
        +checksum_blake2: str
        +compression_ratio: float
        +exists(): bool



    }

    class SilverWriteResult {
        <<frozen dataclass>>
        +table_name: str
        +table_path: str
        +delta_version: int
        +record_count: int








    }

    class RunContext {
        <<dataclass>>
        +run_id: RunID
        +run_type: RunType
        +started_at: datetime
        +checkpoint_offset: int | None








    }

    class HealthCheckResult {
        <<frozen dataclass>>
        +status: HealthStatus
        +latency_ms: float
        +provider: str
        +endpoint: str
        +last_error: str | None
        +consecutive_failures: int
        +checked_at: datetime





    }

    class FencingToken {
        <<frozen dataclass>>
        +sequence: int
        +key: str
        +owner_id: RunID
        +issued_at: float








    }

    class LockContext {
        <<frozen dataclass>>
        +key: str
        +owner_id: RunID
        +exclusive: bool
        +acquired_at: float | None
        +fencing_token: FencingToken | None
        +create(): LockContext
        +is_valid(): bool
        +matches_table(table): bool




    }

    class AuditEntry {
        <<frozen dataclass>>
        +run_id: RunID
        +timestamp: datetime
        +layer: AuditLayer
        +table_name: str
        +operation: AuditOperation
        +records_count: int
        +metadata: dict





    }

    class FilterLoadResult {
        <<dataclass>>
        +ids: tuple~str~
        +total_count: int
        +unique_count: int
        +duplicate_count: int
        +has_duplicates: bool
        +column_ids: dict
        +valid_combinations: frozenset
        +filter_fields: list~str~




    }

    class MemoryStats {
        <<dataclass>>
        +rss_bytes: int
        +vms_bytes: int
        +percent: float









    }

    class SourceMetadata {
        <<dataclass>>
        +type: str
        +api_endpoint: str | None
        +request_details: dict | None









    }

    class DQMetrics {
        <<dataclass>>
        +null_rate: float
        +duplicate_rate: float
        +schema_violations: int
        +custom_metrics: dict








    }

    class DQResult {
        <<dataclass>>
        +passed: bool
        +error_rate: float
        +metrics: DQMetrics
        +anomalies: list








    }

    class EnrichmentResult {
        <<frozen dataclass>>
        +enricher_name: str
        +status: EnrichmentStatus
        +records_input: int
        +records_enriched: int
        +records_not_found: int
        +records_errored: int
        +dq_error_rate: float
        +duration_seconds: float
        +error_message: str | None
        +is_success: bool
        +enrichment_rate: float
        +not_found_rate: float
    }

    LockContext --> FencingToken
    DQResult --> DQMetrics
    AuditEntry --> AuditLayer
