%% BioETL — Class Diagram: Domain Port Protocols
%% All Protocol interfaces defined in domain/ports/

%% @version 1.1.0
%% @date    2026-03-16
%% @type    classDiagram
%% @level   Class / Interface
%% @nodes   19
%% @uniform class width=232 height=216 max_title_len=24 max_desc_lines=10
---
config:
  theme: mc
  layout: elk
  look: classic
---
classDiagram
    direction LR
    class DataSourcePort {
        <<Protocol>>
        +fetch(entity_type, limit, query, filter_ids, filter_field): AsyncIterator~dict~
        +health_check(): HealthCheckResult
        +\_\_aenter\_\_(): Self
        +\_\_aexit\_\_(...): None
        
        
        
        
    }

    class FilterableDataSourcePort {
        <<Protocol>>
        +fetch_filtered(entity_type, filter_ids, filter_field, limit): AsyncIterator~dict~
        +fetch_filtered_with_fallback(entity_type, ids, field, limit): AsyncIterator~dict~
        
        
        
        
        
        
    }

    class StoragePort {
        <<Protocol / compat facade>>
        +write_bronze(records, config, metadata): BronzeWriteResult
        +write_silver(records, config): SilverWriteResult
        +write_gold(records, config): None
        +preview_cleanup(silver_table, gold_table): MetaDict
        +aggregates narrow storage ports
    }

    class LockPort {
        <<Protocol>>
        +acquire(key, owner_id, ttl): FencingToken
        +release(key, owner_id): bool
        +heartbeat(key, owner_id): bool
        +validate_owner(key, owner_id): bool
        +validate_fencing_token(key, token): bool
        
        
        
        
    }

    class CheckpointPort {
        <<Protocol>>
        +save(key, data): None
        +load(key): dict | None
        
        
        
        
        
    }

    class QuarantinePort {
        <<Protocol>>
        +write(records, pipeline, error_code): None
        +inspect(pipeline, limit): list
        +replay(pipeline, filter_fn): int
        
        
        
    }

    class AuditPort {
        <<Protocol>>
        +log_write(entry: AuditEntry): None
        +get_entries(filters): list~AuditEntry~
        
        
        
        
        
        
        
    }

    class LoggerPort {
        <<Protocol>>
        +bind(**kwargs): LoggerPort
        +info(msg, **fields): None
        +error(msg, **fields): None
        
        
        
    }

    class MetricsPort {
        <<Protocol>>
        +observe_histogram(name, value, labels): None
        +increment_counter(name, labels): None
        +set_gauge(name, value, labels): None
        
        
        
        
        
    }

    class TracingPort {
        <<Protocol>>
        +get_tracer(name): Tracer
        +close(): None
        
        
        
        
        
        
        
    }

    class CircuitBreakerPort {
        <<Protocol>>
        +get_state(): CircuitBreakerState
        +call(fn): T
        +reset(): None
        
        
        
        
        
    }

    class RateLimiterPort {
        <<Protocol>>
        +acquire(tokens): None
        +try_acquire(): bool
        
        
        
        
        
        
    }

    class PiiHasherPort {
        <<Protocol>>
        +hash(value: str): str
        
        
        
        
        
        
        
        
    }

    class MetadataWriterPort {
        <<Protocol>>
        +write(path, metadata): None
        
        
        
        
        
        
        
        
    }

    class DeltaReaderPort {
        <<Protocol>>
        +read_table(path, columns, limit): DataFrame
        +get_schema(path): Schema
        
        
        
        
        
        
    }

    class InputFilterPort {
        <<Protocol>>
        +load_filter_ids(path, column): FilterLoadResult
        +load_filter_with_fallback(path, column, fallback): FilterLoadResult
        
        
        
        
        
        
    }

    class DQMonitorPort {
        <<Protocol>>
        +add_metric(name, value): None
        +check_quality(): DQResult
        
        
        
        
        
    }

    class JsonEncoderPort {
        <<Protocol>>
        +encode(obj): str
        +decode(s): Any
        
        
        
        
        
        
        
    }

    class MemoryMonitorPort {
        <<Protocol>>
        +get_stats(): MemoryStats
        
        
        
        
        
        
        
        
    }

    DataSourcePort <|-- FilterableDataSourcePort

    note for StoragePort "Backward-compatible aggregate facade. New consumers SHOULD use narrow storage ports."
    note for QuarantinePort "See L2 for secondary ops"
    note for LoggerPort "See L2 for extra log methods"
    note for InputFilterPort "See L2 for multi-column helpers"

