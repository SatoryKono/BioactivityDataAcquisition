%% Title: Application Core Component Collaboration
%% Covers: RULES.md §1.1 (Application Layer), application/core/
%% Rank: 15 (Score 8.19) — PipelineRunner orchestration of all services
%% Updated: 2026-02-17

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
flowchart TB
    subgraph Runner["PipelineRunner (application/core/runner.py)"]
        RUN["run() — main orchestrator"]
    end

    subgraph Lifecycle["Lifecycle Services"]
        LM["LockManager\n• acquire(key, owner, ttl=90s)\n• release(key, owner)\n• validate_ownership()"]
        HB["HeartbeatTask\n• start(interval=30s)\n• stop()\n• _heartbeat_loop()"]
        CM["CheckpointManager\n• save(last_id, batch_num)\n• load() → state\n• delete()"]
        SD["ShutdownService\n• is_shutting_down()\n• register_signals()"]
    end

    subgraph Validation["Pre/Post Services"]
        PF["PreflightService (553+ LOC)\n• check_config()\n• check_storage()\n• check_data_source()\n• check_lock()\n→ PreflightReport"]
        POST["PostrunService\n• run_dq_checks()\n• execute_vacuum()\n• write_dq_report()\n• publish_metrics()\n→ PostrunResult"]
    end

    subgraph Execution["Batch Execution"]
        BE["BatchExecutor (786 LOC)\n• execute_batch()\n• _extract()\n• _transform()\n• _write()"]
        BT["BatchTransformer\n• transform(records)\n→ TransformResult"]
        BWR["BatchWriter\n• write(batch_data)\n• write_bronze()\n• write_silver()\n• write_gold()"]
        QM["QuarantineManager\n• route_failed_records()\n• create_entry()"]
    end

    subgraph Observability["Observability"]
        OBS["PipelineObserver\n• __enter__() → started\n• __exit__() → completed/failed"]
        BMR["BatchMetricsRecorder\n• record(size, duration, errors)"]
        BTM["BatchTracingManager\n• start_span()\n• end_span()"]
    end

    subgraph Bundle["PipelineServices (frozen dataclass)"]
        PS["All ports injected:\n• storage (bronze+silver+gold)\n• lock, checkpoint\n• quarantine\n• logger, metrics, tracing\n• validators, pii_hasher"]
    end

    %% Runner orchestration
    RUN -->|"1. lock"| LM
    LM -->|"starts"| HB
    RUN -->|"2. preflight"| PF
    RUN -->|"3. batch loop"| BE
    BE --> BT
    BE --> BWR
    BWR --> QM
    RUN -->|"4. postrun"| POST
    RUN -->|"5. release"| LM
    RUN -->|"checkpoint"| CM
    RUN -->|"shutdown check"| SD

    %% Observability wrapping
    OBS -.->|"wraps"| RUN
    BMR -.->|"records"| BE
    BTM -.->|"traces"| BE

    %% All use PipelineServices
    PS -.->|"provides ports to"| Runner & Lifecycle & Validation & Execution

