%% View: Overview | Parent: 41-error-classification-tree-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N2["HTTP"]
        N1["ERROR"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N3["INFRA"]
        N4["no"]
        N5["classify"]
        N7["AUTH"]
        N8["FAIL_FAST"]
        N9["RATE"]
        N11["SERVER"]
        N14["STORE"]
        N15["CB"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N13["LOCKACQ"]
        N6["retry"]
        N10["RETRY"]
        N12["LOCK"]
    end

    N1 --> N2
    N1 --> N3
    N2 --> N4
    N2 --> N5
    N2 --> N6
    N7 --> N8
    N9 --> N10
    N11 --> N10
    N12 --> N8
    N13 --> N8
    N14 --> N10
    N15 --> N10

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    %% linkStyle: data 2-3, err 0-1,4-11
    linkStyle 0 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 1 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 5 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 6 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 7 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 8 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 9 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 10 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 11 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
