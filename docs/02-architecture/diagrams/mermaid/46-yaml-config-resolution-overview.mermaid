%% View: Overview | Parent: 46-yaml-config-resolution-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N2["dq_config_file"]
        N5["override"]
        N6["PIPELINE_CONFIG"]
        N7["TABLE_CONFIG"]
        N13["DQ_ENTITY"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["PIPELINE"]
        N3["br"]
        N4["YAML_LOADER"]
        N8["BASE"]
        N10["SOURCE"]
        N11["DQ_DEFAULTS"]
        N14["DQ_INLINE"]
        N15["FILTER_DEFAULTS"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N9["PROVIDER_BASE"]
        N12["DQ_PROVIDER"]
    end

    N4 --> N5
    N6 --> N7
    N1 --> N2
    N1 --> N3

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Composition fill:#fff3e0,stroke:#e65100,stroke-width:2px

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 1 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 2 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 3 stroke:#475569,stroke-width:2px,stroke-dasharray:5
