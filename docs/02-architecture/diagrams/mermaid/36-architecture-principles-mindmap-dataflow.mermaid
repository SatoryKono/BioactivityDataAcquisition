%% View: Data-Flow | Parent: 36-architecture-principles-mindmap-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N7["DataSourcePort"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N5["Batch"]
        N4["PipelineRun"]
        N10["PipelineRunner"]
        N11["BatchExecutor"]
        N12["23 Transformers"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N1["Bronze"]
        N2["Silver"]
        N3["Gold"]
        N6["QuarantineEntry"]
        N8["Storage Writers"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N9["PipelineRegistry"]
    end

    N1 --> N2
    N2 --> N3
    N3 --> N4
    N4 --> N5
    N5 --> N6
    N6 --> N7
    N7 --> N8
    N8 --> N9
    N9 --> N10
    N10 --> N11
    N11 --> N12

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    style Composition fill:#fff3e0,stroke:#e65100,stroke-width:2px

    %% linkStyle: data 0-3, orch 4-5, DI 6-7, obs 8-8, err 9-10
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#2e7d32,stroke-width:2px
    linkStyle 5 stroke:#2e7d32,stroke-width:2px
    linkStyle 6 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 7 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 8 stroke:#94A3B8,stroke-width:1px
    linkStyle 9 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 10 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
