%% View: Domain-Focus | Parent: 08-domain-ddd-full.mermaid
flowchart TB

    subgraph Domain["🟡 Domain Layer"]
        direction TB
        N3["BatchID"]
        N4["EntityID"]
        N5["ContentHash"]
        N10["HealthStatus"]
        N11["RunID"]
        N13["RunStarted"]
        N14["RunCompleted"]
        N15["R_RUNNING"]
        N16["R_PENDING"]
        N17["R_COMPLETED"]
        N18["R_FAILED"]
        N19["R_SHUTDOWN"]
        N20["B_WRITING"]
    end

    subgraph Application["🟢 Application Layer"]
        direction TB
        N2["PipelineRun"]
        N6["BatchCreated"]
        N7["BatchSealed"]
        N8["BatchWritten"]
        N1["Batch"]
    end

    subgraph Infrastructure["🔵 Infrastructure Layer"]
        direction TB
        N9["RecordQuarantined"]
        N12["QuarantineEntry"]
    end

    N1 --> N6
    N1 --> N7
    N1 --> N8
    N1 --> N9
    N2 --> N13
    N2 --> N14
    N1 --> N11
    N1 --> N3
    N2 --> N11
    N12 --> N4
    N12 --> N5
    N16 --> N15
    N15 --> N17
    N15 --> N18
    N15 --> N19

    style Domain fill:#FFF7ED,stroke:#F59E0B,stroke-width:2px
    style Application fill:#ECFDF5,stroke:#10B981,stroke-width:2px
    style Infrastructure fill:#EFF6FF,stroke:#2563EB,stroke-width:2px
