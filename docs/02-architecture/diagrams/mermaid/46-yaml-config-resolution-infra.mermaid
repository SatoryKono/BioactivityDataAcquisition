%% View: Infrastructure-Mapping | Parent: 46-yaml-config-resolution-full.mermaid
%% @uniform width=184 height=56 max_title_len=18 max_desc_lines=0
flowchart TB
%% keep-orphan: N10, N11, N12, N13, N14, N15, N16, N17, N18, N19, N2, N20, N3

    subgraph Domain["Domain Layer"]
        direction TB
        N1["dq_config_file&nbsp;&nbsp;&nbsp;&nbsp;"]
        N2["DQ_CONFIG_FILE&nbsp;&nbsp;&nbsp;&nbsp;"]
        N3["FILTER_CONFIG_FILE"]
        N7["override&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N8["PIPELINE_CONFIG&nbsp;&nbsp;&nbsp;"]
        N9["TABLE_CONFIG&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N15["DQ_ENTITY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N19["FILTER_ENTITY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Application["Application Layer"]
