%% View: Infrastructure-Mapping | Parent: 46-yaml-config-resolution-full.mermaid
%% @uniform width=184 height=56 max_title_len=18 max_desc_lines=0
flowchart TB
%% keep-orphan: N10, N11, N12, N13, N14, N15, N16, N17, N18, N19, N2, N20, N3

    subgraph Domain["Domain Layer"]
        direction TB
        N1["dq_config_file"]
        N2["DQ_CONFIG_FILE"]
        N3["FILTER_CONFIG_FILE"]
        N7["override"]
        N8["PIPELINE_CONFIG"]
        N9["TABLE_CONFIG"]
        N15["DQ_ENTITY"]
        N19["FILTER_ENTITY"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N4["PIPELINE"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N5["br"]
        N6["YAML_LOADER"]
        N10["BASE"]
        N12["SOURCE"]
        N13["DQ_DEFAULTS"]
        N16["DQ_INLINE"]
        N17["FILTER_DEFAULTS"]
        N20["FILTER_INLINE"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N11["PROVIDER_BASE"]
        N14["DQ_PROVIDER"]
        N18["FILTER_PROVIDER"]
    end

    N6 --> N7
    N8 --> N9
    N4 --> N1
    N4 --> N5

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    style Composition fill:#fff3e0,stroke:#e65100,stroke-width:2px

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 1 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 2 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 3 stroke:#475569,stroke-width:2px,stroke-dasharray:5
