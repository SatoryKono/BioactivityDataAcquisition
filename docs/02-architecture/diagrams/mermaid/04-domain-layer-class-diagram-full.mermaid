            +clear_gold(table) int&nbsp;&nbsp;
            +vacuum(table, retention_days) None
            +archive(source, dest) None
            +health_check() bool&nbsp;&nbsp;&nbsp;&nbsp;
        }

        class LockPort {
            <<Protocol>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
