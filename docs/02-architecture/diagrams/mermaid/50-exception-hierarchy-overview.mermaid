%% View: Overview | Parent: 50-exception-hierarchy-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N10["INVALID_STATE"]
        N12["POLICY_VIOLATION"]
        N15["run_id"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["BIOETL"]
        N2["CRITICAL"]
        N3["RECOVERABLE"]
        N5["status_code"]
        N6["operation"]
        N7["expected"]
        N8["actual"]
        N9["EXT_SERVICE"]
        N11["attempted_operation"]
        N13["violation_details"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N4["STORAGE_ERR"]
        N14["LOCK_LOST"]
    end

    N1 --> N2
    N1 --> N3
    N2 --> N10
    N2 --> N11
    N2 --> N12
    N2 --> N13
    N2 --> N14
    N2 --> N15
    N2 --> N5
    N2 --> N6
    N2 --> N7
    N2 --> N8
    N3 --> N5
    N3 --> N9
    N3 --> N6
    N9 --> N5
    N3 --> N4

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    %% linkStyle: data 0-6, orch 7-9, DI 10-12, obs 13-14, err 15-16
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#1E293B,stroke-width:3px
    linkStyle 5 stroke:#1E293B,stroke-width:3px
    linkStyle 6 stroke:#1E293B,stroke-width:3px
    linkStyle 7 stroke:#2e7d32,stroke-width:2px
    linkStyle 8 stroke:#2e7d32,stroke-width:2px
    linkStyle 9 stroke:#2e7d32,stroke-width:2px
    linkStyle 10 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 11 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 12 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 13 stroke:#94A3B8,stroke-width:1px
    linkStyle 14 stroke:#94A3B8,stroke-width:1px
    linkStyle 15 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 16 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
