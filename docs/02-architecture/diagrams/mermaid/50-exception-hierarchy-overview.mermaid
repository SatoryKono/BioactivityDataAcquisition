%% View: Overview | Parent: 50-exception-hierarchy-full.mermaid
%% @uniform width=192 height=56 max_title_len=19 max_desc_lines=0
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N10["INVALID_STATE&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N12["POLICY_VIOLATION&nbsp;&nbsp;&nbsp;"]
        N15["run_id&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["BIOETL&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N2["CRITICAL&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N3["RECOVERABLE&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N5["status_code&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N6["operation&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N7["expected&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N8["actual&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N9["EXT_SERVICE&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N11["attempted_operation"]
        N13["violation_details&nbsp;&nbsp;"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N4["STORAGE_ERR&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N14["LOCK_LOST&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    N1 --> N2
    N1 --> N3
    N2 --> N10
    N2 --> N11
    N2 --> N12
    N2 --> N13
    N2 --> N14
    N2 --> N15
    N2 --> N5
    N2 --> N6
    N2 --> N7
    N2 --> N8
    N3 --> N5
    N3 --> N9
    N3 --> N6
    N9 --> N5
    N3 --> N4

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    %% linkStyle: data 6,16 | orchestration 0-1,3,5,8-15 | di 2,4,7
