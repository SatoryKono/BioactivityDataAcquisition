%% Parent source: docs/02-architecture/mmd-diagrams/foundation/02-medallion.mmd
%% Full reference diagram retained after decomposition.
%% Title: Medallion Architecture Layers
%% Covers: RULES.md §2.1 (Bronze/Silver/Gold), §2.3 (Quarantine)
%% Updated: 2026-02-17
%% Components: BronzeWriter, SilverWriter, GoldWriter, QuarantineManager

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
flowchart LR
    subgraph Bronze["Bronze Layer"]
        direction TB
        B1["Raw Data<br/>JSONL + zstd"]
        B2["Append-Only writes"]
        B3["Retention: 90 days"]
        B4["content_hash tracking"]
    end

    subgraph Silver["Silver Layer"]
        direction TB
        S1["Normalized Data<br/>Delta Lake (ACID)"]
        S2["Merge by content_hash"]
        S3["Schema enforcement"]
        S4["Deduplication"]
    end

    subgraph Gold["Gold Layer"]
        direction TB
        G1["Business-Ready Data<br/>Delta Lake"]
        G2["Strict validation<br/>(Pandera schemas)"]
        G3["SCD Type 2 /<br/>Overwrite modes"]
        G4["Flattened for analytics"]
    end

    subgraph Quarantine["Quarantine"]
        direction TB
        Q1["Failed records<br/>(DQ errors)"]
        Q2["Error metadata +<br/>stack trace"]
        Q3["Replay support"]
    end

    Bronze -->|"Transform<br/>& normalize"| Silver
    Silver -->|"Validate<br/>& flatten"| Gold
    Bronze -.->|"DQ failure"| Quarantine
    Silver -.->|"DQ failure"| Quarantine
    Quarantine -.->|"Replay"| Bronze

    %% Styling — Medallion colors per policy §4.3
    classDef bronze fill:#fff8e1,stroke:#FFA500,color:#e65100
    classDef silver fill:#eceff1,stroke:#607d8b,color:#263238
    classDef gold fill:#fffde7,stroke:#FFD700,color:#f57f17
    classDef quarantine fill:#ffebee,stroke:#FF6B6B,color:#b71c1c

    class B1,B2,B3,B4 bronze
    class S1,S2,S3,S4 silver
    class G1,G2,G3,G4 gold
    class Q1,Q2,Q3 quarantine
