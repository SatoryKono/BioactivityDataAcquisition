%% Parent source: docs/02-architecture/mmd-diagrams/foundation/02-medallion.mmd
%% Full reference diagram retained after decomposition.
%% Title: Medallion Architecture Layers
%% Covers: RULES.md §2.1 (Bronze/Silver/Gold), §2.3 (Quarantine)
%% Updated: 2026-02-17
%% Components: BronzeWriter, SilverWriter, GoldWriter, QuarantineManager
%% Legend: see 00-legend.mermaid

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform width=224 height=56 max_title_len=23 max_desc_lines=1
flowchart LR
    subgraph Bronze["Bronze Layer"]
        direction TB
        B1["Raw Data&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>JSONL + zstd"]
        B2["Append-Only writes&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        B3["Retention: 90 days&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        B4["content_hash tracking&nbsp;&nbsp;<br/>&nbsp;"]
    end

    subgraph Silver["Silver Layer"]
        direction TB
        S1["Normalized Data&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Delta Lake (ACID)"]
        S2["Merge by content_hash&nbsp;&nbsp;<br/>&nbsp;"]
        S3["Schema enforcement&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        S4["Deduplication&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
    end

    subgraph Gold["Gold Layer"]
        direction TB
        G1["Business-Ready Data&nbsp;&nbsp;&nbsp;&nbsp;<br/>Delta Lake"]
        G2["Strict validation&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Pandera schemas)"]
        G3["SCD Type 2 /&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Overwrite modes"]
        G4["Flattened for analytics<br/>&nbsp;"]
    end

    subgraph Quarantine["Quarantine"]
        direction TB
        Q1["Failed records&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(DQ errors)"]
        Q2["Error metadata +&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>stack trace"]
        Q3["Replay support&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
    end

    Bronze -->|K01| Silver
    Silver -->|K02| Gold
    Bronze -.->|"DQ failure"| Quarantine
    Silver -.->|"DQ failure"| Quarantine
    Quarantine -.->|"Replay"| Bronze

    %% Styling — Medallion colors per policy §4.3
    classDef bronze fill:#fff8e1,stroke:#FFA500,color:#e65100
    classDef silver fill:#eceff1,stroke:#607d8b,color:#263238
    classDef gold fill:#fffde7,stroke:#FFD700,color:#f57f17
    classDef quarantine fill:#ffebee,stroke:#FF6B6B,color:#b71c1c

    class B1,B2,B3,B4 bronze
    class S1,S2,S3,S4 silver
    class G1,G2,G3,G4 gold
    class Q1,Q2,Q3 quarantine

    linkStyle 0 stroke:#1E293B,stroke-width:4px
    linkStyle 1 stroke:#1E293B,stroke-width:4px
    linkStyle 2 stroke:#EF4444,stroke-width:2px,stroke-dasharray:4
    linkStyle 3 stroke:#EF4444,stroke-width:2px,stroke-dasharray:4
    linkStyle 4 stroke:#EF4444,stroke-width:2px,stroke-dasharray:4
