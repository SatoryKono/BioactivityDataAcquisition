%% View: Data-Flow | Parent: 08-domain-ddd-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N4["BatchID"]
        N9["RunID"]
        N12["EntityID"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["Batch"]
        N2["PipelineRun"]
        N5["BatchCreated"]
        N6["BatchSealed"]
        N7["BatchWritten"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N3["QuarantineEntry"]
        N8["RecordQuarantined"]
        N10["RunStarted"]
        N11["RunCompleted"]
    end

    N1 --> N5
    N1 --> N6
    N1 --> N7
    N1 --> N8
    N2 --> N10
    N2 --> N11
    N1 --> N9
    N1 --> N4
    N2 --> N9
    N3 --> N12

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    %% linkStyle: data 1-2,6-7, orch 4-5,8, di 0, err 3,9
    linkStyle 0 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 4 stroke:#2e7d32,stroke-width:2px
    linkStyle 5 stroke:#2e7d32,stroke-width:2px
    linkStyle 6 stroke:#1E293B,stroke-width:3px
    linkStyle 7 stroke:#1E293B,stroke-width:3px
    linkStyle 8 stroke:#2e7d32,stroke-width:2px
    linkStyle 9 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
