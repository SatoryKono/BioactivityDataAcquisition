%% View: Domain-Focus | Parent: 10-infrastructure-layer-class-diagram-full.mermaid
%% @uniform width=232 height=56 max_title_len=24 max_desc_lines=0
flowchart TB
%% keep-orphan: N11, N12, N4, N7, N8, N9

    subgraph Domain["Domain Layer"]
        direction TB
        N1["DataSourcePort"]
        N2["StoragePort"]
        N3["CsvExporter"]
        N4["MetricsPort"]
        N5["RetryPolicy"]
        N6["FilterableDataSourcePort"]
        N7["LockPort"]
        N8["CheckpointPort"]
        N9["QuarantinePort"]
        N10["CircuitBreakerPort"]
        N11["RateLimiterPort"]
        N12["LoggerPort"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N14["ChemblAdapter"]
        N15["PubchemAdapter"]
        N16["UniprotAdapter"]
        N17["PubmedAdapter"]
        N18["SilverWriter"]
        N19["GoldWriter"]
        N20["CircuitBreaker"]
    end

    subgraph Interfaces["Interfaces Layer"]
        direction TB
        N13["UnifiedHTTPClient"]
    end

    N14 --> N1
    N14 --> N6
    N15 --> N1
    N16 --> N1
    N17 --> N1
    N18 --> N2
    N19 --> N2
    N20 --> N10
    N14 --> N13
    N15 --> N13
    N16 --> N13
    N17 --> N13
    N13 --> N20
    N13 --> N5
    N18 --> N3
    N19 --> N3

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    style Interfaces fill:#e3f2fd,stroke:#1565c0,stroke-width:2px

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
