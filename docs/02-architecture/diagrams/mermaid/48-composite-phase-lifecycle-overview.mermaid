%% View: Overview | Parent: 48-composite-phase-lifecycle-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N14["error"]
        N5["idle"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["FAILED"]
        N2["*"]
        N3["NOT_STARTED"]
        N4["COMPLETED"]
        N6["extracting_seed"]
        N7["keys_extracted"]
        N8["running_deps"]
        N9["deps_done"]
        N10["fan_out"]
        N11["enrichers_done"]
        N12["merge_active"]
        N13["success"]
        N15["ENRICHING"]
    end

    N2 --> N3
    N15 --> N1
    N4 --> N2
    N1 --> N2
    N2 --> N5
    N2 --> N6
    N2 --> N7
    N2 --> N8
    N2 --> N9
    N2 --> N10
    N2 --> N11
    N2 --> N12
    N2 --> N13
    N2 --> N14

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px

    %% linkStyle: data 0-5, orch 6-8, DI 9-11, obs 12-12, err 13-13
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#1E293B,stroke-width:3px
    linkStyle 5 stroke:#1E293B,stroke-width:3px
    linkStyle 6 stroke:#2e7d32,stroke-width:2px
    linkStyle 7 stroke:#2e7d32,stroke-width:2px
    linkStyle 8 stroke:#2e7d32,stroke-width:2px
    linkStyle 9 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 10 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 11 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 12 stroke:#94A3B8,stroke-width:1px
    linkStyle 13 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
