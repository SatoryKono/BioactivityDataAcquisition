    linkStyle 21 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 22 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 23 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 24 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
