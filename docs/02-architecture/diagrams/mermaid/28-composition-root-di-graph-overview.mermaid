        N12["GW&nbsp;&nbsp;"]
        N13["BW&nbsp;&nbsp;"]
    end

    subgraph Interfaces["Interfaces Layer"]
        direction TB
        N8["CLI&nbsp;"]
    end

    N8 --> N1
    N1 --> N3
    N3 --> N15
    N1 --> N4
    N1 --> N5
    N1 --> N6
