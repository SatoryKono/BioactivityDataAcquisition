        N14["CRITICAL"]
        N15["RECOVERABLE"]
        N17["VALIDATION"]
        N18["BIOETL"]
        N19["status_code"]
        N20["operation"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["EXT_SERVICE"]
        N6["RUNNER_EXECUTED"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N16["STORAGE_ERR"]
    end

    N18 --> N14
