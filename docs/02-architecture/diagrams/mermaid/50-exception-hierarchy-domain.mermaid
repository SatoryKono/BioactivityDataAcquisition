%% View: Domain-Focus | Parent: 50-exception-hierarchy-full.mermaid
%% @uniform width=168 height=56 max_title_len=16 max_desc_lines=0
flowchart TB
%% keep-orphan: N13

    subgraph Domain["Domain Layer"]
        direction TB
        N2["DQ_ERROR&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N3["POLICY_VIOLATION"]
        N4["METRICS_ERROR&nbsp;&nbsp;&nbsp;"]
        N5["port&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N7["INFRA_ERROR&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N8["last_error&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N9["API_ERROR&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N10["record_id&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N11["entity_type&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N12["DQ_THRESHOLD&nbsp;&nbsp;&nbsp;&nbsp;"]
        N13["ERROR_TYPE&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N14["CRITICAL&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N15["RECOVERABLE&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N17["VALIDATION&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N18["BIOETL&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N19["status_code&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N20["operation&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["EXT_SERVICE&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N6["RUNNER_EXECUTED&nbsp;"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N16["STORAGE_ERR&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    N18 --> N14
    N18 --> N15
    N18 --> N2
    N14 --> N3
    N14 --> N19
    N14 --> N4
    N14 --> N5
    N14 --> N6
    N14 --> N7
    N14 --> N20
    N15 --> N19
    N15 --> N8
    N15 --> N9
    N15 --> N1
    N15 --> N20
    N1 --> N19
    N15 --> N16
    N2 --> N17
    N2 --> N10
    N17 --> N11
    N18 --> N12

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

