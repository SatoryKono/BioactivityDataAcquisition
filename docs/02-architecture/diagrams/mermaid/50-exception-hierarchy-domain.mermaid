%% View: Domain-Focus | Parent: 50-exception-hierarchy-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N2["DQ_ERROR"]
        N3["POLICY_VIOLATION"]
        N4["METRICS_ERROR"]
        N5["port"]
        N7["INFRA_ERROR"]
        N8["last_error"]
        N9["API_ERROR"]
        N10["record_id"]
