%% View: Domain-Focus | Parent: 01-high-level-full.mermaid
%% @uniform width=140 height=56 max_title_len=10 max_desc_lines=0
flowchart TB
%% keep-orphan: N13, N14, N15, N16, N17, N18, N19, N20

    subgraph Domain["Domain Layer"]
        direction TB
        N5["Boot&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N6["Trans&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N8["Sources&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["Runner&nbsp;&nbsp;&nbsp;&nbsp;"]
        N2["Executor&nbsp;&nbsp;"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N7["Adapters&nbsp;&nbsp;"]
        N10["Bronze&nbsp;&nbsp;&nbsp;&nbsp;"]
        N11["Silver&nbsp;&nbsp;&nbsp;&nbsp;"]
        N12["Gold&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N13["A1&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N14["A2&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N15["A3&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N16["A4&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N17["A5&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N18["A6&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N19["A7&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N3["Storage&nbsp;&nbsp;&nbsp;"]
        N20["Quarantine"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N4["Factory&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Interfaces["Interfaces Layer"]
        direction TB
        N9["CLI&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    N8 --> N7
    N9 --> N5
    N5 --> N4
    N4 --> N1
    N1 --> N2
    N2 --> N6
    N6 --> N7
    N3 --> N10
    N3 --> N11
    N3 --> N12
    N2 --> N3

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    style Composition fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style Interfaces fill:#e3f2fd,stroke:#1565c0,stroke-width:2px

    %% linkStyle: data 0,6-10 | orchestration 3-4 | di 1,5 | generic 2
    linkStyle 0 stroke:#1E293B,stroke-width:2px
    linkStyle 1 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 2 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 3 stroke:#2e7d32,stroke-width:2px
    linkStyle 4 stroke:#2e7d32,stroke-width:2px
    linkStyle 5 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 6 stroke:#1E293B,stroke-width:2px
    linkStyle 7 stroke:#1E293B,stroke-width:2px
    linkStyle 8 stroke:#1E293B,stroke-width:2px
    linkStyle 9 stroke:#1E293B,stroke-width:2px
    linkStyle 10 stroke:#1E293B,stroke-width:2px
