%% @uniform width=304 height=108 max_title_len=33 max_desc_lines=4
flowchart TB
    subgraph Source["1. External API"]
        API["REST API Response&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(e.g., ChEMBL /activity)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Bronze["2. Bronze Layer"]
        BW["BronzeWriter.write_bronze()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>• JSONL serialization<br/>• zstd compression<br/>• atomic rename<br/>• _manifest.json"]
        BF[("Bronze File&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>bronze/chembl/activity/<br/>2026-02-17/batch_001.jsonl.zst"<br/>&nbsp;<br/>&nbsp;)]
    end

    subgraph Transform["3. Transform (RecordProcessor)"]
        BT["BatchTransformer.transform()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        TI["BaseTransformer._transform_impl()<br/>(e.g., ActivityTransformer)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        NORM["Data Normalization&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>• NaN → null<br/>• strip strings<br/>• dates → ISO<br/>• floats → round(10)"]
        META["Add Metadata&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>• _run_id (UUID)<br/>• _run_type (incremental/backfill)<br/>• _source_batch_id (FK)<br/>• _ingestion_ts (UTC now)"]
        HASH["Compute _content_hash&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>• exclude META_FIELDS<br/>• canonical JSON (sort_keys)<br/>• sha256 digest<br/>&nbsp;"]
    end

    subgraph Validate["4. Validate"]
        PSV["PanderaSilverValidator.validate()<br/>ActivitySchema (soft mode)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        DQ{{"DQ Error Rate?&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"}}
    end

    subgraph Route["5. Route Decision"]
        CLEAN["✅ Clean Record&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>_dq_warn = false<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        WARN["⚠️ Warning Record&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>_dq_warn = true<br/>(error rate < 5%)<br/>&nbsp;<br/>&nbsp;"]
        QUAR["❌ Quarantine Record&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>QuarantineManager.route()<br/>QuarantineEntry created<br/>&nbsp;<br/>&nbsp;"]
        FAIL["💥 Batch FAIL&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(error rate > 20%)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Silver["6. Silver Layer"]
        SW["SilverWriter.write_silver()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>• merge/upsert by PK<br/>• content_hash dedup<br/>• Delta Lake transaction<br/>&nbsp;"]
        ST[("Silver Table&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>silver/chembl/activity/<br/>_delta_log/"<br/>&nbsp;<br/>&nbsp;)]
    end

    subgraph GoldLayer["7. Gold Layer"]
        TFG["transform_for_gold()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>• exclude JSON fields<br/>(molecule_properties,<br/>molecule_structures, etc.)<br/>&nbsp;"]
        GV["PanderaGoldValidator.validate()&nbsp;&nbsp;<br/>ChEMBLActivityGoldSchema<br/>(strict mode)<br/>&nbsp;<br/>&nbsp;"]
        GW["GoldWriter.write_gold()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        GT[("Gold Table&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>gold/chembl/activity/<br/>_delta_log/"<br/>&nbsp;<br/>&nbsp;)]
    end

    subgraph QuarDB["Quarantine Storage"]
        QT[("Quarantine Table&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>quarantine/chembl/activity/"<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;)]
    end

    %% Flow
    API --> BW --> BF
    BF --> BT --> TI --> NORM --> META --> HASH
    HASH --> PSV --> DQ

    DQ -->|"0% errors"| CLEAN
    DQ -->|K14| WARN
    DQ -->|K15| QUAR
    DQ -->|K16| FAIL

    CLEAN --> SW
    WARN --> SW
    SW --> ST
    ST --> TFG --> GV --> GW --> GT

    QUAR --> QT

    %% Styling
    style Bronze fill:#fff7ed,stroke:#f59e0b,color:#000
    style Silver fill:#f8fafc,stroke:#475569,color:#000
    style GoldLayer fill:#fefce8,stroke:#ca8a04,color:#000
    style QuarDB fill:#ffe4e6,stroke:#e11d48,color:#000

    linkStyle 0,1,2,7,8,9,10,11 stroke:#1E293B,stroke-width:4px
    linkStyle 3,4,5,6 stroke:#EF4444,stroke-width:2px,stroke-dasharray:4
