%% Parent source: docs/02-architecture/mmd-diagrams/foundation/05-layers-interaction.mmd
%% Full reference diagram retained after decomposition.
%% Title: Layer Interaction — Hexagonal Architecture
%% Covers: RULES.md §1.1 (Layers), §1.2 (Ports & Adapters)
%% Updated: 2026-02-17
%% Components: CLI, bootstrap_pipeline, PipelineRunner, PipelineExecutor, BaseTransformer, Port interfaces, Adapters, Storage Writers

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

flowchart TB
    subgraph Interfaces["Interfaces Layer"]
        CLI[CLI Entry Point]
    end

    subgraph Composition["Composition Layer"]
        Bootstrap[bootstrap_pipeline]
        Registry[PipelineRegistry]
        Factories[Factories]

        Bootstrap --> Registry
        Bootstrap --> Factories
    end

    subgraph Application["Application Layer"]
        Runner[PipelineRunner]
        BatchExec[BatchExecutor]
        Transformer[BaseTransformer]
        Services[PipelineServices]

        subgraph Composite["Composite Pipeline (ADR-026)"]
            CompositeRunner[CompositePipelineRunner]
            Coordinator[EnrichmentCoordinator]
            Merger[MergeService]
        end

        Runner --> BatchExec
        BatchExec --> Transformer
        Runner --> Services
        CompositeRunner --> Coordinator
        CompositeRunner --> Merger
        CompositeRunner -.->|"delegates"| Runner
    end

    subgraph Domain["Domain Layer"]
        Ports[Port Interfaces]
        Types[Core Types]
        Entities[Domain Entities]
        Exceptions[Exception Hierarchy]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        Adapters[Data Source Adapters]
        Storage[Storage Writers]
        Observability[Metrics & Tracing]
        Locking[Locks & Checkpoints]
    end

    %% Layer Dependencies
    CLI --> Bootstrap
    Factories --> Runner
    Application --> Ports
    Adapters -.->|implements| Ports
    Storage -.->|implements| Ports
    Observability -.->|implements| Ports

    %% Styling
    classDef domainStyle fill:#f3e5f5,stroke:#6a1b9a
    classDef appStyle fill:#e8f5e9,stroke:#2e7d32
    classDef infraStyle fill:#ffcdd2,stroke:#c62828
    classDef compStyle fill:#fff3e0,stroke:#e65100
    classDef ifaceStyle fill:#e3f2fd,stroke:#1565c0

    class Domain domainStyle
    class Application appStyle
    class Infrastructure infraStyle
    class Composition compStyle
    class Interfaces ifaceStyle

    style Domain fill:#FFF7ED,stroke:#F59E0B,stroke-width:2px
    style Application fill:#ECFDF5,stroke:#10B981,stroke-width:2px
    style Infrastructure fill:#EFF6FF,stroke:#2563EB,stroke-width:2px
    style Composition fill:#F5F3FF,stroke:#7C3AED,stroke-width:2px
    style Interfaces fill:#F1F5F9,stroke:#64748B,stroke-width:2px

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 1 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 2 stroke:#1E293B,stroke-width:4px
    linkStyle 3 stroke:#1E293B,stroke-width:4px
    linkStyle 4 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 5 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 6 stroke:#1E293B,stroke-width:4px
    linkStyle 7 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 8 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 9 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 10 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 11 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 12 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 13 stroke:#94A3B8,stroke-width:1px
