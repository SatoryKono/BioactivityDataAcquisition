%% Full reference diagram retained after decomposition.
%% Title: Cross-Provider Data Enrichment Flow — Publication
%% Covers: ADR-026 (Composite), publication composite pipeline config
%% Rank: 19 (Score 8.00) — 5 providers merging into unified Gold
%% Updated: 2026-02-17
%% Legend: see 00-legend.mermaid

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
flowchart LR
    subgraph ChEMBL["ChEMBL (Seed)"]
        CA["ChemblAdapter\n/document endpoint"]
        CT["PublicationTransformer"]
        CS[("Silver\nchembl/publication")]
    end

    subgraph CrossRef["CrossRef (Enricher)"]
        CRA["CrossRefAdapter\n/works?filter=doi:..."]
        CRT["CrossRefPublicationTransformer"]
        CRS[("Silver\ncrossref/publication")]
    end

    subgraph PubMed["PubMed (Enricher)"]
        PMA["PubMedAdapter\nefetch(PMIDs)"]
        PMT["PubMedPublicationTransformer"]
        PMS[("Silver\npubmed/publication")]
    end

    subgraph OpenAlex["OpenAlex (Enricher)"]
        OAA["OpenAlexAdapter\n/works?filter=doi:..."]
        OAT["OpenAlexPublicationTransformer"]
        OAS[("Silver\nopenalex/publication")]
    end

    subgraph S2["Semantic Scholar (Enricher)"]
        SSA["SemanticScholarAdapter\n/paper/batch"]
        SST["SemanticScholarPublicationTransformer"]
        S2S[("Silver\nsemanticscholar/publication")]
    end

    subgraph Merge["Merge Phase"]
        MS["MergeService\nLEFT OUTER JOIN\nconflict: coalesce"]
        FIELDS["Field Groups:\n• ID_AND_STATUS\n• BIBLIOGRAPHY\n• AUTHOR\n• TERMS\n• CITATIONS\n• DATES\n• PUB_TYPES"]
    end

    subgraph Gold["Gold Output"]
        GS["CompositePublicationGoldSchema\n(Pandera strict validation)"]
        GT[("Gold\ncomposite/publication")]
    end

    %% Flows
    CA --> CT --> CS
    CRA --> CRT --> CRS
    PMA --> PMT --> PMS
    OAA --> OAT --> OAS
    SSA --> SST --> S2S

    CS -->|K27| MS
    CRS -->|K28| MS
    PMS -->|K29| MS
    OAS -->|K30| MS
    S2S -->|K31| MS

    MS --> FIELDS
    FIELDS --> GS --> GT

    %% Styling
    style ChEMBL fill:#FFA500,stroke:#cc8400,color:#000
    style Merge fill:#C0C0C0,stroke:#808080,color:#000
    style Gold fill:#FFD700,stroke:#ccac00,color:#000

    %% linkStyle: data 0-4, orch 5-6, DI 7-8, obs 9-9, err 10-11
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#1E293B,stroke-width:3px
    linkStyle 5 stroke:#2e7d32,stroke-width:2px
    linkStyle 6 stroke:#2e7d32,stroke-width:2px
    linkStyle 7 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 8 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 9 stroke:#94A3B8,stroke-width:1px
    linkStyle 10 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 11 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
