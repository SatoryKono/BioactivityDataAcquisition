%% View: Data-Flow | Parent: 06-application-layer-class-diagram-full.mermaid
flowchart TB

    subgraph Application["Application Layer"]
        direction TB
        N1["BaseChemblTransformer"]
        N2["RecordProcessor"]
        N3["BasePipeline"]
        N4["PipelineRunner"]
        N5["PipelineExecutor"]
        N6["BatchTransformer"]
        N7["BaseTransformer"]
        N8["PipelineServices"]
        N10["PipelineObserver"]
        N12["ActivityTransformer"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N9["QuarantineManager"]
        N11["BatchMetricsRecorder"]
    end

    N1 --> N7
    N12 --> N1
    N4 --> N3
    N5 --> N3
    N5 --> N2
    N2 --> N6
    N2 --> N9
    N2 --> N11
    N6 --> N7
    N3 --> N8

    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    %% linkStyle: data 0-1,5,8, orch 2-4,9, obs 7, err 6
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#2e7d32,stroke-width:2px
    linkStyle 3 stroke:#2e7d32,stroke-width:2px
    linkStyle 4 stroke:#2e7d32,stroke-width:2px
    linkStyle 5 stroke:#1E293B,stroke-width:3px
    linkStyle 6 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 7 stroke:#94A3B8,stroke-width:1px
    linkStyle 8 stroke:#1E293B,stroke-width:3px
    linkStyle 9 stroke:#2e7d32,stroke-width:2px
