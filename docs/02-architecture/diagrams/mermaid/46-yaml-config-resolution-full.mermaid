    end

    subgraph DQ_HIERARCHY["DQ Config Hierarchy (DQConfigLoader)"]
        DQ_DEFAULTS["configs/quality/_defaults.yaml&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(global DQ defaults)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        DQ_PROVIDER["configs/quality/providers/{provider}.yaml&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(provider DQ)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        DQ_ENTITY["configs/quality/entities/{provider}/{entity}.yaml<br/>(entity DQ)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        DQ_INLINE["pipeline.dq_overrides&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(inline overrides)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph FILTER_HIERARCHY["Filter Config Hierarchy (FilterConfigLoader)"]
        FILTER_DEFAULTS["configs/filters/_defaults.yaml&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(global filter defaults)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        FILTER_PROVIDER["configs/filters/providers/{provider}.yaml&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(provider filters)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        FILTER_ENTITY["configs/filters/entities/{provider}/{entity}.yaml<br/>(entity filters)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        FILTER_INLINE["pipeline.filter_rules&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(inline overrides)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph LOADERS["Infrastructure Config Loaders"]
        CONFIG_LOADER["ConfigLoader&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>load_pipeline_config()<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        BASE_CONFIG_LOADER["BaseConfigLoader&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>_deep_merge_base()<br/>_merge_lists()<br/>&nbsp;<br/>&nbsp;"]
        DQ_CONFIG_LOADER["DQConfigLoader&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>_merge_hierarchy()<br/>_deep_merge()<br/>_merge_validation_lists()<br/>&nbsp;"]
        FILTER_CONFIG_LOADER["FilterConfigLoader&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>load()<br/>_merge_lists()<br/>&nbsp;<br/>&nbsp;"]
        YAML_LOADER["config_loader.py&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>_load_base_config()<br/>_deep_merge()<br/>load_pipeline_config()<br/>&nbsp;"]
    end

    subgraph DOMAIN_CONFIG["Domain Config Objects (Frozen)"]
        PIPELINE_CONFIG["PipelineConfig&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(frozen dataclass)<br/>pipeline_name, provider,<br/>entity_type, table, dq,<br/>batch_size, fields"]
        TABLE_CONFIG["TableConfig&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(frozen dataclass)<br/>primary_keys, silver_table,<br/>gold_table<br/>&nbsp;"]
        DQ_CONFIG["DQConfig&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(frozen dataclass)<br/>soft_fail_threshold=0.05<br/>hard_fail_threshold=0.20<br/>field_validations"]
        INPUT_FILTER["InputFilterConfig&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        SILVER_FILTER["SilverFilterConfig&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        GOLD_FILTER["GoldFilterConfig&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph VALIDATION["Pydantic Validation Layer"]
        PIPELINE_YAML_CFG["PipelineYamlConfig&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Pydantic BaseModel)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        SOURCE_YAML_CFG["SourceYamlConfig&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Pydantic BaseModel)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        DQ_CONFIG_FILE["DQConfigFile&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Pydantic BaseModel)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        FILTER_CONFIG_FILE["FilterConfigFile&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Pydantic BaseModel)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    %% Pipeline config resolution
    BASE -->|"layer 1"| YAML_LOADER
    PROVIDER_BASE -->|"layer 2"| YAML_LOADER
    PIPELINE -->|"layer 3"| YAML_LOADER
    SOURCE -->|K32| YAML_LOADER
    YAML_LOADER -->|K33| PIPELINE_YAML_CFG
    PIPELINE_YAML_CFG -->|K34| PIPELINE_CONFIG
    PIPELINE_CONFIG --- TABLE_CONFIG

    %% DQ resolution
    DQ_DEFAULTS -->|"layer 1"| DQ_CONFIG_LOADER
    DQ_PROVIDER -->|"layer 2"| DQ_CONFIG_LOADER
    DQ_ENTITY -->|"layer 3"| DQ_CONFIG_LOADER
    DQ_INLINE -->|"layer 4"| DQ_CONFIG_LOADER
    DQ_CONFIG_LOADER -->|"validate"| DQ_CONFIG_FILE
    DQ_CONFIG_FILE -->|K34| DQ_CONFIG

    %% Filter resolution
    FILTER_DEFAULTS -->|"layer 1"| FILTER_CONFIG_LOADER
    FILTER_PROVIDER -->|"layer 2"| FILTER_CONFIG_LOADER
    FILTER_ENTITY -->|"layer 3"| FILTER_CONFIG_LOADER
    FILTER_INLINE -->|"layer 4"| FILTER_CONFIG_LOADER
    FILTER_CONFIG_LOADER -->|"validate"| FILTER_CONFIG_FILE
    FILTER_CONFIG_FILE -->|K34| INPUT_FILTER
    FILTER_CONFIG_FILE -->|K34| SILVER_FILTER
    FILTER_CONFIG_FILE -->|K34| GOLD_FILTER

    %% Inheritance
    BASE_CONFIG_LOADER -.->|"base class"| DQ_CONFIG_LOADER
    BASE_CONFIG_LOADER -.->|"base class"| FILTER_CONFIG_LOADER
    CONFIG_LOADER -->|"delegates"| YAML_LOADER
    CONFIG_LOADER -->|K35| DQ_CONFIG_LOADER

    %% Convention-based auto-resolution (ADR-029)
    PIPELINE -.->|K36| SOURCE
    PIPELINE -.->|K37| PIPELINE_CONFIG

