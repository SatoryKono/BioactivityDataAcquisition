%% View: Data-Flow | Parent: 05-layers-interaction-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N12["Ports"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N4["Runner"]
        N1["BatchExec"]
        N2["Transformer"]
        N3["Merger"]
        N5["CompositeRunner"]
        N9["Services"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N6["Factories"]
        N10["Coordinator"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N7["Bootstrap"]
        N8["Registry"]
    end

    subgraph Interfaces["Interfaces Layer"]
        direction TB
        N11["CLI"]
    end

    N7 --> N8
    N7 --> N6
    N4 --> N1
    N1 --> N2
    N4 --> N9
    N5 --> N10
    N5 --> N3
    N11 --> N7
    N6 --> N4

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    style Composition fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style Interfaces fill:#e3f2fd,stroke:#1565c0,stroke-width:2px

    %% linkStyle: data 3, orch 2,4-6,8, di 0-1,7
    linkStyle 0 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 1 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 2 stroke:#2e7d32,stroke-width:2px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#2e7d32,stroke-width:2px
    linkStyle 5 stroke:#2e7d32,stroke-width:2px
    linkStyle 6 stroke:#2e7d32,stroke-width:2px
