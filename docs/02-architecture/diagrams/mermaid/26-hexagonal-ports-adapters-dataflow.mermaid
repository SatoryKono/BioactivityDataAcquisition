%% View: Data-Flow | Parent: 26-hexagonal-ports-adapters-full.mermaid
%% @uniform width=140 height=56 max_title_len=3 max_desc_lines=0
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N1["DSP"]
        N9["SP"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N2["CA"]
        N3["PCA"]
        N4["UA"]
        N5["PMA"]
        N6["CRA"]
        N7["OAA"]
        N8["SSA"]
        N10["BW"]
        N11["SW"]
        N12["GW"]
    end

    N1 --> N2
    N1 --> N3
    N1 --> N4
    N1 --> N5
    N1 --> N6
    N1 --> N7
    N1 --> N8
    N9 --> N10
    N9 --> N11
    N9 --> N12

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 1 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 2 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 3 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 4 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 5 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 6 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 7 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 8 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 9 stroke:#475569,stroke-width:2px,stroke-dasharray:5
