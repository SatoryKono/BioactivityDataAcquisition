%% Full reference diagram retained after decomposition.
%% Title: Data Quality Check Workflow
%% Covers: RULES.md §3.1 (DQ Checks), §2.3 (Quarantine)
%% Updated: 2026-02-17
%% Components: DQMonitorPort, BronzeDQAnalyzerPort, SilverDQAnalyzerPort, GoldDQAnalyzerPort, ErrorClassifier, QuarantineManager

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform width=288 height=56 max_title_len=31 max_desc_lines=1
flowchart TD
%% keep-orphan: CFG1, CFG2, CFG3
    subgraph Input["Input Stage"]
        A[/"📥 Input Records&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(from Bronze)"/]
    end

    subgraph Validation["Validation Stage"]
        B["🔍 Pandera Schema Validation&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        B1["Check required fields&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        B2["Validate data types&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        B3["Check value constraints&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        B4["Validate relationships&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]

        B --> B1
        B --> B2
        B --> B3
        B --> B4
    end

    subgraph Classification["Error Classification"]
        C{{"📊 Calculate Error Rate&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"}}
        D["✅ 0% errors&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        E["⚠️ < 5% errors&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(soft_fail_threshold)"]
        F["⚠️ 5-20% errors&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(warning zone)"]
        G["❌ > 20% errors&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(hard_fail_threshold)"]
    end

    subgraph Actions["Action Paths"]
        H["✅ All Pass&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>No warnings"]
        I["✅ Pass with Quarantine&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Route failures"]
        J["⚠️ Pass with Warnings&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Set _dq_warn=true"]
        K["❌ FAIL Batch&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>All to Quarantine"]
    end

    subgraph Routing["Record Routing"]
        L[("💾 Silver Layer&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>SilverWriter.merge()")]
        M[("🗑️ Quarantine&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>QuarantineWriter")]
        N["🚨 Alert&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>P2 Notification"]
    end

    subgraph Metrics["Metrics Export"]
        O["📈 dq_validation_score&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Gauge: 0.0-1.0"]
        P["📈 record_error_rate&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Gauge: percentage"]
        Q["📈 dq_check_duration_ms&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Histogram"]
        R["📈 dq_soft_threshold_exceeded&nbsp;&nbsp;&nbsp;<br/>Counter"]
        S["📈 quarantine_records_total&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Counter"]
    end

    %% Main flow
    A --> B
    B1 --> C
    B2 --> C
    B3 --> C
    B4 --> C

    C -->|"0%"| D
    C -->|"< 5%"| E
    C -->|"5-20%"| F
    C -->|"> 20%"| G

    D --> H
    E --> I
    F --> J
    G --> K

    H --> L
    I --> L
    I --> M
    J --> L
    J --> M
    J --> R
    K --> M
    K --> N

    %% Metrics connections
    B --> O
    B --> P
    B --> Q
    M --> S

    %% Styling
    style D fill:#90EE90,color:#000
    style E fill:#FFFFE0,color:#000
    style F fill:#FFD700,color:#000
    style G fill:#FF6B6B,color:#fff
    style L fill:#C0C0C0,color:#000
    style M fill:#FF6B6B,color:#fff
    style N fill:#FF4500,color:#fff

    %% Configuration annotation
    subgraph Config["DQConfig Parameters"]
        direction LR
        CFG1["soft_fail_threshold: 0.05 (5%)&nbsp;<br/>&nbsp;"]
        CFG2["hard_fail_threshold: 0.20 (20%)<br/>&nbsp;"]
        CFG3["strict_validation: false&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
    end

    linkStyle 0 stroke:#1E293B,stroke-width:4px
    linkStyle 1 stroke:#1E293B,stroke-width:4px
