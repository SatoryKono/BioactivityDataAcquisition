%% View: Infrastructure-Mapping | Parent: 04-domain-layer-class-diagram-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N1["StoragePort"]
        N2["LockPort"]
        N3["CheckpointPort"]
        N4["QuarantinePort"]
        N5["MetricsPort"]
        N6["TracingPort"]
        N7["LoggerPort"]
        N8["BaseEntity"]
        N9["PublicationEntityBase"]
        N15["TableConfig"]
        N16["PipelineConfig"]
        N17["DQConfig"]
        N20["DataSourcePort"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N10["Activity"]
        N11["Molecule"]
        N12["Assay"]
        N13["Target"]
        N14["ChemblPublication"]
        N18["SilverWriteMode"]
        N19["GoldWriteMode"]
    end

    N8 --> N10
    N8 --> N11
    N8 --> N12
    N8 --> N13
    N8 --> N9
    N9 --> N14
    N16 --> N15
    N16 --> N17
    N15 --> N18
    N15 --> N19

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    %% linkStyle: data 0-3, orch 4-5, DI 6-7, obs 8-8, err 9-9
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#2e7d32,stroke-width:2px
    linkStyle 5 stroke:#2e7d32,stroke-width:2px
    linkStyle 6 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 7 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 8 stroke:#94A3B8,stroke-width:1px
    linkStyle 9 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
