%% Full reference diagram retained after decomposition.
%% Title: Composition Root Wiring — Full DI Graph
%% Covers: RULES.md §1.1 (Composition Layer), ADR-005
%% Rank: 3 (Score 9.00) — Complete dependency injection assembly
%% Updated: 2026-02-17
%% Legend: see 00-legend.mermaid

%% @version 1.1.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform width=272 height=126 max_title_len=29 max_desc_lines=5
flowchart TB
%% keep-orphan: OB
    subgraph Entry["Entry Point"]
        CLI["CLI run command<br/><br/><br/><br/><br/>"]
        BOOT["bootstrap/runtime/assembly.py<br/><br/><br/><br/><br/>"]
    end

    subgraph Factories["Composition Factories"]
        direction TB

        subgraph LoggerFactories["Logger & Observability"]
            BL["BootstrapLogger<br/>• configure structlog<br/><br/><br/><br/>"]
            DQF["DQServicesFactory<br/>• create()<br/>→ DQ analyzers + monitor<br/><br/><br/>"]
        end

        subgraph ClientFactories["Client & Data Source"]
            HCF["HttpClientFactory<br/>• create(provider)<br/>→ UnifiedHTTPClient<br/><br/><br/>"]
            DSF["DataSourceFactory<br/>• create(provider, config)<br/>→ DataSourcePort impl<br/><br/><br/>"]
        end

        subgraph StorageFactories["Storage & Services"]
            STF["StorageFactory<br/>• create(config)<br/>→ BronzeWriter + SilverWriter<br/>+ GoldWriter<br/><br/>"]
            STA["StorageAdapter<br/>• create_bronze()<br/>• create_silver()<br/>• create_gold()<br/><br/>"]
            SB["ServicesBuilder<br/>• with_storage()<br/>• with_lock()<br/>• with_logger()<br/>• with_metrics()<br/>• build() → PipelineServices"]
        end

        subgraph PipelineFactories["Pipeline Construction"]
            RF["RunnerFactory<br/>• create_runner()<br/>→ PipelineRunner<br/><br/><br/>"]
            GPF["GenericPipelineFactory<br/>• _pipeline_class<br/>• _transformer_class<br/>• _gold_schema<br/><br/>"]
        end
    end

    subgraph Registry["Registration"]
        PR["ProviderRegistry<br/>• 8 providers registered<br/><br/><br/><br/>"]
        DSR["DataSourceRegistry<br/>• facade → ProviderRegistry<br/><br/><br/><br/>"]
        PLREG["PipelineRegistry<br/>• pipeline_name → factory<br/><br/><br/><br/>"]
        OB["ObservabilityBundle<br/>• logger + metrics + tracing<br/><br/><br/><br/>"]
    end

    subgraph Created["Created Instances"]
        direction TB
        UHC["UnifiedHTTPClient<br/>+ TokenBucket<br/>+ CircuitBreaker<br/><br/><br/>"]
        ADP["Provider Adapter<br/>(ChemblAdapter, etc.)<br/><br/><br/><br/>"]
        BW["BronzeWriter<br/><br/><br/><br/><br/>"]
        SW["SilverWriter<br/><br/><br/><br/><br/>"]
        GW["GoldWriter<br/><br/><br/><br/><br/>"]
        ML["MemoryLock<br/><br/><br/><br/><br/>"]
        LC["LocalCheckpoint<br/><br/><br/><br/><br/>"]
        UQ["UnifiedQuarantine<br/><br/><br/><br/><br/>"]
        SLL["StructlogLogger<br/><br/><br/><br/><br/>"]
        PMM["PrometheusMetrics<br/><br/><br/><br/><br/>"]
        NOT["NoOpTracing<br/><br/><br/><br/><br/>"]
        PS["PipelineServices<br/>(frozen bundle)<br/><br/><br/><br/>"]
        RUN["PipelineRunner<br/>(fully assembled)<br/><br/><br/><br/>"]
    end

    %% Bootstrap flow
    CLI --> BOOT
    BOOT --> BL
    BL --> SLL
    BOOT --> HCF
    HCF --> UHC
    BOOT --> DSF
    DSF -->|"uses"| PR
    DSF -->|"uses"| UHC
    DSF --> ADP
    BOOT --> STF
    STF --> STA
    STA --> BW & SW & GW
    BOOT --> DQF
    BOOT --> SB
    SB -->|K06| BW & SW & GW
    SB -->|K07| ML
    SB -->|K08| LC
    SB -->|K09| UQ
    SB -->|K10| SLL
    SB -->|K11| PMM
    SB -->|K12| NOT
    SB --> PS
    BOOT --> RF
    RF -->|"uses"| PS
    RF -->|"uses"| ADP
    RF --> RUN

    %% Registry connections
    GPF -->|K13| PLREG
    PR -->|"contains"| DSR

    %% Styling
    style Entry fill:#f3e5f5,stroke:#6a1b9a
    style Factories fill:#fce4ec,stroke:#c62828
    style Registry fill:#fff3e0,stroke:#e65100
    style Created fill:#e8f5e9,stroke:#2e7d32

    style LoggerFactories fill:#fffde7,stroke:#fbc02d,stroke-dasharray: 5 5
    style ClientFactories fill:#e3f2fd,stroke:#2196f3,stroke-dasharray: 5 5
    style StorageFactories fill:#f3e5f5,stroke:#9c27b0,stroke-dasharray: 5 5
    style PipelineFactories fill:#e0f2f1,stroke:#009688,stroke-dasharray: 5 5

