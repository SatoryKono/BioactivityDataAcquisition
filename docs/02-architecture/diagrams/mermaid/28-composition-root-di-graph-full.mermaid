%% Parent source: docs/02-architecture/mmd-diagrams/foundation/28-composition-root-di-graph.mmd
%% Full reference diagram retained after decomposition.
%% Title: Composition Root Wiring — Full DI Graph
%% Covers: RULES.md §1.1 (Composition Layer), ADR-005
%% Rank: 3 (Score 9.00) — Complete dependency injection assembly
%% Updated: 2026-02-17
%% Legend: see 00-legend.mermaid

%% @version 1.1.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
flowchart TB
    subgraph Entry["Entry Point"]
        CLI["CLI run command"]
        BOOT["bootstrap/runtime/assembly.py"]
    end

    subgraph Factories["Composition Factories"]
        direction TB

        subgraph LoggerFactories["Logger & Observability"]
            BL["BootstrapLogger\n• configure structlog"]
            DQF["DQServicesFactory\n• create()\n→ DQ analyzers + monitor"]
        end

        subgraph ClientFactories["Client & Data Source"]
            HCF["HttpClientFactory\n• create(provider)\n→ UnifiedHTTPClient"]
            DSF["DataSourceFactory\n• create(provider, config)\n→ DataSourcePort impl"]
        end

        subgraph StorageFactories["Storage & Services"]
            STF["StorageFactory\n• create(config)\n→ BronzeWriter + SilverWriter\n  + GoldWriter"]
            STA["StorageAdapter\n• create_bronze()\n• create_silver()\n• create_gold()"]
            SB["ServicesBuilder\n• with_storage()\n• with_lock()\n• with_logger()\n• with_metrics()\n• build() → PipelineServices"]
        end

        subgraph PipelineFactories["Pipeline Construction"]
            RF["RunnerFactory\n• create_runner()\n→ PipelineRunner"]
            GPF["GenericPipelineFactory\n• _pipeline_class\n• _transformer_class\n• _gold_schema"]
        end
    end

    subgraph Registry["Registration"]
        PR["ProviderRegistry\n• 8 providers registered"]
        DSR["DataSourceRegistry\n• facade → ProviderRegistry"]
        PLREG["PipelineRegistry\n• pipeline_name → factory"]
        OB["ObservabilityBundle\n• logger + metrics + tracing"]
    end

    subgraph Created["Created Instances"]
        direction TB
        UHC["UnifiedHTTPClient\n+ TokenBucket\n+ CircuitBreaker"]
        ADP["Provider Adapter\n(ChemblAdapter, etc.)"]
        BW["BronzeWriter"]
        SW["SilverWriter"]
        GW["GoldWriter"]
        ML["MemoryLock"]
        LC["LocalCheckpoint"]
        UQ["UnifiedQuarantine"]
        SLL["StructlogLogger"]
        PMM["PrometheusMetrics"]
        NOT["NoOpTracing"]
        PS["PipelineServices\n(frozen bundle)"]
        RUN["PipelineRunner\n(fully assembled)"]
    end

    %% Bootstrap flow
    CLI --> BOOT
    BOOT --> BL
    BL --> SLL
    BOOT --> HCF
    HCF --> UHC
    BOOT --> DSF
    DSF -->|"uses"| PR
    DSF -->|"uses"| UHC
    DSF --> ADP
    BOOT --> STF
    STF --> STA
    STA --> BW & SW & GW
    BOOT --> DQF
    BOOT --> SB
    SB -->|K06| BW & SW & GW
    SB -->|K07| ML
    SB -->|K08| LC
    SB -->|K09| UQ
    SB -->|K10| SLL
    SB -->|K11| PMM
    SB -->|K12| NOT
    SB --> PS
    BOOT --> RF
    RF -->|"uses"| PS
    RF -->|"uses"| ADP
    RF --> RUN

    %% Registry connections
    GPF -->|K13| PLREG
    PR -->|"contains"| DSR

    %% Styling
    style Entry fill:#f3e5f5,stroke:#6a1b9a
    style Factories fill:#fce4ec,stroke:#c62828
    style Registry fill:#fff3e0,stroke:#e65100
    style Created fill:#e8f5e9,stroke:#2e7d32

    style LoggerFactories fill:#fffde7,stroke:#fbc02d,stroke-dasharray: 5 5
    style ClientFactories fill:#e3f2fd,stroke:#2196f3,stroke-dasharray: 5 5
    style StorageFactories fill:#f3e5f5,stroke:#9c27b0,stroke-dasharray: 5 5
    style PipelineFactories fill:#e0f2f1,stroke:#009688,stroke-dasharray: 5 5

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 1 stroke:#475569,stroke-width:2px,stroke-dasharray:5
