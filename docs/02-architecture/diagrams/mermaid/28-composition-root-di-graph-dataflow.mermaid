%% View: Data-Flow | Parent: 28-composition-root-di-graph-full.mermaid
flowchart TB

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N1["BOOT"]
        N2["SB"]
        N3["BL"]
        N4["HCF"]
        N5["DSF"]
        N6["STF"]
        N7["STA"]
        N8["SW"]
        N9["GW"]
        N10["RF"]
        N12["SLL"]
    end

    subgraph Interfaces["Interfaces Layer"]
        direction TB
        N11["CLI"]
    end

    N11 --> N1
    N1 --> N3
    N3 --> N12
    N1 --> N4
    N1 --> N5
    N1 --> N6
    N6 --> N7
    N7 --> N8
    N7 --> N9
    N1 --> N2
    N2 --> N8
    N2 --> N9
    N1 --> N10

    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    style Interfaces fill:#e3f2fd,stroke:#1565c0,stroke-width:2px

    %% linkStyle: data 0-4, orch 5-7, DI 8-10, obs 11-11, err 12-12
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#1E293B,stroke-width:3px
    linkStyle 5 stroke:#2e7d32,stroke-width:2px
    linkStyle 6 stroke:#2e7d32,stroke-width:2px
    linkStyle 7 stroke:#2e7d32,stroke-width:2px
    linkStyle 8 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 9 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 10 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 11 stroke:#94A3B8,stroke-width:1px
