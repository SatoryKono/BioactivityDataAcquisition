        N12["R_RUNNING"]
        N13["R_COMPLETED"]
        N14["R_FAILED"]
        N15["R_SHUTDOWN"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N6["RecordQuarantined"]
    end

    N1 --> N3
    N1 --> N4
    N1 --> N5
    N1 --> N6
    N1 --> N2
    N1 --> N7
    N8 --> N2
    N9 --> N10
    N11 --> N12
    N12 --> N13
    N12 --> N14
    N12 --> N15

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
