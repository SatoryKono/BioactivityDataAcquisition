%% View: Data-Flow | Parent: 30-port-adapter-mapping-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N1["P1"]
        N3["P2"]
        N5["P3"]
        N7["P4"]
        N9["P5"]
        N11["P6"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N2["A1"]
        N4["A2"]
        N6["A3"]
        N8["A4"]
        N10["A5"]
        N12["A6"]
    end

    N1 --> N2
    N3 --> N4
    N5 --> N6
    N7 --> N8
    N9 --> N10
    N11 --> N12

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    %% linkStyle: data 0-1, orch 2-2, DI 3-3, obs 4-4, err 5-5
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#2e7d32,stroke-width:2px
    linkStyle 3 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 4 stroke:#94A3B8,stroke-width:1px
    linkStyle 5 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
