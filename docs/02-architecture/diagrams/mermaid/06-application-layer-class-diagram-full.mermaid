    }

    %% Inheritance
    BaseChemblTransformer --|> BaseTransformer
    ActivityTransformer --|> BaseChemblTransformer
    MoleculeTransformer --|> BaseChemblTransformer
    AssayTransformer --|> BaseChemblTransformer
    TargetTransformer --|> BaseChemblTransformer

    %% Composition
    PipelineRunner --> BasePipeline
    PipelineRunner --> RunnerServices
    PipelineExecutor --> BasePipeline
    PipelineExecutor --> RecordProcessor
    RecordProcessor --> BatchTransformer
    RecordProcessor --> QuarantineManager
    RecordProcessor --> BatchMetricsRecorder
    BatchTransformer --> BaseTransformer

    BasePipeline --> PipelineServices
    RunnerServices --> LockManager
    RunnerServices --> PreflightService
    RunnerServices --> PostrunService
    RunnerServices --> LifecycleOrchestrator
    RunnerServices --> PipelineObserver
