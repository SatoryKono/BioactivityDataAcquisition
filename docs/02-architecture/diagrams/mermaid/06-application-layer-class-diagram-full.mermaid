%% Components: PipelineRunner, PipelineExecutor, RecordProcessor, BatchTransformer, LockManager, CheckpointManager

%% @version 1.0.0
%% @date    2026-02-24
%% @type    classDiagram
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform class width=208 height=240 max_title_len=21 max_desc_lines=13
classDiagram
    direction TB

    namespace Core {
        class BasePipeline {
            <<abstract>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            #config: PipelineConfig
            #runtime: RuntimeConfig
            #services: PipelineServices
            +create(config, runtime, services)$ BasePipeline
            +pipeline_name() str&nbsp;
            +provider() str&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            +run_id() RunID&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class PipelineRunner {
            -_pipeline: BasePipeline
            -_services: RunnerServices
            -_lock_key: str&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            +run() RunResult&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            -_acquire_lock() bool
            -_run_preflight() PreflightResult
            -_execute() ExecutionResult
            -_run_postrun() PostrunResult
            -_release_lock() None
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class PipelineExecutor {
            -_pipeline: BasePipeline
            -_processor: RecordProcessor
            -_batch_size: int = 100
            -_checkpoint_interval: int = 1000
            +execute() ExecutionResult
            -_fetch_and_process() AsyncIterator~BatchResult~
            -_adaptive_batch_size() int
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class RecordProcessor {
            -_transformer: BatchTransformer
            -_writer: BatchWriter
            -_quarantine: QuarantineManager
            -_metrics: BatchMetricsRecorder
            +process_batch(records) BatchResult
            +process_stream(records) AsyncIterator~BatchResult~
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class BatchTransformer {
            -_transformer: BaseTransformer
            -_logger: LoggerPort&nbsp;
            +transform_batch(records) TransformResult
            +transform_stream(records) AsyncIterator~TransformResult~
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class PipelineServices {
            <<frozen dataclass>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            +data_source: DataSourcePort
            +storage: StoragePort
            +lock: LockPort&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            +checkpoint: CheckpointPort
            +quarantine: QuarantinePort
            +metrics: MetricsPort
            +tracing: TracingPort
            +logger: LoggerPort&nbsp;&nbsp;
            +dq_monitor: DQMonitorPort?
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class RunnerServices {
            <<frozen dataclass>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            +lock_manager: LockManager
            +preflight: PreflightService
            +postrun: PostrunService
            +lifecycle_orch: LifecycleOrchestrator
            +observer: PipelineObserver
            +context_holder: LockContextHolder?
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }
    }

    namespace Services {
        class LockManager {
            -_lock: LockPort&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            -_logger: LoggerPort&nbsp;
            -_ttl: int = 90&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            -_heartbeat_interval: int = 30
            +acquire_lock(resource, owner_id) LockResult
            +release_lock(resource, owner_id) bool
            +refresh_lock(resource, owner_id) bool
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class CheckpointManager {
            -_checkpoint: CheckpointPort
            -_logger: LoggerPort&nbsp;
            +load_checkpoint(key) CheckpointState?
            +save_checkpoint(key, state) None
            +delete_checkpoint(key) None
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class QuarantineManager {
            -_quarantine: QuarantinePort
            -_logger: LoggerPort&nbsp;
            +quarantine_record(record, error) None
            +quarantine_batch(records, errors) int
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class PreflightService {
            -_data_source: DataSourcePort
            -_storage: StoragePort
            -_logger: LoggerPort&nbsp;
            +run_checks() PreflightResult
            -_check_data_source_health() HealthStatus
            -_check_storage_health() bool
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class PostrunService {
            -_storage: StoragePort
            -_metrics: MetricsPort
            -_logger: LoggerPort&nbsp;
            -_dq_config: DQConfig
            +run_checks(execution_metrics) PostrunResult
            -_check_dq_thresholds() DQCheckResult
            -_emit_dq_metrics() None
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class LifecycleOrchestrator {
            -_lifecycle_service: MedallionLifecycleService
            -_policy: MedallionPolicy
            -_logger: LoggerPort&nbsp;
            +clear_for_run(run_type, tables) ClearResult
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class PipelineObserver {
            -_tracer: TracingPort
            -_metrics: MetricsPort
            -_logger: LoggerPort&nbsp;
            +observe_batch(batch_id, records) Span
            +record_duration(stage, duration) None
            +record_error(error_type) None
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class MemoryMonitor {
            -_threshold_pct: float = 0.8
            -_monitor_interval_ms: int = 1000
            +get_memory_stats() MemoryStats
            +should_reduce_batch() bool
            -_get_stats_estimate() MemoryStats
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class BatchMetricsRecorder {
            -_metrics: MetricsPort
            +record_fetch(count, duration) None
            +record_transform(count, duration) None
            +record_write(count, duration, layer) None
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }
    }

    namespace Transformers {
        class BaseTransformer {
            <<abstract>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            #config: PipelineConfig
            #runtime: RuntimeConfig
            #logger: LoggerPort&nbsp;&nbsp;
            +transform(record: BronzeRecord) SilverRecord
            +transform_batch(records) list~SilverRecord~
            #_transform_impl(record)* SilverRecord
            #compute_content_hash(provider, data) ContentHash
            #serialize_json(value) str
            #entity_to_silver_record(entity) SilverRecord
            #_get_required_field(record, field) Any
            #_extract_nested(record, path) Any?
            #_create_entity(**kwargs) BaseEntity
        }

        class BaseChemblTransformer {
            <<abstract>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            #_normalize_chembl_id(id) str
            #_normalize_units(value, units) tuple
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
            &nbsp;
        }

        class ActivityTransformer {
            +entity: str = "activity"
            #_transform_impl(record) SilverRecord
