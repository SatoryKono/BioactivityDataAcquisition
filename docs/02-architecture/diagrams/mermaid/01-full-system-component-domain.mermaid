        N19["Publication&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N20["PipelineConfig&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["PipelineRunner&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N2["BatchTransformer&nbsp;&nbsp;&nbsp;"]
        N3["PipelineExecutor&nbsp;&nbsp;&nbsp;"]
        N4["RecordProcessor&nbsp;&nbsp;&nbsp;&nbsp;"]
        N5["PreflightService&nbsp;&nbsp;&nbsp;"]
        N6["PostrunService&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N7["ActivityTransformer"]
        N8["MoleculeTransformer"]
        N12["AssayTransformer&nbsp;&nbsp;&nbsp;"]
        N13["TargetTransformer&nbsp;&nbsp;"]
    end

    N1 --> N3
    N1 --> N5
    N1 --> N6
    N3 --> N4
    N4 --> N2
    N2 --> N7
    N2 --> N8
    N1 --> N9
    N1 --> N10
    N1 --> N11

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 1 stroke:#475569,stroke-width:2px,stroke-dasharray:5
