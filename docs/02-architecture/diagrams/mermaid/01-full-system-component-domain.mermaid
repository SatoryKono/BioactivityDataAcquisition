flowchart TB
%% keep-orphan: N12, N13, N14, N15, N16, N17, N18, N19, N20

    subgraph Domain["Domain Layer"]
        direction TB
        N9["DataSourcePort&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N10["StoragePort&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N11["LockPort&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
