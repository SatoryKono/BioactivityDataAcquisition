%% View: Data-Flow | Parent: 46-yaml-config-resolution-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N2["PIPELINE_CONFIG"]
        N8["TABLE_CONFIG"]
        N9["dq_config_file"]
        N12["override"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["PIPELINE"]
        N6["PIPELINE_YAML_CFG"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N3["SOURCE"]
        N4["SILVER_FILTER"]
        N5["GOLD_FILTER"]
        N7["SOURCE_YAML_CFG"]
        N10["br"]
        N11["YAML_LOADER"]
    end

    N11 --> N12
    N2 --> N8
    N1 --> N9
    N1 --> N10

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    linkStyle 0 stroke:#1E293B,stroke-width:4px
    linkStyle 1 stroke:#1E293B,stroke-width:4px
    linkStyle 2 stroke:#1E293B,stroke-width:4px
    linkStyle 3 stroke:#1E293B,stroke-width:4px
