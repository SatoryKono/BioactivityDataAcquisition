%% View: Data-Flow | Parent: 14-provider-health-states-full.mermaid
%% @uniform width=176 height=56 max_title_len=17 max_desc_lines=0
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N2["WatchingErrors&nbsp;&nbsp;&nbsp;"]
        N7["ErrorAccumulating"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N1["*&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N3["ProcessingRequest"]
        N4["HEALTHY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N5["DEGRADED&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N6["RequestSuccess&nbsp;&nbsp;&nbsp;"]
        N8["RecoveryProgress&nbsp;"]
        N9["UNHEALTHY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N10["WaitingForProbe&nbsp;&nbsp;"]
        N11["SendProbe&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        N12["NormalOperation&nbsp;&nbsp;"]
    end

    N1 --> N4
    N1 --> N12
    N1 --> N3
    N3 --> N6
    N6 --> N3
    N4 --> N5
    N1 --> N2
    N2 --> N7
    N2 --> N8
    N7 --> N2
    N8 --> N2
    N5 --> N4
    N5 --> N9
    N1 --> N10
    N10 --> N11
    N9 --> N5

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    linkStyle 0 stroke:#1E293B,stroke-width:4px
