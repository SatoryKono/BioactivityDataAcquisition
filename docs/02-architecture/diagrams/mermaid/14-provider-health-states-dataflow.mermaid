%% View: Data-Flow | Parent: 14-provider-health-states-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N2["WatchingErrors"]
        N7["ErrorAccumulating"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N1["*"]
        N3["ProcessingRequest"]
        N4["HEALTHY"]
        N5["DEGRADED"]
        N6["RequestSuccess"]
        N8["RecoveryProgress"]
        N9["UNHEALTHY"]
        N10["WaitingForProbe"]
        N11["SendProbe"]
        N12["NormalOperation"]
    end

    N1 --> N4
    N1 --> N12
    N1 --> N3
    N3 --> N6
    N6 --> N3
    N4 --> N5
    N1 --> N2
    N2 --> N7
    N2 --> N8
    N7 --> N2
    N8 --> N2
    N5 --> N4
    N5 --> N9
    N1 --> N10
    N10 --> N11
    N9 --> N5

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    %% linkStyle: data 1-4,13-14, obs 0,5,11-12,15, err 6-10
    linkStyle 0 stroke:#94A3B8,stroke-width:1px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#1E293B,stroke-width:3px
    linkStyle 5 stroke:#94A3B8,stroke-width:1px
    linkStyle 6 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 7 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 8 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 9 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 10 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 11 stroke:#94A3B8,stroke-width:1px
    linkStyle 12 stroke:#94A3B8,stroke-width:1px
    linkStyle 13 stroke:#1E293B,stroke-width:3px
    linkStyle 14 stroke:#1E293B,stroke-width:3px
    linkStyle 15 stroke:#94A3B8,stroke-width:1px
