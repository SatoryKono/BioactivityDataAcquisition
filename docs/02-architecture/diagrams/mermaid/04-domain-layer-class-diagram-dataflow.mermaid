%% View: Data-Flow | Parent: 04-domain-layer-class-diagram-full.mermaid
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N1["PipelineConfig"]
        N2["DataSourcePort"]
        N3["FilterableDataSourcePort"]
        N6["QuarantinePort"]
        N7["TableConfig"]
        N8["DQConfig"]
        N9["BaseEntity"]
        N10["PublicationEntityBase"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N4["SilverWriteMode"]
        N5["GoldWriteMode"]
        N11["Activity"]
        N12["Molecule"]
    end

    N9 --> N11
    N9 --> N12
    N9 --> N10
    N3 --> N2
    N1 --> N7
    N1 --> N8
    N7 --> N4
    N7 --> N5

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    %% linkStyle: data 0-2, orch 3-4, DI 5-6, obs 7-7, err 8-7
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#2e7d32,stroke-width:2px
    linkStyle 4 stroke:#2e7d32,stroke-width:2px
    linkStyle 5 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 6 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 7 stroke:#94A3B8,stroke-width:1px
