%% View: Overview | Parent: quality-runtime-views
%% @uniform width=192 height=88 max_title_len=18 max_desc_lines=1
flowchart TB
    subgraph Anchors["Shared runtime anchors"]
        RUN["run_id"]
        MAN["manifest_id"]
        CFG["effective_config_hash"]
        FPR["execution_fingerprint"]
        DAT["dataset_ref"]
    end

    TRACE["Traceability"] ==> MAN
    TRACE -.-> DAT
    IDEMP["Idempotency"] ==> RUN
    IDEMP -.-> CFG
    OBS["Observability"] ==> RUN
    OBS -.-> MAN
    REPRO["Reproducibility"] ==> CFG
    REPRO -.-> FPR

    classDef quality fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    classDef anchor fill:#f1f5f9,stroke:#64748b,stroke-width:1.8px;
    class TRACE,IDEMP,OBS,REPRO quality;
    class RUN,MAN,CFG,FPR,DAT anchor;
