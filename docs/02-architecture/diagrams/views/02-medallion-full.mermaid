%% View: Full | Parent: (root)
%% Parent source: docs/02-architecture/diagrams/foundation/02-full-medallion-data-flow.mmd
%% Full reference diagram retained after decomposition.
%% Title: Medallion Architecture Layers
%% Covers: RULES.md §2.1 (Bronze/Silver/Gold), §2.3 (Quarantine)
%% Updated: 2026-07-31
%% Components: BronzeWriter, SilverWriter, GoldWriter, QuarantineManager
%% Legend: see 00-legend.mermaid

%% @version 1.0.0
%% @date    2026-07-31
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
%% @uniform width=224 height=56 max_title_len=23 max_desc_lines=1
flowchart LR
    subgraph Sources["External Sources"]
        ChEMBL["ChEMBL API"]
        PubChem["PubChem API"]
        UniProt["UniProt API"]
        PubMed["PubMed API"]
        CrossRef["CrossRef API"]
        OpenAlex["OpenAlex API"]
        S2["Semantic Scholar API"]
    end

    subgraph Bronze_Layer["Bronze Layer"]
        direction TB
        BronzeWriter["BronzeWriter"]
        Bronze[("Bronze Storage<br/>JSONL + zstd<br/>retention: 90d<br/>path: bronze/v1/{provider}/{entity}/{date}")]
    end

    subgraph Silver_Layer["Silver Layer"]
        direction TB
        SilverWriter["SilverWriter"]
        Silver[("Silver Storage<br/>Delta Lake<br/>validation: Pandera soft<br/>merge/upsert by content_hash")]
    end

    subgraph Gold_Layer["Gold Layer"]
        direction TB
        GoldWriter["GoldWriter"]
        Gold[("Gold Storage<br/>Delta/Parquet<br/>validation: Pandera strict<br/>strategy: SCD2/append")]
    end

    subgraph DQ_Branch["Data Quality Branch"]
        DQValidator["DQ Validator<br/>━━━━━━━━━━━━━━━<br/>⚠️ Soft: >5% errors<br/>❌ Hard: >20% errors"]
    end

    subgraph Lineage["Lineage Tracking"]
    end

    %% Main flow
    ChEMBL --> BronzeWriter
    PubChem --> BronzeWriter
    UniProt --> BronzeWriter
    PubMed --> BronzeWriter
    CrossRef --> BronzeWriter
    OpenAlex --> BronzeWriter
    S2 --> BronzeWriter

    BronzeWriter --> Bronze
    Bronze --> SilverWriter

    SilverWriter --> DQValidator
    DQValidator -->|"✅ Pass"| Silver
    DQValidator -->|"❌ Fail"| Quarantine

    Silver --> GoldWriter
    GoldWriter --> Gold

    %% Lineage tracking
    Bronze -.->|"batch_id"| LineageLog
    Silver -.->|"version"| LineageLog

    %% Styling
    style Bronze fill:#fff7ed,stroke:#f59e0b,color:#212121
    style Silver fill:#f1f5f9,stroke:#475569,color:#212121
    style Gold fill:#fefce8,stroke:#ca8a04,color:#212121
    style Quarantine fill:#ffe4e6,stroke:#dc2626,color:#212121
    style LineageLog fill:#eff6ff,stroke:#2563eb,color:#212121
