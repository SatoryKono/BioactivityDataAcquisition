%% View: Data-Flow | Parent: 46-yaml-config-resolution-full.mermaid
%% @uniform width=176 height=56 max_title_len=17 max_desc_lines=1
flowchart LR
    YAML["base/provider/entity YAML"] --> YLOAD["YAML loader"]
    SOURCE["source config"] --> YLOAD
    YLOAD --> NORM["normalize payload"]
    NORM --> PIPEVAL["PipelineYamlConfig"]
    PIPEVAL --> PIPECFG["PipelineConfig"]
    PIPECFG --> TABLE["TableConfig"]

    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1.8px;
    classDef infra fill:#fff1f2,stroke:#dc2626,stroke-width:1.8px;
    classDef process fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.8px;
    class YAML,SOURCE storage;
    class YLOAD infra;
    class NORM,PIPEVAL process;
    class PIPECFG,TABLE port;
