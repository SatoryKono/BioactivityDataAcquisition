%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
mindmap
    root((BioETL<br/>Architecture))
        Hexagonal Architecture
            24 Domain Ports
                DataSourcePort
                BronzeStoragePort / SilverStoragePort / GoldStoragePort / MergedStoragePort
                LockPort
                MetricsPort
                LoggerPort
                TracingPort
            Infrastructure Adapters
                7 Provider Adapters
                Storage Writers
                MemoryLock
                PrometheusMetrics
            Structural Subtyping
                Protocol classes
                No explicit inheritance
                runtime_checkable
        Five-Layer Architecture
            Interfaces
                CLI Click
                HealthServer
            Composition
                Factories DI
                Bootstrap
                PipelineRegistry
            Application
                PipelineRunner
                BatchExecutor
                23 Transformers
            Domain
                Ports
                Entities
                Aggregates
                Schemas
            Infrastructure
                HTTP Adapters
                Storage
                Observability
        Medallion Architecture
            Bronze
                JSONL plus zstd
                Append only
                90 days retention
            Silver
                Delta Lake
                Merge Upsert
                Permanent
            Gold
                Delta Parquet
                SCD Type 2
                Strict validation
        DDD Aggregates
            PipelineRun
                States: PENDING RUNNING COMPLETED FAILED
                Domain Events
            Batch
                States: OPEN SEALED WRITING COMMITTED
            QuarantineEntry
                States: NEW UNDER_REVIEW IGNORED REPROCESSED EXPIRED
        Composition Root
            GenericPipelineFactory
            RunnerFactory
            ServicesBuilder
            Constructor Injection
            No Service Locator
        Local Only Deployment
            MemoryLock in-process
            Local File System
            Local Checkpoints
            ADR-010
        Resilience Patterns
            Circuit Breaker 5 failures
            Token Bucket rate limiting
            Exponential Backoff
            Deterministic Jitter MD5
        Data Quality
            Pandera Schemas
            5 percent soft threshold
            20 percent hard threshold
            Quarantine routing
