%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)
%% @uniform width=240 height=126 max_title_len=25 max_desc_lines=5
%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
