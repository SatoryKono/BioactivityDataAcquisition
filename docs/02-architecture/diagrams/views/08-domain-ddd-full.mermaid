flowchart TB
%% keep-orphan: BronzeStoragePort, SilverStoragePort, GoldStoragePort, MergedStoragePort, StorageLifecyclePort, CheckpointPort, CriticalError, DataQualityError, DataSourcePort, HealthStatus, InvalidStateError, LockPort, Measurement, MetricsPort, QuarantinePort, RecoverableError, RunType, TracingPort
    subgraph domain["Domain Layer (DDD)"]
        subgraph ports["ports/"]
            DataSourcePort
            BronzeStoragePort
            SilverStoragePort
            GoldStoragePort
            MergedStoragePort
            StorageLifecyclePort
            LockPort
            CheckpointPort
            QuarantinePort
            MetricsPort
            TracingPort
        end

        subgraph aggregates["aggregates/"]
            Batch["Batch Aggregate<br/>add_record(), quarantine_record()<br/>seal(), mark_committed()"]

            PipelineRun["PipelineRun Aggregate<br/>start(), record_stage_success()<br/>complete(), fail()"]

            QuarantineEntry["QuarantineEntry Aggregate<br/>mark_retrying(), mark_recovered()<br/>mark_dead_letter()"]
        end

        subgraph events["Domain Events"]
            BatchCreated
            BatchSealed
            BatchWritten
            RunStarted
            RunCompleted
            RecordQuarantined
        end

        subgraph value_objects["value_objects/"]
            RunID["RunID (UUID)<br/><br/><br/><br/>"]
            BatchID["BatchID (UUID)<br/><br/><br/><br/>"]
            EntityID["EntityID (str)<br/><br/><br/><br/>"]
            ContentHash["ContentHash (str)<br/><br/><br/><br/>"]
            Measurement["Measurement<br/>(value, unit, relation)<br/><br/><br/>"]
        end

        subgraph types["types.py"]
            RunType["RunType Enum<br/>(INCREMENTAL, BACKFILL, REBUILD)<br/><br/><br/>"]
            HealthStatus["HealthStatus Enum<br/>(HEALTHY, DEGRADED, UNHEALTHY)<br/><br/><br/>"]
        end

        subgraph exceptions["exceptions/"]
            CriticalError
            RecoverableError
            DataQualityError
            InvalidStateError
        end
    end

    %% Relationships
    Batch --> BatchCreated
    Batch --> BatchSealed
    Batch --> BatchWritten
    Batch --> RecordQuarantined
    PipelineRun --> RunStarted
    PipelineRun --> RunCompleted

    Batch --> RunID
    Batch --> BatchID
    PipelineRun --> RunID
    QuarantineEntry --> EntityID
    QuarantineEntry --> ContentHash

    %% State machines
    subgraph batch_states["Batch State Machine"]
        B_OPEN["OPEN"] --> B_SEALED["SEALED"]
        B_SEALED --> B_WRITING["WRITING"]
        B_WRITING --> B_COMMITTED["COMMITTED"]
        B_WRITING --> B_FAILED["FAILED"]
    end

    subgraph run_states["PipelineRun State Machine"]
        R_PENDING["PENDING"] --> R_RUNNING["RUNNING"]
        R_RUNNING --> R_COMPLETED["COMPLETED"]
        R_RUNNING --> R_FAILED["FAILED"]
        R_RUNNING --> R_SHUTDOWN["SHUTDOWN"]
    end

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle 0 stroke:#1E293B,stroke-width:4px
    linkStyle 1 stroke:#1E293B,stroke-width:4px
