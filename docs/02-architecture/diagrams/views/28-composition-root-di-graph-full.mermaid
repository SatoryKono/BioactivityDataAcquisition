%% @nodes   23
%% keep-orphan: ENTRY
%% @uniform-group interfaces nodes=CLI
%% @uniform-group public     nodes=EXEC,CTRL,HEALTH,MAINT,RES,CAPI,ENTRY
%% @uniform-group assembly   nodes=BPR,BSRV,GPF,FMH,CSUP,CWIR,DSF,STF,REG,PRI,CPB,LCOL
%% @uniform-group runtime    nodes=PRS,PRUN,PS,ADP,STOR,ISVC,CPART
%% @uniform-width group
%%{init: {'layout': 'elk', 'flowchart': {'subGraphTitleMargin': {'top': 12, 'bottom': 12}}, 'elk': {'mergeEdges': true, 'nodePlacementStrategy': 'BRANDES_KOEPF', 'edgeRouting': 'ORTHOGONAL'}}}%%
flowchart TB
    subgraph Interfaces["Interfaces"]
        CLI["CLI / interfaces layer"]
    end

    subgraph PublicAPIs["Public composition APIs"]
        EXEC["execution_api<br/>runner creation + metrics flush"]
        CTRL["control_plane_api<br/>inspection + admin accessors"]
        HEALTH["health_api<br/>health + quarantine accessors"]
        MAINT["maintenance_api<br/>maintenance accessors"]
        RES["resources_api<br/>cleanup / checkpoint / archive helpers"]
        CAPI["creation_api<br/>compat shim → creation_support"]
        ENTRY["entrypoints.py<br/>retained broad facade"]
    end

    subgraph Assembly["Composition assembly"]
        BPR["bootstrap_pipeline_runner()"]
        BSRV["bootstrap_pipeline_runner_service()"]
        GPF["GenericPipelineFactory<br/>create_runner + create_with_services"]
        FMH["factory_method_helpers<br/>+ _PipelineFactoryContext"]
        PRI["prepare_runner_inputs()"]
        CPB["control_plane builders<br/>run_manifest_builder + control_plane"]
        LCOL["ledger_collaborator<br/>attach_control_plane_collaborators"]
        CSUP["creation_support<br/>public creation seam"]
        CWIR["_creation_wiring<br/>pipeline creation internals"]
        DSF["DataSourceFactory"]
        STF["StorageFactory"]
        REG["ProviderRegistry"]
    end

    subgraph Runtime["Created runtime objects"]
        PRS["PipelineRunnerService"]
        PRUN["PipelineRunner"]
        PS["PipelineService"]
        ISVC["Inspection services<br/>run-manifest + lineage"]
        CPART["Control-plane artifacts<br/>manifest + ledger refs + config hashes"]
        ADP["Provider adapter"]
        STOR["Bronze / Silver / Gold writers"]
    end

    CLI --> CTRL
    CLI --> HEALTH
    CLI --> MAINT
    CLI --> EXEC
    CLI -. cleanup and lifecycle commands .-> RES

    ENTRY -. retained public re-export .-> EXEC
    ENTRY -. retained public re-export .-> CTRL
    ENTRY -. retained public re-export .-> HEALTH
    ENTRY -. retained public re-export .-> MAINT
    ENTRY -. retained public re-export .-> RES
    ENTRY -. retained public re-export .-> CAPI

    EXEC ==> BPR
    CTRL ==> BSRV
    HEALTH ==> BSRV
    MAINT ==> BSRV
    CAPI --> CSUP
    RES --> STF

    BPR --> GPF
    BSRV --> GPF
    GPF --> FMH
    FMH --> PRI
    PRI --> CPB
    FMH --> DSF
    FMH --> STF
    FMH --> CSUP
    CSUP --> CWIR
    CWIR --> PS
    DSF --> REG
    DSF --> ADP
    STF --> STOR
    FMH --> PRUN
    CPB --> CPART
    CPB --> PRUN
    LCOL --> PRUN
    BSRV --> PRS
    PRS --> PS
    PRUN --> PS
    PRUN --> ADP
    CTRL --> ISVC

    style Interfaces fill:#eff6ff,stroke:#2563eb
    style PublicAPIs fill:#fff7ed,stroke:#f59e0b
    style Assembly fill:#ffe4e6,stroke:#dc2626
    style Runtime fill:#f0fdf4,stroke:#16a34a

    classDef layer_interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef layer_composition fill:#fff7ed,stroke:#f59e0b,stroke-width:1.8px;
    classDef layer_application fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    classDef layer_infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:1.8px;

    class CLI layer_interfaces;
    class EXEC,SERV,RES,CAPI,ENTRY,BPR,BSRV,GPF,FMH,PRI,CPB,LCOL,CSUP,CWIR,DSF,STF,REG layer_composition;
    class PRS,PRUN,PS,ISVC,CPART layer_application;
    class ADP,STOR layer_infrastructure;
