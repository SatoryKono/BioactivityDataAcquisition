%% Title: Composition Root Wiring — Full DI Graph
%% Covers: RULES.md §1.1 (Composition Layer), ADR-005
%% Rank: 3 (Score 9.00) — Complete dependency injection assembly
%% Updated: 2026-03-24

%% @version 1.2.0
%% @date    2026-03-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)
%% @uniform-group entry     nodes=CLI,BOOT
%% @uniform-group factories nodes=BL,OB,HCF,DSF,STF,GPF,FMH,CAP,CSUP,CWIR
%% @uniform-group registry  nodes=PR
%% @uniform-group created   nodes=UHC,ADP,STOR,PS,PRS,RUN
%% @uniform-width group

%% @uniform width=296 groups=4 width_strategy=group
%% @uniform-stats entry        width=296 height=144 max_desc_lines=6
%% @uniform-stats factories    width=224 height=144 max_desc_lines=6
%% @uniform-stats registry     width=200 height=144 max_desc_lines=6
%% @uniform-stats created      width=176 height=144 max_desc_lines=6
%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
flowchart TB
    subgraph Entry["Entry Point"]
        CLI["CLI run command<br/><br/>"]
        BOOT["bootstrap/runtime/assembly.py<br/><br/>"]
    end

    subgraph Factories["Composition Factories"]
        direction LR

        subgraph LoggerFactories["Logger & Observability"]
            BL["BootstrapLogger<br/>• configure structlog<br/><br/>"]
            OB["ObservabilityBundle<br/>• logger + metrics + tracing<br/><br/>"]
        end

        subgraph ClientFactories["Client & Data Source"]
            HCF["HttpClientFactory<br/>• create(provider)<br/>→ UnifiedHTTPClient<br/><br/>"]
            DSF["DataSourceFactory<br/>• create(provider, config)<br/>→ DataSourcePort impl<br/><br/>"]
        end

        subgraph StorageFactories["Storage"]
            STF["StorageFactory<br/>• create(config)<br/>→ Bronze/Silver/Gold writers<br/>"]
        end

        subgraph PipelineFactories["Pipeline Construction"]
            GPF["GenericPipelineFactory<br/>• create_runner + create_with_services<br/>"]
            FMH["factory_method_helpers<br/>• build_factory_services()<br/>• create_factory_runner()"]
            CAP["creation_api<br/>compat shim<br/><br/>"]
            CSUP["creation_support<br/>public creation seam<br/><br/>"]
            CWIR["_creation_wiring<br/>pipeline creation internals<br/><br/>"]
        end
    end

    subgraph Registry["Registration"]
        PR["ProviderRegistry<br/>• 8 providers registered<br/><br/>"]
    end

    subgraph Created["Created Instances"]
        direction TB
        subgraph RuntimeInfra["Infra Instances"]
            direction TB
            UHC["[A] UnifiedHTTPClient<br/>+ TokenBucket<br/>+ CircuitBreaker<br/><br/>"]
            ADP["[A] Provider Adapter<br/>(ChemblAdapter, etc.)<br/><br/>"]
            STOR["Bronze / Silver / Gold writers<br/><br/>"]
        end
        subgraph RuntimeCore["Application Instances"]
            direction TB
            PS["PipelineService<br/>(frozen bundle)<br/><br/>"]
            PRS["PipelineRunnerService<br/><br/>"]
            RUN["PipelineRunner<br/>(fully assembled)<br/><br/>"]
        end
    end

    %% Bootstrap flow
    CLI ==> BOOT
    BOOT -.-> BL
    BL --> OB
    BOOT -.-> HCF
    HCF --> UHC
    BOOT -.-> DSF
    DSF -.->|"uses"| PR
    DSF -.->|"uses"| UHC
    DSF --> ADP
    BOOT -.-> STF
    STF --> STOR
    BOOT ==> GPF
    GPF --> FMH
    CAP -. compat .-> CSUP
    FMH --> CSUP
    CSUP --> CWIR
    FMH --> DSF
    FMH --> STF
    CWIR --> PS
    GPF --> PRS
    FMH ==> RUN
    RUN --> PS
    RUN --> ADP
    PRS --> PS
    OB -.-> RUN

    %% Layout constraints
    CLI ~~~ BOOT
    PR ~~~ OB
    UHC ~~~ ADP ~~~ STOR ~~~ PS ~~~ PRS ~~~ RUN

    %% Styling
    style Entry fill:#f5f3ff,stroke:#7c3aed
    style Factories fill:#ffe4e6,stroke:#dc2626
    style Registry fill:#fff7ed,stroke:#f59e0b
    style Created fill:#f0fdf4,stroke:#16a34a

    style LoggerFactories fill:#fefce8,stroke:#ca8a04,stroke-dasharray: 5 5
    style ClientFactories fill:#eff6ff,stroke:#2563eb,stroke-dasharray: 5 5
    style StorageFactories fill:#f5f3ff,stroke:#7c3aed,stroke-dasharray: 5 5
    style PipelineFactories fill:#fff7ed,stroke:#f59e0b,stroke-dasharray: 5 5

    %% Layer palette (semantic)
    classDef layer_domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.8px;
    classDef layer_application fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    classDef layer_infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:1.8px;
    classDef layer_composition fill:#fff7ed,stroke:#f59e0b,stroke-width:1.8px;
    classDef layer_interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef service fill:#f0fdf4,stroke:#16a34a,stroke-width:1.6px;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1.4px,stroke-dasharray:3 2;

    class CLI layer_interfaces;
    class BOOT,BL,OB,HCF,DSF,STF,GPF,FMH,CAP,CSUP,CWIR,PR layer_composition;
    class PS,PRS,RUN layer_application;
    class UHC,ADP,STOR layer_infrastructure;

    %% Click tooltips
    click FMH "../../02-architecture/decisions/ADR-005-composition-layer-separation.md" "Assembler helpers coordinate storage, data source, and runner creation seams"
    click DSF "../../00-project/RULES.md" "Resolves provider registry and shared HTTP client"
    click CSUP "../../00-project/RULES.md" "Sanctioned support seam for pipeline creation wiring"
