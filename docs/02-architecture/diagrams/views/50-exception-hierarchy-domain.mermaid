%% View: Domain-Focus | Parent: 50-exception-hierarchy-full.mermaid
%% @uniform width=168 height=56 max_title_len=16 max_desc_lines=0
flowchart TB
%% keep-orphan: N13

    subgraph Domain["Domain Layer"]
        direction TB
        N2["DQ_ERROR"]
        N3["POLICY_VIOLATION"]
        N4["METRICS_ERROR"]
        N5["port"]
        N7["INFRA_ERROR"]
        N8["last_error"]
        N9["API_ERROR"]
        N10["record_id"]
        N11["entity_type"]
        N12["DQ_THRESHOLD"]
        N13["ERROR_TYPE"]
        N14["CRITICAL"]
        N15["RECOVERABLE"]
        N17["VALIDATION"]
        N18["BIOETL"]
        N19["status_code"]
        N20["operation"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["EXT_SERVICE"]
        N6["RUNNER_EXECUTED"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N16["STORAGE_ERR"]
    end

    N18 --> N14
    N18 --> N15
    N18 --> N2
    N14 --> N3
    N14 --> N19
    N14 --> N4
    N14 --> N5
    N14 --> N6
    N14 --> N7
    N14 --> N20
    N15 --> N19
    N15 --> N8
    N15 --> N9
    N15 --> N1
    N15 --> N20
    N1 --> N19
    N15 --> N16
    N2 --> N17
    N2 --> N10
    N17 --> N11
    N18 --> N12

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px

    %% linkStyle: data 16 | di 0-6,8-12,14-15,17-20 | generic 7,13

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle 0,1,2,3,4,5,6,8,9,10,11,12,14,15,17,18,19,20 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 7,13 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 16 stroke:#1E293B,stroke-width:2px
