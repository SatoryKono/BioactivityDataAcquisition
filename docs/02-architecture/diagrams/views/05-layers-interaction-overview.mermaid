%% View: Overview | Parent: 05-layers-interaction-full.mermaid
%% @uniform width=168 height=56 max_title_len=16 max_desc_lines=0
flowchart TB
    subgraph Interfaces["Interfaces"]
        CLI["CLI"]
        RunService["RunnerService"]
    end

    subgraph Composition["Composition"]
        Builder["build_pipeline_runner"]
        Factory["GenericPipelineFactory"]
    end

    subgraph Application["Application"]
        Runner["PipelineRunner"]
        Processing["BatchProcessingService"]
        Composite["CompositeRunner"]
    end

    subgraph Domain["Domain"]
        Ports["Ports"]
        Models["Models / Types"]
    end

    subgraph Infrastructure["Infrastructure"]
        Adapters["Adapters"]
        Storage["Storage"]
    end

    CLI --> RunService --> Builder --> Factory --> Runner --> Processing
    Composite -.->|"delegates"| Runner
    Runner --> Ports
    Processing --> Models
    Adapters -.->|"implements"| Ports
    Storage -.->|"implements"| Ports

    style Interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style Composition fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px
