flowchart TB
    PIPEVAL["PipelineYamlConfig"] --> PIPECFG["PipelineConfig"]
    PIPECFG --> TABLE["TableConfig"]
    DQFILE["DQConfigFile"] --> DQCFG["DQConfig"]
    FFILE["FilterConfigFile"] --> IFCFG["InputFilterConfig"]
    FFILE --> SILVER["SilverFilterConfig"]
    FFILE --> GOLD["GoldFilterConfig"]

    classDef process fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.8px;
    class PIPEVAL,DQFILE,FFILE process;
    class PIPECFG,TABLE,DQCFG,IFCFG,SILVER,GOLD port;
