%% View: Infrastructure-Mapping | Parent: 06-application-layer-class-diagram-full.mermaid
%% @uniform width=232 height=72 max_title_len=24 max_desc_lines=1
flowchart TB
    subgraph Orchestration["Runner Orchestration"]
        direction TB
        PR["PipelineRunner"]
        RD["RunnerDependencies"]
        PS["PipelineService"]
    end

    subgraph Collaborators["Lifecycle / Support Services"]
        direction TB
        LK["LockRuntimeService"]
        CM["CheckpointRuntimeService"]
        PF["PreflightService"]
        PO["PostrunService"]
        ML["MedallionLifecycleService"]
        OB["PipelineObserver"]
    end

    subgraph Processing["Execution Support"]
        direction TB
        BE["BatchExecutor"]
        BTM["BatchTracingManagerService"]
        BMR["BatchMetricsRecorderService"]
    end

    PR ==> RD
    PR --> PS
    RD --> LK
    RD --> CM
    RD --> PF
    RD --> PO
    RD --> ML
    RD -.-> OB
    RD --> BE
    BE -.-> BTM
    BE -.-> BMR

    style Orchestration fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Collaborators fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style Processing fill:#eff6ff,stroke:#2563eb,stroke-width:2px

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle default stroke:#1E293B,stroke-width:4px
