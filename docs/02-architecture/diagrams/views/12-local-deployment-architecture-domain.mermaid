flowchart TB
    SCHEDULE["Local scheduler"] --> CLI["CLI / manual run"]
    CLI --> ACT["chembl_activity"]
    CLI --> ASSAY["chembl_assay"]
    CLI --> TARGET["chembl_target"]
    CLI --> MOL["chembl_molecule"]
    CLI --> PC["pubchem_compound"]
    CLI --> UNI["uniprot_protein"]

    classDef iface fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    class SCHEDULE,CLI iface;
    class ACT,ASSAY,TARGET,MOL,PC,UNI app;
