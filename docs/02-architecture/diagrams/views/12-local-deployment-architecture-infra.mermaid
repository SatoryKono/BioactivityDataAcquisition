%% View: Infrastructure-Mapping | Parent: 12-local-deployment-architecture-full.mermaid
%% @uniform width=168 height=56 max_title_len=16 max_desc_lines=1
flowchart TB
    WORKERS["Local workers"] -.-> LOCK["MemoryLock"]
    WORKERS --> DATA["bronze / silver / gold"]
    WORKERS --> AUX["quarantine / checkpoints / lineage"]
    WORKERS --> OBS["logs / metrics"]
    NOTE["No cross-process coordination;<br/>lock is in-process only."] -.-> LOCK

    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    classDef infra fill:#fff1f2,stroke:#dc2626,stroke-width:1.8px;
    class WORKERS app;
    class LOCK,DATA,AUX,OBS,NOTE infra;
