flowchart TB
    BASE["base + provider + entity YAML"] --> YAML["YAML loader"]
    SOURCE["provider source config"] --> YAML
    YAML --> NORM["normalize_pipeline_config_payload<br/>compat new + legacy shapes"]
    NORM --> PIPEVAL["PipelineYamlConfig"]
    PIPEVAL --> PIPECFG["PipelineConfig"]
    PIPECFG --> TABLE["TableConfig"]

    DQ["DQ hierarchy<br/>base + provider + entity + inline"] --> DQLOAD["DQConfigLoader"] --> DQFILE["DQConfigFile"]
    FILTERS["Filter hierarchy<br/>base + provider + entity + inline"] --> FLOAD["FilterConfigLoader"] --> FFILE["FilterConfigFile"]
    DQFILE --> DQCFG["DQConfig"]
    FFILE --> IFCFG["Input / Silver / Gold filters"]
    SOURCE -.->|"legacy-flat source payload still accepted"| SRCVAL["SourceYamlConfig"]
