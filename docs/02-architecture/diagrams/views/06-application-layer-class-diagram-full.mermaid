%% View: Full | Parent: (root)
%% Parent source: docs/02-architecture/diagrams/foundation/06-application-layer-class-diagram.mmd
%% Full reference diagram retained after decomposition.
%% Title: Application Layer Class Diagram
%% Covers: RULES.md §1.1 (Application Layer), application/core/, application/services/, application/observability/
%% Updated: 2026-03-24
%% Components: BasePipeline, PipelineRunner, BatchExecutor, BatchProcessingService, PipelineService, lifecycle/postrun collaborators

%% @version 1.1.0
%% @date    2026-03-24
%% @type    classDiagram
%% @level   Component / Class

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform class width=208 height=220 max_title_len=21 max_desc_lines=12
classDiagram
    direction TB

    namespace Core {
        class BasePipeline {
            <<abstract>>
            #_config
            #_runtime
            #_services
            #_context
            #_transformer
            +create(...)
            +transform_bronze_to_silver(...)
        }

        class PipelineRunner {
            -_pipeline
            -_services
            -_executor
            -_checkpoint_manager
            -_lock_manager
            -_preflight_service
            -_postrun_service
            -_lifecycle_service
            -_observer
            +run()
            +execution_metrics()
        }

        class PipelineRunnerDependencies {
            <<frozen dataclass>>
            +executor
            +checkpoint_manager
            +lock_manager
            +preflight
            +postrun
            +lifecycle_service
            +observer
        }

        class BatchExecutor {
            -_services
            -_context
            -_config
            -_processing_port
            -_execution_state_service
            +execute(...)
            +process(...)
            +get_run_statistics()
        }

        class BatchProcessingService {
            -_services
            -_support
            -_transformer
            -_writer
            -_tracing
            +extract_records(...)
            +process_batch(...)
        }

        class BatchTransformer {
            -_transform
            -_quarantine_manager
            -_batch_metrics
            +transform_batch(...)
            +transform_single(...)
        }

        class BatchWriter {
            -_storage
            -_gold_validator
            -_batch_metrics
            +write_bronze(...)
            +write_silver(...)
            +write_gold(...)
        }

        class PipelineService {
            <<frozen dataclass>>
            +data_source
            +storage
            +lock
            +checkpoint
            +quarantine
            +metrics
            +tracing
            +logger
            +dq_monitor
            +metadata_coordinator
            +dq_report_service
            +aclose()
        }
    }

    namespace Services {
        class LockRuntimeService {
            -_lock
            -_run_id
            -_config
            -_heartbeat
            +acquire()
            +start_heartbeat()
            +validate()
            +release()
        }

        class CheckpointRuntimeService {
            -_checkpoint
            -_pipeline_name
            -_run_id
            +load_checkpoint()
            +save_checkpoint(...)
            +delete_checkpoint()
        }

        class PreflightService {
            -_health_aggregator
            -_medallion_validator
            +validate_infrastructure(...)
            +validate_preflight(...)
        }

        class PostrunService {
            -_dq_service
            -_lifecycle_service
            +run(...)
            +run_dq_checks(...)
            +run_vacuum_if_enabled()
            +cleanup(...)
        }

        class MedallionLifecycleService {
            +prepare_for_run(...)
            +finalize_run(...)
            +clear(...)
        }

        class PipelineObserver {
            -_metrics
            -_logger
            -_tracer
            +emit_phase_started(...)
            +emit_phase_completed(...)
        }

        class BatchMetricsRecorderService {
            -_metrics
            +track_batch_size(...)
            +track_processed_records(...)
            +track_error(...)
        }

        class BatchTracingManagerService {
            -_tracer
            -_context
            +start_execution_span()
            +start_batch_span(...)
            +end_span(...)
        }

        class QuarantineRuntimeService {
            -_quarantine
            -_pipeline_name
            +quarantine_record(...)
            +quarantine_records(...)
        }
    }

    namespace Transformers {
        class BaseTransformer {
            <<abstract>>
            +transform(...)
            +transform_batch(...)
        }
    }

    PipelineRunner --> BasePipeline
    PipelineRunner --> PipelineService
    PipelineRunner --> PipelineRunnerDependencies
    PipelineRunnerDependencies --> BatchExecutor
    PipelineRunnerDependencies --> CheckpointRuntimeService
    PipelineRunnerDependencies --> LockRuntimeService
    PipelineRunnerDependencies --> PreflightService
    PipelineRunnerDependencies --> PostrunService
    PipelineRunnerDependencies --> MedallionLifecycleService
    PipelineRunnerDependencies ..> PipelineObserver

    BasePipeline --> PipelineService
    BasePipeline ..> BaseTransformer
    BatchExecutor --> BatchProcessingService : processing_port impl
    BatchProcessingService --> PipelineService
    BatchProcessingService --> BatchTransformer
    BatchProcessingService --> BatchWriter
    BatchProcessingService ..> BatchTracingManagerService
    BatchProcessingService ..> BatchMetricsRecorderService
    BatchTransformer --> BaseTransformer
    BatchTransformer --> QuarantineRuntimeService
    BatchWriter ..> BatchMetricsRecorderService
