%% Title: Application Layer Class Diagram
%% Covers: RULES.md §1.1 (Application Layer), application/core/, application/services/, application/observability/
%% Updated: 2026-09-03
%% Components: BasePipeline, PipelineRunner, BatchExecutor, BatchProcessingService, PipelineService, runner orchestration services, control-plane and inspection services

%% @version 1.2.0
%% @date    2026-09-03
%% @type    classDiagram
%% @level   Component / Class
%% @nodes   25
%%{init: {'layout': 'elk', 'flowchart': {'subGraphTitleMargin': {'top': 12, 'bottom': 12}}, 'elk': {'mergeEdges': true, 'nodePlacementStrategy': 'BRANDES_KOEPF', 'edgeRouting': 'ORTHOGONAL'}}}%%
%% @uniform class width=208 height=220 max_title_len=21 max_desc_lines=12
classDiagram
    direction TB

    namespace Core {
        class BasePipeline {
            <<abstract>>
            #_config
            #_runtime
            #_services
            #_context
            #_transformer
            +create(...)
            +transform_bronze_to_silver(...)
        }

        class PipelineRunner {
            -_pipeline
            -_services
            -_executor
            -_checkpoint_manager
            -_lock_runtime_service
            -_preflight_service
            -_postrun_service
            -_lifecycle_service
            -_observer
            +run()
            +execution_metrics()
        }

        class PipelineRunnerDependencies {
            <<frozen dataclass>>
            +executor
            +checkpoint_manager
            +lock_runtime_service
            +preflight
            +postrun
            +lifecycle_service
            +observer
        }

        class BatchExecutor {
            -_services
            -_context
            -_config
            -_processing_port
            -_execution_state_service
            +execute(...)
            +process(...)
            +get_run_statistics()
        }

        class BatchProcessingService {
            -_services
            -_support
            -_transformer
            -_writer
            -_tracing
            +extract_records(...)
            +process_batch(...)
        }

        class BatchTransformer {
            -_transform
            -_quarantine_manager
            -_batch_metrics
            +transform_batch(...)
            +transform_single(...)
        }

        class BatchWriter {
            -_storage
            -_gold_validator
            -_batch_metrics
            +write_bronze(...)
            +write_silver(...)
            +write_gold(...)
        }

        class PipelineService {
            <<frozen dataclass>>
            +data_source
            +storage
            +lock
            +checkpoint
            +quarantine
            +metrics
            +tracing
            +logger
            +dq_monitor
            +metadata_coordinator
            +dq_report_service
            +aclose()
        }
    }

    namespace Services {
        class PipelineRunnerService {
            +runner_factory
            +metrics_extractor
            +logger
            +run(...)
            +list_pipelines()
            +validate_pipeline(...)
        }

        class PipelineRunContextService {
            +merge_options(...)
            +build_context(...)
        }

        class PipelineRunExecutionService {
            +execute(...)
        }

        class CliRunOrchestrationService {
            +validate_start_offset(...)
            +build_options(...)
            +prepare_execution_request(...)
            +execute_pipeline(...)
        }

        class LockRuntimeService {
            -_lock
            -_run_id
            -_config
            -_heartbeat
            +acquire()
            +start_heartbeat()
            +validate()
            +release()
        }

        class CheckpointRuntimeService {
            -_checkpoint
            -_pipeline_name
            -_run_id
            +load_checkpoint()
            +save_checkpoint(...)
            +delete_checkpoint()
        }

        class PreflightService {
            -_health_aggregator
            -_medallion_validator
            +validate_infrastructure(...)
            +validate_preflight(...)
        }

        class PostrunService {
            -_dq_service
            -_lifecycle_service
            +run(...)
            +run_dq_checks(...)
            +run_vacuum_if_enabled()
            +cleanup(...)
        }

        class MedallionLifecycleService {
            +prepare_for_run(...)
            +finalize_run(...)
            +clear(...)
        }

        class PipelineObserver {
            -_metrics
            -_logger
            -_tracer
            +emit_phase_started(...)
            +emit_phase_completed(...)
        }

        class BatchMetricsRecorderService {
            -_metrics
            +track_batch_size(...)
            +track_processed_records(...)
            +track_error(...)
        }

        class BatchTracingManagerService {
            -_tracer
            -_context
            +start_execution_span()
            +start_batch_span(...)
            +end_span(...)
        }

        class QuarantineRuntimeService {
            -_quarantine
            -_pipeline_name
            +quarantine_record(...)
            +quarantine_records(...)
        }
    }

    namespace ControlPlane {
        class RunManifestService {
            +manifest_port
            +schema_version
            +create_manifest(...)
        }

        class RunLedgerService {
            +ledger_port
            +manifest_id
            +run_id
            +record_manifest_created(...)
            +record_run_started()
            +record_stage_completed(...)
            +record_run_finished(...)
        }

        class EffectiveConfigService {
            +create_effective_config_artifact(...)
            +serialize_artifact(...)
            +compute_artifact_hashes(...)
            +check_dq_compatibility(...)
        }

        class LineageInspectionService {
            +lineage_store
            +manifest_port
            +show_fragment(...)
            +trace(...)
            +explain_run(...)
        }
    }

    namespace Transformers {
        class BaseTransformer {
            <<abstract>>
            +transform(...)
            +transform_batch(...)
        }
    }

    PipelineRunnerService --> PipelineRunContextService
    PipelineRunnerService --> PipelineRunExecutionService
    PipelineRunner --> BasePipeline
    PipelineRunner --> PipelineService
    PipelineRunner --> PipelineRunnerDependencies
    PipelineRunnerDependencies --> BatchExecutor
    PipelineRunnerDependencies --> CheckpointRuntimeService
    PipelineRunnerDependencies --> LockRuntimeService
    PipelineRunnerDependencies --> PreflightService
    PipelineRunnerDependencies --> PostrunService
    PipelineRunnerDependencies --> MedallionLifecycleService
    PipelineRunnerDependencies ..> PipelineObserver

    BasePipeline --> PipelineService
    BasePipeline ..> BaseTransformer
    BatchExecutor --> BatchProcessingService : processing_port impl
    BatchProcessingService --> PipelineService
    BatchProcessingService --> BatchTransformer
    BatchProcessingService --> BatchWriter
    BatchProcessingService ..> BatchTracingManagerService
    BatchProcessingService ..> BatchMetricsRecorderService
    BatchTransformer --> BaseTransformer
    BatchTransformer --> QuarantineRuntimeService
    BatchWriter ..> BatchMetricsRecorderService
    CliRunOrchestrationService ..> PipelineRunnerService
    RunManifestService ..> EffectiveConfigService
    RunLedgerService ..> RunManifestService
    LineageInspectionService ..> RunManifestService
