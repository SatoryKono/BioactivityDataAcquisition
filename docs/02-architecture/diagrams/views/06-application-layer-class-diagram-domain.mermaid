%% View: Domain-Focus | Parent: 06-application-layer-class-diagram-full.mermaid
%% @uniform width=232 height=72 max_title_len=24 max_desc_lines=1
flowchart TB
    subgraph DomainFacing["Pipeline Definition And Transform"]
        direction TB
        BP["BasePipeline"]
        PS["PipelineService"]
        TR["BaseTransformer"]
        BT["BatchTransformer"]
        BPS["BatchProcessingService"]
        BW["BatchWriter"]
        QM["QuarantineRuntimeService"]
    end

    subgraph RuntimeData["Runtime Data"]
        direction TB
        CTX["PipelineContext"]
        OUT["BatchProcessingOutcome"]
    end

    BP ==> PS
    BP -.-> TR
    BPS --> PS
    BPS --> BT
    BPS --> BW
    BPS --> CTX
    BT --> TR
    BT --> QM
    BW --> OUT
    BPS --> OUT

    style DomainFacing fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style RuntimeData fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle default stroke:#1E293B,stroke-width:4px
