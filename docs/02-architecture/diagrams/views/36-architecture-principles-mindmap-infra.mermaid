%% View: Infrastructure-Mapping | Parent: 36-architecture-principles-mindmap-full.mermaid
%% @uniform width=224 height=56 max_title_len=23 max_desc_lines=0
flowchart TB
%% keep-orphan: N13, N14, N15, N16, N17, N18, N19, N3, N4, N5, N6, N7, N8

    subgraph Domain["Domain Layer"]
        direction TB
        N4["Bronze/Silver/Gold/MergedStoragePorts"]
        N5["LockPort"]
        N6["MetricsPort"]
        N7["LoggerPort"]
        N8["TracingPort"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N1["Infrastructure Adapters"]
        N2["Local Only Deployment"]
        N3["QuarantineEntry"]
        N10["Storage Writers"]
        N11["MemoryLock"]
        N12["PrometheusMetrics"]
        N14["HTTP Adapters"]
        N15["Storage"]
        N16["Delta Lake"]
        N17["Delta Parquet"]
        N20["MemoryLock in-process"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N13["PipelineRegistry"]
        N18["GenericPipelineFactory"]
        N19["RunnerFactory"]
        N9["7 Provider Adapters"]
    end

    N1 --> N9
    N1 --> N10
    N1 --> N11
    N1 --> N12
    N2 --> N20

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style Composition fill:#fff7ed,stroke:#f59e0b,stroke-width:2px

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 1 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 2 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 3 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 4 stroke:#475569,stroke-width:2px,stroke-dasharray:5
