%% View: Domain-Focus | Parent: 01-full-system-component-full.mermaid
%% @uniform width=192 height=56 max_title_len=19 max_desc_lines=0
%%{init: {'layout':'elk','theme':'base','flowchart':{'defaultRenderer':'elk'},'elk':{'mergeEdges':true,'edgeRouting':'ORTHOGONAL','nodePlacementStrategy':'BRANDES_KOEPF'}}}%%
flowchart TB
    subgraph Domain["Domain Layer"]
        Ports["Port facades"]
        Models["Entities / value objects"]
        Runtime["Pipeline + runtime config"]
        Errors["Errors / events"]
    end

    subgraph Application["Application Layer"]
        Runner["PipelineRunner"]
        Services["PipelineService"]
        Lifecycle["Preflight / Postrun"]
        Processing["BatchProcessingService"]
        Composite["Composite runtime"]
    end

    Runner -.-> Ports
    Services -.-> Ports
    Lifecycle -.-> Ports
    Processing --> Models
    Runner --> Runtime
    Runner --> Errors
    Composite --> Models

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
