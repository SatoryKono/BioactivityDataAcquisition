%% View: Data-Flow | Parent: 06-application-layer-class-diagram-full.mermaid
%% @uniform width=208 height=72 max_title_len=18 max_desc_lines=1
flowchart LR
    subgraph Flow["Execution Flow"]
        direction LR
        PR["PipelineRunner"]
        BE["BatchExecutor"]
        BPS["BatchProcessingService"]
        BT["BatchTransformer"]
        BW["BatchWriter"]
    end

    subgraph Context["Injected Context"]
        direction TB
        BP["BasePipeline"]
        PS["PipelineService"]
        TR["BaseTransformer"]
        QM["QuarantineRuntimeService"]
    end

    PR ==> BE
    BE ==> BPS
    BPS ==> BT
    BPS ==> BW
    BP --> PS
    BP -.-> TR
    BPS --> PS
    BT --> TR
    BT --> QM

    style Flow fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Context fill:#fff1f2,stroke:#dc2626,stroke-width:2px

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle default stroke:#1E293B,stroke-width:4px
