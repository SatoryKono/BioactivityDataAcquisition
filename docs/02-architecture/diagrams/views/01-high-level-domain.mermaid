%% View: Domain-Focus | Parent: 01-high-level-full.mermaid
%% @uniform width=140 height=56 max_title_len=10 max_desc_lines=0
flowchart TB
%% keep-orphan: N13, N14, N15, N16, N17, N18, N19, N20

    subgraph Domain["Domain Layer"]
        direction TB
        N5["Boot"]
        N6["Trans"]
        N8["Sources"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["Runner"]
        N2["Executor"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N7["Adapters"]
        N10["Bronze"]
        N11["Silver"]
        N12["Gold"]
        N13["A1"]
        N14["A2"]
        N15["A3"]
        N16["A4"]
        N17["A5"]
        N18["A6"]
        N19["A7"]
        N3["Storage"]
        N20["Quarantine"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N4["Factory"]
    end

    subgraph Interfaces["Interfaces Layer"]
        direction TB
        N9["CLI"]
    end

    N8 --> N7
    N9 --> N5
    N5 --> N4
    N4 --> N1
    N1 --> N2
    N2 --> N6
    N6 --> N7
    N3 --> N10
    N3 --> N11
    N3 --> N12
    N2 --> N3

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style Composition fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
    style Interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:2px

    %% linkStyle: data 0,6-10 | orchestration 3-4 | di 1,5 | generic 2

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle 0 stroke:#1E293B,stroke-width:2px
    linkStyle 1 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 2 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 3 stroke:#16a34a,stroke-width:2px
    linkStyle 4 stroke:#16a34a,stroke-width:2px
    linkStyle 5 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 6 stroke:#1E293B,stroke-width:2px
    linkStyle 7 stroke:#1E293B,stroke-width:2px
    linkStyle 8 stroke:#1E293B,stroke-width:2px
    linkStyle 9 stroke:#1E293B,stroke-width:2px
    linkStyle 10 stroke:#1E293B,stroke-width:2px
