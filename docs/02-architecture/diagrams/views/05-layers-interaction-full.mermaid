flowchart TB
    subgraph Interfaces["Interfaces Layer"]
        CLI["CLI commands"]
        RunService["PipelineRunnerService"]
        CLI --> RunService
    end

    subgraph Composition["Composition Layer"]
        Builder["build_pipeline_runner"]
        Registry["PipelineRegistry"]
        Factory["GenericPipelineFactory"]
        StorageFactory["StorageFactory"]
        RunService --> Builder
        Builder --> Registry
        Builder --> Factory
        Factory --> StorageFactory
    end

    subgraph Application["Application Layer"]
        Runner["PipelineRunner"]
        BasePipeline["BasePipeline"]
        Executor["BatchExecutor"]
        Processing["BatchProcessingService"]
        TransformWrite["BatchTransformer / BatchWriter"]
        Services["PipelineService"]
        Lifecycle["Preflight / Postrun / Lifecycle"]

        subgraph Composite["Composite Pipeline (ADR-026)"]
            CompositeRunner["CompositePipelineRunner"]
            CompositeSupport["Coordinator / MergeService"]
        end

        Builder --> Runner
        Factory --> BasePipeline
        Runner --> Executor
        Runner --> Services
        Runner --> Lifecycle
        BasePipeline --> Services
        Executor --> Processing
        Processing --> TransformWrite
        Processing --> Services
        CompositeRunner --> CompositeSupport
        CompositeRunner -.->|"delegates"| Runner
    end

    subgraph Domain["Domain Layer"]
        Ports["Port facades"]
        Models["Entities / value objects"]
        RuntimeTypes["Config / runtime types"]
        Errors["Errors / events"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        Adapters["Provider adapters"]
        StorageRuntime["Bronze / Delta / Gold storage"]
        RuntimeAdapters["Locks / checkpoints"]
        Observability["Metrics / tracing"]
    end

    BasePipeline --> Ports
    Services --> Ports
    Lifecycle --> Ports
    Processing --> Models
    Runner --> RuntimeTypes
    Runner --> Errors

    Adapters -.->|"implements"| Ports
    StorageRuntime -.->|"implements"| Ports
    RuntimeAdapters -.->|"implements"| Ports
    Observability -.->|"implements"| Ports

    StorageFactory --> StorageRuntime
    Builder --> RuntimeAdapters
    Builder --> Observability

    style Interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style Composition fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px
