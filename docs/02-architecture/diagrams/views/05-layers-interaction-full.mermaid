%% @version 1.1.0
%% @date    2026-08-21
%% @type    flowchart
%% @level   Component / Class
%% @uniform width=236 height=56 max_title_len=24 max_desc_lines=1
%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
