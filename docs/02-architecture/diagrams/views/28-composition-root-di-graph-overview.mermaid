%% View: Overview | Parent: 28-composition-root-di-graph-full.mermaid
%% Decomposed overview for DI assembly path.
%% @uniform width=220 height=64 max_title_len=22 max_desc_lines=1
%%{init: {'layout':'elk','theme':'base','flowchart':{'nodeSpacing':50,'rankSpacing':64,'curve':'linear'},'elk':{'mergeEdges':true,'edgeRouting':'ORTHOGONAL','nodePlacementStrategy':'BRANDES_KOEPF'}}}%%
flowchart LR
    subgraph Entry["Entry"]
        CLI["CLI run"]
        BOOT["Bootstrap runtime"]
    end

    subgraph Factories["Pipeline Assembly"]
        direction TB
        GPF["GenericPipelineFactory"]
        FMH["factory_method_helpers"]
        CS["creation_support"]
        DSF["DataSourceFactory"]
        STF["StorageFactory"]
    end

    subgraph Runtime["Created Runtime"]
        direction TB
        RUN["PipelineRunner"]
        PS["PipelineService"]
        ADP["ProviderAdapter"]
        WR["Writers"]
    end

    CLI --> BOOT
    BOOT -.-> GPF
    GPF --> FMH
    FMH --> CS
    BOOT -.-> DSF
    BOOT -.-> STF

    DSF --> ADP
    STF --> WR
    CS --> PS
    FMH --> RUN
    ADP --> RUN
    WR -.-> PS
    PS -.-> RUN

    classDef layer_application fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    classDef layer_infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:1.8px;
    classDef layer_composition fill:#fff7ed,stroke:#f59e0b,stroke-width:1.8px;
    classDef layer_interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef service fill:#f0fdf4,stroke:#16a34a,stroke-width:1.6px;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1.4px,stroke-dasharray:3 2;

    class RUN,PS layer_application;
    class ADP,WR layer_infrastructure;
    class BOOT,GPF,FMH,CS,DSF,STF layer_composition;
    class CLI layer_interfaces;
