%% View: Infra | Parent: 08-complete-etl-workflow-full.mermaid
%% @uniform width=192 height=56 max_title_len=18 max_desc_lines=0
flowchart LR
    subgraph Application["Application"]
        Runner["PipelineRunner"]
        Processing["BatchProcessingService"]
        Postrun["PostrunService"]
        Services["PipelineService"]
    end

    subgraph Infrastructure["Infrastructure"]
        Source["DataSourcePort impl"]
        Storage["Bronze/Silver/Gold/Merged storage adapters"]
        Runtime["Lock + checkpoint"]
        Obs["Metrics / tracing"]
        Reports["DQ report + metadata"]
    end

    Runner -.-> Runtime
    Runner --> Services
    Processing ==> Source
    Processing ==> Storage
    Processing -.-> Obs
    Postrun --> Storage
    Postrun ==> Reports
    Services --> Source
    Services --> Storage
    Services --> Obs

    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px
