%% View: Domain | Parent: 08-complete-etl-workflow-full.mermaid
%% @uniform width=184 height=56 max_title_len=19 max_desc_lines=0
flowchart LR
    subgraph Application["Application orchestration"]
        Runner["PipelineRunner"]
        Executor["BatchExecutor"]
        Processing["BatchProcessingService"]
        Postrun["PostrunService"]
    end

    subgraph Domain["Domain artifacts"]
        Policy["RunType / medallion policy"]
        Batch["BronzeRecord batch"]
        Records["SilverRecord + GoldRecord"]
        Quality["DQ thresholds / quarantine"]
        Result["PostrunResult / VacuumResult"]
    end

    Runner --> Policy
    Runner --> Executor
    Executor --> Batch
    Processing --> Records
    Processing --> Quality
    Postrun --> Result

    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
