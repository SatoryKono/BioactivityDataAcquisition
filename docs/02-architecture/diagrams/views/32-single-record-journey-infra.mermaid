%% View: Infrastructure-Mapping | Parent: 32-single-record-journey-full.mermaid
%% @uniform width=176 height=56 max_title_len=20 max_desc_lines=0
flowchart LR
    subgraph Application["Application"]
        Fetch["DataSourcePort.fetch()"]
        Bronze["write_bronze_layer()"]
        Persist["write_silver_gold_concurrent()"]
        Quar["quarantine_records()"]
    end

    subgraph Infrastructure["Infrastructure"]
        Source["Provider adapter"]
        BronzeFile["Bronze file / manifest"]
        Silver["Silver Delta"]
        Gold["Gold Delta"]
        Quarantine["Quarantine storage"]
    end

    Source --> Fetch
    Bronze ==> BronzeFile
    Persist ==> Silver
    Persist ==> Gold
    Quar --> Quarantine

    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px
