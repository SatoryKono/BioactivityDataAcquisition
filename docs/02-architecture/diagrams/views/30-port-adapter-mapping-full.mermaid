            P14["[P] MetadataWriterPort"]
            P15["[P] MetadataCoordinatorPort"]
            P22["[P] InputFilterPort"]
            P21["[P] JsonEncoderPort"]
        end
        subgraph RuntimePorts["Runtime Controls"]
            direction TB
            P18["[P] ShutdownPort"]
            P23["[P] RateLimiterPort"]
            P24["[P] CircuitBreakerPort"]
        end
    end

    subgraph Adapters["Infrastructure Adapters"]
        direction TB
        subgraph CoreDataAdapters["Core Data & Storage Adapters"]
            direction TB
            A1["[A] ProviderAdapters (7)"]
            A2["[A] FilteredDataSource<br/>CachedBronzeDataSource"]
