        subgraph ObservabilityAdapters["Observability & DQ Adapters"]
            direction TB
            A7["[A] StructlogLogger<br/>UnifiedLogger"]
            A8["[A] PrometheusMetrics"]
            A9["[A] NoOpTracing<br/>OpenTelemetryTracer"]
            A10["[A] DataQualityMonitor"]
            A17["[A] MemoryMonitor"]
