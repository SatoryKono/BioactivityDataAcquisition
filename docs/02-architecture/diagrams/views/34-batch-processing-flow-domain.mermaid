%% View: Domain-Focus | Parent: 34-batch-processing-flow-full.mermaid
%% @uniform width=232 height=64 max_title_len=28 max_desc_lines=1
%%{init: {'theme':'base','layout':'elk','flowchart':{'curve':'linear'},'elk':{'nodePlacementStrategy':'BRANDES_KOEPF','mergeEdges':true,'edgeRouting':'ORTHOGONAL'}}}%%
flowchart TB
    subgraph Domain["Domain / Data Objects"]
        direction TB
        RAW["BronzeRecord batch"]
        META["SourceMetadata"]
        TR["TransformResult"]
        OUT["BatchProcessingOutcome"]
    end

    subgraph Application["Application Layer"]
        direction TB
        BPS["BatchProcessingService"]
        SUP["SupportService"]
        BT["BatchTransformer"]
        QM["QuarantineRuntimeService"]
        STATE["StateService"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        DS["DataSourcePort"]
        BR["BronzeWriter"]
        SI["SilverWriter"]
        GO["GoldWriter"]
    end

    DS ==> RAW
    RAW --> BPS
    BPS --> META
    BPS --> SUP
    SUP --> BR
    SUP --> BT
    BT --> TR
    TR --> QM
    TR ==> SI
    TR ==> GO
    SUP --> OUT
    TR --> OUT
    OUT --> STATE

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle default stroke:#1E293B,stroke-width:4px
