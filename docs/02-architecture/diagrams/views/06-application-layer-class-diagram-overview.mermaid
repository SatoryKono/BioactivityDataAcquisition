%% View: Overview | Parent: 06-application-layer-class-diagram-full.mermaid
%% @uniform width=208 height=72 max_title_len=21 max_desc_lines=1
flowchart TB
    subgraph Core["Application Core"]
        direction TB
        BP["BasePipeline"]
        PR["PipelineRunner"]
        RD["RunnerDependencies"]
        BE["BatchExecutor"]
        PS["PipelineService"]
    end

    subgraph Processing["Processing Flow"]
        direction TB
        BPS["BatchProcessingService"]
        BT["BatchTransformer"]
        BW["BatchWriter"]
        TR["BaseTransformer"]
    end

    subgraph Lifecycle["Lifecycle Services"]
        direction TB
        LK["LockRuntimeService"]
        PF["PreflightService"]
        PO["PostrunService"]
        ML["MedallionLifecycleService"]
        OB["PipelineObserver"]
    end

    PR ==> RD
    PR --> BP
    PR --> PS
    RD --> BE
    RD --> LK
    RD --> PF
    RD --> PO
    RD --> ML
    RD -.-> OB
    BE --> BPS
    BPS --> BT
    BPS --> BW
    BP -.-> TR
    BT --> TR

    style Core fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Processing fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style Lifecycle fill:#fff1f2,stroke:#dc2626,stroke-width:2px

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle default stroke:#1E293B,stroke-width:4px
