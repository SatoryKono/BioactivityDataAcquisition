%% View: Overview | Parent: 04-domain-layer-class-diagram-full.mermaid
%% @uniform width=232 height=56 max_title_len=24 max_desc_lines=0
flowchart TB
%% keep-orphan: N15

    subgraph Domain["Domain Layer"]
        direction TB
        N1["BaseEntity"]
        N2["PublicationEntityBase"]
        N7["PipelineConfig"]
        N8["TableConfig"]
        N12["DQConfig"]
        N13["FilterableDataSourcePort"]
        N14["DataSourcePort"]
        N15["RuntimeConfig"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N3["Activity"]
        N4["Molecule"]
        N5["Assay"]
        N6["Target"]
        N11["ChemblPublication"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N9["SilverWriteMode"]
        N10["GoldWriteMode"]
    end

    N1 --> N3
    N1 --> N4
    N1 --> N5
    N1 --> N6
    N1 --> N2
    N2 --> N11
    N13 --> N14
    N7 --> N8
    N7 --> N12
    N8 --> N9
    N8 --> N10

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px

    %% linkStyle: data 9-10 | di 4,6-8 | generic 0-3,5

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 1 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 2 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 3 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 4 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 5 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 6 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 7 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 8 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 9 stroke:#1E293B,stroke-width:2px
    linkStyle 10 stroke:#1E293B,stroke-width:2px
