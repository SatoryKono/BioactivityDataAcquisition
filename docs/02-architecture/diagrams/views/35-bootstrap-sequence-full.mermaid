flowchart TB
    subgraph Step1["Step 1: Logger"]
        S1A["BootstrapLogger.configure()"]
        S1B["StructlogLogger<br/>(JSON, ISO timestamps, run_id binding)"]
    end

    subgraph Step2["Step 2: Configuration"]
        S2A["ConfigLoader.load(pipeline_name)"]
        S2B["PipelineYamlConfig<br/>(base defaults merged with entity.yaml)"]
        S2C["DQ + Filter config loaders"]
    end

    subgraph Step3["Step 3: Observability Bundle"]
        S3A["ObservabilityBundle"]
        S3B["MetricsPort + TracingPort"]
    end

    subgraph Step4["Step 4: Storage"]
        S4A["StorageFactory.create(config)"]
        S4B["BronzeWriter<br/>(JSONL + zstd)"]
        S4C["SilverWriter<br/>(Delta Lake)"]
        S4D["GoldWriter<br/>(Delta / Parquet)"]
    end

    subgraph Step5["Step 5: HTTP Client"]
        S5A["HttpClientFactory.create(provider)"]
        S5B["UnifiedHTTPClient"]
        S5C["TokenBucket + CircuitBreaker"]
    end

    subgraph Step6["Step 6: Data Source"]
        S6A["DataSourceFactory.create(provider)"]
        S6B["ProviderRegistry.get(provider)"]
        S6C["Provider Adapter<br/>(e.g., ChemblAdapter)"]
    end

    subgraph Step7["Step 7: Coordination"]
        S7A["MemoryLock<br/>(LockPort, TTL=90s)"]
        S7B["LocalCheckpoint<br/>(CheckpointPort)"]
        S7C["UnifiedQuarantine<br/>(QuarantinePort)"]
    end

    subgraph Step8["Step 8: Factory Context & Services"]
        S8A["_build_factory_context()"]
        S8B["_PipelineFactoryContext"]
        S8C["build_factory_services()"]
        S8D["PipelineService (frozen)"]
    end

    subgraph Step9["Step 9: Pipeline Creation & Runner"]
        S9A["GenericPipelineFactory.create_runner()"]
        S9B["GenericPipelineFactory.create_with_services()"]
        S9C["creation_support / _creation_wiring"]
        S9D["assemble_runner() → PipelineRunner"]
    end

    %% Flow
    S1A --> S1B
    S1B --> S2A
    S2A --> S2B & S2C
    S2B --> S3A
    S3A --> S3B
    S2B --> S4A
    S4A --> S4B & S4C & S4D
    S4B & S4C & S4D --> S5A
    S5A --> S5B
    S5B --> S5C
    S5B --> S6A
    S6A --> S6B --> S6C
    S6C --> S7A & S7B & S7C
    S2B --> S8A
    S8A --> S8B --> S8C --> S8D
    S8B -.-> S6A
    S8B -.-> S4A
    S3A -.-> S9A
    S8D --> S9A --> S9B --> S9C --> S9D
    S9C -.-> S8D
    S9C -.-> S6C

