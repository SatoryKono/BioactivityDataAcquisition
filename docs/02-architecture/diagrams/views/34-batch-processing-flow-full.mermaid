%% Title: Batch Processing Flow — BatchProcessingService choreography
%% Covers: RULES.md §2.1 (Data Flow), application/core/{batch_executor,batch_processing_service,batch_processing_support}.py
%% Rank: 9 (Score 8.44) — Core data processing choreography for every batch
%% Updated: 2026-03-24

%% @version 1.1.0
%% @date    2026-03-24
%% @type    sequenceDiagram
%% @level   Component / Class
%% @nodes   14
%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform sequence width=200 max_title_len=20
sequenceDiagram
    autonumber
    participant Runner as PipelineRunner
    participant BE as BatchExecutor
    participant BPS as BatchProcessingService
    participant DS as DataSourcePort
    participant BTM as BatchTracingManagerService
    participant SUP as BatchProcessingSupportService
    participant BT as BatchTransformer
    participant BW as BatchWriter
    participant Bronze as BronzeWriter
    participant Silver as SilverWriter
    participant Gold as GoldWriter
    participant QM as QuarantineRuntimeService
    participant BMR as BatchMetricsRecorderService
    participant State as BatchExecutionStateService

    Runner->>BE: execute(limit, query, offset)

    Note over BE,BPS: extraction loop assembles one batch before processing
    BE->>BPS: extract_records(limit, query, offset)
    BPS->>DS: fetch(entity_type, limit, query, offset)
    DS-->>BPS: Bronze records

    Note over BE,BPS: once one batch is assembled
    BE->>BPS: process_batch(records, start_index, query_string)
    BPS->>BTM: start_batch_span(batch_id, count, start_index)
    BPS->>SUP: get_source_metadata(query_string)
    SUP-->>BPS: SourceMetadata?

    Note over BPS,SUP: Bronze write + transform + Silver/Gold choreography
    BPS->>SUP: write_bronze_layer(records, batch_id, ingestion_ts, metadata)
    SUP->>BW: write_bronze(...)
    BW->>Bronze: write_bronze(records,...)
    SUP->>BMR: track_batch_size("bronze")<br/>track_processed_records("bronze")

    BPS->>SUP: transform_and_track_metrics(records, batch_id, start_index)
    SUP->>BT: transform_batch(records, batch_id, start_index)
    BT->>QM: flush filtered / DQ records when needed
    SUP->>BMR: track quarantined / silver / gold counts

    BPS->>SUP: write_silver_gold_concurrent(transform_result, ...)
    par Silver write
        SUP->>BW: write_silver(...)
        BW->>Silver: Delta merge / append
    and Gold write
        SUP->>BW: write_gold(...)
        BW->>Gold: validate + write
    end

    BPS->>SUP: finalize_batch_span(span, records, transform_result)
    SUP->>BTM: set_batch_result(...) + end_span()
    SUP-->>BPS: BatchProcessingOutcome
    BPS-->>BE: BatchProcessingOutcome

    BE->>State: commit_successful_batch(records, outcome)
    State-->>BE: cumulative counters updated
    BE-->>Runner: continue extraction loop / build batch result
