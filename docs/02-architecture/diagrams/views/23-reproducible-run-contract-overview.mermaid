%% View: Overview | Parent: ../architecture/23-reproducible-run-contract.mmd
%% @uniform width=188 height=64 max_title_len=18 max_desc_lines=1
flowchart LR
    YAML["Config inputs + source refs"] --> RESOLVE["Resolve + normalize config"]
    RESOLVE --> OVERRIDE["Apply runtime overrides"]
    OVERRIDE --> ART["EffectiveConfigArtifact"]
    ART --> MAN["RunManifest provenance"]
    MAN --> FPRINT["execution_fingerprint"]
    FPRINT --> REPLAY["Replay / diff / checkpoint compare"]

    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1.8px;
    classDef process fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef artifact fill:#f1f5f9,stroke:#64748b,stroke-width:1.8px;
    class YAML storage;
    class RESOLVE,OVERRIDE,REPLAY process;
    class ART,MAN,FPRINT artifact;
