%% View: Overview | Parent: 30-port-adapter-mapping-full.mermaid
%% Decomposed overview of port families and adapter families.
%% @uniform width=236 height=64 max_title_len=24 max_desc_lines=1
%%{init: {'layout':'elk','theme':'base','flowchart':{'nodeSpacing':56,'rankSpacing':68,'curve':'linear'},'elk':{'mergeEdges':true,'edgeRouting':'ORTHOGONAL','nodePlacementStrategy':'BRANDES_KOEPF'}}}%%
flowchart LR
    subgraph Ports["Domain Port Families"]
        direction TB
        PCORE["[P] Core Data Ports"]
        POBS["[P] Observability Ports"]
        PPOL["[P] Validation/Policy Ports"]
        PRUN["[P] Runtime Control Ports"]
    end

    subgraph Adapters["Infrastructure Adapter Families"]
        direction TB
        APROV["[A] Provider Adapters"]
        ASTORE["[A] Storage Adapters"]
        AOBS["[A] Observability Adapters"]
        APOL["[A] Validation/Policy Adapters"]
        ARUN["[A] Runtime Adapters"]
    end

    subgraph NoOps["Fallbacks"]
        direction TB
        NOOP["[N] NoOp Adapters"]
    end

    PCORE ==> APROV
    PCORE ==> ASTORE
    POBS --> AOBS
    PPOL --> APOL
    PRUN --> ARUN

    POBS -.-> NOOP
    PRUN -.-> NOOP

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.8px;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1.8px;
    classDef noop fill:#eff6ff,stroke:#64748b,stroke-width:1.8px,stroke-dasharray:4 2;

    class PCORE,POBS,PPOL,PRUN port;
    class APROV,ASTORE,AOBS,APOL,ARUN adapter;
    class NOOP noop;
