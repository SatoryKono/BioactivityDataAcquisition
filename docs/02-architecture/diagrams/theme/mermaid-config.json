{
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#f5f3ff",
    "primaryBorderColor": "#7c3aed",
    "primaryTextColor": "#212121",
    "secondaryColor": "#fff1f2",
    "secondaryBorderColor": "#dc2626",
    "secondaryTextColor": "#212121",
    "tertiaryColor": "#f0fdf4",
    "tertiaryBorderColor": "#16a34a",
    "tertiaryTextColor": "#212121",
    "noteBkgColor": "#fefce8",
    "noteBorderColor": "#ca8a04",
    "noteTextColor": "#212121",

    "lineColor": "#475569",
    "textColor": "#212121",
    "mainBkg": "#eff6ff",

    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif",
    "fontSize": "16px",

    "nodeBorder": "#2563eb",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#94a3b8",
    "titleColor": "#1e40af",

    "edgeLabelBackground": "#ffffff",
    "nodeTextColor": "#212121",

    "actorBkg": "#eff6ff",
    "actorBorder": "#2563eb",
    "actorTextColor": "#1e40af",
    "actorLineColor": "#475569",
    "signalColor": "#475569",
    "signalTextColor": "#212121",
    "labelBoxBkgColor": "#eff6ff",
    "labelBoxBorderColor": "#2563eb",
    "labelTextColor": "#1e40af",
    "loopTextColor": "#475569",
    "activationBorderColor": "#2563eb",
    "activationBkgColor": "#dbeafe",
    "sequenceNumberColor": "#ffffff",

    "classText": "#212121",

    "fillType0": "#eff6ff",
    "fillType1": "#fff7ed",
    "fillType2": "#f0fdf4",
    "fillType3": "#f5f3ff",
    "fillType4": "#ffe4e6",
    "fillType5": "#f8fafc",
    "fillType6": "#fefce8",
    "fillType7": "#f1f5f9",

    "pie1": "#2563eb",
    "pie2": "#f59e0b",
    "pie3": "#16a34a",
    "pie4": "#7c3aed",
    "pie5": "#dc2626",
    "pie6": "#0891b2",
    "pie7": "#ca8a04",
    "pie8": "#64748b",

    "cScale0": "#eff6ff",
    "cScale1": "#dbeafe",
    "cScale2": "#bfdbfe",
    "cScale3": "#93c5fd",
    "cScale4": "#60a5fa",
    "cScale5": "#3b82f6",
    "cScale6": "#2563eb",
    "cScale7": "#1d4ed8"
  },
  "flowchart": {
    "curve": "step",
    "padding": 24,
    "nodeSpacing": 50,
    "rankSpacing": 45,
    "htmlLabels": true,
    "useMaxWidth": true,
    "diagramPadding": 16,
    "wrappingWidth": 240
  },
  "sequence": {
    "mirrorActors": false,
    "messageAlign": "center",
    "actorMargin": 80,
    "width": 180,
    "height": 50,
    "boxMargin": 12,
    "boxTextMargin": 6,
    "noteMargin": 16,
    "messageMargin": 40,
    "diagramMarginX": 50,
    "diagramMarginY": 16,
    "useMaxWidth": true,
    "rightAngles": true,
    "showSequenceNumbers": false
  },
  "elk": {
    "mergeEdges": true,
    "nodePlacementStrategy": "BRANDES_KOEPF",
    "cycleBreakingStrategy": "GREEDY",
    "direction": "RIGHT",
    "spacing.nodeNode": 40,
    "spacing.edgeNode": 30,
    "spacing.edgeEdge": 20,
    "edgeRouting": "ORTHOGONAL"
  },
  "class": {
    "defaultRenderer": "dagre-wrapper",
    "useMaxWidth": true,
    "padding": 16,
    "htmlLabels": true
  },
  "state": {
    "useMaxWidth": true,
    "padding": 12,
    "dividerColor": "#94a3b8",
    "defaultRenderer": "elk"
  },
  "er": {
    "useMaxWidth": true,
    "fontSize": 13
  },
  "pie": {
    "useMaxWidth": true
  },
  "mindmap": {
    "useMaxWidth": true,
    "padding": 20
  },
  "gantt": {
    "useMaxWidth": true,
    "fontSize": 13,
    "barHeight": 24,
    "barGap": 6,
    "topPadding": 60,
    "leftPadding": 100,
    "gridLineStartPadding": 40,
    "numberSectionStyles": 4
  }
}
