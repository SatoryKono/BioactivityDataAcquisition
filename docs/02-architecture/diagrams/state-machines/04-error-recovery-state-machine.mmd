%% @version 1.0.0
%% @date 2026-07-24
%% @type state
%% @level system
stateDiagram-v2
    [*] --> ErrorDetected: Error occurs
    
    ErrorDetected --> Classify: Classify error type
    ErrorDetected --> Failed: Critical error
    
    Classify --> Transient: Transient error
    Classify --> Permanent: Permanent error
    Classify --> Unknown: Unknown error type
    
    Transient --> RetryDecision: Evaluate retry eligibility
    Permanent --> NoRetry: No retry
    Unknown --> UnknownStrategy: Unknown strategy
    
    RetryDecision --> Retry: Retry with backoff
    RetryDecision --> NoRetry: Max retries exceeded
    RetryDecision --> Escalate: Retry count threshold
    
    Retry --> Success: Retry successful
    Retry --> Failed: Retry failed
    
    Success --> RecoveryComplete: Recovery successful
    RecoveryComplete --> [*]: Resume execution
    
    NoRetry --> Escalate: Escalate for review
    UnknownStrategy --> Escalate: Escalate for review
    
    Escalate --> ManualIntervention: Manual intervention required
    Escalate --> AutoRecovery: Auto-recovery possible
    
    AutoRecovery --> AutoFix: Apply auto-fix rules
    AutoFix --> AutoValidate: Validate auto-fix
    
    AutoValidate --> RecoveryComplete: Auto-fix successful
    AutoValidate --> ManualIntervention: Auto-fix failed
    
    ManualIntervention --> ManualReview: Operator review
    ManualReview --> ManualFix: Operator applies fix
    ManualReview --> ManualFail: Operator gives up
    
    ManualFix --> ManualValidate: Validate manual fix
    ManualValidate --> RecoveryComplete: Manual fix successful
    ManualValidate --> ManualIntervention: Manual fix failed
    
    ManualFail --> Failed: Manual recovery failed
    Failed --> [*]: Recovery failed
    
    note right of ErrorDetected
        Error detected in pipeline execution
        Error details captured
    end note
    
    note right of Classify
        Error classification
        Transient vs Permanent
    end note
    
    note right of Transient
        Temporary error
        Retry with backoff
    end note
    
    note right of Permanent
        Permanent error
        No retry possible
    end note
    
    note right of RetryDecision
        Evaluate retry eligibility
        Check retry count
    end note
    
    note right of Retry
        Retry with exponential backoff
        Monitor retry success
    end note
    
    note right of Escalate
        Escalate for review
        Threshold exceeded
    end note
    
    note right of AutoRecovery
        Auto-recovery possible
        Apply auto-fix rules
    end note
    
    note right of ManualIntervention
        Manual intervention required
        Operator review needed
    end note
    
    note right of RecoveryComplete
        Recovery successful
        Resume execution
    end note
    
    note right of Failed
        Recovery failed
        Terminal state
    end note
