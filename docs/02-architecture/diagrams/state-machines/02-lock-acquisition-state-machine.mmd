%% @version 1.0.0
%% @date 2026-07-24
%% @type state
%% @level system
stateDiagram-v2
    [*] --> LockRequest: Request lock
    
    LockRequest --> Pending: Lock request submitted
    LockRequest --> Failed: Lock immediately unavailable
    
    Pending --> Acquired: Lock granted
    Pending --> Failed: Lock denied
    Pending --> Timeout: Lock request timeout
    
    Acquired --> Active: Lock active
    Acquired --> Renewal: Lock renewal requested
    
    Active --> Renewal: Renewal during active period
    Active --> Release: Lock release requested
    Active --> Timeout: Lock timeout
    
    Renewal --> Active: Renewal successful
    Renewal --> Failed: Renewal failed
    Renewal --> Timeout: Renewal timeout
    
    Release --> Released: Lock released
    Release --> Failed: Release failed
    
    Timeout --> Expired: Lock expired
    Timeout --> Failed: Lock timeout failure
    
    Failed --> [*]: Lock acquisition failed
    Released --> [*]: Lock successfully released
    Expired --> [*]: Lock expired
    
    note right of LockRequest
        Pipeline requests lock for idempotent execution
    end note
    
    note right of Pending
        Lock request being processed
        Waiting for lock availability
    end note
    
    note right of Acquired
        Lock successfully acquired
        Pipeline can proceed with execution
    end note
    
    note right of Active
        Lock is active and owned
        Pipeline execution in progress
    end note
    
    note right of Renewal
        Lock renewal during long-running execution
        Extends lock ownership period
    end note
    
    note right of Release
        Lock release requested after completion
        Normal cleanup path
    end note
    
    note right of Timeout
        Lock timeout reached
        Automatic lock expiration
    end note
    
    note right of Failed
        Lock acquisition or management failed
        Terminal state
    end note
    
    note right of Released
        Lock successfully released
        Resource available for others
    end note
    
    note right of Expired
        Lock expired due to timeout
        Automatic cleanup
    end note
