%% @type state
%% @level system
stateDiagram-v2
    [*] --> CheckpointRequest: Request checkpoint
    
    CheckpointRequest --> Creating: Start checkpoint creation
    CheckpointRequest --> Failed: Checkpoint request invalid
    
    Creating --> Validating: Checkpoint data written
    Creating --> Failed: Creation failed
    
    Validating --> Active: Checkpoint validated
    Validating --> Failed: Validation failed
    
    Active --> Recovery: Recovery requested
    Active --> Cleanup: Cleanup requested
    Active --> Expired: Checkpoint expired
    
    Recovery --> Restoring: Start restore process
    Recovery --> Failed: Recovery failed
    
    Restoring --> Resumed: Restore successful
    Restoring --> Failed: Restore failed
    
    Resumed --> Active: Resume complete
    Resumed --> Cleanup: Cleanup after resume
    
    Cleanup --> Cleaning: Start cleanup
    Cleanup --> Failed: Cleanup failed
    
    Cleaning --> Cleaned: Cleanup complete
    Cleaning --> Failed: Cleanup failed
    
    Expired --> Archived: Archive expired checkpoint
    Expired --> Failed: Archive failed
    
    Cleaned --> [*]: Checkpoint removed
    Archived --> [*]: Checkpoint archived
    Failed --> [*]: Checkpoint failed
    
    note right of CheckpointRequest
        Pipeline requests checkpoint creation
        At safe execution point
    end note
    
    note right of Creating
        Checkpoint data being written
        State capture in progress
    end note
    
    note right of Validating
        Checkpoint data validation
        Integrity verification
    end note
    
    note right of Active
        Checkpoint active and valid
        Available for recovery
    end note
    
    note right of Recovery
        Recovery from checkpoint requested
        Resume from safe point
    end note
    
    note right of Restoring
        Restore process in progress
        State restoration
    end note
    
    note right of Resumed
        Resume completed successfully
        Pipeline execution continues
    end note
    
    note right of Cleanup
        Cleanup requested after completion
        Normal cleanup path
    end note
    
    note right of Expired
        Checkpoint retention period exceeded
        Automatic expiration
    end note
    
    note right of Failed
        Checkpoint operation failed
        Terminal state
    end note
    
    note right of Cleaned
        Checkpoint successfully removed
        Resource cleanup complete
    end note
    
    note right of Archived
        Checkpoint archived for retention
        Historical preservation
    end note
