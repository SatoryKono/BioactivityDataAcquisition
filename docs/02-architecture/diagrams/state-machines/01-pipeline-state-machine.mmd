%% @version 1.0.0
%% @date 2026-07-24
%% @type state
%% @level system
stateDiagram-v2
    [*] --> Initial: Pipeline created
    
    Initial --> Running: Start execution
    
    Running --> Success: All steps succeed
    Running --> Failed: Step or workflow failure
    Running --> Retry: Transient error
    
    Retry --> Running: Retry successful
    Retry --> Failed: Max retries exceeded
    Retry --> CircuitBreaker: Circuit breaker triggered
    
    CircuitBreaker --> Failed: Circuit breaker open
    CircuitBreaker --> Running: Circuit breaker closed
    
    Failed --> Cleanup: Start cleanup
    Success --> Cleanup: Start cleanup
    
    Cleanup --> [*]: Pipeline terminated
    
    note right of Initial
        Pipeline created but not started
    end note
    
    note right of Running
        Active execution state
        At least one step in progress
    end note
    
    note right of Success
        All selected steps completed successfully
        Terminal state
    end note
    
    note right of Failed
        Pipeline stopped due to failure
        Terminal state
    end note
    
    note right of Retry
        Transient error detected
        Retry with backoff
    end note
    
    note right of CircuitBreaker
        Circuit breaker activated
        Prevents cascading failures
    end note
    
    note right of Cleanup
        Resource cleanup and shutdown
        Lock release, connection close
    end note
