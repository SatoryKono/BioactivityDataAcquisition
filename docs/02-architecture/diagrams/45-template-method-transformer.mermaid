classDiagram
    class BaseTransformer {
        <<abstract>>
        -_logger: LoggerPort
        -_config: PipelineYamlConfig
        +transform(records: list) DataFrame
        +transform_for_gold(df: DataFrame) DataFrame
        #_transform_impl(records: list)* DataFrame
        #_get_silver_schema() type
        #_get_gold_schema() type
        -_normalize_values(df) DataFrame
        -_add_metadata(df, run_context) DataFrame
        -_compute_content_hash(df) DataFrame
    }

    class BaseChemblTransformer {
        <<abstract>>
        #_transform_impl(records)* DataFrame
        #_chembl_specific_normalization(df) DataFrame
    }

    class BasePublicationTransformer {
        <<abstract>>
        #_transform_impl(records)* DataFrame
        #_normalize_authors(raw) list
        #_normalize_date(raw) str
    }

    class ActivityTransformer {
        +_transform_impl(records) DataFrame
        +_get_silver_schema() ActivitySchema
        +_get_gold_schema() ChEMBLActivityGoldSchema
    }

    class MoleculeTransformer {
        +_transform_impl(records) DataFrame
        +_get_silver_schema() MoleculeSchema
        +_get_gold_schema() ChEMBLMoleculeGoldSchema
    }

    class AssayTransformer {
