%% @type flowchart
%% @level system
%%{init: {'layout': 'elk'}}%%
flowchart TD
    Start([Start UniProt extract]) --> Client[UnifiedHTTPClient ADR-032]
    Client --> RL{Rate limit OK?}
    RL -->|No| Wait[Backoff / wait]
    Wait --> RL
    RL -->|Yes| Req[Build request + pagination cursor]
    Req --> Call[HTTP call]
    Call --> CB{Circuit breaker}
    CB -->|Open| Fail[Fail extract / retry policy]
    CB -->|Closed| Resp{Response class}
    Resp -->|2xx| Parse[Parse payload]
    Resp -->|429/5xx| Retry[Retry with jitter]
    Retry --> Call
    Resp -->|4xx permanent| Err[Error path / quarantine upstream]
    Parse --> Page{More pages?}
    Page -->|Yes| Req
    Page -->|No| Done([Hand off records to Bronze writer])
    classDef domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef infra fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef composition fill:#fff7ed,stroke:#ea580c,stroke-width:2px
    classDef interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:2px
