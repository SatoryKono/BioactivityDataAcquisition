%% @version 1.0.0
%% @date 2026-07-24
%% @type flowchart
%% @level system
flowchart TD
    Start([ChEMBL Medallion Layer Start]) --> Domain[ChEMBL Domain Entity]
    
    Domain --> Bronze[Bronze Write]
    Bronze --> BronzeFormat[Format as JSONL]
    BronzeFormat --> BronzeMeta[Add Bronze Metadata]
    BronzeMeta --> BronzeWrite[Write to Bronze Delta Lake]
    BronzeWrite --> BronzeSuccess{Bronze Write Success?}
    BronzeSuccess -->|Yes| Silver[Silver Transformation]
    BronzeSuccess -->|No| BronzeError[Bronze Write Error]
    
    Silver --> SilverTransform[Apply Silver Transformations]
    SilverTransform --> SilverType[Silver Data Type]
    SilverType --> SilverNorm[Data Normalization]
    SilverNorm --> SilverEnrich[Enrichment]
    SilverEnrich --> SilverDQ[Apply Silver DQ Rules]
    
    SilverDQ --> SilverDQCheck{Silver DQ Passes?}
    SilverDQCheck -->|Yes| SilverWrite[Write to Silver Delta Lake]
    SilverDQCheck -->|No| SilverQuarantine[Route to Silver Quarantine]
    
    SilverWrite --> SilverSuccess{Silver Write Success?}
    SilverSuccess -->|Yes| Gold[Gold Enrichment]
    SilverSuccess -->|No| SilverError[Silver Write Error]
    
    SilverQuarantine --> Quarantine[Quarantine Handling]
    
    Gold --> GoldTransform[Apply Gold Transformations]
    GoldTransform --> GoldMerge[Merge with Other Sources]
    GoldMerge --> GoldFinal[Final Gold Data]
    GoldFinal --> GoldStrict[Apply Strict Validation]
    
    GoldStrict --> GoldCheck{Strict Validation Passes?}
    GoldCheck -->|Yes| GoldWrite[Write to Gold Delta Lake]
    GoldCheck -->|No| GoldQuarantine[Route to Gold Quarantine]
    
    GoldWrite --> GoldSuccess{Gold Write Success?}
    GoldSuccess -->|Yes| Complete[Medallion Flow Complete]
    GoldSuccess -->|No| GoldError[Gold Write Error]
    
    GoldQuarantine --> Quarantine
    
    BronzeError --> Log1[Log Bronze Error]
    SilverError --> Log2[Log Silver Error]
    GoldError --> Log3[Log Gold Error]
    
    Log1 --> Metrics1[Emit Error Metrics]
    Log2 --> Metrics2[Emit Error Metrics]
    Log3 --> Metrics3[Emit Error Metrics]
    
    Metrics1 --> Fail[Medallion Flow Failed]
    Metrics2 --> Fail
    Metrics3 --> Fail
    
    Quarantine --> QuarantineMetrics[Emit Quarantine Metrics]
    QuarantineMetrics --> QuarantineComplete[Quarantine Handling Complete]
    
    Complete --> Success[Emit Success Metrics]
    Success --> End([ChEMBL Medallion Layer End])

    style Start fill:#e1f5ff
    style End fill:#e1f5ff
    style Complete fill:#c8e6c9
    style Fail fill:#ffcccc
    style BronzeSuccess fill:#fff4e6
    style SilverDQCheck fill:#fff4e6
    style SilverSuccess fill:#fff4e6
    style GoldCheck fill:#fff4e6
    style GoldSuccess fill:#fff4e6
