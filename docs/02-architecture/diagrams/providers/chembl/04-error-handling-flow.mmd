%% Title: ChEMBL Error Handling Flow
%% Description: Error handling flow diagram for ChEMBL provider showing API errors, validation failures, DQ threshold breaches, retry logic, and circuit breaker activation. Covers ChEMBL-specific error handling patterns.
%% @version 1.0.0
%% @date 2026-07-24
%% @type flowchart
%% @level system
%% @nodes 46
%% @adr ADR-032,ADR-016,ADR-040

%% @version 1.0.0
%% @date 2026-07-24
%% @type flowchart
%% @level system
flowchart TD
    Start([ChEMBL Error Handling Start]) --> ErrorType[Detect Error Type]
    
    ErrorType --> TypeClass{Error Category?}
    TypeClass -->|API Error| API[API Error]
    TypeClass -->|Validation Error| Validation[Validation Error]
    TypeClass -->|DQ Error| DQ[DQ Error]
    TypeClass -->|Storage Error| Storage[Storage Error]
    
    API --> APIStatus{HTTP Status?}
    APIStatus -->|429 Rate Limit| RateLimit[Rate Limit Error]
    APIStatus -->|5xx Server| Server[Server Error]
    APIStatus -->|4xx Client| Client[Client Error]
    APIStatus -->|Network| Network[Network Error]
    
    RateLimit --> RateLimitRetry{Retry Eligible?}
    RateLimitRetry -->|Yes| Backoff1[Wait with Backoff]
    RateLimitRetry -->|No| RateLimitFail[Rate Limit Failure]
    Backoff1 --> API
    
    Server --> ServerRetry{Retry Eligible?}
    ServerRetry -->|Yes| Backoff2[Wait with Backoff]
    ServerRetry -->|No| ServerFail[Server Failure]
    Backoff2 --> API
    
    Client --> ClientType{Client Error Type?}
    ClientType -->|401 Auth| Auth[Authentication Error]
    ClientType -->|404 Not Found| NotFound[Resource Not Found]
    ClientType -->|Other Client| ClientFail[Client Error]
    
    Auth --> AuthFail[Authentication Failure]
    NotFound --> NotFoundFail[Resource Not Found Failure]
    ClientFail --> ClientFail
    
    Network --> NetworkRetry{Retry Eligible?}
    NetworkRetry -->|Yes| Backoff3[Wait with Backoff]
    NetworkRetry -->|No| NetworkFail[Network Failure]
    Backoff3 --> API
    
    Validation --> ValidationType{Validation Type?}
    ValidationType -->|Schema| Schema[Schema Validation Error]
    ValidationType -->|Field| Field[Field Validation Error]
    ValidationType -->|Type| Type[Type Validation Error]
    
    Schema --> SchemaError[Schema Error]
    Field --> FieldError[Field Error]
    Type --> TypeError[Type Error]
    
    DQ --> DQType{DQ Error Type?}
    DQType -->|Completeness| Completeness[Completeness Error]
    DQType -->|Accuracy| Accuracy[Accuracy Error]
    DQType -->|Consistency| Consistency[Consistency Error]
    
    Completeness --> CompletenessFail[Completeness Failure]
    Accuracy --> AccuracyFail[Accuracy Failure]
    Consistency --> ConsistencyFail[Consistency Failure]
    
    Storage --> StorageType{Storage Error?}
    StorageType -->|Write| Write[Write Error]
    StorageType -->|Read| Read[Read Error]
    StorageType -->|Delta| Delta[Delta Lake Error]
    
    Write --> WriteFail[Write Failure]
    Read --> ReadFail[Read Failure]
    Delta --> DeltaFail[Delta Lake Failure]
    
    %% Circuit Breaker Check
    API --> CircuitBreaker[Check Circuit Breaker]
    CircuitBreaker --> CBState{Circuit Breaker State?}
    CBState -->|OPEN| CBFail[Circuit Breaker Open]
    CBState -->|HALF_OPEN| CBHalfOpen[Circuit Breaker Half-Open]
    CBState -->|CLOSED| CBOk[Circuit Breaker Closed]
    
    CBHalfOpen --> CBHalfOpenCheck{Request Success?}
    CBHalfOpenCheck -->|Yes| CBOk
    CBHalfOpenCheck -->|No| CBFail
    
    %% Error Classification
    RateLimitFail --> Classify[Classify Error Severity]
    ServerFail --> Classify
    AuthFail --> Classify
    NotFoundFail --> Classify
    ClientFail --> Classify
    NetworkFail --> Classify
    SchemaError --> Classify
    FieldError --> Classify
    TypeError --> Classify
    CompletenessFail --> Classify
    AccuracyFail --> Classify
    ConsistencyFail --> Classify
    WriteFail --> Classify
    ReadFail --> Classify
    DeltaFail --> Classify
    CBFail --> Classify
    
    Classify --> Severity{Error Severity?}
    Severity -->|Transient| Transient[Transient Error]
    Severity -->|Permanent| Permanent[Permanent Error]
    Severity -->|Unknown| Unknown[Unknown Error]
    
    %% Error Handling Strategy
    Transient --> RetryStrategy[Apply Retry Strategy]
    Permanent --> NoRetry[No Retry]
    Unknown --> UnknownStrategy[Unknown Strategy]
    
    RetryStrategy --> RetryCheck{Max Retries?}
    RetryCheck -->|No| NoRetry
    RetryCheck -->|Yes| Backoff4[Wait with Backoff]
    Backoff4 --> API
    
    NoRetry --> Log[Log Error Details]
    UnknownStrategy --> Log
    
    Log --> Metrics[Emit Error Metrics]
    Metrics --> Alert[Generate Alert]
    Alert --> AlertSeverity{Alert Severity?}
    AlertSeverity -->|Critical| CriticalAlert[Critical Alert]
    AlertSeverity -->|Warning| WarningAlert[Warning Alert]
    AlertSeverity -->|Info| InfoAlert[Info Alert]
    
    CriticalAlert --> Fail[Error Handling Failed]
    WarningAlert --> Warning[Error Handling Warning]
    InfoAlert --> Info[Error Handling Info]
    
    Fail --> End([ChEMBL Error Handling End])
    Warning --> End
    Info --> End
    classDef domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef infra fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef composition fill:#fff7ed,stroke:#ea580c,stroke-width:2px
    classDef interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:2px
