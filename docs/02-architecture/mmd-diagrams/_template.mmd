%% @uniform width=232 height=56 max_title_len=24 max_desc_lines=0
graph LR
    %% ═══════════════════════════════════════════════════════════════
    %% SUBGRAPH PALETTE (canonical ADR-040 colors)
    %% ═══════════════════════════════════════════════════════════════
    %% Domain:         fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px (Lavender)
    %% Application:    fill:#f0fdf4,stroke:#16a34a,stroke-width:2px (Mint)
    %% Infrastructure: fill:#fff1f2,stroke:#dc2626,stroke-width:2px (Rose)
    %% Composition:    fill:#fffbeb,stroke:#d97706,stroke-width:2px (Amber)
    %% Interfaces:     fill:#eff6ff,stroke:#2563eb,stroke-width:2px (Blue)
    %% Data/Storage:   fill:#f8fafc,stroke:#475569,stroke-width:2px (Slate)
    %% External:       fill:#eceff1,stroke:#455a64,stroke-width:1px (Gray)
    %% Bronze:         fill:#fff7ed,stroke:#ea580c,stroke-width:2px (Orange)
    %% Silver:         fill:#f1f5f9,stroke:#64748b,stroke-width:2px (Cool Gray)
    %% Gold:           fill:#fefce8,stroke:#ca8a04,stroke-width:2px (Yellow)
    %% Quarantine:     fill:#fef2f2,stroke:#dc2626,stroke-width:2px (Red)

    subgraph Layer["Layer Title"]
        direction LR
        N1["fa:fa-gear Node Label"]
    end

    %% ═══════════════════════════════════════════════════════════════
    %% NODE STYLES (classDef)
    %% ═══════════════════════════════════════════════════════════════
    classDef domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef app    fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef infra  fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef comp   fill:#fffbeb,stroke:#d97706,stroke-width:2px
    classDef iface  fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    classDef data   fill:#f8fafc,stroke:#475569,stroke-width:2px
    classDef ext    fill:#eceff1,stroke:#455a64,stroke-width:1px

    %% Medallion-specific
    classDef bronze fill:#fff7ed,stroke:#ea580c,stroke-width:2px
    classDef silver fill:#f1f5f9,stroke:#64748b,stroke-width:2px
    classDef gold   fill:#fefce8,stroke:#ca8a04,stroke-width:2px
    classDef quar   fill:#fef2f2,stroke:#dc2626,stroke-width:2px

    %% Class-diagram-specific
    classDef port    fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,min-width:160px
    classDef entity  fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,min-width:160px
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:2px,min-width:160px
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:2px,min-width:160px
    classDef config  fill:#fffbeb,stroke:#d97706,stroke-width:2px,min-width:160px
    classDef noop    fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,stroke-dasharray:5,min-width:160px

    class N1 domain

    %% ═══════════════════════════════════════════════════════════════
    %% LINK STYLES — semantic thickness (LBP-005)
    %% ═══════════════════════════════════════════════════════════════
    %% Apply after all links are defined. Index = link order (0-based).
    %%
    %% Data flow (main pipeline path):
    %%   linkStyle 0,1,2 stroke:#1E293B,stroke-width:3px
    %%
    %% Orchestration / control:
    %%   linkStyle 3,4 stroke:#16a34a,stroke-width:2px
    %%
    %% DI / implements (dashed):
    %%   linkStyle 5,6 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
    %%
    %% Observability / metrics:
    %%   linkStyle 7,8 stroke:#94A3B8,stroke-width:1px

