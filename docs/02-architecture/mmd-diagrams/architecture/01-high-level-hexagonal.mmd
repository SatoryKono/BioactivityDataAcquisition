graph LR

    %% == DRIVING SIDE (Left) ============================

    subgraph External_In["External (Driving)"]
        USERS["Users / CI&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Interfaces["Interfaces"]
        CLI["CLI (Click)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        ORCH["Orchestration&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Composition["Composition Root"]
        BOOTSTRAP["Bootstrap & Factories&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    %% == APPLICATION (Center-Left) ======================

    subgraph Application["Application"]
        subgraph BizLogic["Business Logic"]
            CORE["Core Services&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
            COMPOSITE["Composite Pipeline&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        end
        SERVICES["Support Services&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        PIPELINES["Transformers&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    %% == DOMAIN -- the hexagon core (Center) ============

    subgraph Domain["Domain (pure, no I/O)"]
        PORTS["Port Protocols&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        ENTITIES["Entities & Value Objects&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        DOM_SVC["Domain Services & Config&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    %% == DRIVEN SIDE (Right) ============================

    subgraph Infrastructure["Infrastructure (implements Ports)"]
        ADAPTERS["Provider Adapters&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        STORAGE["Storage (Delta Lake)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        INFRA_SUPPORT["Observability / Resilience / Security"]
    end

    subgraph External_Out["External (Driven)"]
        EXT_APIS["External APIs&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        FS["File System&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        OBS_EXT["Prometheus / OTel&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    %% == LEGEND =========================================

    subgraph Legend["Legend"]
        L1["Domain"]:::domain
        L2["Application"]:::app
        L3["Composition"]:::comp
        L4["Interfaces"]:::iface
        L5["Infrastructure"]:::infra
        L6["External"]:::ext
        L1 --- L2 --- L3 --- L4 --- L5 --- L6
    end

    %% -- Layout hint: anchor legend near bottom-center --
    BOOTSTRAP ~~~ L1

    %% -- Driving flow (left -> right) -------------------
    USERS -.-> CLI
    USERS -.-> ORCH
    CLI --> BOOTSTRAP
    ORCH --> BOOTSTRAP
    BOOTSTRAP -->|"builds & injects"| CORE

    %% -- Composition wires Infrastructure ---------------
    BOOTSTRAP --> ADAPTERS
    BOOTSTRAP --> STORAGE
    BOOTSTRAP --> INFRA_SUPPORT

    %% -- Application uses Domain ------------------------
    CORE --> PORTS
    CORE --> ENTITIES
    SERVICES --> PORTS
    COMPOSITE --> PORTS
    PIPELINES --> DOM_SVC

    %% -- Ports resolved to Adapters (DI) ----------------
    PORTS ==>|"resolves to"| ADAPTERS

    %% -- Infrastructure calls External ------------------
    ADAPTERS -.-> EXT_APIS
    STORAGE -.-> FS
    INFRA_SUPPORT -.-> OBS_EXT

    %% == STYLES =========================================

    classDef domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef app fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef infra fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef comp fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef iface fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef ext fill:#eceff1,stroke:#455a64,stroke-width:1px

    class PORTS,ENTITIES,DOM_SVC domain
    class CORE,SERVICES,COMPOSITE,PIPELINES app
    class ADAPTERS,STORAGE,INFRA_SUPPORT infra
    class BOOTSTRAP comp
    class CLI,ORCH iface
    class USERS,EXT_APIS,FS,OBS_EXT ext

