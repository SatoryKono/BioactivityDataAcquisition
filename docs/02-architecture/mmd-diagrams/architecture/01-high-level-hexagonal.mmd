%% BioETL — High-Level Hexagonal Architecture
%% Shows the Ports & Adapters (Hexagonal) pattern across all layers.

%% @version 1.1.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes  39

graph TB
    subgraph External["External Systems"]
        subgraph ExternalAPIs["External APIs"]
            CHEMBL_API["ChEMBL API"]
            PUBMED_API["PubMed API"]
            UNIPROT_API["UniProt API"]
            PUBCHEM_API["PubChem API"]
            CROSSREF_API["CrossRef API"]
            OPENALEX_API["OpenAlex API"]
            SEMSCHOLAR_API["Semantic Scholar API"]
        end
        FS["File System<br/>(Delta Lake / Parquet / JSONL)"]
        PROM["Prometheus"]
        OTEL["OpenTelemetry"]
    end

    subgraph Interfaces["interfaces layer"]
        CLI["CLI Commands<br/>(Click)"]
        HTTP_IF["HTTP Interface"]
        ORCH["Orchestration"]
    end

    subgraph Composition["composition layer"]
        BOOTSTRAP["Bootstrap / Assembly"]
        FACTORIES["Factories"]
        PROVIDERS["Provider Registry"]
        RT_BUILDERS["Runtime Builders"]
    end

    subgraph Application["application layer"]
        CORE["Core<br/>(Runner, BatchExecutor,<br/>Transformer, Writer)"]
        SERVICES["Services<br/>(DQ, Export, Health,<br/>Medallion Lifecycle)"]
        COMPOSITE["Composite Pipeline<br/>(Coordinator, Merger,<br/>FSM)"]
        PIPELINES["Pipeline Transformers<br/>(per provider)"]
        OBSERVER["Observability<br/>(PipelineObserver)"]
    end

    subgraph Domain["domain layer (pure, no I/O)"]
        PORTS["Port Protocols<br/>(DataSourcePort, StoragePort,<br/>LockPort, MetricsPort, ...)"]
        ENTITIES["Entities & Aggregates<br/>(Batch, PipelineRun,<br/>BaseEntity)"]
        VO["Value Objects<br/>(BronzeWriteResult,<br/>SilverWriteResult, ...)"]
        CFG["Configuration<br/>(PipelineConfig,<br/>RuntimeConfig, DQConfig)"]
        DOM_SVC["Domain Services<br/>(Identity, Normalization,<br/>UnitConverter)"]
        TYPES["Types & Enums<br/>(RunType, HealthStatus,<br/>PublicationType)"]
        EXCEPTIONS["Exception Hierarchy<br/>(BioETLError tree)"]
        SCHEMAS["Schemas<br/>(Pandera DataFrameModel)"]
    end

    subgraph Infrastructure["infrastructure layer"]
        ADAPTERS["HTTP Adapters<br/>(ChEMBL, PubMed, UniProt,<br/>CrossRef, OpenAlex, S2, PubChem)"]
        STORAGE["Storage<br/>(BronzeWriter, SilverWriter,<br/>GoldWriter, DeltaReader)"]
        OBS_INFRA["Observability Infra<br/>(UnifiedLogger, Metrics,<br/>Tracing)"]
        RESILIENCE["Resilience<br/>(CircuitBreaker,<br/>TokenBucket, Retry)"]
        SECURITY["Security<br/>(PII Hasher)"]
        CHECKPOINT["Checkpoint<br/>(LocalCheckpoint)"]
        LOCKING["Locking<br/>(MemoryLock)"]
        AUDIT["Audit<br/>(FileAuditAdapter)"]
        VALIDATION["Validation<br/>(Pandera Validators)"]
    end

    %% External → Infrastructure
    ExternalAPIs -.-> ADAPTERS
    FS -.-> STORAGE
    PROM -.-> OBS_INFRA
    OTEL -.-> OBS_INFRA

    %% Interfaces → Composition
    CLI --> BOOTSTRAP
    HTTP_IF --> BOOTSTRAP
    ORCH --> BOOTSTRAP

    %% Composition → Application
    BOOTSTRAP --> CORE
    FACTORIES --> CORE
    FACTORIES --> PIPELINES
    RT_BUILDERS --> CORE

    %% Composition → Infrastructure
    BOOTSTRAP --> ADAPTERS
    BOOTSTRAP --> STORAGE
    BOOTSTRAP --> OBS_INFRA

    %% Application → Domain
    CORE --> PORTS
    CORE --> ENTITIES
    CORE --> VO
    SERVICES --> PORTS
    COMPOSITE --> PORTS
    PIPELINES --> ENTITIES
    PIPELINES --> DOM_SVC

    %% Infrastructure → Domain (implements Ports)
    ADAPTERS -->|implements| PORTS
    STORAGE -->|implements| PORTS
    OBS_INFRA -->|implements| PORTS
    RESILIENCE -->|implements| PORTS
    CHECKPOINT -->|implements| PORTS
    LOCKING -->|implements| PORTS
    AUDIT -->|implements| PORTS
    SECURITY -->|implements| PORTS

    classDef domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef app fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef infra fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef comp fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef iface fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef ext fill:#eceff1,stroke:#455a64,stroke-width:1px

    class PORTS,ENTITIES,VO,CFG,DOM_SVC,TYPES,EXCEPTIONS,SCHEMAS domain
    class CORE,SERVICES,COMPOSITE,PIPELINES,OBSERVER app
    class ADAPTERS,STORAGE,OBS_INFRA,RESILIENCE,SECURITY,CHECKPOINT,LOCKING,AUDIT,VALIDATION infra
    class BOOTSTRAP,FACTORIES,PROVIDERS,RT_BUILDERS comp
    class CLI,HTTP_IF,ORCH iface
    class CHEMBL_API,PUBMED_API,UNIPROT_API,PUBCHEM_API,CROSSREF_API,OPENALEX_API,SEMSCHOLAR_API,FS,PROM,OTEL ext

    linkStyle default stroke:#666,stroke-width:1px,color:#666
    linkStyle 1,2,3,4 stroke-dasharray: 5 5
    linkStyle 19,20,21,22,23,24,25,26 stroke:#c62828,stroke-width:2px
