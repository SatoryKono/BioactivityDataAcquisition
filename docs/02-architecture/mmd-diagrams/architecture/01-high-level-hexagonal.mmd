%% BioETL — High-Level Hexagonal Architecture
%% Shows the Ports & Adapters (Hexagonal) pattern across all layers.

%% @version 1.1.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   39

%%{init: {'theme': 'base'}}%%
%% @uniform width=208 height=72 max_title_len=21 max_desc_lines=2
graph TB
%% keep-orphan: CFG, EXCEPTIONS, OBSERVER, PROVIDERS, SCHEMAS, TYPES, VALIDATION
    subgraph External["External Systems"]
        subgraph ExternalAPIs["External APIs"]
        end
        FS["File System&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Delta Lake / Parquet / JSONL)<br/>&nbsp;"]
        PROM["Prometheus&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        OTEL["OpenTelemetry&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Interfaces["interfaces layer"]
        CLI["CLI Commands&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Click)<br/>&nbsp;"]
        HTTP_IF["HTTP Interface&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        ORCH["Orchestration&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Composition["composition layer"]
        BOOTSTRAP["Bootstrap / Assembly&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        FACTORIES["Factories&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        PROVIDERS["Provider Registry&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        RT_BUILDERS["Runtime Builders&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Application["application layer"]
        CORE["Core&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Runner, BatchExecutor,<br/>Transformer, Writer)"]
        SERVICES["Services&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(DQ, Export, Health,<br/>Medallion Lifecycle)"]
        COMPOSITE["Composite Pipeline&nbsp;&nbsp;&nbsp;<br/>(Coordinator, Merger,<br/>FSM)"]
        PIPELINES["Pipeline Transformers<br/>(per provider)<br/>&nbsp;"]
        OBSERVER["Observability&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(PipelineObserver)<br/>&nbsp;"]
    end

    subgraph Domain["domain layer (pure, no I/O)"]
        PORTS["Port Protocols&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(DataSourcePort, StoragePort,<br/>LockPort, MetricsPort, ...)"]
        ENTITIES["Entities & Aggregates<br/>(Batch, PipelineRun,<br/>BaseEntity)"]
        VO["Value Objects&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(BronzeWriteResult,<br/>SilverWriteResult, ...)"]
        CFG["Configuration&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(PipelineConfig,<br/>RuntimeConfig, DQConfig)"]
        DOM_SVC["Domain Services&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Identity, Normalization,<br/>UnitConverter)"]
        TYPES["Types & Enums&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(RunType, HealthStatus,<br/>PublicationType)"]
        EXCEPTIONS["Exception Hierarchy&nbsp;&nbsp;<br/>(BioETLError tree)<br/>&nbsp;"]
        SCHEMAS["Schemas&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Pandera DataFrameModel)<br/>&nbsp;"]
    end

    subgraph Infrastructure["infrastructure layer"]
        ADAPTERS["HTTP Adapters&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(ChEMBL, PubMed, UniProt,<br/>CrossRef, OpenAlex, S2, PubChem)"]
        STORAGE["Storage&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(BronzeWriter, SilverWriter,<br/>GoldWriter, DeltaReader)"]
        OBS_INFRA["Observability Infra&nbsp;&nbsp;<br/>(UnifiedLogger, Metrics,<br/>Tracing)"]
        RESILIENCE["Resilience&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(CircuitBreaker,<br/>TokenBucket, Retry)"]
        SECURITY["Security&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(PII Hasher)<br/>&nbsp;"]
        CHECKPOINT["Checkpoint&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(LocalCheckpoint)<br/>&nbsp;"]
        LOCKING["Locking&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(MemoryLock)<br/>&nbsp;"]
        AUDIT["Audit&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(FileAuditAdapter)<br/>&nbsp;"]
        VALIDATION["Validation&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Pandera Validators)<br/>&nbsp;"]
    end

    %% External → Infrastructure
    ExternalAPIs -.-> ADAPTERS
    FS -.-> STORAGE
    PROM -.-> OBS_INFRA
    OTEL -.-> OBS_INFRA

    %% Interfaces → Composition
    CLI --> BOOTSTRAP
    HTTP_IF --> BOOTSTRAP
    ORCH --> BOOTSTRAP

    %% Composition → Application
    BOOTSTRAP --> CORE
    FACTORIES --> CORE
    FACTORIES --> PIPELINES
    RT_BUILDERS --> CORE

    %% Composition → Infrastructure
    BOOTSTRAP --> ADAPTERS
    BOOTSTRAP --> STORAGE
    BOOTSTRAP --> OBS_INFRA

    %% Application → Domain
    CORE --> PORTS
    CORE --> ENTITIES
    CORE --> VO
    SERVICES --> PORTS
    COMPOSITE --> PORTS
    PIPELINES --> ENTITIES
    PIPELINES --> DOM_SVC

    %% Infrastructure → Domain (implements Ports)
    ADAPTERS -->|implements| PORTS
    STORAGE -->|implements| PORTS
    OBS_INFRA -->|implements| PORTS
    RESILIENCE -->|implements| PORTS
    CHECKPOINT -->|implements| PORTS
    LOCKING -->|implements| PORTS
    AUDIT -->|implements| PORTS
    SECURITY -->|implements| PORTS

    classDef domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef app fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef infra fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef comp fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef iface fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef ext fill:#eceff1,stroke:#455a64,stroke-width:1px

    class PORTS,ENTITIES,VO,CFG,DOM_SVC,TYPES,EXCEPTIONS,SCHEMAS domain
    class CORE,SERVICES,COMPOSITE,PIPELINES,OBSERVER app
    class ADAPTERS,STORAGE,OBS_INFRA,RESILIENCE,SECURITY,CHECKPOINT,LOCKING,AUDIT,VALIDATION infra
    class BOOTSTRAP,FACTORIES,PROVIDERS,RT_BUILDERS comp
    class CLI,HTTP_IF,ORCH iface
    class CHEMBL_API,PUBMED_API,UNIPROT_API,PUBCHEM_API,CROSSREF_API,OPENALEX_API,SEMSCHOLAR_API,FS,PROM,OTEL ext

    linkStyle default stroke:#666,stroke-width:1px,color:#666
    linkStyle 1,2,3,4 stroke-dasharray: 5 5
    linkStyle 19,20,21,22,23,24,25,26 stroke:#c62828,stroke-width:2px
