%% BioETL — BatchExecutor Internal Architecture
%% Shows the composition of BatchExecutor and its helper components.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   15
%% @uniform width=200 height=234 max_title_len=20 max_desc_lines=11

graph TB
    subgraph BatchExecutor["BatchExecutor"]
        BE["BatchExecutor&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>_services: PipelineServices<br/>_context: PipelineContext<br/>_config: RecordProcessorConfig<br/>batch_size: int<br/>checkpoint_interval: int<br/>━━━━━━━━━━━━━━━━━<br/>+ execute(limit, query, offset)<br/>+ process(records, start_index)<br/>+ get_dq_context()<br/>+ get_run_statistics()"]
    end

    subgraph Helpers["Composed Helper Components"]
        BMM["BatchMemoryManager&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>_memory_monitor: MemoryMonitorPort<br/>_memory_config: MemoryConfig<br/>_initial_batch_size: int<br/>━━━━━━━━━━━━━━━━━<br/>+ check_pressure() → new_size<br/>+ maybe_recover() → new_size<br/>Adaptive batch sizing:<br/>reduces under memory pressure,<br/>recovers when pressure drops<br/>&nbsp;"]

        BMR["BatchMetricsRecorder<br/>━━━━━━━━━━━━━━━━━<br/>_metrics: MetricsPort<br/>_pipeline_label: str<br/>_run_type_label: str<br/>━━━━━━━━━━━━━━━━━<br/>+ track_batch_size(stage, size)<br/>+ track_processed_records(stage, count)<br/>+ track_error(stage, error_type)<br/>+ track_quarantined_records()<br/>&nbsp;<br/>&nbsp;"]

        BTM["BatchTracingManager&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>_tracer: TracingPort<br/>TRACER_NAME = 'bioetl.batch_executor'<br/>━━━━━━━━━━━━━━━━━<br/>+ start_execution_span()<br/>+ start_batch_span(batch_id)<br/>+ start_layer_span(name)<br/>+ end_span(span, error)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]

        BT["BatchTransformer&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>_transform: TransformCallback<br/>_gold_filter: GoldFilterCallback<br/>_gold_transform: GoldTransformCallback<br/>_error_classifier: ErrorClassifier<br/>━━━━━━━━━━━━━━━━━<br/>+ transform_batch(records, batch_id)<br/>+ transform_single(record)<br/>+ _check_dq_thresholds()<br/>&nbsp;<br/>&nbsp;"]

        BW["BatchWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>_storage: StoragePort<br/>_gold_validator: GoldValidatorPort<br/>_lock_validator: Callable<br/>━━━━━━━━━━━━━━━━━<br/>+ write_bronze(records, batch_id)<br/>+ write_silver(records, batch_id)<br/>+ write_gold(records)<br/>+ _validate_lock() — Safety Guard<br/>&nbsp;<br/>&nbsp;"]

        QM["QuarantineManager&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>_quarantine: QuarantinePort<br/>━━━━━━━━━━━━━━━━━<br/>+ quarantine_record(raw, error_type,<br/>batch_id, error_msg, ts)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]

        CM["CheckpointManager&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>_checkpoint: CheckpointPort<br/>━━━━━━━━━━━━━━━━━<br/>+ load_checkpoint()<br/>+ save_checkpoint(offset)<br/>+ delete_checkpoint()<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph DataFlow["Data Flow Through Batch"]
        direction LR
        RAW["Raw API Records&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(dict[str, Any])<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        SILVER["Silver Records&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Delta Lake)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]

        RAW -->|"write_bronze()"| BRONZE
        RAW -->|"transform_batch()"| SILVER
        SILVER -->|"write_gold()"| GOLD
        RAW -->|"on error"| QUAR
    end

    subgraph TransformResult["TransformResult"]
        TR["TransformResult&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>silver_records: list[SilverRecord]<br/>gold_records: list[dict]<br/>quarantined_count: int<br/>errors: list[TransformError]<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph ErrorClassification["Error Classification"]
        ECL["ErrorClassifier&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>Classifies exceptions as:<br/>• QUARANTINE (data issue)<br/>• RETRY (transient)<br/>• FATAL (stop pipeline)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    %% Composition
    BE --> BMM
    BE --> BMR
    BE --> BTM
    BE --> BT
    BE --> BW
    BE --> QM
    BE --> CM

    %% Transform produces result
    BT --> TR
    BT --> ECL

    %% Writer uses lock validation
    BW -.->|"Safety Guard"| CM

    classDef executor fill:#e3f2fd,stroke:#1565c0,stroke-width:3px
    classDef helper fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef data fill:#c8e6c9,stroke:#2e7d32
    classDef result fill:#f3e5f5,stroke:#6a1b9a
    classDef error fill:#ffcdd2,stroke:#c62828

    class BE executor
    class BMM,BMR,BTM,BT,BW,QM,CM helper
    class RAW,BRONZE,SILVER,GOLD data
    class QUAR error
    class TR result
    class ECL error
