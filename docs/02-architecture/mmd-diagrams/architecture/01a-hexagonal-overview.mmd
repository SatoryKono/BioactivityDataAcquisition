graph TB
    subgraph Interfaces["Interfaces Layer"]
        CLI["CLI Commands (Click)"]
        ORCH["Orchestration"]
    end

    subgraph Composition["Composition Layer"]
        BOOTSTRAP["Bootstrap / Assembly"]
    end

    subgraph Application["Application Layer"]
        CORE["Application Core"]
    end

    subgraph Domain["Domain Layer"]
        PORTS["Port Protocols"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        ADAPTERS["Provider Adapters"]
        STORAGE["Storage Writers / Reader"]
        OBS_INFRA["Observability Infra"]
    end

    ExternalAPIs["External APIs"]
    FS["File System"]
    PROM["Prometheus"]
    OTEL["OpenTelemetry"]

    ExternalAPIs -.-> ADAPTERS
    FS -.-> STORAGE
    PROM -.-> OBS_INFRA
    OTEL -.-> OBS_INFRA
    CLI --> BOOTSTRAP
    ORCH --> BOOTSTRAP
    BOOTSTRAP --> CORE
    BOOTSTRAP --> ADAPTERS
    BOOTSTRAP --> STORAGE
    BOOTSTRAP --> OBS_INFRA
    CORE --> PORTS
    ADAPTERS -->|implements| PORTS
    STORAGE -->|implements| PORTS
    OBS_INFRA -->|implements| PORTS

    classDef domain fill:#f3e5f5,stroke:#6a1b9a
    classDef app fill:#e8f5e9,stroke:#2e7d32
    classDef infra fill:#ffcdd2,stroke:#c62828
    classDef comp fill:#fff3e0,stroke:#e65100
    classDef iface fill:#e3f2fd,stroke:#1565c0
    classDef ext fill:#eceff1,stroke:#455a64

    class CLI,ORCH iface
    class BOOTSTRAP comp
    class CORE app
    class PORTS domain
    class ADAPTERS,STORAGE,OBS_INFRA infra
    class ExternalAPIs,FS,PROM,OTEL ext
