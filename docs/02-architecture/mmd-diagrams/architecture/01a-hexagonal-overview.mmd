graph TB
    subgraph Interfaces["Interfaces Layer"]
        CLI["CLI Commands (Click)&nbsp;&nbsp;&nbsp;&nbsp;"]
        ORCH["Orchestration&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Composition["Composition Layer"]
        BOOTSTRAP["Bootstrap / Assembly&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Application["Application Layer"]
        CORE["Application Core&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Domain["Domain Layer"]
        PORTS["Port Protocols&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        ADAPTERS["Provider Adapters&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        STORAGE["Storage Writers / Reader"]
        OBS_INFRA["Observability Infra&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    ExternalAPIs["External APIs&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    FS["File System&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    PROM["Prometheus&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    OTEL["OpenTelemetry&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]

    ExternalAPIs -.-> ADAPTERS
    FS -.-> STORAGE
    PROM -.-> OBS_INFRA
    OTEL -.-> OBS_INFRA
    CLI --> BOOTSTRAP
    ORCH --> BOOTSTRAP
    BOOTSTRAP --> CORE
    BOOTSTRAP --> ADAPTERS
    BOOTSTRAP --> STORAGE
    BOOTSTRAP --> OBS_INFRA
    CORE --> PORTS
    ADAPTERS -->|implements| PORTS
    STORAGE -->|implements| PORTS
    OBS_INFRA -->|implements| PORTS

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
