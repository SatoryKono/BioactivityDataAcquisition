%% BioETL — Hexagonal Architecture Overview (simplified)
%% Shows 5 layers + external systems + primary dependency arrows

%% @version 1.0.0
%% @date    2026-02-25
%% @type    flowchart
%% @level   System / Component
%% @view    overview
%% @parent  01-high-level-hexagonal.mmd
%% @nodes   11

graph TB
    subgraph External["External Systems"]
        APIs["7 External APIs"]
        FS["File System<br/>(Delta Lake / Parquet)"]
    end

    subgraph Interfaces["Interfaces Layer"]
        CLI["CLI (Click)"]
    end

    subgraph Composition["Composition Layer"]
        BOOTSTRAP["Bootstrap / Assembly"]
        FACTORIES["Factories"]
    end

    subgraph Application["Application Layer"]
        CORE["Core (Runner, Executor,<br/>Transformer, Writer)"]
        SERVICES["Services (DQ, Health,<br/>Medallion Lifecycle)"]
    end

    subgraph Domain["Domain Layer (pure, no I/O)"]
        PORTS["Port Protocols"]
        ENTITIES["Entities & Value Objects"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        ADAPTERS["HTTP Adapters"]
        STORAGE["Storage Writers"]
    end

    CLI --> BOOTSTRAP
    BOOTSTRAP --> CORE
    FACTORIES --> CORE
    CORE --> PORTS
    SERVICES --> PORTS
    ADAPTERS -->|implements| PORTS
    STORAGE -->|implements| PORTS
    APIs -.-> ADAPTERS
    FS -.-> STORAGE

    classDef domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef app fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef infra fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef comp fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef iface fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef ext fill:#eceff1,stroke:#455a64,stroke-width:1px

    class PORTS,ENTITIES domain
    class CORE,SERVICES app
    class ADAPTERS,STORAGE infra
    class BOOTSTRAP,FACTORIES comp
    class CLI iface
    class APIs,FS ext
