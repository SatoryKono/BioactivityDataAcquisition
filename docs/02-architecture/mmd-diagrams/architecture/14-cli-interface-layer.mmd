%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   24

%% @uniform width=248 height=72 max_title_len=26 max_desc_lines=2
%%{init: {'layout': 'elk', 'theme': 'base', 'themeVariables': {'fontFamily': 'Inter, Roboto, sans-serif'}, 'elk': {'mergeEdges': true, 'nodePlacementStrategy': 'BRANDES_KOEPF', 'cycleBreakingStrategy': 'GREEDY', 'spacing.nodeNode': 40, 'spacing.edgeNode': 30, 'spacing.edgeEdge': 20, 'edgeRouting': 'POLYLINE'}}}%%
graph LR
    subgraph User["User"]
        TERM["Terminal<br/><br/>"]:::size-md
    end

    subgraph CLI["CLI Interface (Click)"]
        MAIN["bioetl<br/>(main group)<br/>"]:::size-md
        subgraph RunCmds["Run Commands"]
            RUN["bioetl run<br/>━━━━━━━━━━━━━━━━━<br/>--provider<br/>--entity<br/>--run-type<br/>--limit<br/>--resume<br/>--dry-run"]:::size-lg
            RUN_COMP["bioetl run-composite<br/>━━━━━━━━━━━━━━━━━<br/>--config<br/>--run-type<br/>--resume"]:::size-md
        end

        subgraph HealthCmds["Health Commands"]
            HEALTH["bioetl health<br/>━━━━━━━━━━━━━━━━━<br/>--provider<br/>Check API health"]:::size-md
        end

        subgraph DataCmds["Data Commands"]
            EXPORT["bioetl export<br/>━━━━━━━━━━━━━━━━━<br/>--table<br/>--format csv"]:::size-md
            QUARANTINE["bioetl quarantine<br/>━━━━━━━━━━━━━━━━━<br/>inspect / replay / purge"]:::size-md
            CHECKPOINT["bioetl checkpoint<br/>━━━━━━━━━━━━━━━━━<br/>list / delete"]:::size-md
        end

        subgraph MaintenanceCmds["Maintenance Commands"]
            VACUUM["bioetl maintenance vacuum<br/>━━━━━━━━━━━━━━━━━<br/>--table / --all"]:::size-md
            ARCHIVE["bioetl maintenance archive<br/>━━━━━━━━━━━━━━━━━<br/>Archive old data"]:::size-md
        end

        subgraph ConfigCmds["Config Commands"]
            CONFIG["bioetl config<br/>━━━━━━━━━━━━━━━━━<br/>list / show"]:::size-md
        end
    end

    subgraph Composition["Composition Layer"]
        BOOT["Bootstrap Assembly<br/><br/>"]:::size-md
        RF["RunnerFactory<br/><br/>"]:::size-md
        DSR["DataSourceRegistry<br/><br/>"]:::size-md
        TF["TransformerFactory<br/><br/>"]:::size-md
    end

    subgraph Application["Application Layer"]
        CPR["CompositePipelineRunner<br/><br/>"]:::size-md
        HS["HealthService<br/><br/>"]:::size-md
        ES["ExportService<br/><br/>"]:::size-md
        QS["QuarantineService<br/><br/>"]:::size-md
        CS["CheckpointService<br/><br/>"]:::size-md
        VS["VacuumService<br/><br/>"]:::size-md
        CFGS["ConfigService<br/><br/>"]:::size-md
    end

    %% CLI routing
    TERM --> MAIN
    MAIN --> RUN & RUN_COMP & HEALTH & EXPORT & QUARANTINE & CHECKPOINT & VACUUM & ARCHIVE & CONFIG

    %% CLI → Composition
    RUN --> BOOT
    RUN_COMP --> BOOT

    %% Composition → Application
    BOOT --> RF --> PRS
    BOOT --> DSR
    BOOT --> TF
    RUN_COMP --> CPR

    %% Direct CLI → Application
    HEALTH --> HS
    EXPORT --> ES
    QUARANTINE --> QS
    CHECKPOINT --> CS
    VACUUM --> VS
    ARCHIVE --> VS
    CONFIG --> CFGS

    %% Shutdown
    MAIN -.->|"SIGINT/SIGTERM"| SS

    classDef user fill:#f1f5f9,stroke:#64748b,stroke-width:1.5px
    classDef cli fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    classDef comp fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:2px

    class TERM user
    class MAIN,RUN,RUN_COMP,HEALTH,EXPORT,QUARANTINE,CHECKPOINT,VACUUM,ARCHIVE,CONFIG cli
    class BOOT,RF,DSR,TF comp
    class PRS,CPR,HS,ES,QS,CS,VS,CFGS,SS app
