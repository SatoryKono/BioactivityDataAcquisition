graph LR
    TERM["Terminal user"]:::size-md

    subgraph CLI["interfaces/cli"]
        MAIN["cli.main<br/>Click group"]:::size-md
        REG["registry_helpers<br/>fresh explicit PipelineRegistry"]:::size-md
        RUN["run / run-all"]:::size-md
        RC["run-composite"]:::size-md
        ADM["health / export / quarantine / checkpoint<br/>config / lock / maintenance"]:::size-lg
    end

    subgraph Composition["composition boundary"]
        ENTRY["composition.entrypoints<br/>retained public facade"]:::size-md
        BOOTR["bootstrap.runtime<br/>pipeline + composite execution"]:::size-md
        BOOTC["bootstrap.cli<br/>admin / maintenance services"]:::size-md
        PIPE["PipelineRegistry"]:::size-md
    end

    subgraph Runtime["Created runtime services"]
        PRUN["PipelineRunnerService"]:::size-md
        CRUN["CompositePipelineRunnerService"]:::size-md
        ASVC["Admin services<br/>health / export / checkpoint / vacuum"]:::size-md
        HSRV["HTTP HealthServer<br/>optional command mode"]:::size-md
    end

    TERM --> MAIN
    MAIN --> RUN
    MAIN --> RC
    MAIN --> ADM

    RUN --> REG --> PIPE
    RUN --> ENTRY
    RC --> ENTRY
    ADM --> ENTRY

    ENTRY --> BOOTR
    ENTRY --> BOOTC

    BOOTR --> PRUN
    BOOTR --> CRUN
    BOOTC --> ASVC
    ADM -.->|"server mode"| HSRV
    ENTRY -.->|"health deps"| HSRV

    NOTE["CLI main avoids direct composition imports for registry setup;<br/>command modules load composition entrypoints on demand."]:::size-md
    REG -.-> NOTE

    classDef user fill:#f1f5f9,stroke:#64748b
