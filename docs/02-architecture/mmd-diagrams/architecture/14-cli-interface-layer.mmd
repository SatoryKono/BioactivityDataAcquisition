    %% CLI routing
    TERM --> MAIN
    MAIN --> RUN & RUN_COMP & HEALTH & EXPORT & QUARANTINE & CHECKPOINT & VACUUM & ARCHIVE & CONFIG

    %% CLI → Composition
    RUN --> BOOT
    RUN_COMP --> BOOT

    %% Composition → Application
    BOOT --> RF --> PRS
    BOOT --> DSR
    BOOT --> TF
    RUN_COMP --> CPR

    %% Direct CLI → Application
    HEALTH --> HS
    EXPORT --> ES
    QUARANTINE --> QS
    CHECKPOINT --> CS
    VACUUM --> VS
    ARCHIVE --> VS
    CONFIG --> CFGS

    %% Shutdown
    MAIN -.->|"SIGINT/SIGTERM"| SS

