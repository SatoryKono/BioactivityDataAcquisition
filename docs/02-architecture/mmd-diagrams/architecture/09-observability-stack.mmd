graph TB
%% keep-orphan: DQMP
    subgraph Ports["Domain Ports"]
        LP["LoggerPort (Protocol)<br/>bind(**kwargs)<br/>info/warning/error/debug<br/>exception(msg, **fields)"]:::size-lg
        MP["MetricsPort<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ observe_histogram(name, value, labels)<br/>+ increment_counter(name, labels)<br/>+ set_gauge(name, value, labels)<br/>+ close()"]:::size-lg
        TP["TracingPort<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ get_tracer(name) → Tracer<br/>+ close()"]:::size-lg
        DQMP["DQMonitorPort<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ add_metric(name, value)<br/>+ check_quality()<br/>+ update_baseline_from_metrics()"]:::size-lg
    end

    subgraph AppObserver["Application Observability"]
        PO["PipelineObserver<br/>metrics + logger + tracer<br/>emit_event(event)<br/>on_preflight()/on_execution()<br/>on_postrun()"]:::size-lg
        BMR["BatchMetricsRecorder<br/>━━━━━━━━━━━━━━━━━<br/>+ track_batch_size()<br/>+ track_processed_records()<br/>+ track_error()<br/>+ track_quarantined_records()"]:::size-lg
        BTM["BatchTracingManager<br/>━━━━━━━━━━━━━━━━━<br/>+ start_execution_span()<br/>+ start_batch_span()<br/>+ start_layer_span()<br/>+ end_span()"]:::size-lg
    end

    subgraph InfraLogging["Infrastructure: Logging"]
        UL["UnifiedLogger<br/>(implements LoggerPort)<br/>━━━━━━━━━━━━━━━━━<br/>Structured JSON output<br/>Log Schema enforcement<br/>Secret filtering"]:::size-lg
    end

    subgraph InfraMetrics["Infrastructure: Metrics"]
        MC["MetricsCollector<br/>(implements MetricsPort)"]:::size-lg
        PM["PrometheusMetrics<br/>(implements MetricsPort)<br/>━━━━━━━━━━━━━━━━━<br/>Histograms, Counters,<br/>Gauges for Prometheus"]:::size-lg
        MSA["MetricsServerAdapter<br/>━━━━━━━━━━━━━━━━━<br/>HTTP server for<br/>/metrics endpoint"]:::size-lg
    end

    subgraph InfraTracing["Infrastructure: Tracing"]
        OTT["OpenTelemetryTracer<br/>(implements TracingPort)<br/>━━━━━━━━━━━━━━━━━<br/>OTLP export<br/>Span management"]:::size-lg
    end

    subgraph InfraAnomaly["Infrastructure: Anomaly Detection"]
        AD["AnomalyDetector"]:::size-lg
        DS["DetectorStrategy (ABC)"]:::size-lg
        ZSD["ZScoreDetector"]:::size-lg
        DS --> ZSD
        AD --> DS
    end

    subgraph AdapterMetrics["Adapter-Level Metrics"]
        AM["AdapterMetrics<br/>provider: str<br/>measure_request() context<br/>metrics: duration + total"]:::size-lg
    end

    subgraph External["External Systems"]
        PROM["Prometheus Server"]:::size-lg
        GRAFANA["Grafana Dashboards"]:::size-lg
        OTEL_COL["OpenTelemetry Collector"]:::size-lg
    end

    %% Port implementations
    LP -.-> UL & SL & NOL
    MP -.-> MC & PM & NOM
    TP -.-> OTT & NOT

    %% Application usage
    PO --> LP & MP & TP
    BMR --> MP
    BTM --> TP

    %% Adapter metrics
    AM --> MP

    %% Infrastructure to external
    PM --> MSA --> PROM --> GRAFANA
    OTT --> OTEL_COL --> JAEGER

