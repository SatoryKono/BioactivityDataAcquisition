graph TB
%% keep-orphan: CBDSD, RDSD, R_CR, R_OA, R_PC, R_PM, R_SS, R_UP
    subgraph Ports["Domain Ports"]
        CBP["CircuitBreakerPort&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ get_state() → CircuitBreakerState<br/>+ get_failure_count() → int<br/>+ call(fn) → T<br/>+ reset()<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        RLP["RateLimiterPort&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ acquire(tokens)<br/>+ try_acquire() → bool<br/>+ available_tokens() → int<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        HCP["HealthCheckPort&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ check_health() → HealthCheckResult<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph CircuitBreaker["Circuit Breaker Pattern"]
        CB["CircuitBreaker&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>provider: str<br/>failure_threshold: int<br/>recovery_timeout: int<br/>metrics: MetricsPort<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]

        subgraph CBStates["State Machine"]
            CLOSED["CLOSED&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(normal operation)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            OPEN["OPEN&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(fail fast,<br/>no requests)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            HALF["HALF_OPEN&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(probe with<br/>single request)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]

            CLOSED -->|"failures ≥ threshold"| OPEN
            OPEN -->|"recovery_timeout elapsed"| HALF
            HALF -->|"success"| CLOSED
            HALF -->|"failure"| OPEN
        end
    end

    subgraph RateLimiter["Rate Limiter (Token Bucket)"]
        TB["TokenBucket&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>rate: float<br/>capacity: int<br/>provider: str<br/>metrics: MetricsPort<br/>━━━━━━━━━━━━━━━━━<br/>+ acquire(tokens=1)<br/>waits until tokens available<br/>+ _refill()<br/>replenish based on elapsed time"]

        subgraph Rates["Provider Rate Limits"]
            R_PC["PubChem: 5 req/s&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            R_UP["UniProt: 100 req/s&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            R_OA["OpenAlex: 10 req/s&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            R_CR["CrossRef: 50 req/s&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            R_SS["Semantic Scholar: 0.33 req/s&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            R_PM["PubMed: 3-10 req/s&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        end
    end

    subgraph Retry["Retry Logic"]
        RP["Retry (in UnifiedHTTPClient)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>max_retries: int<br/>backoff_factor: float<br/>retry_on: set[int]<br/>━━━━━━━━━━━━━━━━━<br/>Exponential backoff<br/>with jitter<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph HealthCheck["Health Check Template"]
        HCPM["HealthCheckProviderMixin&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>Template Method Pattern:<br/>1. _probe_health() — override<br/>2. Log success/failure<br/>3. Record metrics<br/>4. Return HealthCheckResult<br/>5. Fallback to CB state<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]

        HCR["HealthCheckResult&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>status: HealthStatus<br/>latency_ms: float<br/>provider: str<br/>endpoint: str<br/>last_error: str | None<br/>consecutive_failures: int<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]

        HS["HealthStatus&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>HEALTHY<br/>DEGRADED<br/>UNHEALTHY<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Client["UnifiedHTTPClient"]
        UHC["UnifiedHTTPClient&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>Composes all patterns:<br/>1. acquire rate limiter<br/>2. check circuit breaker<br/>3. attempt request<br/>4. retry on failure<br/>5. record metrics<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Decorators["Data Source Decorators"]
        CBDSD["CircuitBreakerDataSourceDecorator<br/>━━━━━━━━━━━━━━━━━<br/>Wraps DataSourcePort<br/>with circuit breaker<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        RDSD["RetryingDataSourceDecorator&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>Wraps DataSourcePort<br/>with retry logic<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    %% Port implementations
    CBP -.-> CB
    RLP -.-> TB
    HCP -.-> HCPM

    %% Client composition
    UHC --> TB
    UHC --> CB
    UHC --> RP

    %% Health check
    HCPM --> CB
    HCPM --> HCR
    HCR --> HS

    classDef port fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef pattern fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef state fill:#fff3e0,stroke:#e65100
    classDef health fill:#f3e5f5,stroke:#6a1b9a
    classDef client fill:#fce4ec,stroke:#b71c1c,stroke-width:2px
    classDef decorator fill:#eceff1,stroke:#455a64

    class CBP,RLP,HCP port
    class CB,TB,RP pattern
    class CLOSED,OPEN,HALF state
    class HCPM,HCR,HS health
    class UHC client
    class CBDSD,RDSD decorator
