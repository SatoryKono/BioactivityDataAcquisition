%% keep-orphan: FDSP
    subgraph Domain["Domain Ports"]
        DSP["fa:fa-plug DataSourcePort"]
        FDSP["fa:fa-filter FilterableDataSourcePort"]
        STP["fa:fa-database StoragePort"]
        DRP["fa:fa-book-open DeltaReaderPort"]
        IFP["fa:fa-file-import InputFilterPort"]
    end

    subgraph Infrastructure["Implementations"]
        CA["ChemblAdapter"]
        PA["PubchemAdapter"]
        UA["UniprotAdapter"]
        BW["BronzeWriter"]
        SW["SilverWriter"]
        GW["GoldWriter"]
        DR_I["DeltaReader"]
        CSVR["CsvFilterReader"]
    end

    DSP --- CA & PA & UA
    STP --- BW & SW & GW
    DRP --- DR_I
    IFP --- CSVR

    classDef domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef infra  fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef data   fill:#f8fafc,stroke:#475569,stroke-width:2px

    class DSP,FDSP,STP,DRP,IFP domain
    class CA,PA,UA infra
    class BW,SW,GW,DR_I,CSVR data
