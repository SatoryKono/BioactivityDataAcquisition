%% keep-orphan: FDSP
    subgraph Domain["Domain Ports"]
        DSP["fa:fa-plug DataSourcePort"]:::size-sm
        FDSP["fa:fa-filter FilterableDataSourcePort"]:::size-sm
        STP["fa:fa-database StoragePort"]:::size-sm
        DRP["fa:fa-book-open DeltaReaderPort"]:::size-sm
        IFP["fa:fa-file-import InputFilterPort"]:::size-sm
    end

    subgraph Infrastructure["Implementations"]
        CA["ChemblAdapter"]:::size-sm
        PA["PubchemAdapter"]:::size-sm
        UA["UniprotAdapter"]:::size-sm
        BW["BronzeWriter"]:::size-sm
        SW["SilverWriter"]:::size-sm
        GW["GoldWriter"]:::size-sm
        DR_I["DeltaReader"]:::size-sm
        CSVR["CsvFilterReader"]:::size-sm
    end

    DSP --- CA & PA & UA
    STP --- BW & SW & GW
    DRP --- DR_I
    IFP --- CSVR

    classDef domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef infra  fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef data   fill:#f8fafc,stroke:#475569,stroke-width:2px

    class DSP,FDSP,STP,DRP,IFP domain
    class CA,PA,UA infra
    class BW,SW,GW,DR_I,CSVR data
