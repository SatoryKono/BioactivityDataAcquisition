%% @uniform width=336 height=240 max_title_len=37 max_desc_lines=18
graph TB
    subgraph TemplateMethod["Template Method Pattern"]
        BT["BaseTransformer (ABC)<br/>template core<br/>provider/entity<br/>metrics + tracing + pii<br/>transform()"]:::size-lg
    end

    subgraph ChEMBL["ChEMBL Transformers"]
        BCT["BaseChemblTransformer<br/>entity_class + primary_id_field<br/>_extract_business_data()"]:::size-lg
        AT["ActivityTransformer"]:::size-lg
    end

    subgraph Publications["Publication Transformers"]
        BPT["BasePublicationTransformer<br/>validate -> extract -> build<br/>_extract_fields + _build_entity"]:::size-lg
        PMT["PubMedPublicationTransformer<br/>XML parsing + extractor stack"]:::size-lg
    end

    subgraph UniProtTrans["UniProt Transformers"]
        UPT["UniProtProteinTransformer<br/>taxonomy/gene/feature extractors"]:::size-lg
        IDMT["IDMappingTransformer"]:::size-lg
    end

    subgraph Other["Other Transformers"]
        PCCT["PubChemCompoundTransformer"]:::size-lg
    end

    subgraph Extractors["Extractor Pattern"]
        BFE["BaseFieldExtractor (ABC)<br/>extract(record) -> dict"]:::size-lg
        AE["AbstractExtractor"]:::size-lg
    end

    %% Inheritance
    BT --> BCT
    BT --> BPT
    BT --> UPT
    BT --> IDMT
    BT --> PCCT

    BCT --> AT & AST & APT & MT & TGT & TCT & PT & PTT & PST & TIT & CLT & PCT & SFT & CRT

    BPT --> PMT & CRfT & OAT & SST

    %% Extractors
    BFE --> AE & AuE & DE & CE & IE & TE & GE & FE & CRE & CME

    PMT -.->|uses| AuE & DE & CE & IE & AE
    UPT -.->|uses| TE & GE & FE & CRE & CME

    classDef base fill:#f0fdf4,stroke:#16a34a,stroke-width:3px
    classDef chembl fill:#fff7ed,stroke:#f59e0b
    classDef pub fill:#f0fdf4,stroke:#16a34a
    classDef uniprot fill:#f5f3ff,stroke:#7c3aed
    classDef other fill:#f1f5f9,stroke:#64748b
    classDef extractor fill:#fefce8,stroke:#ca8a04

    class BT,BCT,BPT base
    class AT,AST,APT,MT,TGT,TCT,PT,PTT,PST,TIT,CLT,PCT,SFT,CRT chembl
    class PMT,CRfT,OAT,SST pub
    class UPT,IDMT uniprot
    class PCCT other
    class BFE,AE,AuE,DE,CE,IE,TE,GE,FE,CRE,CME extractor
