graph TB
    subgraph TemplateMethod["Template Method Pattern"]
        BT["BaseTransformer (ABC)<br/>━━━━━━━━━━━━━━━━━<br/>provider: str<br/>entity_type: str<br/>_tracer: TracingPort<br/>_metrics: MetricsPort<br/>_identity: IdentityService<br/>_pii_hasher: PiiHasherPort<br/>_data_normalizer: DataNormalizationPort<br/>━━━━━━━━━━━━━━━━━<br/>+ transform(ctx, record, idx) → SilverRecord<br/>  ├ _transform_impl()    ← ABSTRACT HOOK<br/>  ├ compute_entity_id()<br/>  ├ compute_content_hash()<br/>  └ should_write_silver/gold()<br/>+ transform_for_gold(ctx, silver) → dict<br/>+ entity_to_silver_record(entity) → dict<br/>+ hash_pii_value() / hash_pii_list()<br/>+ validate_value_object()"]
    end

    subgraph ChEMBL["ChEMBL Transformers"]
        BCT["BaseChemblTransformer<br/>━━━━━━━━━━━━━━━━━<br/>entity_class: type<br/>primary_id_field: str<br/>━━━━━━━━━━━━━━━━━<br/>+ _extract_business_data()"]

        AT["ActivityTransformer"]
        AST["AssayTransformer"]
        APT["AssayParametersTransformer"]
        MT["MoleculeTransformer"]
        TGT["TargetTransformer"]
        TCT["TargetComponentTransformer"]
        PT["PublicationTransformer"]
        PTT["PublicationTermTransformer"]
        PST["PublicationSimilarityTransformer"]
        TIT["TissueTransformer"]
        CLT["CellLineTransformer"]
        PCT["ProteinClassTransformer"]
        SFT["SubcellularFractionTransformer"]
        CRT["CompoundRecordTransformer"]
    end

    subgraph Publications["Publication Transformers"]
        BPT["BasePublicationTransformer<br/>━━━━━━━━━━━━━━━━━<br/>Pre-extract validation<br/>→ extraction<br/>→ entity creation<br/>━━━━━━━━━━━━━━━━━<br/>+ _extract_fields() ← ABSTRACT<br/>+ _build_entity() ← ABSTRACT"]

        PMT["PubMedPublicationTransformer<br/>uses: XML parsing,<br/>AuthorExtractor,<br/>DateExtractor, etc."]
        CRfT["CrossRefPublicationTransformer<br/>uses: JSON parsing,<br/>extractors"]
        OAT["OpenAlexPublicationTransformer<br/>uses: JSON parsing,<br/>extractors"]
        SST["SemanticScholarPublicationTransformer<br/>uses: JSON parsing,<br/>extractors"]
    end

    subgraph UniProtTrans["UniProt Transformers"]
        UPT["UniProtProteinTransformer<br/>uses: TaxonomyExtractor,<br/>GeneExtractor,<br/>FeatureExtractor,<br/>CrossRefExtractor,<br/>CommentExtractor"]
        IDMT["IDMappingTransformer"]
    end

    subgraph Other["Other Transformers"]
        PCCT["PubChemCompoundTransformer"]
    end

    subgraph Extractors["Extractor Pattern"]
        BFE["BaseFieldExtractor (ABC)<br/>━━━━━━━━━━━━━━━━━<br/>+ extract(record) → dict"]
        AE["AbstractExtractor"]
        AuE["AuthorExtractor"]
        DE["DateExtractor"]
        CE["ClassificationExtractor"]
        IE["IdentifierExtractor"]
        TE["TaxonomyExtractor"]
        GE["GeneExtractor"]
        FE["FeatureExtractor"]
        CRE["CrossRefExtractor"]
        CME["CommentExtractor"]
    end

    %% Inheritance
    BT --> BCT
    BT --> BPT
    BT --> UPT
    BT --> IDMT
    BT --> PCCT

    BCT --> AT & AST & APT & MT & TGT & TCT & PT & PTT & PST & TIT & CLT & PCT & SFT & CRT

    BPT --> PMT & CRfT & OAT & SST

    %% Extractors
    BFE --> AE & AuE & DE & CE & IE & TE & GE & FE & CRE & CME

    PMT -.->|uses| AuE & DE & CE & IE & AE
    UPT -.->|uses| TE & GE & FE & CRE & CME

