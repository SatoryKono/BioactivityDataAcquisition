%% BioETL — Layer Dependency Matrix (ARCH-001)
%% Enforced import boundaries between architectural layers.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   5
%% @uniform width=184 height=96 max_title_len=14 max_desc_lines=3

graph LR
%% keep-orphan: FORBIDDEN, OK
    subgraph Legend
        direction TB
        OK["✅ Allowed&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        FORBIDDEN["❌ Forbidden&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Layers["Architectural Layers"]
        direction TB
        DOMAIN["domain&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(pure business logic,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>no I/O, no frameworks)&nbsp;&nbsp;&nbsp;&nbsp;"]
        APP["application&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(use cases, orchestration,<br/>transformers)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        INFRA["infrastructure&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(adapters, storage,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>observability)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        COMP["composition&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(DI wiring, factories,&nbsp;&nbsp;&nbsp;&nbsp;<br/>bootstrap)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        IFACE["interfaces&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(CLI, HTTP,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>orchestration)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    end

    %% Allowed dependencies (solid arrows)
    IFACE -->|"imports"| COMP
    IFACE -->|"imports"| APP
    IFACE -->|"imports"| INFRA
    IFACE -->|"imports"| DOMAIN

    COMP -->|"imports"| INFRA
    COMP -->|"imports"| APP
    COMP -->|"imports"| DOMAIN

    APP -->|"imports"| DOMAIN

    INFRA -->|"imports"| DOMAIN

    %% Self-references
    DOMAIN -.->|"self"| DOMAIN
    APP -.->|"self"| APP
    INFRA -.->|"self"| INFRA
    COMP -.->|"self"| COMP
    IFACE -.->|"self"| IFACE

    classDef domainStyle fill:#f3e5f5,stroke:#6a1b9a,stroke-width:3px
    classDef appStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef infraStyle fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef compStyle fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef ifaceStyle fill:#e3f2fd,stroke:#1565c0,stroke-width:2px

    class DOMAIN domainStyle
    class APP appStyle
    class INFRA infraStyle
    class COMP compStyle
    class IFACE ifaceStyle
