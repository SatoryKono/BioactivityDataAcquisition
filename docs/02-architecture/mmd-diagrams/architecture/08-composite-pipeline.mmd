%% BioETL — Composite Pipeline Architecture
%% Shows seed → dependencies → enrichers (parallel) → merge flow.

%% @version 1.1.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   33

%%{init: {'layout': 'elk', 'elk': {'mergeEdges': false, 'nodePlacementStrategy': 'SIMPLE', 'edgeRouting': 'ORTHOGONAL'}}}%%
%% @uniform width=256 height=126 max_title_len=27 max_desc_lines=5
graph TB
    subgraph Config["Composite Configuration"]
        CC["CompositeConfig<br/><br/><br/><br/><br/>"]:::size-lg
        SC["SeedConfig<br/><br/><br/><br/><br/>"]:::size-lg
        DC["DependencyConfig<br/><br/><br/><br/><br/>"]:::size-lg
        EC["EnricherConfig<br/><br/><br/><br/><br/>"]:::size-lg
        MC["MergeConfig<br/><br/><br/><br/><br/>"]:::size-lg
        NoteConfig["Config Details:<br/>• name: str<br/>• seed: SeedConfig<br/>• dependencies: DependencyConfig[]<br/>• enrichers: EnricherConfig[]<br/>• merge: MergeConfig"]:::size-lg
        CC -.- NoteConfig
    end

    CC --> SC
    CC --> DC
    CC --> EC
    CC --> MC

    subgraph Runner["CompositePipelineRunner"]
        CPR["CompositePipelineRunner<br/><br/><br/><br/><br/>"]:::size-lg
        NoteRunner["Orchestrates full<br/>composite execution<br/><br/><br/><br/>"]:::size-lg
        CPR -.- NoteRunner
    end

    subgraph FSM["State Machine"]
        INIT["INIT<br/><br/><br/><br/><br/>"]:::size-lg
        SEED_RUN["SEED_RUNNING<br/><br/><br/><br/><br/>"]:::size-lg
        DEP_RUN["DEPS_RUNNING<br/><br/><br/><br/><br/>"]:::size-lg
        ENR_RUN["ENRICHERS_RUNNING<br/><br/><br/><br/><br/>"]:::size-lg
        MERGE_RUN["MERGING<br/><br/><br/><br/><br/>"]:::size-lg
        DONE["COMPLETED<br/><br/><br/><br/><br/>"]:::size-lg
        FAILED["FAILED<br/><br/><br/><br/><br/>"]:::size-lg
        INIT --> SEED_RUN
        SEED_RUN --> DEP_RUN
        DEP_RUN --> ENR_RUN
        ENR_RUN --> MERGE_RUN
        MERGE_RUN --> DONE
        SEED_RUN --> FAILED
        DEP_RUN --> FAILED
        ENR_RUN --> FAILED
        MERGE_RUN --> FAILED
    end

    subgraph Execution["Execution Components"]
        SEED["Seed Pipeline<br/><br/><br/><br/><br/>"]:::size-lg
        subgraph DepsBlock["Dependencies (Sequential)"]
            DEP_COORD["DependencyCoordinator<br/><br/><br/><br/><br/>"]:::size-lg
            DEP1["Dependency 1<br/><br/><br/><br/><br/>"]:::size-lg
        end

        subgraph EnrichBlock["Enrichers (Parallel Fan-Out)"]
            ENR_COORD["EnrichmentCoordinator<br/><br/><br/><br/><br/>"]:::size-lg
            ENR1["Enricher 1<br/><br/><br/><br/><br/>"]:::size-lg
            ENR2["Enricher 2<br/><br/><br/><br/><br/>"]:::size-lg
            ENR3["Enricher 3<br/><br/><br/><br/><br/>"]:::size-lg
            ENR4["Enricher 4<br/><br/><br/><br/><br/>"]:::size-lg
        end

        subgraph MergeBlock["Merge Phase"]
            MS["MergeService<br/><br/><br/><br/><br/>"]:::size-lg
            DEDUP["EnricherDeduplicator<br/><br/><br/><br/><br/>"]:::size-lg
            AGG["EnricherAggregator<br/><br/><br/><br/><br/>"]:::size-lg
            REN["ColumnRenamer<br/><br/><br/><br/><br/>"]:::size-lg
        end
    end

    subgraph CrossVal["Cross-Validation"]
        CV["EnrichmentCrossValidator<br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph Checkpoint["Checkpoint"]
        CCM["CompositeCheckpointManager<br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph Preflight["Preflight"]
        CPV["CompositePreflightValidator<br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph Results["Results"]
        ER["EnrichmentResult<br/><br/><br/><br/><br/>"]:::size-lg
        MR["MergeResult<br/><br/><br/><br/><br/>"]:::size-lg
        CR["CompositeResult<br/><br/><br/><br/><br/>"]:::size-lg
    end

    %% Flow
    CPR --> CPV
    CPR --> SEED
    CPR --> DEP_COORD
    CPR --> ENR_COORD
    CPR --> MS
    CPR --> CCM
    CPR --> CV

    DEP_COORD --> DEP1 --> DEP2

    SEED -->|"entity keys"| ENR_COORD
    ENR_COORD --> ENR1 & ENR2 & ENR3 & ENR4

    ENR1 --> ER
    ENR2 --> ER
    ENR3 --> ER
    ENR4 --> ER

    MS --> DEDUP --> AGG --> REN --> ORD
    MS --> MR

    CPR --> CR

    classDef config fill:#f5f3ff,stroke:#7c3aed
    classDef runner fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef exec fill:#fff7ed,stroke:#f59e0b
    classDef merge fill:#f5f3ff,stroke:#7c3aed
    classDef result fill:#c8e6c9,stroke:#16a34a
    classDef fsm fill:#f1f5f9,stroke:#64748b
    classDef check fill:#ffe4e6,stroke:#dc2626

    class CC,SC,DC,EC,MC config
    class CPR runner
    class SEED,DEP_COORD,DEP1,DEP2,ENR_COORD,ENR1,ENR2,ENR3,ENR4 exec
    class MS,DEDUP,AGG,REN,ORD merge
    class ER,MR,CR result
    class INIT,SEED_RUN,DEP_RUN,ENR_RUN,MERGE_RUN,DONE,FAILED fsm
    class CCM,CPV,CV check
