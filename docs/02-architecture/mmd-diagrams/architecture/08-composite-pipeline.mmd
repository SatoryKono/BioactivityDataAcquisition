%% BioETL — Composite Pipeline Architecture
%% Shows seed → dependencies → enrichers (parallel) → merge flow.

%% @version 1.1.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   33

%%{init: {'layout': 'elk', 'elk': {'mergeEdges': false, 'nodePlacementStrategy': 'SIMPLE', 'edgeRouting': 'ORTHOGONAL'}}}%%
%% @uniform width=256 height=126 max_title_len=27 max_desc_lines=5
graph TB
    subgraph Config["Composite Configuration"]
        CC["CompositeConfig<br/><br/><br/><br/><br/>"]
        SC["SeedConfig<br/><br/><br/><br/><br/>"]
        DC["DependencyConfig<br/><br/><br/><br/><br/>"]
        EC["EnricherConfig<br/><br/><br/><br/><br/>"]
        MC["MergeConfig<br/><br/><br/><br/><br/>"]

        NoteConfig["Config Details:<br/>• name: str<br/>• seed: SeedConfig<br/>• dependencies: DependencyConfig[]<br/>• enrichers: EnricherConfig[]<br/>• merge: MergeConfig"]
        CC -.- NoteConfig
    end

    CC --> SC
    CC --> DC
    CC --> EC
    CC --> MC

    subgraph Runner["CompositePipelineRunner"]
        CPR["CompositePipelineRunner<br/><br/><br/><br/><br/>"]
        NoteRunner["Orchestrates full<br/>composite execution<br/><br/><br/><br/>"]
        CPR -.- NoteRunner
    end

    subgraph FSM["State Machine"]
        INIT["INIT<br/><br/><br/><br/><br/>"]
        SEED_RUN["SEED_RUNNING<br/><br/><br/><br/><br/>"]
        DEP_RUN["DEPS_RUNNING<br/><br/><br/><br/><br/>"]
        ENR_RUN["ENRICHERS_RUNNING<br/><br/><br/><br/><br/>"]
        MERGE_RUN["MERGING<br/><br/><br/><br/><br/>"]
        DONE["COMPLETED<br/><br/><br/><br/><br/>"]
        FAILED["FAILED<br/><br/><br/><br/><br/>"]

        INIT --> SEED_RUN
        SEED_RUN --> DEP_RUN
        DEP_RUN --> ENR_RUN
        ENR_RUN --> MERGE_RUN
        MERGE_RUN --> DONE
        SEED_RUN --> FAILED
        DEP_RUN --> FAILED
        ENR_RUN --> FAILED
        MERGE_RUN --> FAILED
    end

    subgraph Execution["Execution Components"]
        SEED["Seed Pipeline<br/><br/><br/><br/><br/>"]

        subgraph DepsBlock["Dependencies (Sequential)"]
            DEP_COORD["DependencyCoordinator<br/><br/><br/><br/><br/>"]
            DEP1["Dependency 1<br/><br/><br/><br/><br/>"]
        end

        subgraph EnrichBlock["Enrichers (Parallel Fan-Out)"]
            ENR_COORD["EnrichmentCoordinator<br/><br/><br/><br/><br/>"]
            ENR1["Enricher 1<br/><br/><br/><br/><br/>"]
            ENR2["Enricher 2<br/><br/><br/><br/><br/>"]
            ENR3["Enricher 3<br/><br/><br/><br/><br/>"]
            ENR4["Enricher 4<br/><br/><br/><br/><br/>"]
        end

        subgraph MergeBlock["Merge Phase"]
            MS["MergeService<br/><br/><br/><br/><br/>"]
            DEDUP["EnricherDeduplicator<br/><br/><br/><br/><br/>"]
            AGG["EnricherAggregator<br/><br/><br/><br/><br/>"]
            REN["ColumnRenamer<br/><br/><br/><br/><br/>"]
        end
    end

    subgraph CrossVal["Cross-Validation"]
        CV["EnrichmentCrossValidator<br/><br/><br/><br/><br/>"]
    end

    subgraph Checkpoint["Checkpoint"]
        CCM["CompositeCheckpointManager<br/><br/><br/><br/><br/>"]
    end

    subgraph Preflight["Preflight"]
        CPV["CompositePreflightValidator<br/><br/><br/><br/><br/>"]
    end

    subgraph Results["Results"]
        ER["EnrichmentResult<br/><br/><br/><br/><br/>"]
        MR["MergeResult<br/><br/><br/><br/><br/>"]
        CR["CompositeResult<br/><br/><br/><br/><br/>"]
    end

    %% Flow
    CPR --> CPV
    CPR --> SEED
    CPR --> DEP_COORD
    CPR --> ENR_COORD
    CPR --> MS
    CPR --> CCM
    CPR --> CV

    DEP_COORD --> DEP1 --> DEP2

    SEED -->|"entity keys"| ENR_COORD
    ENR_COORD --> ENR1 & ENR2 & ENR3 & ENR4

    ENR1 --> ER
    ENR2 --> ER
    ENR3 --> ER
    ENR4 --> ER

    MS --> DEDUP --> AGG --> REN --> ORD
    MS --> MR

    CPR --> CR

    classDef config fill:#f3e5f5,stroke:#6a1b9a
    classDef runner fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef exec fill:#fff3e0,stroke:#e65100
    classDef merge fill:#f3e5f5,stroke:#6a1b9a
    classDef result fill:#c8e6c9,stroke:#2e7d32
    classDef fsm fill:#eceff1,stroke:#455a64
    classDef check fill:#fce4ec,stroke:#b71c1c

    class CC,SC,DC,EC,MC config
    class CPR runner
    class SEED,DEP_COORD,DEP1,DEP2,ENR_COORD,ENR1,ENR2,ENR3,ENR4 exec
    class MS,DEDUP,AGG,REN,ORD merge
    class ER,MR,CR result
    class INIT,SEED_RUN,DEP_RUN,ENR_RUN,MERGE_RUN,DONE,FAILED fsm
    class CCM,CPV,CV check
