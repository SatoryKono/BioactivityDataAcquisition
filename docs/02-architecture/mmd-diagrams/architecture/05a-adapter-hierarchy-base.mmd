graph TB
%% keep-orphan: FSM, HCP, NSMF, PFM
    subgraph Domain["Domain Layer"]
        DSP["DataSourcePort"]
        HCP["HealthCheckPort"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        HCPM["HealthCheckProviderMixin"]
        NSMF["NotSupportedMultiFilterMixin"]
        FSM["FilterableStubMixin"]
        PFM["PaginatedFetcherMixin"]
        BHA["BaseHttpAdapter"]
        BSA["BaseSyncAdapter"]
    end

    DSP -->|extends| FDSP
    HCPM --> BHA
    HCPM --> BSA
    DSP -.->|implements| BHA
    DSP -.->|implements| BSA
    DSP -.->|wraps| CBD
    DSP -.->|wraps| RDD
    DSP -.->|wraps| CBDS

    classDef domain fill:#f3e5f5,stroke:#6a1b9a
    classDef infra fill:#ffcdd2,stroke:#c62828

    class DSP,HCP domain
    class HCPM,NSMF,FSM,PFM,BHA,BSA infra
