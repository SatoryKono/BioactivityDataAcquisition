graph TB
    subgraph Base["Base"]
        BHA["BaseHttpAdapter"]
        BSA["BaseSyncAdapter"]
    end

    subgraph ChEMBL["ChEMBL"]
        CHM["ChemblHealthMixin"]
        CMM["ChemblMetadataMixin"]
        CA["ChemblAdapter"]
    end

    BHA --> CA
    CHM --> CA
    CMM --> CA

    subgraph PubMed["PubMed"]
        PSM["PubMedSearchMixin"]
        PFetchM["PubMedFetchMixin"]
        PHM["PubMedHealthMixin"]
        PA["PubMedAdapter"]
    end

    BHA --> PA
    PSM --> PA
    PFetchM --> PA
    PHM --> PA

    subgraph Others["Other Providers"]
        UA["UniProtAdapter"]
        CRA["CrossRefAdapter"]
        OAA["OpenAlexAdapter"]
        SSA["SemanticScholarAdapter"]
        PCA["PubChemAdapter"]
    end

    BHA --> UA
    BHA --> CRA
    BHA --> OAA
    BHA --> SSA
    BSA --> PCA

    classDef base fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef adapter fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef mixin fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1px

    class BHA,BSA base
    class CA,PA,UA,CRA,OAA,SSA,PCA adapter
    class CHM,CMM,PSM,PFetchM,PHM mixin
