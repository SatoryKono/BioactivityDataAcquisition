%% BioETL — Medallion Architecture Data Flow (Bronze → Silver → Gold)
%% Shows how data flows through the three medallion layers.

%% @version 1.1.0
%% @date 2026-02-28
%% @type flowchart
%% @level System / Component
%% @nodes 42
%% @reference Canonical medallion flow — at threshold boundary

%%{init: {'layout': 'elk', 'elk': {'mergeEdges': false, 'nodePlacementStrategy': 'SIMPLE', 'edgeRouting': 'ORTHOGONAL'}}}%%
%% @uniform width=200 height=56 max_title_len=20 max_desc_lines=1
graph LR
 subgraph Sources["External Data Sources"]
 API1["ChEMBL API"]:::size-sm
 API2["PubMed API"]:::size-sm
 API3["UniProt API"]:::size-sm
 API4["PubChem API"]:::size-sm
 API5["CrossRef API"]:::size-sm
 API6["OpenAlex API"]:::size-sm
 API7["Semantic Scholar API"]:::size-sm
 end

 subgraph Ingestion["Data Ingestion"]
 DS["DataSourcePort<br/>fetch() / fetch_filtered()"]:::size-sm
 RL["RateLimiter<br/>(TokenBucket)"]:::size-sm
 CB["CircuitBreaker"]:::size-sm
 RETRY["Retry Logic"]:::size-sm
 end

 subgraph Bronze["Bronze Layer (Raw)"]
 BW["BronzeWriter"]:::size-sm
 BJSONL["JSONL + zstd<br/>compressed files"]:::size-sm
 BMETA["_metadata.yaml<br/>sidecar"]:::size-sm
 BAUDIT["Audit Log"]:::size-sm
 end

 subgraph Transform["Transformation"]
 BT["BaseTransformer<br/>(Template Method)"]:::size-sm
 NORM["Normalization<br/>(text, units, dates)"]:::size-sm
 HASH["Identity Service<br/>(entity_id + content_hash)"]:::size-sm
 PII["PII Hasher<br/>(SHA256 + salt)"]:::size-sm
 DQ_CHECK["DQ Thresholds<br/>Check"]:::size-sm
 end

 subgraph Silver["Silver Layer (Normalized)"]
 SW["SilverWriter<br/>(Delta Lake)"]:::size-sm
 DELTA_S["Delta Table<br/>(merge/upsert)"]:::size-sm
 SV["Silver Validator<br/>(Pandera)"]:::size-sm
 SMETA["_metadata.yaml"]:::size-sm
 end

 subgraph GoldTransform["Gold Transformation"]
 GFILT["Gold Filters"]:::size-sm
 GMAP["Field Mapping<br/>(exclude fields)"]:::size-sm
 GV["Gold Validator<br/>(Pandera strict)"]:::size-sm
 end

 subgraph Gold["Gold Layer (Business-Ready)"]
 GW["GoldWriter<br/>(Delta Lake)"]:::size-sm
 DELTA_G["Delta Table<br/>(validated, typed)"]:::size-sm
 GMETA["_metadata.yaml"]:::size-sm
 end

 subgraph Quarantine["Quarantine"]
 QM["QuarantineManager"]:::size-sm
 QS["Quarantine Store"]:::size-sm
 end

 subgraph DQ["Data Quality Reports"]
 DQ_B["Bronze DQ<br/>Analyzer"]:::size-sm
 DQ_S["Silver DQ<br/>Analyzer"]:::size-sm
 DQ_G["Gold DQ<br/>Analyzer"]:::size-sm
 DQ_RPT["DQ Report<br/>Output"]:::size-sm
 end

 %% Flow
 API1 & API2 & API3 & API4 & API5 & API6 & API7 -.-> DS
 DS --> RL --> CB --> RETRY

 RETRY --> BW
 BW --> BJSONL
 BW --> BMETA
 BW --> BAUDIT

 BJSONL --> BT
 BT --> NORM --> HASH --> PII
 PII --> DQ_CHECK

 DQ_CHECK -->|"pass"| SW
 DQ_CHECK -->|"fail"| QM --> QS

 SW --> SV --> DELTA_S
 SW --> SMETA

 DELTA_S --> GFILT --> GMAP --> GV
 GV --> GW --> DELTA_G
 GW --> GMETA

 BJSONL --> DQ_B --> DQ_RPT
 DELTA_S --> DQ_S --> DQ_RPT
 DELTA_G --> DQ_G --> DQ_RPT

 classDef bronze fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
 classDef silver fill:#f1f5f9,stroke:#475569,stroke-width:2px
 classDef gold fill:#fefce8,stroke:#ca8a04,stroke-width:2px
 classDef source fill:#f1f5f9,stroke:#64748b
 classDef process fill:#f0fdf4,stroke:#16a34a
 classDef quarantine fill:#fff1f2,stroke:#dc2626
 classDef dq fill:#f5f3ff,stroke:#7c3aed

 class BW,BJSONL,BMETA,BAUDIT bronze
 class SW,DELTA_S,SV,SMETA silver
 class GW,DELTA_G,GV,GMETA gold
 class API1,API2,API3,API4,API5,API6,API7 source
 class DS,RL,CB,RETRY,BT,NORM,HASH,PII,DQ_CHECK,GFILT,GMAP process
 class QM,QS quarantine
 class DQ_B,DQ_S,DQ_G,DQ_RPT dq

