%% BioETL — Medallion Architecture Data Flow (Bronze → Silver → Gold)
%% Shows how data flows through the three medallion layers.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @status active
%% @nodes  36

graph LR
    subgraph Sources["External Data Sources"]
        API1["ChEMBL API"]
        API2["PubMed API"]
        API3["UniProt API"]
        API4["PubChem API"]
        API5["CrossRef API"]
        API6["OpenAlex API"]
        API7["Semantic Scholar API"]
    end

    subgraph Ingestion["Data Ingestion"]
        DS["DataSourcePort<br/>fetch() / fetch_filtered()"]
        RL["RateLimiter<br/>(TokenBucket)"]
        CB["CircuitBreaker"]
        RETRY["Retry Logic"]
    end

    subgraph Bronze["Bronze Layer (Raw)"]
        BW["BronzeWriter"]
        BJSONL["JSONL + zstd<br/>compressed files"]
        BMETA["_metadata.yaml<br/>sidecar"]
        BAUDIT["Audit Log"]
    end

    subgraph Transform["Transformation"]
        BT["BaseTransformer<br/>(Template Method)"]
        NORM["Normalization<br/>(text, units, dates)"]
        HASH["Identity Service<br/>(entity_id + content_hash)"]
        PII["PII Hasher<br/>(SHA256 + salt)"]
        DQ_CHECK["DQ Thresholds<br/>Check"]
    end

    subgraph Silver["Silver Layer (Normalized)"]
        SW["SilverWriter<br/>(Delta Lake)"]
        DELTA_S["Delta Table<br/>(merge/upsert)"]
        SV["Silver Validator<br/>(Pandera)"]
        SMETA["_metadata.yaml"]
    end

    subgraph GoldTransform["Gold Transformation"]
        GFILT["Gold Filters"]
        GMAP["Field Mapping<br/>(exclude fields)"]
        GV["Gold Validator<br/>(Pandera strict)"]
    end

    subgraph Gold["Gold Layer (Business-Ready)"]
        GW["GoldWriter<br/>(Delta Lake)"]
        DELTA_G["Delta Table<br/>(validated, typed)"]
        GMETA["_metadata.yaml"]
    end

    subgraph Quarantine["Quarantine"]
        QM["QuarantineManager"]
        QS["Quarantine Store"]
    end

    subgraph DQ["Data Quality Reports"]
        DQ_B["Bronze DQ<br/>Analyzer"]
        DQ_S["Silver DQ<br/>Analyzer"]
        DQ_G["Gold DQ<br/>Analyzer"]
        DQ_RPT["DQ Reports<br/>(JSON)"]
    end

    %% Flow
    API1 & API2 & API3 & API4 & API5 & API6 & API7 --> DS
    DS --> RL --> CB --> RETRY

    RETRY --> BW
    BW --> BJSONL
    BW --> BMETA
    BW --> BAUDIT

    BJSONL --> BT
    BT --> NORM --> HASH --> PII
    PII --> DQ_CHECK

    DQ_CHECK -->|"pass"| SW
    DQ_CHECK -->|"fail"| QM --> QS

    SW --> SV --> DELTA_S
    SW --> SMETA

    DELTA_S --> GFILT --> GMAP --> GV
    GV --> GW --> DELTA_G
    GW --> GMETA

    BJSONL --> DQ_B --> DQ_RPT
    DELTA_S --> DQ_S --> DQ_RPT
    DELTA_G --> DQ_G --> DQ_RPT

    classDef bronze fill:#ff8a65,stroke:#bf360c,stroke-width:2px
    classDef silver fill:#90caf9,stroke:#0d47a1,stroke-width:2px
    classDef gold fill:#ffd54f,stroke:#f57f17,stroke-width:2px
    classDef source fill:#eceff1,stroke:#455a64
    classDef process fill:#c8e6c9,stroke:#2e7d32
    classDef quarantine fill:#ffcdd2,stroke:#c62828
    classDef dq fill:#e1bee7,stroke:#6a1b9a

    class BW,BJSONL,BMETA,BAUDIT bronze
    class SW,DELTA_S,SV,SMETA silver
    class GW,DELTA_G,GV,GMETA gold
    class API1,API2,API3,API4,API5,API6,API7 source
    class DS,RL,CB,RETRY,BT,NORM,HASH,PII,DQ_CHECK,GFILT,GMAP process
    class QM,QS quarantine
    class DQ_B,DQ_S,DQ_G,DQ_RPT dq
