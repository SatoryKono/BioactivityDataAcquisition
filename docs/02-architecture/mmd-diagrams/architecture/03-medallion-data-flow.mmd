%% BioETL — Medallion Architecture Data Flow (Bronze → Silver → Gold)
%% Shows how data flows through the three medallion layers.

%% @version 1.1.0
%% @date    2026-02-27
%% @type    flowchart
%% @level   System / Component
%% @nodes   25

%%{init: {
  'layout': 'elk',
  'theme': 'base',
  'themeVariables': { 'fontFamily': 'Inter, system-ui, sans-serif' },
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'cycleBreakingStrategy': 'GREEDY',
    'direction': 'RIGHT',
    'spacing.nodeNode': 45,
    'spacing.edgeNode': 35,
    'spacing.edgeEdge': 25
  }
}}%%

%% @uniform width=232 height=56 max_title_len=24 max_desc_lines=1
graph LR
    subgraph Sources["External Data Sources"]
        APIS["fa:fa-cloud Public APIs<br/>(ChEMBL, UniProt, etc.)"]
    end

    subgraph Ingestion["Data Ingestion"]
        DS["fa:fa-plug DataSourcePort"]
        INGEST_P["Ingestion Pipeline<br/>(RateLimit, CB, Retry)"]
    end

    subgraph Bronze["Bronze Layer (Raw)"]
        BW["fa:fa-file-arrow-down BronzeWriter"]
        BSTORE["fa:fa-file-zipper JSONL + zstd"]
    end

    subgraph Transform["Transformation"]
        BT["fa:fa-gear BaseTransformer"]
        DQ_CHECK["fa:fa-vial DQ Thresholds"]
    end

    subgraph Silver["Silver Layer (Cleaned)"]
        SW["fa:fa-database SilverWriter<br/>(Delta Lake)"]
        SV["fa:fa-check-double Silver Validator"]
    end

    subgraph Gold["Gold Layer (Aggregated)"]
        GW["fa:fa-table GoldWriter<br/>(Delta Lake)"]
        GV["fa:fa-shield-check Gold Validator"]
    end

    subgraph Quarantine["Quarantine"]
        QS["fa:fa-biohazard Quarantine Store"]
    end

    %% Flow
    APIS --> DS
    DS --> INGEST_P --> BW
    BW --> BSTORE
    BSTORE --> BT
    BT --> DQ_CHECK
    
    DQ_CHECK -->|"pass"| SW
    DQ_CHECK -->|"fail"| QS
    
    SW --> SV --> GW
    GW --> GV

    %% Styles
    classDef domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef app    fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef infra  fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef data   fill:#f8fafc,stroke:#475569,stroke-width:2px
    classDef ext    fill:#eceff1,stroke:#455a64,stroke-width:1px

    class DS,BT,DQ_CHECK,SV,GV domain
    class INGEST_P app
    class BW,SW,GW infra
    class BSTORE,QS data
    class APIS ext
