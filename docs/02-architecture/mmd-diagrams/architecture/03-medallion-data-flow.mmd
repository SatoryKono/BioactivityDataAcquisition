%% BioETL — Medallion Architecture Data Flow (Bronze → Silver → Gold)
%% Shows how data flows through the three medallion layers.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   36

%%{init: {'layout': 'elk', 'elk': {'mergeEdges': false, 'nodePlacementStrategy': 'SIMPLE'}}}%%
%% @uniform width=200 height=56 max_title_len=20 max_desc_lines=1
graph LR
    subgraph Sources["External Data Sources"]
        API7["Semantic Scholar API<br/>&nbsp;"]
    end

    subgraph Ingestion["Data Ingestion"]
        DS["DataSourcePort&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>fetch() / fetch_filtered()"]
        RL["RateLimiter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(TokenBucket)"]
        CB["CircuitBreaker&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        RETRY["Retry Logic&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
    end

    subgraph Bronze["Bronze Layer (Raw)"]
        BW["BronzeWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        BJSONL["JSONL + zstd&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>compressed files"]
        BMETA["_metadata.yaml&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>sidecar"]
        BAUDIT["Audit Log&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
    end

    subgraph Transform["Transformation"]
        BT["BaseTransformer&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Template Method)"]
        NORM["Normalization&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(text, units, dates)"]
        HASH["Identity Service&nbsp;&nbsp;&nbsp;&nbsp;<br/>(entity_id + content_hash)"]
        PII["PII Hasher&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(SHA256 + salt)"]
        DQ_CHECK["DQ Thresholds&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Check"]
    end

    subgraph Silver["Silver Layer (Normalized)"]
        SW["SilverWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Delta Lake)"]
        DELTA_S["Delta Table&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(merge/upsert)"]
        SV["Silver Validator&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Pandera)"]
        SMETA["_metadata.yaml&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
    end

    subgraph GoldTransform["Gold Transformation"]
        GFILT["Gold Filters&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        GMAP["Field Mapping&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(exclude fields)"]
        GV["Gold Validator&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Pandera strict)"]
    end

    subgraph Gold["Gold Layer (Business-Ready)"]
        GW["GoldWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Delta Lake)"]
        DELTA_G["Delta Table&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(validated, typed)"]
        GMETA["_metadata.yaml&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
    end

    subgraph Quarantine["Quarantine"]
        QM["QuarantineManager&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
        QS["Quarantine Store&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;"]
    end

    subgraph DQ["Data Quality Reports"]
        DQ_B["Bronze DQ&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Analyzer"]
        DQ_S["Silver DQ&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Analyzer"]
        DQ_G["Gold DQ&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Analyzer"]
    end

    %% Flow
    API1 & API2 & API3 & API4 & API5 & API6 & API7 --> DS
    DS --> RL --> CB --> RETRY

    RETRY --> BW
    BW --> BJSONL
    BW --> BMETA
    BW --> BAUDIT

    BJSONL --> BT
    BT --> NORM --> HASH --> PII
    PII --> DQ_CHECK

    DQ_CHECK -->|"pass"| SW
    DQ_CHECK -->|"fail"| QM --> QS

    SW --> SV --> DELTA_S
    SW --> SMETA

    DELTA_S --> GFILT --> GMAP --> GV
    GV --> GW --> DELTA_G
    GW --> GMETA

    BJSONL --> DQ_B --> DQ_RPT
    DELTA_S --> DQ_S --> DQ_RPT
    DELTA_G --> DQ_G --> DQ_RPT

    classDef bronze fill:#ff8a65,stroke:#bf360c,stroke-width:2px
    classDef silver fill:#90caf9,stroke:#0d47a1,stroke-width:2px
    classDef gold fill:#ffd54f,stroke:#f57f17,stroke-width:2px
    classDef source fill:#eceff1,stroke:#455a64
    classDef process fill:#c8e6c9,stroke:#2e7d32
    classDef quarantine fill:#ffcdd2,stroke:#c62828
    classDef dq fill:#e1bee7,stroke:#6a1b9a

    class BW,BJSONL,BMETA,BAUDIT bronze
    class SW,DELTA_S,SV,SMETA silver
    class GW,DELTA_G,GV,GMETA gold
    class API1,API2,API3,API4,API5,API6,API7 source
    class DS,RL,CB,RETRY,BT,NORM,HASH,PII,DQ_CHECK,GFILT,GMAP process
    class QM,QS quarantine
    class DQ_B,DQ_S,DQ_G,DQ_RPT dq
