graph TB
%% keep-orphan: MC, NOM, UL
    subgraph InfraLogging["Infrastructure: Logging"]
        UL["UnifiedLogger<br/>(impl LoggerPort)"]:::size-sm
    end

    subgraph InfraMetrics["Infrastructure: Metrics"]
        MC["MetricsCollector<br/>(impl MetricsPort)"]:::size-sm
        PM["PrometheusMetrics<br/>(impl MetricsPort)"]:::size-sm
        MSA["MetricsServerAdapter"]:::size-sm
        NOM["NoOpMetrics"]:::size-sm
    end

    subgraph InfraTracing["Infrastructure: Tracing"]
        OTT["OpenTelemetryTracer<br/>(impl TracingPort)"]:::size-sm
    end

    subgraph InfraAnomaly["Infrastructure: Anomaly Detection"]
        AD["AnomalyDetector"]:::size-sm
        DS["DetectorStrategy (ABC)"]:::size-sm
        ZSD["ZScoreDetector"]:::size-sm
    end

    subgraph External["External Systems"]
        PROM["Prometheus Server"]:::size-sm
        GRAFANA["Grafana"]:::size-sm
        OTEL_COL["OTel Collector"]:::size-sm
        JAEGER["Jaeger"]:::size-sm
    end

    %% Anomaly detection
    DS --> ZSD
    AD --> DS

    %% Metrics to external
    PM --> MSA --> PROM --> GRAFANA

    %% Tracing to external
    OTT --> OTEL_COL --> JAEGER

    classDef logging fill:#fefce8,stroke:#ca8a04
    classDef metrics fill:#f5f3ff,stroke:#7c3aed
    classDef tracing fill:#ffe4e6,stroke:#dc2626
    classDef anomaly fill:#fff1f2,stroke:#dc2626
    classDef ext fill:#f1f5f9,stroke:#64748b

    class UL logging
    class MC,PM,MSA,NOM metrics
    class OTT tracing
    class AD,DS,ZSD anomaly
    class PROM,GRAFANA,OTEL_COL,JAEGER ext
