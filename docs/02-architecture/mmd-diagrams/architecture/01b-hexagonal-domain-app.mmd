graph TB
%% keep-orphan: CFG, EXCEPTIONS, OBSERVER, SCHEMAS, TYPES
    subgraph Application["Application Layer"]
        CORE["Core (Runner, BatchExecutor, Transformer, Writer)"]
        SERVICES["Services (DQ, Export, Health, Medallion Lifecycle)"]
        COMPOSITE["Composite Pipeline (Coordinator, Merger, FSM)"]
        PIPELINES["Pipeline Transformers (per provider)"]
        OBSERVER["PipelineObserver"]
    end

    subgraph Domain["Domain Layer"]
        PORTS["Port Protocols"]
        ENTITIES["Entities and Aggregates"]
        VO["Value Objects"]
        CFG["Configuration"]
        DOM_SVC["Domain Services"]
        TYPES["Types and Enums"]
        EXCEPTIONS["Exception Hierarchy"]
        SCHEMAS["Schemas"]
    end

    CORE --> PORTS
    CORE --> ENTITIES
    CORE --> VO
    SERVICES --> PORTS
    COMPOSITE --> PORTS
    PIPELINES --> ENTITIES
    PIPELINES --> DOM_SVC

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
