%% Port Contracts — Observability view
%% Covers logger/metrics/tracing and resilience ports.

%% @version 1.0.0
%% @date    2026-02-25
%% @type    flowchart
%% @level   System / Component
%% @status  active
%% @view    observability
%% @parent  13-port-protocol-contracts.mmd
%% @nodes   14

flowchart LR
    subgraph Domain["Domain Layer"]
        direction TB
        LGP[LoggerPort]:::port
        MTP[MetricsPort]:::port
        TRP[TracingPort]:::port
        CBP[CircuitBreakerPort]:::port
        RLP[RateLimiterPort]:::port
    end
    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        UL[UnifiedLogger]:::adapter
        SL[StructlogLogger]:::adapter
        MC[MetricsCollector]:::adapter
        OT[OpenTelemetryTracer]:::adapter
        CB[CircuitBreaker]:::adapter
        TB[TokenBucket]:::adapter
    end
    LGP -.-> UL
    LGP -.-> SL
    MTP -.-> MC
    TRP -.-> OT
    CBP -.-> CB
    RLP -.-> TB
    classDef port fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1.5px
    classDef adapter fill:#ffcdd2,stroke:#c62828,stroke-width:1.5px
    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
