%% BioETL — Bootstrap / DI Container (Composition Root)
%% Shows how dependencies are assembled and wired together.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   29

%%{init: {'layout': 'elk', 'elk': {'mergeEdges': false, 'nodePlacementStrategy': 'SIMPLE', 'edgeRouting': 'ORTHOGONAL'}}}%%
%% @uniform width=192 height=108 max_title_len=19 max_desc_lines=4
graph TB
    subgraph Entry["Entry Points"]
        CLI["CLI Commands<br/>(Click)<br/><br/><br/>"]:::size-md
        HTTP["HTTP Interface<br/><br/><br/><br/>"]:::size-md
    end

    subgraph Composition["composition layer"]
        subgraph Bootstrap["Bootstrap Assembly"]
            RA["RuntimeAssembly<br/>━━━━━━━━━━━━━━━━━<br/>Central DI wiring point.<br/>Creates all infrastructure<br/>and application components."]:::size-md
            RBA["RunnerBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_runner()<br/><br/>"]:::size-md
            SBA["StorageBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_storage()<br/><br/>"]:::size-md
            HBA["HealthBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_health()<br/><br/>"]:::size-md
            CBA["CheckpointBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_checkpoint()<br/><br/>"]:::size-md
            LBA["LockBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_lock()<br/><br/>"]:::size-md
        end

        subgraph Factories["Factories"]
            DSR["DataSourceRegistry<br/>━━━━━━━━━━━━━━━━━<br/>Maps provider+entity →<br/>DataSourcePort factory<br/>"]:::size-md
            TF["TransformerFactory<br/>━━━━━━━━━━━━━━━━━<br/>Maps provider+entity →<br/>BaseTransformer factory<br/>"]:::size-md
            RF["RunnerFactory<br/>━━━━━━━━━━━━━━━━━<br/>+ create_runner()<br/><br/>"]:::size-md
            DQF["DQFactory<br/>━━━━━━━━━━━━━━━━━<br/>+ create_dq_analyzers()<br/><br/>"]:::size-md
        end

        subgraph Providers["Provider Registry"]
            PR["ProviderRegistry<br/>━━━━━━━━━━━━━━━━━<br/>Registers all provider<br/>pipelines and their<br/>extraction params"]:::size-md
            EP["ExtractionParams<br/>Registration<br/><br/><br/>"]:::size-md
        end

        subgraph Builders["Runtime Builders"]
            RB["RunnerBuilder<br/>━━━━━━━━━━━━━━━━━<br/>Fluent builder for<br/>PipelineRunner creation<br/>"]:::size-md
        end
    end

    subgraph Created["Created Components"]
        subgraph InfraCreated["Infrastructure"]
            ADAPTER["Provider Adapter<br/>(DataSourcePort)<br/><br/><br/>"]:::size-md
            STORAGE["BronzeWriter +<br/>SilverWriter +<br/>GoldWriter<br/><br/>"]:::size-md
            LOGGER["UnifiedLogger<br/>(LoggerPort)<br/><br/><br/>"]:::size-md
            METRICS["PrometheusMetrics<br/>(MetricsPort)<br/><br/><br/>"]:::size-md
            TRACER["OpenTelemetryTracer<br/>(TracingPort)<br/><br/><br/>"]:::size-md
            LOCK["MemoryLock<br/>(LockPort)<br/><br/><br/>"]:::size-md
            CHKPT["LocalCheckpoint<br/>(CheckpointPort)<br/><br/><br/>"]:::size-md
            QUAR["UnifiedQuarantine<br/>(QuarantinePort)<br/><br/><br/>"]:::size-md
        end

        subgraph AppCreated["Application"]
            PS["PipelineServices<br/>(frozen dataclass<br/>with all injected ports)<br/><br/>"]:::size-md
            RUNNER["PipelineRunner<br/><br/><br/><br/>"]:::size-md
            TRANSFORMER["BaseTransformer<br/>(provider-specific)<br/><br/><br/>"]:::size-md
            OBSERVER["PipelineObserver<br/><br/><br/><br/>"]:::size-md
        end
    end

    %% Entry → Composition
    CLI --> RA
    HTTP --> RA

    %% Assembly wiring
    RA --> RBA
    RA --> SBA
    RA --> HBA
    RA --> CBA
    RA --> LBA

    %% Factories
    RA --> DSR
    RA --> TF
    RA --> RF
    RA --> DQF

    %% Provider registration
    PR --> DSR
    PR --> TF
    EP --> PR

    %% Builder
    RF --> RB

    %% Created components
    DSR -->|creates| ADAPTER
    SBA -->|creates| STORAGE
    RA -->|creates| LOGGER
    RA -->|creates| METRICS
    RA -->|creates| TRACER
    LBA -->|creates| LOCK
    CBA -->|creates| CHKPT
    RA -->|creates| QUAR
    RA -->|creates| AUDIT
    RA -->|creates| PII

    TF -->|creates| TRANSFORMER
    RBA -->|creates| RUNNER

    %% PipelineServices aggregation
    ADAPTER --> PS
    STORAGE --> PS
    LOGGER --> PS
    METRICS --> PS
    TRACER --> PS
    LOCK --> PS
    CHKPT --> PS
    QUAR --> PS

    PS --> RUNNER
    TRANSFORMER --> RUNNER
    OBSERVER --> RUNNER

    classDef entry fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    classDef comp fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
    classDef factory fill:#fff7ed,stroke:#f59e0b
    classDef infra fill:#fff1f2,stroke:#dc2626
    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:2px

    class CLI,HTTP entry
    class RA,RBA,SBA,HBA,CBA,LBA comp
    class DSR,TF,RF,DQF,PR,EP,RB factory
    class ADAPTER,STORAGE,LOGGER,METRICS,TRACER,LOCK,CHKPT,QUAR,AUDIT,PII infra
    class PS,RUNNER,TRANSFORMER,OBSERVER app
