%% BioETL — Bootstrap / DI Container (Composition Root)
%% Shows how dependencies are assembled and wired together.

%% @version 1.0.0
%% @date 2026-02-24
%% @type flowchart
%% @level System / Component
%% @nodes 29
%% @reference Decomposed into 12a, 12b sub-diagrams

%%{init: {'layout': 'elk', 'elk': {'mergeEdges': false, 'nodePlacementStrategy': 'SIMPLE', 'edgeRouting': 'ORTHOGONAL'}}}%%
%% @uniform width=192 height=108 max_title_len=19 max_desc_lines=4
graph TB
 subgraph Entry["Entry Points"]
 CLI["CLI Commands<br/>(Click)"]:::size-md
 HTTP["HTTP Interface"]:::size-md
 end

 subgraph Composition["composition layer"]
 subgraph Bootstrap["Bootstrap Assembly"]
 RA["RuntimeAssembly<br/>-----------------<br/>Central DI wiring point.<br/>Creates all infrastructure<br/>and application components."]:::size-md
 RBA["RunnerBootstrap<br/>-----------------<br/>+ assemble_runner()"]:::size-md
 SBA["StorageBootstrap<br/>-----------------<br/>+ assemble_storage()"]:::size-md
 HBA["HealthBootstrap<br/>-----------------<br/>+ assemble_health()"]:::size-md
 CBA["CheckpointBootstrap<br/>-----------------<br/>+ assemble_checkpoint()"]:::size-md
 LBA["LockBootstrap<br/>-----------------<br/>+ assemble_lock()"]:::size-md
 end

 subgraph Factories["Factories"]
 DSR["DataSourceRegistry<br/>-----------------<br/>Maps provider+entity →<br/>DataSourcePort factory"]:::size-md
 TF["TransformerFactory<br/>-----------------<br/>Maps provider+entity →<br/>BaseTransformer factory"]:::size-md
 RF["RunnerFactory<br/>-----------------<br/>+ create_runner()"]:::size-md
 DQF["DQFactory<br/>-----------------<br/>+ create_dq_analyzers()"]:::size-md
 end

 subgraph Providers["Provider Registry"]
 PR["ProviderRegistry<br/>-----------------<br/>Registers all provider<br/>pipelines and their<br/>extraction params"]:::size-md
 EP["ExtractionParams<br/>Registration"]:::size-md
 end

 subgraph Builders["Runtime Builders"]
 RB["RunnerBuilder<br/>-----------------<br/>Fluent builder for<br/>PipelineRunner creation"]:::size-md
 end
 end

 subgraph Created["Created Components"]
 subgraph InfraCreated["Infrastructure"]
 ADAPTER["Provider Adapter<br/>(DataSourcePort)"]:::size-md
 STORAGE["BronzeWriter +<br/>SilverWriter +<br/>GoldWriter"]:::size-md
 LOGGER["UnifiedLogger<br/>(LoggerPort)"]:::size-md
 METRICS["PrometheusMetrics<br/>(MetricsPort)"]:::size-md
 TRACER["OpenTelemetryTracer<br/>(TracingPort)"]:::size-md
 LOCK["MemoryLock<br/>(LockPort)"]:::size-md
 CHKPT["LocalCheckpoint<br/>(CheckpointPort)"]:::size-md
 QUAR["UnifiedQuarantine<br/>(QuarantinePort)"]:::size-md
 end

 subgraph AppCreated["Application"]
 PS["PipelineServices<br/>(frozen dataclass<br/>with all injected ports)"]:::size-md
 RUNNER["PipelineRunner"]:::size-md
 TRANSFORMER["BaseTransformer<br/>(provider-specific)"]:::size-md
 OBSERVER["PipelineObserver"]:::size-md
 end
 end

 %% Entry → Composition
 CLI ==> RA
 HTTP --> RA

 %% Assembly wiring
 RA --> RBA
 RA --> SBA
 RA --> HBA
 RA --> CBA
 RA --> LBA

 %% Factories
 RA --> DSR
 RA --> TF
 RA --> RF
 RA --> DQF

 %% Provider registration
 PR --> DSR
 PR --> TF
 EP --> PR

 %% Builder
 RF --> RB

 %% Created components
 DSR -->|creates| ADAPTER
 SBA -->|creates| STORAGE
 RA -->|creates| LOGGER
 RA -->|creates| METRICS
 RA -->|creates| TRACER
 LBA -->|creates| LOCK
 CBA -->|creates| CHKPT
 RA -->|creates| QUAR
 RA -->|creates| AUDIT
 RA -->|creates| PII

 TF -->|creates| TRANSFORMER
 RBA -->|creates| RUNNER

 %% PipelineServices aggregation
 ADAPTER --> PS
 STORAGE --> PS
 LOGGER --> PS
 METRICS --> PS
 TRACER --> PS
 LOCK --> PS
 CHKPT --> PS
 QUAR --> PS

 PS --> RUNNER
 TRANSFORMER --> RUNNER
 OBSERVER --> RUNNER

