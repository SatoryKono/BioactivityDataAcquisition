            DSF["DataSourceFactory<br/>canonical provider adapter path"]:::size-md
            RF["RunnerFactory<br/>pipeline runner creation"]:::size-md
        end

        subgraph Runtime["Runtime bootstrap"]
            RUNTIME["bootstrap.runtime<br/>pipeline / composite bootstrap"]:::size-md
            RH["Runtime assembly helpers<br/>RunnerFactoryBuilderService +<br/>CompositeSupportServicesFactory"]:::size-md
        end

        subgraph Admin["CLI/bootstrap services"]
            SUPPORT["bootstrap.cli + bootstrap.assembly<br/>admin commands + shared ports"]:::size-md
        end
    end

    subgraph Created["Created collaborators"]
        ADAPTER["Provider adapter<br/>DataSourcePort"]:::size-md
        STORAGE["StorageAdapter<br/>Bronze / Silver / Gold"]:::size-md
        OBS["Observability bundle<br/>logger / metrics / tracer"]:::size-md
        LOCK["LockPort + checkpoint / quarantine ports"]:::size-md
        RUNNER["PipelineRunner"]:::size-md
        COMPOSITE["CompositePipelineRunnerService"]:::size-md
        ADMINSVC["Admin services<br/>health / export / vacuum / checkpoint"]:::size-md
    end

    CALLERS ==> ENTRY
    ENTRY --> BOOT

    BOOT --> RUNTIME
