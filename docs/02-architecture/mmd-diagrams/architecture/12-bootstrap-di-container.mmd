graph TB
    CALLERS["Entry callers<br/>CLI + tests/scripts + future API"]:::size-md

    subgraph Public["Public composition seams"]
        ENTRY["composition.entrypoints<br/>canonical retained facade"]:::size-md
        BOOT["composition.bootstrap<br/>runtime / cli / assembly"]:::size-md
    end

    subgraph Composition["Internal composition modules"]
        subgraph Registries["Registries + factories"]
            PR["ProviderRegistry<br/>provider configs + creators"]:::size-md
