%% BioETL — Bootstrap / DI Container (Composition Root)
%% Shows how dependencies are assembled and wired together.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   29

%%{init: {'layout': 'elk', 'elk': {'mergeEdges': false, 'nodePlacementStrategy': 'NETWORK_SIMPLEX', 'edgeRouting': 'POLYLINE'}}}%%
%% @uniform width=192 height=108 max_title_len=19 max_desc_lines=4
graph TB
    subgraph Entry["Entry Points"]
        CLI["CLI Commands<br/>(Click)<br/>"]
        HTTP["HTTP Interface<br/>"]
    end

    subgraph Composition["composition layer"]
        subgraph Bootstrap["Bootstrap Assembly"]
            RA["RuntimeAssembly<br/>━━━━━━━━━━━━━━━━━<br/>Central DI wiring point.<br/>Creates all infrastructure<br/>and application components."]
            RBA["RunnerBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_runner()<br/>"]
            SBA["StorageBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_storage()<br/>"]
            HBA["HealthBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_health()<br/>"]
            CBA["CheckpointBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_checkpoint()<br/>"]
            LBA["LockBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_lock()<br/>"]
        end

        subgraph Factories["Factories"]
            DSR["DataSourceRegistry<br/>━━━━━━━━━━━━━━━━━<br/>Maps provider+entity →<br/>DataSourcePort factory<br/>"]
            TF["TransformerFactory<br/>━━━━━━━━━━━━━━━━━<br/>Maps provider+entity →<br/>BaseTransformer factory<br/>"]
            RF["RunnerFactory<br/>━━━━━━━━━━━━━━━━━<br/>+ create_runner()<br/>"]
            DQF["DQFactory<br/>━━━━━━━━━━━━━━━━━<br/>+ create_dq_analyzers()<br/>"]
        end

        subgraph Providers["Provider Registry"]
            PR["ProviderRegistry<br/>━━━━━━━━━━━━━━━━━<br/>Registers all provider<br/>pipelines and their<br/>extraction params"]
            EP["ExtractionParams<br/>Registration<br/>"]
        end

        subgraph Builders["Runtime Builders"]
            RB["RunnerBuilder<br/>━━━━━━━━━━━━━━━━━<br/>Fluent builder for<br/>PipelineRunner creation<br/>"]
        end
    end

    subgraph Created["Created Components"]
        subgraph InfraCreated["Infrastructure"]
            ADAPTER["Provider Adapter<br/>(DataSourcePort)<br/>"]
            STORAGE["BronzeWriter +<br/>SilverWriter +<br/>GoldWriter<br/>"]
            LOGGER["UnifiedLogger<br/>(LoggerPort)<br/>"]
            METRICS["PrometheusMetrics<br/>(MetricsPort)<br/>"]
            TRACER["OpenTelemetryTracer<br/>(TracingPort)<br/>"]
            LOCK["MemoryLock<br/>(LockPort)<br/>"]
            CHKPT["LocalCheckpoint<br/>(CheckpointPort)<br/>"]
            QUAR["UnifiedQuarantine<br/>(QuarantinePort)<br/>"]
        end

        subgraph AppCreated["Application"]
            PS["PipelineServices<br/>(frozen dataclass<br/>with all injected ports)<br/>"]
            RUNNER["PipelineRunner<br/>"]
            TRANSFORMER["BaseTransformer<br/>(provider-specific)<br/>"]
            OBSERVER["PipelineObserver<br/>"]
        end
    end

    %% Entry → Composition
    CLI --> RA
    HTTP --> RA

    %% Assembly wiring
    RA --> RBA
    RA --> SBA
    RA --> HBA
    RA --> CBA
    RA --> LBA

    %% Factories
    RA --> DSR
    RA --> TF
    RA --> RF
    RA --> DQF

    %% Provider registration
    PR --> DSR
    PR --> TF
    EP --> PR

    %% Builder
    RF --> RB

    %% Created components
    DSR -->|creates| ADAPTER
    SBA -->|creates| STORAGE
    RA -->|creates| LOGGER
    RA -->|creates| METRICS
    RA -->|creates| TRACER
    LBA -->|creates| LOCK
    CBA -->|creates| CHKPT
    RA -->|creates| QUAR
    RA -->|creates| AUDIT
    RA -->|creates| PII

    TF -->|creates| TRANSFORMER
    RBA -->|creates| RUNNER

    %% PipelineServices aggregation
    ADAPTER --> PS
    STORAGE --> PS
    LOGGER --> PS
    METRICS --> PS
    TRACER --> PS
    LOCK --> PS
    CHKPT --> PS
    QUAR --> PS

    PS --> RUNNER
    TRANSFORMER --> RUNNER
    OBSERVER --> RUNNER

    classDef entry fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef comp fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef factory fill:#fff3e0,stroke:#e65100
    classDef infra fill:#ffcdd2,stroke:#c62828
    classDef app fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px

    class CLI,HTTP entry
    class RA,RBA,SBA,HBA,CBA,LBA comp
    class DSR,TF,RF,DQF,PR,EP,RB factory
    class ADAPTER,STORAGE,LOGGER,METRICS,TRACER,LOCK,CHKPT,QUAR,AUDIT,PII infra
    class PS,RUNNER,TRANSFORMER,OBSERVER app
