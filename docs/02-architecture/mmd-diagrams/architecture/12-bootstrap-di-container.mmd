%% BioETL — Bootstrap / DI Container (Composition Root)
%% Shows how dependencies are assembled and wired together.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   29

%%{init: {'layout': 'elk', 'elk': {'mergeEdges': false, 'nodePlacementStrategy': 'SIMPLE', 'edgeRouting': 'ORTHOGONAL'}}}%%
%% @uniform width=192 height=108 max_title_len=19 max_desc_lines=4
graph TB
    subgraph Entry["Entry Points"]
        CLI["CLI Commands&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Click)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        HTTP["HTTP Interface&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Composition["composition layer"]
        subgraph Bootstrap["Bootstrap Assembly"]
            RA["RuntimeAssembly&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>Central DI wiring point.<br/>Creates all infrastructure<br/>and application components."]
            RBA["RunnerBootstrap&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_runner()<br/>&nbsp;<br/>&nbsp;"]
            SBA["StorageBootstrap&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_storage()<br/>&nbsp;<br/>&nbsp;"]
            HBA["HealthBootstrap&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_health()<br/>&nbsp;<br/>&nbsp;"]
            CBA["CheckpointBootstrap<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_checkpoint()<br/>&nbsp;<br/>&nbsp;"]
            LBA["LockBootstrap&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>+ assemble_lock()<br/>&nbsp;<br/>&nbsp;"]
        end

        subgraph Factories["Factories"]
            DSR["DataSourceRegistry&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>Maps provider+entity →<br/>DataSourcePort factory<br/>&nbsp;"]
            TF["TransformerFactory&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>Maps provider+entity →<br/>BaseTransformer factory<br/>&nbsp;"]
            RF["RunnerFactory&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>+ create_runner()<br/>&nbsp;<br/>&nbsp;"]
            DQF["DQFactory&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>+ create_dq_analyzers()<br/>&nbsp;<br/>&nbsp;"]
        end

        subgraph Providers["Provider Registry"]
            PR["ProviderRegistry&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>Registers all provider<br/>pipelines and their<br/>extraction params"]
            EP["ExtractionParams&nbsp;&nbsp;&nbsp;<br/>Registration<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        end

        subgraph Builders["Runtime Builders"]
            RB["RunnerBuilder&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━━━<br/>Fluent builder for<br/>PipelineRunner creation<br/>&nbsp;"]
        end
    end

    subgraph Created["Created Components"]
        subgraph InfraCreated["Infrastructure"]
            ADAPTER["Provider Adapter&nbsp;&nbsp;&nbsp;<br/>(DataSourcePort)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            STORAGE["BronzeWriter +&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>SilverWriter +<br/>GoldWriter<br/>&nbsp;<br/>&nbsp;"]
            LOGGER["UnifiedLogger&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(LoggerPort)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            METRICS["PrometheusMetrics&nbsp;&nbsp;<br/>(MetricsPort)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            TRACER["OpenTelemetryTracer<br/>(TracingPort)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            LOCK["MemoryLock&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(LockPort)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            CHKPT["LocalCheckpoint&nbsp;&nbsp;&nbsp;&nbsp;<br/>(CheckpointPort)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            QUAR["UnifiedQuarantine&nbsp;&nbsp;<br/>(QuarantinePort)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        end

        subgraph AppCreated["Application"]
            PS["PipelineServices&nbsp;&nbsp;&nbsp;<br/>(frozen dataclass<br/>with all injected ports)<br/>&nbsp;<br/>&nbsp;"]
            RUNNER["PipelineRunner&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            TRANSFORMER["BaseTransformer&nbsp;&nbsp;&nbsp;&nbsp;<br/>(provider-specific)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
            OBSERVER["PipelineObserver&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        end
    end

    %% Entry → Composition
    CLI --> RA
    HTTP --> RA

    %% Assembly wiring
    RA --> RBA
    RA --> SBA
    RA --> HBA
    RA --> CBA
    RA --> LBA

    %% Factories
    RA --> DSR
    RA --> TF
    RA --> RF
    RA --> DQF

    %% Provider registration
    PR --> DSR
    PR --> TF
    EP --> PR

    %% Builder
    RF --> RB

    %% Created components
    DSR -->|creates| ADAPTER
    SBA -->|creates| STORAGE
    RA -->|creates| LOGGER
    RA -->|creates| METRICS
    RA -->|creates| TRACER
    LBA -->|creates| LOCK
    CBA -->|creates| CHKPT
    RA -->|creates| QUAR
    RA -->|creates| AUDIT
    RA -->|creates| PII

    TF -->|creates| TRANSFORMER
    RBA -->|creates| RUNNER

    %% PipelineServices aggregation
    ADAPTER --> PS
    STORAGE --> PS
    LOGGER --> PS
    METRICS --> PS
    TRACER --> PS
    LOCK --> PS
    CHKPT --> PS
    QUAR --> PS

    PS --> RUNNER
    TRANSFORMER --> RUNNER
    OBSERVER --> RUNNER

    classDef entry fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef comp fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef factory fill:#fff3e0,stroke:#e65100
    classDef infra fill:#ffcdd2,stroke:#c62828
    classDef app fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px

    class CLI,HTTP entry
    class RA,RBA,SBA,HBA,CBA,LBA comp
    class DSR,TF,RF,DQF,PR,EP,RB factory
    class ADAPTER,STORAGE,LOGGER,METRICS,TRACER,LOCK,CHKPT,QUAR,AUDIT,PII infra
    class PS,RUNNER,TRANSFORMER,OBSERVER app
