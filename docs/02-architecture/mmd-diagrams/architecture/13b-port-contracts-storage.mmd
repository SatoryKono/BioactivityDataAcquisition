%% Port contracts — storage and medallion persistence ports
%% Covers write/read protocols for Bronze/Silver/Gold tiers.

%% @version 1.0.0
%% @date    2026-02-25
%% @type    flowchart
%% @level   System / Component
%% @status  active
%% @view    storage
%% @parent  13-port-protocol-contracts.mmd
%% @nodes   10

flowchart LR
    subgraph Domain["Domain Layer"]
        direction TB
        StoragePort[StoragePort]
        BronzeWriterPort[BronzeWriterPort]
        SilverWriterPort[SilverWriterPort]
        GoldWriterPort[GoldWriterPort]
        DeltaReaderPort[DeltaReaderPort]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        BronzeWriter[BronzeWriter]
        SilverWriter[SilverWriter]
        GoldWriter[GoldWriter]
        DeltaReader[DeltaReader]
        QuarantineWriter[QuarantineWriter]
    end

    BronzeWriter -.-> BronzeWriterPort
    SilverWriter -.-> SilverWriterPort
    GoldWriter -.-> GoldWriterPort
    DeltaReader -.-> DeltaReaderPort
    QuarantineWriter -.-> StoragePort
    StoragePort --> BronzeWriterPort
    StoragePort --> SilverWriterPort
    StoragePort --> GoldWriterPort
    StoragePort --> DeltaReaderPort

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
