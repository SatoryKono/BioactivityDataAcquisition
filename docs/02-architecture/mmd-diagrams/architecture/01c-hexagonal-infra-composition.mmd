%% Hexagonal detail — infrastructure adapters and composition factories
%% Covers DI factories that bind adapters to domain ports.

%% @version 1.0.0
%% @date    2026-02-25
%% @type    flowchart
%% @level   System / Component
%% @status  active
%% @view    detail
%% @parent  01-high-level-hexagonal.mmd
%% @nodes   13

flowchart LR
    subgraph Composition["Composition Layer"]
        direction TB
        BootstrapFactory[BootstrapFactory]
        ServiceFactory[ServiceFactory]
        ProviderAdapterFactory[ProviderAdapterFactory]
        PipelineFactory[PipelineFactory]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        ProviderClients[Provider Clients]
        StorageAdapters[Storage Adapters]
        ObservabilityAdapters[Observability Adapters]
        ResilienceAdapters[Resilience Adapters]
        SecurityAdapters[Security Adapters]
        ConfigAdapters[Config Adapters]
    end

    subgraph Domain["Domain Layer"]
        direction TB
        DataPorts[Data Ports]
        StoragePorts[Storage Ports]
        OpsPorts[Ops Ports]
    end

    BootstrapFactory --> ServiceFactory
    ServiceFactory --> ProviderAdapterFactory
    ServiceFactory --> PipelineFactory
    ProviderAdapterFactory --> ProviderClients
    PipelineFactory --> StorageAdapters
    PipelineFactory --> ObservabilityAdapters
    PipelineFactory --> ResilienceAdapters
    PipelineFactory --> SecurityAdapters
    PipelineFactory --> ConfigAdapters
    ProviderClients -.-> DataPorts
    StorageAdapters -.-> StoragePorts
    ObservabilityAdapters -.-> OpsPorts
    ResilienceAdapters -.-> OpsPorts

    style Composition fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
