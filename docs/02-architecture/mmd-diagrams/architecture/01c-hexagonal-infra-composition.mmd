%% Hexagonal Architecture — infrastructure and composition detail
%% Covers infrastructure implementations and composition factories.

%% @version 1.0.0
%% @date    2026-02-25
%% @type    flowchart
%% @level   System / Component
%% @status  active
%% @view    detail
%% @parent  01-high-level-hexagonal.mmd
%% @nodes   16

flowchart LR
    subgraph Composition["Composition Layer"]
        direction TB
        RF[RunnerFactory]:::factory
        TF[TransformerFactory]:::factory
        DF[DataSourceFactory]:::factory
    end
    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        CHA[ChemblAdapter]:::adapter
        PMA[PubMedAdapter]:::adapter
        BW[BronzeWriter]:::adapter
        SW[SilverWriter]:::adapter
        GW[GoldWriter]:::adapter
        LOG[UnifiedLogger]:::adapter
    end
    subgraph Domain["Domain Layer"]
        direction TB
        DSP[DataSourcePort]:::port
        STP[StoragePort]:::port
        LGP[LoggerPort]:::port
    end
    RF --> DF
    RF --> TF
    DF --> CHA
    DF --> PMA
    TF --> BW
    TF --> SW
    TF --> GW
    LOG -.-> LGP
    CHA -.-> DSP
    PMA -.-> DSP
    BW -.-> STP
    SW -.-> STP
    GW -.-> STP
    classDef port fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1.5px
    classDef adapter fill:#ffcdd2,stroke:#c62828,stroke-width:1.5px
    classDef factory fill:#fff3e0,stroke:#e65100,stroke-width:1.5px
