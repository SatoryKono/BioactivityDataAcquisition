%% BioETL — Configuration System
%% Shows how YAML configs are loaded, validated, and used across the system.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   29

%%{init: {'layout': 'elk', 'elk': {'mergeEdges': false, 'nodePlacementStrategy': 'SIMPLE', 'edgeRouting': 'ORTHOGONAL'}}}%%
%% @uniform width=216 height=198 max_title_len=22 max_desc_lines=9
graph LR
%% keep-orphan: APC, CBC, CCFG, OBS_SET, PCP, PIPE_SET, SETTINGS, SRC
    subgraph YAML["YAML Config Files"]
        PC_YAML["configs/pipelines/<br/>*.yaml<br/>(pipeline configs)<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        DQ_YAML["configs/quality/<br/>*.yaml<br/>(DQ rules)<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        FILT_YAML["configs/filters/<br/>*.yaml<br/>(filter configs)<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        COMP_YAML["configs/composite/<br/>*.yaml<br/>(composite pipeline configs)<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        FG_YAML["configs/field_groups/<br/>*.yaml<br/>(field group definitions)<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph Loaders["Infrastructure Config Loaders"]
        PCL["PipelineConfigLoader<br/>━━━━━━━━━━━━━━━━━<br/>+ load(path) → PipelineConfig<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        DQCL["DQConfigLoader<br/>━━━━━━━━━━━━━━━━━<br/>+ load(path) → DQConfig<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        FCL["FilterConfigLoader<br/>━━━━━━━━━━━━━━━━━<br/>+ load(path) → FilterConfig<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        FGL["FieldGroupLoader<br/>━━━━━━━━━━━━━━━━━<br/>+ load(path) → FieldGroupConfig<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        BCL["BaseConfigLoader<br/>(ABC, Generic[T])<br/>━━━━━━━━━━━━━━━━━<br/>+ load() → T<br/>+ _validate() → T<br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph InfraSchemas["Infrastructure Schemas (Pydantic)"]
        PYC["PipelineYamlConfig<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        APC["ApiConfig<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        SRC["SourceConfig<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        CBC["CircuitBreakerConfig<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        DQF["DQConfigFile<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        FFG["FilterConfigFile<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        PCP["PipelineContractPolicy<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph DomainConfig["Domain Configuration"]
        RT["RuntimeConfig<br/>━━━━━━━━━━━━━━━━━<br/>run_type: RunType<br/>resume: bool<br/>limit: int | None<br/>heartbeat_interval: int<br/>dry_run: bool<br/>vacuum_after_run: bool<br/>strict_validation: bool<br/>skip_gold: bool"]:::size-lg
        PIPE["PipelineConfig<br/>━━━━━━━━━━━━━━━━━<br/>pipeline_name: str<br/>provider: str<br/>entity_type: str<br/>table: TableConfig<br/>batch_size: int<br/>checkpoint_interval: int<br/>dq: DQConfig<br/>loading_strategy: LoadingStrategy"]:::size-lg
        TC["TableConfig<br/>━━━━━━━━━━━━━━━━━<br/>silver_table: str<br/>gold_table: str<br/><br/><br/><br/><br/><br/>"]:::size-lg
        DQC["DQConfig<br/>━━━━━━━━━━━━━━━━━<br/>soft_error_threshold: float<br/>hard_error_threshold: float<br/><br/><br/><br/><br/><br/>"]:::size-lg
        SFC["SilverFilterConfig<br/>━━━━━━━━━━━━━━━━━<br/>source_path: str<br/>column_name: str<br/><br/><br/><br/><br/><br/>"]:::size-lg
        GFC["GoldFilterConfig<br/>━━━━━━━━━━━━━━━━━<br/>source_path: str<br/>column_name: str<br/><br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph CompositeConfig["Composite Domain Config"]
        CCFG["CompositeConfig<br/>━━━━━━━━━━━━━━━━━<br/>name: str<br/>seed: SeedConfig<br/>dependencies: DependencyConfig[]<br/>enrichers: EnricherConfig[]<br/>merge: MergeConfig<br/><br/><br/>"]:::size-lg
    end

    subgraph AppConfig["Application Config"]
        RPC["RecordProcessorConfig<br/>━━━━━━━━━━━━━━━━━<br/>table_config: TableConfig<br/>silver_schema<br/>gold_schema<br/>dq_config: DQConfig<br/><br/><br/><br/>"]:::size-lg
        LC["LockConfig<br/>━━━━━━━━━━━━━━━━━<br/>timeout: float<br/>heartbeat_interval: int<br/>max_retries: int<br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph InfraSettings["Infrastructure Settings"]
        SETTINGS["Settings<br/>(pydantic BaseSettings)<br/>━━━━━━━━━━━━━━━━━<br/>data_dir: Path<br/>log_level: str<br/>providers: dict<br/>+ from YAML + ENV<br/><br/><br/>"]:::size-lg
        OBS_SET["ObservabilitySettings<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        PIPE_SET["PipelineSettings<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
    end

    %% YAML → Loaders
    PC_YAML --> PCL
    DQ_YAML --> DQCL
    FILT_YAML --> FCL
    FG_YAML --> FGL
    COMP_YAML --> PCL

    %% Loaders inheritance
    BCL --> PCL
    BCL --> DQCL
    BCL --> FCL

    %% Loaders → Infra Schemas (validation)
    PCL --> PYC
    DQCL --> DQF
    FCL --> FFG

    %% Infra Schemas → Domain Config
    PYC --> PIPE
    DQF --> DQC
    FFG --> SFC & GFC

    %% Domain Config composition
    PIPE --> TC
    PIPE --> DQC
    PIPE --> SFC
    PIPE --> GFC

    %% Application uses domain config
    PIPE --> RPC
    RT --> LC

    classDef yaml fill:#fefce8,stroke:#ca8a04,stroke-width:2px
    classDef loader fill:#fff7ed,stroke:#f59e0b
    classDef schema fill:#ffe4e6,stroke:#dc2626
    classDef domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef app fill:#f0fdf4,stroke:#16a34a
    classDef settings fill:#f1f5f9,stroke:#64748b

    class PC_YAML,DQ_YAML,FILT_YAML,COMP_YAML,FG_YAML yaml
    class PCL,DQCL,FCL,FGL,BCL loader
    class PYC,APC,SRC,CBC,DQF,FFG,PCP schema
    class RT,PIPE,TC,DQC,SFC,GFC,CCFG domain
    class RPC,LC app
    class SETTINGS,OBS_SET,PIPE_SET settings
