%% BioETL — Configuration System
%% Shows how YAML configs are loaded, validated, and used across the system.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @status  active
%% @nodes   ~29

graph TB
    subgraph YAML["YAML Config Files"]
        PC_YAML["configs/pipelines/<br/>*.yaml<br/>(pipeline configs)"]
        DQ_YAML["configs/quality/<br/>*.yaml<br/>(DQ rules)"]
        FILT_YAML["configs/filters/<br/>*.yaml<br/>(filter configs)"]
        COMP_YAML["configs/composite/<br/>*.yaml<br/>(composite pipeline configs)"]
        FG_YAML["configs/field_groups/<br/>*.yaml<br/>(field group definitions)"]
    end

    subgraph Loaders["Infrastructure Config Loaders"]
        PCL["PipelineConfigLoader<br/>━━━━━━━━━━━━━━━━━<br/>+ load(path) → PipelineConfig"]
        DQCL["DQConfigLoader<br/>━━━━━━━━━━━━━━━━━<br/>+ load(path) → DQConfig"]
        FCL["FilterConfigLoader<br/>━━━━━━━━━━━━━━━━━<br/>+ load(path) → FilterConfig"]
        FGL["FieldGroupLoader<br/>━━━━━━━━━━━━━━━━━<br/>+ load(path) → FieldGroupConfig"]
        BCL["BaseConfigLoader<br/>(ABC, Generic[T])<br/>━━━━━━━━━━━━━━━━━<br/>+ load() → T<br/>+ _validate() → T"]
    end

    subgraph InfraSchemas["Infrastructure Schemas (Pydantic)"]
        PYC["PipelineYamlConfig"]
        APC["ApiConfig"]
        SRC["SourceConfig"]
        CBC["CircuitBreakerConfig"]
        DQF["DQConfigFile"]
        FFG["FilterConfigFile"]
        PCP["PipelineContractPolicy"]
    end

    subgraph DomainConfig["Domain Configuration"]
        RT["RuntimeConfig<br/>━━━━━━━━━━━━━━━━━<br/>run_type: RunType<br/>resume: bool<br/>limit: int | None<br/>heartbeat_interval: int<br/>dry_run: bool<br/>vacuum_after_run: bool<br/>strict_validation: bool<br/>skip_gold: bool"]

        PIPE["PipelineConfig<br/>━━━━━━━━━━━━━━━━━<br/>pipeline_name: str<br/>provider: str<br/>entity_type: str<br/>table: TableConfig<br/>batch_size: int<br/>checkpoint_interval: int<br/>dq: DQConfig<br/>loading_strategy: LoadingStrategy"]

        TC["TableConfig<br/>━━━━━━━━━━━━━━━━━<br/>silver_table: str<br/>gold_table: str"]

        DQC["DQConfig<br/>━━━━━━━━━━━━━━━━━<br/>soft_error_threshold: float<br/>hard_error_threshold: float"]

        SFC["SilverFilterConfig<br/>━━━━━━━━━━━━━━━━━<br/>source_path: str<br/>column_name: str"]

        GFC["GoldFilterConfig<br/>━━━━━━━━━━━━━━━━━<br/>source_path: str<br/>column_name: str"]
    end

    subgraph CompositeConfig["Composite Domain Config"]
        CCFG["CompositeConfig<br/>━━━━━━━━━━━━━━━━━<br/>name: str<br/>seed: SeedConfig<br/>dependencies: DependencyConfig[]<br/>enrichers: EnricherConfig[]<br/>merge: MergeConfig"]
    end

    subgraph AppConfig["Application Config"]
        RPC["RecordProcessorConfig<br/>━━━━━━━━━━━━━━━━━<br/>table_config: TableConfig<br/>silver_schema<br/>gold_schema<br/>dq_config: DQConfig"]
        LC["LockConfig<br/>━━━━━━━━━━━━━━━━━<br/>timeout: float<br/>heartbeat_interval: int<br/>max_retries: int"]
    end

    subgraph InfraSettings["Infrastructure Settings"]
        SETTINGS["Settings<br/>(pydantic BaseSettings)<br/>━━━━━━━━━━━━━━━━━<br/>data_dir: Path<br/>log_level: str<br/>providers: dict<br/>+ from YAML + ENV"]
        OBS_SET["ObservabilitySettings"]
        PIPE_SET["PipelineSettings"]
    end

    %% YAML → Loaders
    PC_YAML --> PCL
    DQ_YAML --> DQCL
    FILT_YAML --> FCL
    FG_YAML --> FGL
    COMP_YAML --> PCL

    %% Loaders inheritance
    BCL --> PCL
    BCL --> DQCL
    BCL --> FCL

    %% Loaders → Infra Schemas (validation)
    PCL --> PYC
    DQCL --> DQF
    FCL --> FFG

    %% Infra Schemas → Domain Config
    PYC --> PIPE
    DQF --> DQC
    FFG --> SFC & GFC

    %% Domain Config composition
    PIPE --> TC
    PIPE --> DQC
    PIPE --> SFC
    PIPE --> GFC

    %% Application uses domain config
    PIPE --> RPC
    RT --> LC

    classDef yaml fill:#fff9c4,stroke:#f57f17,stroke-width:2px
    classDef loader fill:#fff3e0,stroke:#e65100
    classDef schema fill:#fce4ec,stroke:#b71c1c
    classDef domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef app fill:#e8f5e9,stroke:#2e7d32
    classDef settings fill:#eceff1,stroke:#455a64

    class PC_YAML,DQ_YAML,FILT_YAML,COMP_YAML,FG_YAML yaml
    class PCL,DQCL,FCL,FGL,BCL loader
    class PYC,APC,SRC,CBC,DQF,FFG,PCP schema
    class RT,PIPE,TC,DQC,SFC,GFC,CCFG domain
    class RPC,LC app
    class SETTINGS,OBS_SET,PIPE_SET settings
