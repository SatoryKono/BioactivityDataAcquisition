%% keep-orphan: DQW, NOV
    subgraph Port["Domain Port"]
        SP["StoragePort<br/>(Protocol)"]:::size-lg
    end

    subgraph Writers["Storage Writers"]
        subgraph BronzeStorage["Bronze Storage"]
            BW["BronzeWriter<br/>base_path + logger + metrics<br/>save_json + validate_json<br/>write_bronze()<br/>aclose()"]:::size-lg
            AWG["AtomicWriteGroup<br/>━━━━━━━━━━━━━━━━━<br/>Atomic multi-file writes<br/>with rollback"]:::size-lg
        end

        subgraph SilverStorage["Silver Storage"]
            BDW["BaseDeltaWriter<br/>base_path + logger<br/>retention manager<br/>get_table_path()<br/>clear()<br/>prepare_arrow_data()"]:::size-lg
            SWR["SilverWriter<br/>csv_exporter + write_policy<br/>silver_validator<br/>write_silver()<br/>merge_silver()<br/>clear_silver()"]:::size-lg
        end

        subgraph GoldStorage["Gold Storage"]
            GWR["GoldWriter<br/>━━━━━━━━━━━━━━━━━<br/>csv_exporter: CsvExporter<br/>audit: AuditPort<br/>metadata_writer: MetadataWriterPort<br/>━━━━━━━━━━━━━━━━━<br/>+ write_gold()<br/>+ clear_gold()"]:::size-lg
        end

        subgraph Reader["Delta Reader"]
        end
    end

    subgraph Support["Support Components"]
        AC["ArrowDataConverter<br/>(records → PyArrow)"]:::size-lg
        RM["RetentionManager<br/>(vacuum/retention)"]:::size-lg
        MW["MetadataWriter<br/>(_metadata.yaml)"]:::size-lg
        CSV["CsvExporter<br/>(Delta → CSV export)"]:::size-lg
        DQW["DQReportWriter<br/>(DQ reports JSON)"]:::size-lg
    end

    subgraph Validation["Validation"]
        PSV["PanderaSilverValidator<br/>(SilverValidatorPort)"]:::size-lg
        PGV["PanderaGoldValidator<br/>(GoldValidatorPort)"]:::size-lg
        NOV["NoOpValidator<br/>(Null Object)"]:::size-lg
    end

    subgraph FileSystem["File System Layout"]
        FS_B["data/<br/>├── bronze/<br/>│   └── {provider}/{entity}/{date}/<br/>│       ├── batch_*.jsonl.zst<br/>│       └── _metadata.yaml"]:::size-lg
        FS_S["├── silver/<br/>│   └── {provider}_{entity}/<br/>│       ├── _delta_log/<br/>│       ├── part-*.parquet<br/>│       └── _metadata.yaml"]:::size-lg
        FS_G["└── gold/<br/>└── {provider}_{entity}/<br/>├── _delta_log/<br/>├── part-*.parquet<br/>└── _metadata.yaml"]:::size-lg
    end

