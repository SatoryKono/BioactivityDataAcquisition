flowchart LR
    subgraph Domain["Domain Layer"]
        direction TB
        DSP[DataSourcePort]:::port
        FDSP[FilterableDataSourcePort]:::port
        IFP[InputFilterPort]:::port
    end
    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        CA[ChemblAdapter]:::adapter
        PA[PubMedAdapter]:::adapter
        UA[UniProtAdapter]:::adapter
        CRA[CrossRefAdapter]:::adapter
        OAA[OpenAlexAdapter]:::adapter
        SSA[SemanticScholarAdapter]:::adapter
        PCA[PubChemAdapter]:::adapter
        CSVR[CsvFilterReader]:::adapter
    end
    DSP -.-> CA
    DSP -.-> PA
    DSP -.-> UA
    DSP -.-> CRA
    DSP -.-> OAA
    DSP -.-> SSA
    DSP -.-> PCA
    FDSP -.-> IFP
    IFP -.-> CSVR
    classDef port fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1.5px
    classDef adapter fill:#ffcdd2,stroke:#c62828,stroke-width:1.5px
    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
