    LocalCheckpoint -.-> CheckpointPort
    FileAuditAdapter -.-> AuditPort
    QuarantineAdapter -.-> QuarantinePort
    HealthAdapter -.-> HealthCheckPort
    YamlConfigAdapter -.-> ConfigPort

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
