        direction TB
        LockPort[LockPort]
        CheckpointPort[CheckpointPort]
        AuditPort[AuditPort]
        QuarantinePort[QuarantinePort]
        HealthCheckPort[HealthCheckPort]
        ConfigPort[ConfigPort]
