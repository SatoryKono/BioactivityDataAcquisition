%% BioETL — Provider Adapter Hierarchy
%% Shows how each provider adapter inherits from base classes and implements DataSourcePort.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   27
%% @reference  Decomposed into 05a, 05b sub-diagrams

%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
%% @uniform width=304 height=180 max_title_len=33 max_desc_lines=8
graph TB
%% keep-orphan: DFM, HCP, UIDM
    subgraph Ports["Domain Ports"]
        DSP["DataSourcePort<br/>(Protocol)"]:::size-lg
        HCP["HealthCheckPort<br/>(Protocol)"]:::size-lg
    end

    DSP -->|extends| FDSP

    subgraph Mixins["Mixins"]
        HCM["HealthCheckMixin"]:::size-lg
        HCPM["HealthCheckProviderMixin"]:::size-lg
        NSMF["NotSupportedMultiFilterMixin"]:::size-lg
        DFM["DelegatingFallbackMixin"]:::size-lg
        FSM["FilterableStubMixin"]:::size-lg
        PFM["PaginatedFetcherMixin"]:::size-lg
    end

    HCM --> HCPM

    subgraph Base["Base Adapters"]
        BHA["BaseHttpAdapter<br/>http_client + logger + metrics<br/>core: fetch/health_check/aclose"]:::size-lg
        BSA["BaseSyncAdapter<br/>logger + rate_limiter<br/>circuit_breaker + thread_pool<br/>core: fetch + health"]:::size-lg
    end

    HCPM --> BHA
    DSP -.->|implements| BHA
    HCPM --> BSA
    DSP -.->|implements| BSA

    subgraph ChEMBL["ChEMBL"]
        CHM["ChemblHealthMixin"]:::size-lg
        CMM["ChemblMetadataMixin"]:::size-lg
        CA["ChemblAdapter<br/>fetch + filtered + multi-filter<br/>fallback + model output"]:::size-lg
    end

    BHA --> CA
    CHM --> CA
    CMM --> CA

    subgraph PubMed["PubMed"]
        PSM["PubMedSearchMixin"]:::size-lg
        PFetchM["PubMedFetchMixin"]:::size-lg
        PHM["PubMedHealthMixin"]:::size-lg
        PA["PubMedAdapter<br/>email + api_key + batch_size<br/>fetch + filtered + fallback"]:::size-lg
    end

    BHA --> PA
    NSMF --> PA
    PSM --> PA
    PFetchM --> PA
    PHM --> PA

    subgraph UniProt["UniProt"]
        UA["UniProtAdapter<br/>api_key + base_url<br/>fetch + filtered + multi-filter"]:::size-lg
        UIDM["UniProtIDMappingClient"]:::size-lg
    end

    BHA --> UA
    PFM --> UA

    subgraph CrossRef["CrossRef"]
        CRA["CrossRefAdapter<br/>mailto + batch_size<br/>fetch + filtered + fallback"]:::size-lg
    end

    BHA --> CRA

    subgraph OpenAlex["OpenAlex"]
        OAA["OpenAlexAdapter<br/>mailto + batch_size<br/>fetch + filtered + fallback"]:::size-lg
    end

    BHA --> OAA

    subgraph SemanticScholar["Semantic Scholar"]
        SSA["SemanticScholarAdapter<br/>api_key + batch_size + fields<br/>fetch + filtered + fallback"]:::size-lg
    end

    BHA --> SSA

    subgraph PubChem["PubChem"]
        PCA["PubChemAdapter<br/>sync adapter (ThreadPool)<br/>fetch + filtered + model output"]:::size-lg
    end

    BSA --> PCA
    FSM --> PCA

    subgraph Decorators["Adapter Decorators"]
    end

    DSP -.->|wraps| CBD
    DSP -.->|wraps| RDD
    DSP -.->|wraps| CBDS

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef base fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef mixin fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px
    classDef decorator fill:#f1f5f9,stroke:#64748b,stroke-width:1px

    class DSP,FDSP,HCP port
    class BHA,BSA base
    class CA,PA,UA,UIDM,CRA,OAA,SSA,PCA adapter
    class HCM,HCPM,NSMF,DFM,FSM,PFM,CHM,CMM,PSM,PFetchM,PHM mixin
    class CBD,RDD,CBDS decorator
