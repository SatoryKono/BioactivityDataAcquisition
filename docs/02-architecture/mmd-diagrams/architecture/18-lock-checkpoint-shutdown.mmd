%% @uniform width=264 height=216 max_title_len=28 max_desc_lines=10
%%{init: {'layout': 'elk', 'theme': 'base', 'themeVariables': {'fontFamily': 'Inter, Roboto, sans-serif'}, 'elk': {'mergeEdges': true, 'nodePlacementStrategy': 'BRANDES_KOEPF', 'cycleBreakingStrategy': 'GREEDY', 'spacing.nodeNode': 40, 'spacing.edgeNode': 30, 'spacing.edgeEdge': 20, 'edgeRouting': 'POLYLINE'}}}%%
graph TB
%% keep-orphan: LNHE, SHP
    subgraph Ports["Domain Ports"]
        LKP["LockPort<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ acquire(key, owner, ttl)<br/>+ release(key, owner)<br/>+ heartbeat(key, owner)<br/>+ validate_owner(key, owner)<br/>+ validate_fencing_token(token)<br/><br/><br/>"]:::size-lg
        CKP["CheckpointPort<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ save(key, data)<br/>+ load(key) → dict | None<br/>+ list_all() → list<br/>+ delete(key)<br/><br/><br/><br/>"]:::size-lg
        SHP["ShutdownPort<br/>(Protocol)<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph DomainLock["Domain Lock Types"]
        FT["FencingToken<br/>(frozen dataclass)<br/>━━━━━━━━━━━━━━━━━<br/>sequence: int<br/>key: str<br/>owner_id: RunID<br/>issued_at: float<br/><br/><br/><br/>"]:::size-lg
        LNHE["LockNotHeldError<br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
    end

    subgraph AppLock["Application: LockManager"]
        LM["LockManager<br/>━━━━━━━━━━━━━━━━━<br/>_lock: LockPort<br/>_run_id: RunID<br/>_config: LockConfig<br/>_shutdown_signal: ShutdownSignal<br/>━━━━━━━━━━━━━━━━━<br/>+ acquire(timeout) → FencingToken<br/>+ release()<br/>+ validate() → bool<br/>"]:::size-lg
        HB["HeartbeatTask<br/>━━━━━━━━━━━━━━━━━<br/>Background async task<br/>periodically calls<br/>lock.heartbeat()<br/><br/><br/><br/><br/><br/>"]:::size-lg
    end

        CM["CheckpointManager<br/>━━━━━━━━━━━━━━━━━<br/>_checkpoint: CheckpointPort<br/>_pipeline_name: str<br/>_run_id: RunID<br/>_resume: bool<br/>━━━━━━━━━━━━━━━━━<br/>+ load_checkpoint() → dict | None<br/>+ save_checkpoint(offset)<br/>+ delete_checkpoint()<br/>"]:::size-lg

    subgraph AppShutdown["Application: Shutdown"]
        SS["ShutdownSignal<br/>━━━━━━━━━━━━━━━━━<br/>is_requested: bool<br/>reason: ShutdownReason | None<br/>━━━━━━━━━━━━━━━━━<br/>+ request(reason)<br/>+ reset()<br/><br/><br/><br/>"]:::size-lg
        SR["ShutdownReason<br/>━━━━━━━━━━━━━━━━━<br/>SIGINT<br/>SIGTERM<br/>LOCK_LOST<br/>MEMORY_PRESSURE<br/>DQ_THRESHOLD<br/><br/><br/><br/>"]:::size-lg
    end

        ML["MemoryLock<br/>━━━━━━━━━━━━━━━━━<br/>_locks: dict<br/>_global_lock: asyncio.Lock<br/>_ttl_check_interval: float<br/>━━━━━━━━━━━━━━━━━<br/>+ acquire() → FencingToken<br/>+ release()<br/>+ heartbeat() — extend TTL<br/>+ validate_owner()<br/>+ validate_fencing_token()"]:::size-lg

        LCP["LocalCheckpoint<br/>━━━━━━━━━━━━━━━━━<br/>base_path: Path<br/>━━━━━━━━━━━━━━━━━<br/>+ save() — atomic (tmp + rename)<br/>+ load() → dict<br/>+ exists() → bool<br/>+ delete()<br/><br/><br/>"]:::size-lg

        SG["BatchWriter._validate_lock()<br/>━━━━━━━━━━━━━━━━━<br/>Before each Silver/Gold write:<br/>1. validate lock still held<br/>2. validate fencing token<br/>3. raise LockNotHeldError if invalid<br/>Prevents split-brain writes<br/><br/><br/><br/>"]:::size-lg

    subgraph Lifecycle["Pipeline Lifecycle Integration"]
        direction LR
        START["Pipeline Start<br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        ACQ["Acquire Lock<br/>+ start heartbeat<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        EXEC["Execute Batches<br/>+ save checkpoints<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        SIG["Signal received?<br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        GRACEFUL["Graceful shutdown:<br/>finish current batch,<br/>save checkpoint,<br/>release lock<br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        REL["Release Lock<br/>+ delete checkpoint<br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        END["Pipeline End<br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>"]:::size-lg
        START --> ACQ --> EXEC --> SIG
        SIG -->|"yes"| GRACEFUL --> END
        SIG -->|"no"| REL --> END
    end

    %% Port implementations
    LKP -.-> ML
    CKP -.-> LCP

    %% Application composition
    LM --> LKP
    LM --> HB
    LM --> FT & LC & LCH
    CM --> CKP

    %% Shutdown
    SS --> SR

    %% Safety guard
    SG --> LM

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef domain fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef infra fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef safety fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef lifecycle fill:#f1f5f9,stroke:#64748b,stroke-width:1.5px

    class LKP,CKP,SHP port
    class FT,LC,LCH,LNHE domain
    class LM,HB,CM,SS,SR app
    class ML,LCP infra
    class SG safety
    class START,ACQ,EXEC,SIG,GRACEFUL,REL,END lifecycle
