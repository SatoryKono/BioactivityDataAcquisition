%% BioETL — Locking, Checkpoint, and Graceful Shutdown
%% Shows distributed safety mechanisms.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @status  active
%% @nodes   ~22

graph TB
    subgraph Ports["Domain Ports"]
        LKP["LockPort<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ acquire(key, owner, ttl)<br/>+ release(key, owner)<br/>+ heartbeat(key, owner)<br/>+ validate_owner(key, owner)<br/>+ validate_fencing_token(token)"]
        CKP["CheckpointPort<br/>(Protocol)<br/>━━━━━━━━━━━━━━━━━<br/>+ save(key, data)<br/>+ load(key) → dict | None<br/>+ list_all() → list<br/>+ delete(key)"]
        SHP["ShutdownPort<br/>(Protocol)"]
    end

    subgraph DomainLock["Domain Lock Types"]
        FT["FencingToken<br/>(frozen dataclass)<br/>━━━━━━━━━━━━━━━━━<br/>sequence: int<br/>key: str<br/>owner_id: RunID<br/>issued_at: float"]
        LC["LockContext<br/>(frozen dataclass)<br/>━━━━━━━━━━━━━━━━━<br/>key: str<br/>owner_id: RunID<br/>exclusive: bool<br/>acquired_at: float | None<br/>fencing_token: FencingToken | None"]
        LCH["LockContextHolder<br/>━━━━━━━━━━━━━━━━━<br/>+ set(ctx)<br/>+ get() → LockContext<br/>+ clear()"]
        LNHE["LockNotHeldError"]
    end

    subgraph AppLock["Application: LockManager"]
        LM["LockManager<br/>━━━━━━━━━━━━━━━━━<br/>_lock: LockPort<br/>_run_id: RunID<br/>_config: LockConfig<br/>_shutdown_signal: ShutdownSignal<br/>━━━━━━━━━━━━━━━━━<br/>+ acquire(timeout) → FencingToken<br/>+ release()<br/>+ validate() → bool"]
        HB["HeartbeatTask<br/>━━━━━━━━━━━━━━━━━<br/>Background async task<br/>periodically calls<br/>lock.heartbeat()"]
    end

    subgraph AppCheckpoint["Application: CheckpointManager"]
        CM["CheckpointManager<br/>━━━━━━━━━━━━━━━━━<br/>_checkpoint: CheckpointPort<br/>_pipeline_name: str<br/>_run_id: RunID<br/>_resume: bool<br/>━━━━━━━━━━━━━━━━━<br/>+ load_checkpoint() → dict | None<br/>+ save_checkpoint(offset)<br/>+ delete_checkpoint()"]
    end

    subgraph AppShutdown["Application: Shutdown"]
        SS["ShutdownSignal<br/>━━━━━━━━━━━━━━━━━<br/>is_requested: bool<br/>reason: ShutdownReason | None<br/>━━━━━━━━━━━━━━━━━<br/>+ request(reason)<br/>+ reset()"]
        SR["ShutdownReason<br/>━━━━━━━━━━━━━━━━━<br/>SIGINT<br/>SIGTERM<br/>LOCK_LOST<br/>MEMORY_PRESSURE<br/>DQ_THRESHOLD"]
    end

    subgraph InfraLock["Infrastructure: MemoryLock"]
        ML["MemoryLock<br/>━━━━━━━━━━━━━━━━━<br/>_locks: dict<br/>_global_lock: asyncio.Lock<br/>_ttl_check_interval: float<br/>━━━━━━━━━━━━━━━━━<br/>+ acquire() → FencingToken<br/>+ release()<br/>+ heartbeat() — extend TTL<br/>+ validate_owner()<br/>+ validate_fencing_token()"]
    end

    subgraph InfraCheckpoint["Infrastructure: LocalCheckpoint"]
        LCP["LocalCheckpoint<br/>━━━━━━━━━━━━━━━━━<br/>base_path: Path<br/>━━━━━━━━━━━━━━━━━<br/>+ save() — atomic (tmp + rename)<br/>+ load() → dict<br/>+ exists() → bool<br/>+ delete()"]
    end

    subgraph SafetyGuard["Safety Guard Pattern"]
        SG["BatchWriter._validate_lock()<br/>━━━━━━━━━━━━━━━━━<br/>Before each Silver/Gold write:<br/>1. validate lock still held<br/>2. validate fencing token<br/>3. raise LockNotHeldError if invalid<br/><br/>Prevents split-brain writes"]
    end

    subgraph Lifecycle["Pipeline Lifecycle Integration"]
        direction LR
        START["Pipeline Start"]
        ACQ["Acquire Lock<br/>+ start heartbeat"]
        EXEC["Execute Batches<br/>+ save checkpoints"]
        SIG["Signal received?"]
        GRACEFUL["Graceful shutdown:<br/>finish current batch,<br/>save checkpoint,<br/>release lock"]
        REL["Release Lock<br/>+ delete checkpoint"]
        END["Pipeline End"]

        START --> ACQ --> EXEC --> SIG
        SIG -->|"yes"| GRACEFUL --> END
        SIG -->|"no"| REL --> END
    end

    %% Port implementations
    LKP -.-> ML
    CKP -.-> LCP

    %% Application composition
    LM --> LKP
    LM --> HB
    LM --> FT & LC & LCH
    CM --> CKP

    %% Shutdown
    SS --> SR

    %% Safety guard
    SG --> LM

    classDef port fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef domain fill:#c8e6c9,stroke:#2e7d32
    classDef app fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef infra fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef safety fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    classDef lifecycle fill:#eceff1,stroke:#455a64

    class LKP,CKP,SHP port
    class FT,LC,LCH,LNHE domain
    class LM,HB,CM,SS,SR app
    class ML,LCP infra
    class SG safety
    class START,ACQ,EXEC,SIG,GRACEFUL,REL,END lifecycle
