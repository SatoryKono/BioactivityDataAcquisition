%% BioETL — Locking, Checkpoint, and Graceful Shutdown
%% Shows distributed safety mechanisms.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   System / Component
%% @nodes   22
%% @reference  Decomposed into 18a-lock-system, 18b-checkpoint-shutdown

%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
%% @uniform width=264 height=216 max_title_len=28 max_desc_lines=10
graph TB
%% keep-orphan: LNHE, SHP
    subgraph Ports["Domain Ports"]
        LKP["LockPort (Protocol)<br/>acquire/release/heartbeat<br/>validate_owner + validate_token"]:::size-lg
        CKP["CheckpointPort (Protocol)<br/>save/load/list/delete"]:::size-lg
        SHP["ShutdownPort<br/>(Protocol)"]:::size-lg
    end

    subgraph DomainLock["Domain Lock Types"]
        FT["FencingToken<br/>sequence + key + owner_id + issued_at"]:::size-lg
        LNHE["LockNotHeldError"]:::size-lg
    end

    subgraph AppLock["Application: LockCoordinator"]
        LM["LockCoordinator<br/>lock + run_id + shutdown_signal<br/>acquire/release/validate"]:::size-lg
        HB["HeartbeatTask<br/>━━━━━━━━━━━━━━━━━<br/>Background async task<br/>periodically calls<br/>lock.heartbeat()"]:::size-lg
    end

    subgraph AppCheckpoint["Application: CheckpointManager"]
        CM["CheckpointManager<br/>checkpoint + pipeline_name + run_id<br/>load/save/delete checkpoint"]:::size-lg
    end

    subgraph AppShutdown["Application: Shutdown"]
        SS["ShutdownSignal<br/>is_requested + reason<br/>request(reason) + reset()"]:::size-lg
        SR["ShutdownReason<br/>SIGINT | SIGTERM | LOCK_LOST<br/>MEMORY_PRESSURE | DQ_THRESHOLD"]:::size-lg
    end

    subgraph InfraLock["Infrastructure: MemoryLock"]
        ML["MemoryLock<br/>in-memory lock store<br/>acquire/release/heartbeat<br/>validate owner + token"]:::size-lg
    end

    subgraph InfraCheckpoint["Infrastructure: LocalCheckpoint"]
        LCP["LocalCheckpoint<br/>base_path + atomic save/load<br/>exists + delete"]:::size-lg
    end

    subgraph SafetyGuard["Safety Guard Pattern"]
        SG["validate_lock()<br/>pre-write lock+token check<br/>raise LockNotHeldError<br/>prevent split-brain"]:::size-lg
    end

    subgraph Lifecycle["Pipeline Lifecycle Integration"]
        direction LR
        START["Pipeline Start"]:::size-lg
        ACQ["Acquire Lock<br/>+ start heartbeat"]:::size-lg
        EXEC["Execute Batches<br/>+ save checkpoints"]:::size-lg
        SIG["Signal received?"]:::size-lg
        GRACEFUL["Graceful shutdown<br/>finish batch + save checkpoint<br/>release lock"]:::size-lg
        REL["Release Lock<br/>+ delete checkpoint"]:::size-lg
        END["Pipeline End"]:::size-lg
        START --> ACQ --> EXEC --> SIG
        SIG -->|"yes"| GRACEFUL --> END
        SIG -->|"no"| REL --> END
    end

    %% Port implementations
    LKP -.-> ML
    CKP -.-> LCP

    %% Application composition
    LM --> LKP
    LM --> HB
    LM --> FT & LC & LCH
    CM --> CKP

    %% Shutdown
    SS --> SR

    %% Safety guard
    SG --> LM

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    classDef domain fill:#f5f3ff,stroke:#7c3aed
    classDef app fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    classDef infra fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef safety fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    classDef lifecycle fill:#f1f5f9,stroke:#64748b

    class LKP,CKP,SHP port
    class FT,LC,LCH,LNHE domain
    class LM,HB,CM,SS,SR app
    class ML,LCP infra
    class SG safety
    class START,ACQ,EXEC,SIG,GRACEFUL,REL,END lifecycle
