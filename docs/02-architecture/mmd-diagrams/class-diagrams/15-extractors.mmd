%% BioETL — Class Diagram: Field Extractors
%% Extractor pattern used in transformers.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    classDiagram
%% @level   Class / Interface
%% @uniform class width=232 height=72 max_title_len=23 max_desc_lines=2

classDiagram
    direction TB
    class BaseFieldExtractor {
        <<ABC>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record: dict) dict*&nbsp;&nbsp;&nbsp;
    }

    note for BaseFieldExtractor "Strategy pattern for\nextracting fields from\nraw API records"

    class AbstractExtractor {
        PubMed abstract text&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class AuthorExtractor {
        Author name normalization&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class DateExtractor {
        Publication date parsing&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class ClassificationExtractor {
        Publication type classification
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class IdentifierExtractor {
        DOI, PMID, etc.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class TaxonomyExtractor {
        UniProt organism/taxonomy&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class GeneExtractor {
        UniProt gene information&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class FeatureExtractor {
        UniProt protein features&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class CrossRefExtractor {
        UniProt cross-references&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class CommentExtractor {
        UniProt protein comments&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +extract(record) dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    }

    class MedlineDateParser {
        Parses various date formats&nbsp;&nbsp;&nbsp;&nbsp;
        +parse(date_str) date | None&nbsp;&nbsp;&nbsp;
    }

    BaseFieldExtractor <|-- AbstractExtractor
    BaseFieldExtractor <|-- AuthorExtractor
    BaseFieldExtractor <|-- DateExtractor
    BaseFieldExtractor <|-- ClassificationExtractor
    BaseFieldExtractor <|-- IdentifierExtractor
    BaseFieldExtractor <|-- TaxonomyExtractor
    BaseFieldExtractor <|-- GeneExtractor
    BaseFieldExtractor <|-- FeatureExtractor
    BaseFieldExtractor <|-- CrossRefExtractor
    BaseFieldExtractor <|-- CommentExtractor

    DateExtractor --> MedlineDateParser : uses

    namespace PubMedExtractors {
        class AbstractExtractor
        class AuthorExtractor
        class DateExtractor
        class ClassificationExtractor
        class IdentifierExtractor
    }

    namespace UniProtExtractors {
        class TaxonomyExtractor
        class GeneExtractor
        class FeatureExtractor
        class CrossRefExtractor
        class CommentExtractor
    }

    style BaseFieldExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style AbstractExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style AuthorExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style DateExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style ClassificationExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style IdentifierExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style TaxonomyExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style GeneExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style FeatureExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style CrossRefExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style CommentExtractor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style MedlineDateParser fill:#eff6ff,stroke:#2563eb,stroke-width:2px
