%% BioETL — Class Diagram: Application Core Services
%% PipelineRunner, BatchExecutor, and their composition.

%% @version 1.1.0
%% @date    2026-02-26
%% @type    classDiagram
%% @level   Class / Interface
%% @nodes   16
%% @uniform-group core    nodes=PipelineRunner,PipelineServices,BatchExecutor
%% @uniform-group batch   nodes=BatchTransformer,BatchWriter
%% @uniform-group infra   nodes=BatchMemoryManager,BatchMetricsRecorder,BatchTracingManager
%% @uniform-group manager nodes=CheckpointManager,LockManager
%% @uniform-group support nodes=PreflightService,PostrunService,QuarantineManager,ShutdownSignal,HeartbeatTask,ErrorClassifier

%% @uniform-width group
%% @uniform class width=592 groups=5 width_strategy=group
%% @uniform-stats core         width=376 height=312 max_desc_lines=15
%% @uniform-stats batch        width=592 height=256 max_desc_lines=12
%% @uniform-stats infra        width=376 height=168 max_desc_lines=7
%% @uniform-stats manager      width=256 height=200 max_desc_lines=9
%% @uniform-stats support      width=552 height=112 max_desc_lines=4
classDiagram
    direction LR
    namespace Runner_Core {
        class PipelineRunner {
            -_config
            -_runtime
            -_services
            -_executor
            -_checkpoint_manager
            -_shutdown_signal
            -_lock_manager
            -_preflight_service
            -_postrun_service
            +run()
            +... : lifecycle orchestration
        }

        class PipelineServices {
            <<frozen dataclass>>
            +data_source
            +storage
            +lock
            +checkpoint
            +quarantine
            +metrics
            +tracing
            +logger
            +dq_monitor
            +... : optional reporting services
        }

        class BatchExecutor {
            -_services
            -_context
            -_config
            -_checkpoint_manager
            +batch_size
            +checkpoint_interval
            +records_fetched
            +records_bronze
            +records_quarantined
            +execute(limit, query, offset)
            +process(records, start_index)
            +get_dq_context()
            +... : run statistics API
        }
    }

    namespace Batch_Processing {
        class BatchTransformer {
            -_context
            -_config
            -_error_classifier
            -_quarantine_manager
            -_batch_metrics
            +transform_batch(records, batch_id, start_index)
            +transform_single(raw_record, batch_id, index)
            +... : internal transform callbacks
        }

        class BatchWriter {
            -_storage
            -_context
            -_gold_validator
            -_error_classifier
            -_silver_mode
            -_gold_mode
            -_column_orderer
            +write_bronze(records, batch_id, ingestion_ts, metadata)
            +write_silver(records, batch_id, ingestion_ts, bronze_refs)
            +write_gold(records, silver_refs)
            +... : validation and lock checks
        }

        class BatchMemoryManager {
            -_memory_monitor
            -_memory_config
            -_initial_batch_size
            +enabled
            +batch_size_reductions
            +check_pressure(current_size, interval, fetched)
            +maybe_recover(current_size)
        }

        class BatchMetricsRecorder {
            -_metrics
            -_pipeline_label
            -_run_type_label
            +track_batch_size(stage, size)
            +track_processed_records(stage, count)
            +track_error(stage, error_type)
            +track_quarantined_records(error_type, count)
        }

        class BatchTracingManager {
            -_tracer
            -_context
            +TRACER_NAME
            +start_execution_span()
            +start_batch_span(batch_id, count, start)
            +start_layer_span(name, batch_id, count)
            +end_span(span, error)
        }
    }

    namespace Execution_Managers {
        class CheckpointManager {
            -_checkpoint
            -_logger
            -_pipeline_name
            -_run_id
            -_resume
            +load_checkpoint()
            +save_checkpoint(offset)
            +delete_checkpoint()
        }

        class LockManager {
            -_lock
            -_run_id
            -_config
            -_shutdown_signal
            -_heartbeat
            -_fencing_token
            +acquire(timeout)
            +release()
            +validate()
        }
    }

    namespace Support_Services {
        class PreflightService {
            +execute(config, runtime, services, context, observer)
        }

        class PostrunService {
            +execute(config, runtime, context, executor, metadata, observer)
        }

        class QuarantineManager {
            -_quarantine
            +quarantine_record(raw, error_type, batch_id, msg, ts)
        }

        class ShutdownSignal {
            +is_requested
            +reason
            +request(reason)
            +reset()
        }

        class HeartbeatTask {
            Background async task
            +start()
            +stop()
        }

        class ErrorClassifier {
            +classify(error)
        }
    }

    PipelineRunner *-- BatchExecutor
    PipelineRunner *-- LockManager
    PipelineRunner *-- CheckpointManager
    PipelineRunner *-- PreflightService
    PipelineRunner *-- PostrunService
    PipelineRunner *-- ShutdownSignal
    PipelineRunner o-- PipelineServices

    BatchExecutor *-- BatchTransformer
    BatchExecutor *-- BatchWriter
    BatchExecutor *-- BatchMemoryManager
    BatchExecutor *-- BatchMetricsRecorder
    BatchExecutor *-- BatchTracingManager
    BatchExecutor *-- QuarantineManager
    BatchExecutor *-- CheckpointManager

    BatchTransformer --> ErrorClassifier
    BatchWriter --> ErrorClassifier

    LockManager *-- HeartbeatTask

    style PipelineRunner fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style PipelineServices fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style BatchExecutor fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style BatchTransformer fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style BatchWriter fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style BatchMemoryManager fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style BatchMetricsRecorder fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style BatchTracingManager fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style CheckpointManager fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style LockManager fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style PreflightService fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style PostrunService fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style QuarantineManager fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style ShutdownSignal fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style HeartbeatTask fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style ErrorClassifier fill:#eff6ff,stroke:#2563eb,stroke-width:2px
