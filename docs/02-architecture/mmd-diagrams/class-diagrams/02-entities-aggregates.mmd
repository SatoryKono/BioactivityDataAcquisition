%% BioETL — Class Diagram: Entities & Aggregates
%% Domain entities, aggregate roots, and their relationships.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    classDiagram
%% @level   Class / Interface
%% @uniform class width=168 height=240 max_title_len=16 max_desc_lines=14

classDiagram
    class BaseEntity {
        <<frozen dataclass>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +entity_id: EntityID
        +content_hash: ContentHash
        +run_id: RunID&nbsp;&nbsp;
        +run_type: RunType
        +ingestion_ts: datetime
        +_index: int&nbsp;&nbsp;&nbsp;&nbsp;
        +source_batch_id: BatchID | None
        +_dq_warn: bool&nbsp;
        +_dq_error: bool
        +__post_init__()
        &nbsp;
        &nbsp;
        &nbsp;
    }

    class Bioactivity {
        <<frozen dataclass>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +activity_id: str
        +molecule_id: str
        +target_id: str | None
        +assay_id: str | None
        +canonical_smiles: str | None
        +standard_type: str | None
        +standard_value: float | None
        +standard_units: str | None
        +pchembl_value: float | None
        +publication_doi: str | None
        +_state: BioactivityState
        +from_raw() Bioactivity
        +with_state(state) Bioactivity
    }

    class BioactivityState {
        <<StrEnum>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        RAW&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        NORMALIZED&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        VALIDATED&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
    }

    class PublicationBase {
        <<frozen dataclass>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +doi: str | None
        +pmid: str | None
        +title: str | None
        +authors: list~str~
        +journal: str | None
        +year: int | None
        +publication_type: PublicationType
        +abstract_text: str | None
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
    }

    class Batch {
        <<Aggregate Root>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        -_batch_id: BatchID
        -_status: BatchStatus
        -_records: list~BatchRecord~
        -_invalid_records: list~BatchRecord~
        +create(batch_id) Batch
        +add_record(record) None
        +seal() None&nbsp;&nbsp;&nbsp;&nbsp;
        +collect_events() list~DomainEvent~
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
    }

    class BatchRecord {
        <<frozen dataclass>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +index: int&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +entity_id: EntityID | None
        +content_hash: ContentHash | None
        +data: dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +is_valid: bool&nbsp;
        +error: str | None
        +error_code: str | None
        +with_validation_error(msg, code) BatchRecord
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
    }

    class BatchStatus {
        <<StrEnum>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        OPEN&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        SEALED&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        WRITING&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        COMMITTED&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        FAILED&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
    }

    class PipelineRun {
        <<Aggregate Root>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        -_run_id: RunID&nbsp;
        -_state: PipelineRunState
        -_stages: dict~str, StageResult~
        +start_stage(name) None
        +complete_stage(name, result) None
        +fail_stage(name, error) None
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
        &nbsp;
    }

    class StageResult {
        <<frozen dataclass>>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        +stage: str&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
