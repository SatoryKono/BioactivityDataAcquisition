%% BioETL — Class Diagram: Domain Services
%% Pure domain services without I/O.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    classDiagram
%% @level   Class / Interface
%% @uniform class width=248 height=72 max_title_len=26 max_desc_lines=2

classDiagram
    class IdentityService {
        +compute_entity_id(provider, entity_type, source_id, record) EntityID
        +compute_content_hash(provider, record) ContentHash
    }

    class NormalizationService {
        +normalize_text(text) str&nbsp;
        +normalize_values(values) dict
    }

    class DataNormalizationService {
        +normalize_field(value, field_type) Any
        &nbsp;
    }

    class AuthorNormalizationService {
        +normalize_author_name(name) str
        +normalize_author_list(authors) list~str~
    }

    class ActivityAggregator {
        +aggregate(activities) AggregatedActivity
        &nbsp;
    }

    class UnitConverter {
        +convert(value, from_unit, to_unit) float
        +normalize_unit(unit) str&nbsp;
    }

    class ValueValidator {
        +validate(value, constraints) ValidationResult
        &nbsp;
    }

    class TextSimilarity {
        +similarity_score(text1, text2) float
        +is_similar(text1, text2, threshold) bool
    }

    class DQMetricsCalculator {
        +calculate(records, config) DQMetrics
        &nbsp;
    }

    class DQSerializer {
        +serialize(metrics) dict&nbsp;&nbsp;
        +deserialize(data) DQMetrics
    }

    note for IdentityService "Deterministic hashing:\nEntityID = SHA256(provider:entity_type:source_id)\nContentHash = SHA256(sorted business fields)"
    note for UnitConverter "Handles bioactivity unit\nconversions (nM, uM, etc.)"
    note for TextSimilarity "Used for title matching\nin publication enrichment"
