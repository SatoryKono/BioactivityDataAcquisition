%% BioETL — Class Diagram: Observability Components
%% Logging, metrics, tracing implementations.

%% @version 1.0.0
%% @date    2026-02-24
%% @type    classDiagram
%% @level   Class / Interface
%% @uniform class width=200 height=198 max_title_len=20 max_desc_lines=9

classDiagram
    direction TB
    class LoggerPort {
        <<Protocol>>
        +bind(**kwargs) LoggerPort
        +info(msg, **fields) None
        +warning(msg, **fields) None
        +error(msg, **fields) None
        +debug(msg, **fields) None
        +exception(msg, **fields) None
        
        
    }

    class UnifiedLogger {
        -_logger: BoundLogger
        -_pipeline: str
        -_run_id: str
        +bind(**kwargs) LoggerPort
        +info(msg, **fields) None
        +warning(msg, **fields) None
        +error(msg, **fields) None
        +debug(msg, **fields) None
        +exception(msg, **fields) None
    }

    class StructlogLogger {
        Wraps structlog directly
        
        
        
        
        
        
        
        
    }

    class NoOpLogger {
        <<Null Object>>
        All methods are no-ops
        
        
        
        
        
        
        
    }

    class MetricsPort {
        <<Protocol>>
        +observe_histogram(name, value, labels) None
        +increment_counter(name, labels) None
        +set_gauge(name, value, labels) None
        +close() None
        
        
        
        
    }

    class MetricsCollector {
        +observe_histogram(name, value, labels) None
        +increment_counter(name, labels) None
        +set_gauge(name, value, labels) None
        +close() None
        
        
        
        
        
    }

    class PrometheusMetrics {
        Integrates with prometheus_client
        +observe_histogram() None
        +increment_counter() None
        +set_gauge() None
        
        
        
        
        
    }

    class NoOpMetrics {
        <<Null Object>>
        
        
        
        
        
        
        
        
    }

    class MetricsServerAdapter {
        +start() None
        +stop() None
        HTTP /metrics endpoint
        
        
        
        
        
        
    }

    class TracingPort {
        <<Protocol>>
        +get_tracer(name) Tracer
        +close() None
        
        
        
        
        
        
    }

    class OpenTelemetryTracer {
        Integrates with OpenTelemetry SDK
        +get_tracer(name) Tracer
        +close() None
        
        
        
        
        
        
    }

    class NoOpTracing {
        <<Null Object>>
        +get_tracer(name) NoOpTracer
        
        
        
        
        
        
        
    }

    class AnomalyDetector {
        +detect(metrics) list~Anomaly~
        
        
        
        
        
        
        
        
    }

    class DetectorStrategy {
        <<ABC>>
        +detect(values, baseline) Anomaly | None
        
        
        
        
        
        
        
    }

    class ZScoreDetector {
        +z_threshold: float
        +detect(values, baseline) Anomaly | None
        
        
        
        
        
        
        
    }

    class Anomaly {
        <<dataclass>>
        +type: AnomalyType
        +severity: AnomalySeverity
        +metric_name: str
        +current_value: float
        +baseline_value: float
        
        
        
    }

    class AnomalyType {
        <<Enum>>
        SPIKE
        DROP
        DRIFT
        
        
        
        
        
    }

    class AnomalySeverity {
        <<Enum>>
        LOW
        MEDIUM
        HIGH
        CRITICAL
        
        
        
        
    }

    class AdapterMetrics {
        +metrics: MetricsPort
        +provider: str
        +measure_request() ContextManager
        
        
        
        
        
        
    }

    LoggerPort <|.. UnifiedLogger
    LoggerPort <|.. StructlogLogger
    LoggerPort <|.. NoOpLogger

    MetricsPort <|.. MetricsCollector
    MetricsPort <|.. PrometheusMetrics
    MetricsPort <|.. NoOpMetrics

    TracingPort <|.. OpenTelemetryTracer
    TracingPort <|.. NoOpTracing

    PrometheusMetrics --> MetricsServerAdapter

    DetectorStrategy <|-- ZScoreDetector
    AnomalyDetector --> DetectorStrategy
    AnomalyDetector --> Anomaly
    Anomaly --> AnomalyType
    Anomaly --> AnomalySeverity
