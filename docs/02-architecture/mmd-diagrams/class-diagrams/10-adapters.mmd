    style OpenAlexAdapter fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style SemanticScholarAdapter fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style PubChemAdapter fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style CircuitBreaker fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style TokenBucket fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style AdapterMetrics fill:#eff6ff,stroke:#2563eb,stroke-width:2px
