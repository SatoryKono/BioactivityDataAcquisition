    style HealthCheckProviderMixin fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style BaseHttpAdapter fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style BaseSyncAdapter fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style UnifiedHTTPClient fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style ChemblAdapter fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style PubMedAdapter fill:#fff1f2,stroke:#dc2626,stroke-width:2px
