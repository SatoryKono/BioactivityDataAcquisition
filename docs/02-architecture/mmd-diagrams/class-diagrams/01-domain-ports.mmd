classDiagram
    direction TB
    class DataSourcePort {
        <<Protocol>>
        +fetch(entity_type, limit, query, filter_ids, filter_field) AsyncIterator~dict~
        +health_check() HealthCheckResult
        +aclose() None
        +__aenter__() Self
        +__aexit__(...) None
        
        
        
        
    }

    class FilterableDataSourcePort {
        <<Protocol>>
        +fetch_filtered(entity_type, filter_ids, filter_field, limit) AsyncIterator~dict~
        +fetch_multi_filtered(entity_type, filters, limit) AsyncIterator~dict~
        +fetch_filtered_with_fallback(entity_type, filter_ids, filter_field, limit) AsyncIterator~dict~
        
        
        
        
        
        
    }

    class StoragePort {
        <<Protocol>>
        +write_bronze(records, config, metadata) BronzeWriteResult
        +write_silver(records, config) SilverWriteResult
        +write_gold(records, config) None
        +read_silver(table_name, columns, limit) DataFrame
        +clear_silver(table_name) None
        +clear_gold(table_name) None
        +vacuum(table_name, retention_hours) None
        +archive(table_name, target_path) None
        +health_check() HealthCheckResult
    }

    class LockPort {
        <<Protocol>>
        +acquire(key, owner_id, ttl) FencingToken
        +release(key, owner_id) None
        +heartbeat(key, owner_id) None
        +validate_owner(key, owner_id) bool
        +validate_fencing_token(token) bool
        
        
        
        
    }

    class CheckpointPort {
        <<Protocol>>
        +save(key, data) None
        +load(key) dict | None
        +list_all() list
        +delete(key) None
        
        
        
        
        
    }

    class QuarantinePort {
        <<Protocol>>
        +write(records, pipeline, error_code) None
        +inspect(pipeline, limit) list
        +get_stats(pipeline) dict
        +replay(pipeline, filter_fn) int
        +purge(pipeline, before) int
        +update_status(payload_hash, status) None
        
        
        
    }

    class AuditPort {
        <<Protocol>>
        +log_write(entry: AuditEntry) None
        +get_entries(filters) list~AuditEntry~
        
        
        
        
        
        
        
    }

    class LoggerPort {
        <<Protocol>>
        +bind(**kwargs) LoggerPort
        +info(msg, **fields) None
        +warning(msg, **fields) None
        +error(msg, **fields) None
        +debug(msg, **fields) None
        +exception(msg, **fields) None
        
        
        
    }

    class MetricsPort {
        <<Protocol>>
        +observe_histogram(name, value, labels) None
        +increment_counter(name, labels) None
        +set_gauge(name, value, labels) None
        +close() None
        
        
        
        
        
    }

    class TracingPort {
        <<Protocol>>
        +get_tracer(name) Tracer
        +close() None
        
        
        
        
        
        
        
    }

    class CircuitBreakerPort {
        <<Protocol>>
        +get_state() CircuitBreakerState
        +get_failure_count() int
        +call(fn) T
        +reset() None
        
        
        
        
        
    }

    class RateLimiterPort {
        <<Protocol>>
        +acquire(tokens) None
        +try_acquire() bool
        +available_tokens() int
        
        
        
        
        
        
    }

    class PiiHasherPort {
        <<Protocol>>
        +hash(value: str) str
        
        
        
        
        
        
        
        
    }

    class MetadataWriterPort {
        <<Protocol>>
        +write(path, metadata) None
        
        
        
        
        
        
        
        
    }

    class DeltaReaderPort {
        <<Protocol>>
        +read_table(path, columns, limit) DataFrame
        +get_schema(path) Schema
        +get_row_count(path) int
        
        
        
        
        
        
    }

    class InputFilterPort {
        <<Protocol>>
        +load_filter_ids(path, column) FilterLoadResult
        +load_multi_column_filter(path, columns) FilterLoadResult
        +load_filter_with_fallback(path, column, fallback) FilterLoadResult
        
        
        
        
        
        
    }

    class DQMonitorPort {
        <<Protocol>>
        +add_metric(name, value) None
        +check_quality() DQResult
        +update_baseline_from_metrics() None
        +get_baseline_stats() dict
        
        
        
        
        
    }

    class JsonEncoderPort {
        <<Protocol>>
        +encode(obj) str
        +decode(s) Any
        
        
        
        
        
        
        
    }

    class MemoryMonitorPort {
        <<Protocol>>
        +get_stats() MemoryStats
        
        
        
        
        
        
        
        
    }

