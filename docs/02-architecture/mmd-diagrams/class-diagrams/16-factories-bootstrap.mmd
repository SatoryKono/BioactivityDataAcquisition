    style StorageBootstrap fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style HealthBootstrap fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style CheckpointBootstrap fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style LockBootstrap fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style ProviderRegistry fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style RunnerBuilder fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style GenericFactory fill:#eff6ff,stroke:#2563eb,stroke-width:2px
