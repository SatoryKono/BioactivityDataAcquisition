%% View: Full | Parent: (root)
%% Parent source: docs/02-architecture/mmd-diagrams/foundation/29-composite-pipeline-workflow.mmd
%% Full reference diagram retained after decomposition.
%% Title: Composite Pipeline Full Workflow — Seed to Gold (ADR-026)
%% Covers: RULES.md §2.10 (Composite Pipelines), ADR-026
%% Rank: 4 (Score 8.88) — Most complex architectural feature
%% Updated: 2026-02-17

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform width=288 height=90 max_title_len=31 max_desc_lines=3
flowchart TB
    subgraph Init["Phase 1: Initialization"]
        CFG["Load CompositeConfig<br/>from YAML<br/><br/>"]
        PFV["CompositePreflightValidator<br/>• validate seed<br/>• validate enrichers<br/>• check silver tables"]
        BOOT["bootstrap_composite_runner()<br/>→ CompositePipelineRunner<br/><br/>"]
    end

    subgraph Seed["Phase 2: Seed Pipeline"]
        SP["Run Seed Pipeline<br/>(e.g., chembl_publication)<br/><br/>"]
        SB[("Seed Silver Table<br/>silver/chembl/publication/"<br/><br/>)]
    end

    subgraph Deps["Phase 3: Dependencies"]
        DC["DependencyCoordinator<br/>• run_dependencies()<br/><br/>"]
        DEP1["Dependency 1<br/>(e.g., uniprot_protein)<br/><br/>"]
        DEP2["Dependency 2<br/>(optional)<br/><br/>"]
        DS1[("Dep 1 Silver Table"<br/><br/><br/>)]
        DS2[("Dep 2 Silver Table"<br/><br/><br/>)]
    end

    subgraph Keys["Phase 3.5: Key Extraction"]
        KE["KeyExtractorService<br/>• extract_keys(seed_silver,<br/>join_keys=[doi, pmid])<br/>"]
        KEYS["Filter Keys<br/>(DOIs, PMIDs)<br/><br/>"]
    end

    subgraph Enrich["Phase 4: Fan-Out Enrichment"]
        EC["EnrichmentCoordinator<br/>• asyncio.gather(*enrichers,<br/>return_exceptions=True)<br/>"]
        E1["CrossRef Enricher<br/>filter_ids=DOIs<br/><br/>"]
        E2["PubMed Enricher<br/>filter_ids=PMIDs<br/><br/>"]
        E3["OpenAlex Enricher<br/>filter_ids=DOIs<br/><br/>"]
        E4["SemanticScholar Enricher<br/>filter_ids=DOIs<br/><br/>"]
        ES1[("crossref/publication/"<br/><br/><br/>)]
        ES2[("pubmed/publication/"<br/><br/><br/>)]
        ES3[("openalex/publication/"<br/><br/><br/>)]
        ES4[("semanticscholar/publication/"<br/><br/><br/>)]
    end

    subgraph Merge["Phase 5: Merge"]
        DD["EnricherDeduplicator<br/>• deduplicate across sources<br/><br/>"]
        MS["MergeService<br/>• LEFT OUTER JOIN<br/>• conflict_resolution<br/>• column_ordering"]
        CO["ColumnOrderer<br/>• FieldGroup priority<br/>• exclude TRASH group<br/>"]
        CR["ColumnRenamer<br/>• qualified names<br/>• e.g., crossref.publication.title<br/>"]
    end

    subgraph Gold["Phase 6: Gold Write"]
        XV["EnrichmentCrossValidator<br/>• check join coverage<br/>• detect orphans<br/>"]
        GW["GoldWriter.write_gold()<br/>CompositePublicationGoldSchema<br/>(Pandera strict validation)<br/>"]
        GT[("Gold Table<br/>gold/composite/publication/"<br/><br/>)]
    end

    subgraph CKP["Checkpointing (each phase)"]
        CCM["CompositeCheckpointManager<br/>• save after each phase<br/>• resume from any phase<br/>"]
    end

    %% Flow
    CFG --> PFV --> BOOT
    BOOT --> SP --> SB

    SB --> DC
    DC --> DEP1 --> DS1
    DC --> DEP2 --> DS2

    SB --> KE
    KE --> KEYS

    KEYS --> EC
    EC --> E1 & E2 & E3 & E4
    E1 --> ES1
    E2 --> ES2
    E3 --> ES3
    E4 --> ES4

    ES1 & ES2 & ES3 & ES4 --> DD
    DD --> MS
    SB -->|"seed data"| MS
    MS --> CO --> CR

    CR --> XV --> GW --> GT

    CCM -.->|"checkpoint"| Seed & Deps & Enrich & Merge & Gold

    %% Styling
    style Seed fill:#fff7ed,stroke:#f59e0b
    style Enrich fill:#f8fafc,stroke:#475569
    style Gold fill:#fefce8,stroke:#ca8a04
    style Merge fill:#eff6ff,stroke:#2563eb

    linkStyle 0 stroke:#1E293B,stroke-width:4px
    linkStyle 1 stroke:#1E293B,stroke-width:4px
    linkStyle 2 stroke:#1E293B,stroke-width:4px
    linkStyle 3 stroke:#1E293B,stroke-width:4px
    linkStyle 4 stroke:#1E293B,stroke-width:4px
    linkStyle 5 stroke:#1E293B,stroke-width:4px
    linkStyle 6 stroke:#1E293B,stroke-width:4px
    linkStyle 7 stroke:#1E293B,stroke-width:4px
    linkStyle 8 stroke:#1E293B,stroke-width:4px
    linkStyle 9 stroke:#1E293B,stroke-width:4px
    linkStyle 10 stroke:#1E293B,stroke-width:4px
    linkStyle 11 stroke:#1E293B,stroke-width:4px
    linkStyle 12 stroke:#1E293B,stroke-width:4px
    linkStyle 13 stroke:#1E293B,stroke-width:4px
    linkStyle 14 stroke:#1E293B,stroke-width:4px
    linkStyle 15 stroke:#1E293B,stroke-width:4px
    linkStyle 16 stroke:#1E293B,stroke-width:4px
    linkStyle 17 stroke:#1E293B,stroke-width:4px
    linkStyle 18 stroke:#475569,stroke-width:2px,stroke-dasharray:5
