%% View: Overview | Parent: 36-architecture-principles-mindmap-full.mermaid
%% @uniform width=224 height=56 max_title_len=23 max_desc_lines=1
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N9["DDD Aggregates<br/>"]
        N10["24 Domain Ports<br/>"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["BioETL<br/>Architecture"]
        N2["Five-Layer Architecture<br/>"]
        N4["Local Only Deployment<br/>"]
        N5["Resilience Patterns<br/>"]
        N6["Data Quality<br/>"]
        N7["Hexagonal Architecture<br/>"]
        N8["Medallion Architecture<br/>"]
        N11["Domain<br/>"]
        N13["Application<br/>"]
        N14["Infrastructure<br/>"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N15["Infrastructure Adapters<br/>"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N3["Composition Root<br/>"]
        N12["Composition<br/>"]
    end

    N1 --> N7
    N7 --> N10
    N7 --> N15
    N1 --> N2
    N2 --> N12
    N2 --> N13
    N2 --> N11
    N2 --> N14
    N1 --> N8
    N1 --> N9
    N1 --> N3
    N1 --> N4
    N1 --> N5
    N1 --> N6

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style Composition fill:#fff7ed,stroke:#f59e0b,stroke-width:2px

    %% linkStyle: data 2 | orchestration 0,3,5-8,11-13 | di 1,9 | generic 4,10

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle 0 stroke:#16a34a,stroke-width:2px
    linkStyle 1 stroke:#7c3aed,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 2 stroke:#1E293B,stroke-width:2px
    linkStyle 3 stroke:#16a34a,stroke-width:2px
    linkStyle 4 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 5 stroke:#16a34a,stroke-width:2px
    linkStyle 6 stroke:#16a34a,stroke-width:2px
    linkStyle 7 stroke:#16a34a,stroke-width:2px
