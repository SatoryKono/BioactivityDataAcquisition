flowchart LR
    CFG["[S] CompositeConfig"] --> PFV["[S] Preflight"]
    PFV --> SEED["[S] Seed Pipeline"]
    SEED ==> SS["[D] Seed Silver"]

    SS --> DEP["[S] Dependencies"]
    DEP --> KEYS["[S] Key Extraction"]
    KEYS ==> ENR["[S] Enrichment Fan-Out"]
    ENR ==> MERGE["[S] DataMerge"]

    MERGE ==> CONTRACT["[S] Contract Resolver"]
    CONTRACT --> GW["[S] GoldWriter"]
    GW ==> GOLD["[D] Gold Table"]

    CKP["[S] CheckpointManager"] -.->|save/resume| SEED
    CKP -.->|save/resume| DEP
    CKP -.->|save/resume| ENR
    CKP -.->|save/resume| MERGE
    CKP -.->|save/resume| GW

    classDef layer_application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px;
    classDef layer_infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px;

    class CFG,PFV,SEED,DEP,KEYS,ENR,MERGE,CONTRACT,GW,CKP layer_application;
    class SS,GOLD layer_infrastructure;
