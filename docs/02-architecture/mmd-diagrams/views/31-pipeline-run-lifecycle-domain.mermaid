flowchart TB
%% keep-orphan: N3

    subgraph Domain["Domain Layer"]
        direction TB
        N4["EXTRACTING"]
        N5["FAILED"]
        N6["WRITING"]
        N10["VALIDATING"]
        N12["DRAINING"]
        N13["RELEASING"]
        N14["*"]
        N15["PENDING"]
        N17["CLEARING"]
        N18["QUARANTINING"]
        N20["COMPLETED"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["TRANSFORMING"]
        N2["BATCH_DONE"]
        N3["BatchLoop"]
        N9["PREFLIGHT_PASSED"]
        N8["PREFLIGHT"]
        N19["POSTRUN"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N7["LOCKING"]
        N11["CHECKPOINTING"]
        N16["LOCKED"]
    end

    N14 --> N15
    N15 --> N7
    N7 --> N16
    N7 --> N5
    N16 --> N8
    N8 --> N9
    N8 --> N5
    N9 --> N17
    N9 --> N4
