    style ClientFactories fill:#ffffff,stroke:#2563eb,stroke-dasharray: 5 5
    style StorageFactories fill:#ffffff,stroke:#7c3aed,stroke-dasharray: 5 5
    style PipelineFactories fill:#ffffff,stroke:#16a34a,stroke-dasharray: 5 5

    %% Layer palette (semantic)
    classDef layer_domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.8px;
    classDef layer_application fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    classDef layer_infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:1.8px;
    classDef layer_composition fill:#fff7ed,stroke:#f59e0b,stroke-width:1.8px;
    classDef layer_interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;

    class CLI layer_interfaces;
    class BOOT,BL,DQF,HCF,DSF,STF,STA,SB,RF,GPF,PR,OB layer_composition;
    class PS,RUN layer_application;
    class UHC,ADP,BW,SLL layer_infrastructure;

    %% Click tooltips
    click SB "../../02-architecture/decisions/ADR-005-composition-layer-separation.md" "Injects storage, lock, checkpoint, quarantine, logger, metrics, tracing"
