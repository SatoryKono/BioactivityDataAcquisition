%% View: Infrastructure-Mapping | Parent: 01-full-system-component-full.mermaid
%% @uniform width=176 height=56 max_title_len=17 max_desc_lines=0
flowchart TB
%% keep-orphan: N10, N11, N12, N13, N14, N15, N16, N17, N18, N19, N20, N3, N4, N5, N6, N7, N8, N9

    subgraph Domain["Domain Layer"]
        direction TB
        N4["StoragePort"]
        N5["LockPort"]
        N17["CheckpointPort"]
        N18["QuarantinePort"]
        N19["MetricsPort"]
        N20["TracingPort"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N2["ChemblAdapter"]
        N3["LockManager"]
        N6["PubchemAdapter"]
        N7["UniprotAdapter"]
        N8["PubmedAdapter"]
        N9["CrossRefAdapter"]
        N10["OpenAlexAdapter"]
        N11["S2Adapter"]
        N12["BronzeWriter"]
        N13["SilverWriter"]
        N14["GoldWriter"]
        N16["CheckpointManager"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N15["Registry"]
    end

    subgraph Interfaces["Interfaces Layer"]
        direction TB
        N1["UnifiedHTTPClient"]
    end

    N2 --> N1

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style Composition fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
    style Interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:2px

    %% linkStyle: data 0
    linkStyle 0 stroke:#1E293B,stroke-width:3px
