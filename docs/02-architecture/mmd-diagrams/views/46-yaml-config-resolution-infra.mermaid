flowchart TB
%% keep-orphan: N10, N11, N12, N13, N14, N15, N16, N17, N18, N19, N2, N20, N3

    subgraph Domain["Domain Layer"]
        direction TB
        N1["dq_config_file"]
        N2["DQ_CONFIG_FILE"]
        N3["FILTER_CONFIG_FILE"]
        N7["override"]
        N8["PIPELINE_CONFIG"]
        N9["TABLE_CONFIG"]
        N15["DQ_ENTITY"]
        N19["FILTER_ENTITY"]
