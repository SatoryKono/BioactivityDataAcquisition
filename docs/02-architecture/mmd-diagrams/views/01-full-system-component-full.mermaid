%% Full reference diagram retained after decomposition.
%% Title: Full System Component Diagram
%% Covers: RULES.md §1.1 (Five-Layer Architecture), §1.2 (Ports & Adapters)
%% Updated: 2026-02-17
%% Components: CLI, Bootstrap, PipelineRunner, DataSourcePort, StoragePort, BronzeWriter, SilverWriter, GoldWriter

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform width=216 height=56 max_title_len=22 max_desc_lines=1
flowchart TB
%% keep-orphan: Activity, Assay, AssayTransformer, CheckpointManager, CheckpointPort, Checkpoints, DQConfig, LifecycleOrchestrator, LoggerPort, MetricsPort, Molecule, PipelineConfig, Publication, Quarantine, QuarantinePort, RuntimeConfig, Target, TargetTransformer, TracingPort
    subgraph External["External Systems"]
        ChEMBL_API["ChEMBL API<br/>"]
        PubChem_API["PubChem API<br/>"]
        UniProt_API["UniProt API<br/>"]
        PubMed_API["PubMed API<br/>"]
        CrossRef_API["CrossRef API<br/>"]
        OpenAlex_API["OpenAlex API<br/>"]
        S2_API["Semantic Scholar API<br/>"]
    end

    subgraph Interfaces["Interfaces Layer"]
        CLI["CLI<br/>(Click)"]
        Orchestration["Orchestration<br/>(Signal Handling)"]
    end

    subgraph Application["Application Layer"]
        subgraph Core["Core"]
            PipelineRunner["PipelineRunner<br/>"]
            PipelineExecutor["PipelineExecutor<br/>"]
            RecordProcessor["RecordProcessor<br/>"]
            BatchTransformer["BatchTransformer<br/>"]
        end
        subgraph Services["Services"]
            LockManager["LockManager<br/>"]
            CheckpointManager["CheckpointManager<br/>"]
            PreflightService["PreflightService<br/>"]
            PostrunService["PostrunService<br/>"]
            LifecycleOrchestrator["LifecycleOrchestrator<br/>"]
        end
        subgraph Transformers["Entity Transformers"]
            ActivityTransformer["ActivityTransformer<br/>"]
            MoleculeTransformer["MoleculeTransformer<br/>"]
            AssayTransformer["AssayTransformer<br/>"]
            TargetTransformer["TargetTransformer<br/>"]
        end
    end

    subgraph Domain["Domain Layer"]
        subgraph Ports["Ports (Protocols)"]
            DataSourcePort["DataSourcePort<br/>"]
            StoragePort["StoragePort<br/>"]
            LockPort["LockPort<br/>"]
            CheckpointPort["CheckpointPort<br/>"]
            QuarantinePort["QuarantinePort<br/>"]
            MetricsPort["MetricsPort<br/>"]
            TracingPort["TracingPort<br/>"]
            LoggerPort["LoggerPort<br/>"]
        end
        subgraph Entities["Entities"]
            Activity["Activity<br/>"]
            Molecule["Molecule<br/>"]
            Assay["Assay<br/>"]
            Target["Target<br/>"]
            Publication["Publication<br/>(5 providers)"]
        end
        subgraph Config["Configuration"]
            PipelineConfig["PipelineConfig<br/>"]
            RuntimeConfig["RuntimeConfig<br/>"]
            DQConfig["DQConfig<br/>"]
        end
    end

    subgraph Infrastructure["Infrastructure Layer"]
        subgraph Adapters["Data Source Adapters"]
            ChemblAdapter["ChemblAdapter<br/>"]
            PubchemAdapter["PubchemAdapter<br/>"]
            UniprotAdapter["UniprotAdapter<br/>"]
            PubmedAdapter["PubmedAdapter<br/>"]
            CrossRefAdapter["CrossRefAdapter<br/>"]
            OpenAlexAdapter["OpenAlexAdapter<br/>"]
            S2Adapter["SemanticScholarAdapter<br/>"]
        end
        subgraph HTTP["HTTP Infrastructure"]
            UnifiedHTTPClient["UnifiedHTTPClient<br/>"]
            CircuitBreaker["CircuitBreaker<br/>"]
            TokenBucket["TokenBucket<br/>(RateLimiter)"]
        end
        subgraph Storage["Storage Writers"]
            BronzeWriter["BronzeWriter<br/>"]
            SilverWriter["SilverWriter<br/>(Silver)"]
            GoldWriter["GoldWriter<br/>"]
        end
        subgraph Locking["Locking"]
            MemoryLock["MemoryLock<br/>"]
        end
    end

    subgraph Composition["Composition Layer"]
        Bootstrap["bootstrap_pipeline()<br/>"]
        Factories["Factories<br/>"]
        Registry["PipelineRegistry<br/>"]
    end

    subgraph DataLake["Data Lake (Local FS)"]
        Bronze[("Bronze<br/>JSONL+zstd")]
        Silver[("Silver<br/>Delta Lake")]
        Gold[("Gold<br/>Delta/Parquet")]
        Quarantine[("Quarantine"<br/>)]
        Checkpoints[("Checkpoints"<br/>)]
    end

    %% External connections
    ChEMBL_API --> ChemblAdapter
    PubChem_API --> PubchemAdapter
    UniProt_API --> UniprotAdapter
    PubMed_API --> PubmedAdapter
    CrossRef_API --> CrossRefAdapter
    OpenAlex_API --> OpenAlexAdapter
    S2_API --> S2Adapter

    %% Interface to Application
    CLI --> Bootstrap
    Orchestration --> PipelineRunner

    %% Composition wiring
    Bootstrap --> Factories
    Factories --> Registry
    Bootstrap --> PipelineRunner

    %% Application internal
    PipelineRunner --> PipelineExecutor
    PipelineRunner --> LockManager
    PipelineRunner --> PreflightService
    PipelineRunner --> PostrunService
    PipelineExecutor --> RecordProcessor
    RecordProcessor --> BatchTransformer
    BatchTransformer --> ActivityTransformer
    BatchTransformer --> MoleculeTransformer

    %% Domain dependencies (interfaces)
    PipelineRunner -.-> DataSourcePort
    PipelineRunner -.-> StoragePort
    PipelineRunner -.-> LockPort

    %% Infrastructure implements Ports
    ChemblAdapter -.->|implements| DataSourcePort
    BronzeWriter -.->|implements| StoragePort
    MemoryLock -.->|implements| LockPort

    %% HTTP infrastructure
    ChemblAdapter --> UnifiedHTTPClient
    UnifiedHTTPClient --> CircuitBreaker
    UnifiedHTTPClient --> TokenBucket

    %% Storage writes
    BronzeWriter --> Bronze
    SilverWriter --> Silver
    GoldWriter --> Gold

