%% View: Data-Flow | Parent: 46-yaml-config-resolution-full.mermaid
%% @uniform width=176 height=56 max_title_len=17 max_desc_lines=0
flowchart TB
%% keep-orphan: N3, N4, N5, N6, N7

    subgraph Domain["Domain Layer"]
        direction TB
        N2["PIPELINE_CONFIG"]
        N8["TABLE_CONFIG"]
        N9["dq_config_file"]
        N12["override"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N1["PIPELINE"]
        N6["PIPELINE_YAML_CFG"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N3["SOURCE"]
        N4["SILVER_FILTER"]
        N5["GOLD_FILTER"]
        N7["SOURCE_YAML_CFG"]
        N10["br"]
        N11["YAML_LOADER"]
    end

    N11 --> N12
    N2 --> N8
    N1 --> N9
    N1 --> N10

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px

    %% linkStyle: data 0, orch 3, di 1-2
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 2 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 3 stroke:#2e7d32,stroke-width:2px
