%% View: Infrastructure-Mapping | Parent: 44-cross-provider-enrichment-full.mermaid
%% @uniform width=144 height=56 max_title_len=13 max_desc_lines=0
flowchart TB

    subgraph Domain["Domain Layer"]
        direction TB
        N4["pmid"]
        N16["pub_type"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N1["CS"]
        N2["CT"]
        N3["CA"]
        N5["ntitle"]
        N6["authors"]
        N7["CRS"]
        N8["CRT"]
        N9["CRA"]
        N10["nfunders"]
        N11["references"]
        N12["PMS"]
        N13["PMT"]
        N14["PMA"]
        N15["nmesh_terms"]
        N17["OAS"]
        N18["OAT"]
        N19["OAA"]
        N20["ninstitutions"]
    end

    N3 --> N2
    N2 --> N1
    N9 --> N8
    N8 --> N7
    N14 --> N13
    N13 --> N12
    N19 --> N18
    N18 --> N17
    N1 --> N4
    N1 --> N5
    N1 --> N6
    N7 --> N10
    N7 --> N11
    N12 --> N15
    N12 --> N16
    N17 --> N20

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px

    %% linkStyle: data 0-15
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#1E293B,stroke-width:3px
    linkStyle 4 stroke:#1E293B,stroke-width:3px
    linkStyle 5 stroke:#1E293B,stroke-width:3px
