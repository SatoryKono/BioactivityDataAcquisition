%% Title: Medallion Architecture Invariants (ARCH-007)
%% Covers: RULES.md §2.1 (Medallion), ARCH-007 clear policy
%% Rank: 14 (Score 8.19) — Critical data safety rules
%% Updated: 2026-02-17
%% Legend: see 00-legend.mermaid

%% @version 1.0.0
%% @date 2026-02-24
%% @type flowchart
%% @level Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform width=256 height=90 max_title_len=27 max_desc_lines=3
flowchart TB
%% keep-orphan: E3, E4
 subgraph RunTypes["RunType Enum (domain/types.py)"]
 INC["RunType.INCREMENTAL<br/>'Fetch new data since last run'"\]
 BF["RunType.BACKFILL<br/>'Re-fetch a date range'"\]
 RB["RunType.REBUILD<br/>'Full clean rebuild'"\]
 end

 subgraph Policy["MedallionLifecycleService\n(application/services/medallion_lifecycle.py)"]
 CHECK{{"Check RunType<br/><br/><br/>"}}
 end

 subgraph IncPath["INCREMENTAL Path"]
 I1["[X] DO NOT clear Silver"\]
 I2["[X] DO NOT clear Gold"\]
 I3["Silver: merge/upsert<br/>(content_hash dedup)"\]
 I4["Gold: merge/append"\]
 end

 subgraph BFPath["BACKFILL Path"]
 B1["[OK] MUST clear Silver<br/>SilverWriter.clear()"\]
 B2["[OK] MUST clear Gold<br/>GoldWriter.clear()"\]
 B3["Silver: full reload"\]
 B4["Gold: full reload"\]
 end

 subgraph RBPath["REBUILD Path"]
 R1["[OK] MUST clear Silver<br/>SilverWriter.clear()"\]
 R2["[OK] MUST clear Gold<br/>GoldWriter.clear()"\]
 R3["Silver: full rebuild<br/>from Bronze/API"\]
 R4["Gold: full rebuild<br/>from Silver"\]
 end

 subgraph Enforcement["Enforcement"]
 E1["PipelineRunner checks<br/>run_type before execution"\]
 E2["MedallionLifecycleService<br/>enforces clear policy"\]
 E3["ClearResult tracks<br/>what was cleared"\]
 E4["Tests verify:<br/>INCREMENTAL never clears"\]
 end

 subgraph Bronze["Bronze Layer (Always Append)"]
 BZ["BronzeWriter.write_bronze()<br/>• ALWAYS append-only<br/>• Never cleared by run_type<br/>• 90-day retention policy"]
 end

 %% Flow
 INC --> CHECK
 BF --> CHECK
 RB --> CHECK

 CHECK -->|K17| I1
 I1 --> I2 --> I3 --> I4

 CHECK -->|"BACKFILL"| B1
 B1 --> B2 --> B3 --> B4

 CHECK -->|"REBUILD"| R1
 R1 --> R2 --> R3 --> R4

 E1 -.-> CHECK
 E2 -.-> Policy

 BZ -.->|K18| Bronze

 %% Styling
 style IncPath fill:#f0fdf4,stroke:#16a34a
 style BFPath fill:#fff7ed,stroke:#f59e0b
 style RBPath fill:#ffe4e6,stroke:#dc2626
 style Bronze fill:#fff7ed,stroke:#f59e0b,color:#000
 style Policy fill:#eff6ff,stroke:#2563eb

 linkStyle 0,1,2,3,4,5,6,7,8 stroke:#1e293b,stroke-width:2px
 linkStyle 9,10,11 stroke:#475569,stroke-width:2px,stroke-dasharray:5
