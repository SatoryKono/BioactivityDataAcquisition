%% Title: Error Classification Decision Tree — Full Logic
%% Covers: RULES.md §3.1 (Error Handling), domain/exceptions/
%% Rank: 16 (Score 8.06) — Complete error classification reference
%% Updated: 2026-02-17
%% Legend: see 00-legend.mermaid

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform width=152 height=90 max_title_len=14 max_desc_lines=3
flowchart TB
    ERROR["Error Occurred<br/><br/><br/>"]

    ERROR --> HTTP{{"HTTP Status Code?"}}
    ERROR --> DOMAIN{{"Domain Error?"}}
    ERROR --> INFRA{{"Infrastructure Error?"}}

    %% HTTP errors
    HTTP -->|"401, 403"| AUTH["ServiceAuthenticationError\n(CriticalError)\n→ FAIL FAST, no retry\n→ Check API key config"]
    HTTP -->|"404"| NOTFOUND["ApiError\n(RecoverableError)\n→ Log warning\n→ Skip entity"]
    HTTP -->|"429"| RATE["RateLimitExceededError\n(RecoverableError)\n→ Check Retry-After header\n→ Exponential backoff"]
    HTTP -->|K19| SERVER["ServiceUnavailableError\n(RecoverableError)\n→ Retry with backoff\n→ Max 3 attempts"]
    HTTP -->|"Other"| UNKNOWN_HTTP["ExternalServiceError\n→ Log, classify, retry"]

    %% Domain errors
    DOMAIN -->|K20| SCHEMA["SchemaViolationError\n(DataQualityError → ValidationError)\n→ Route to Quarantine"]
    DOMAIN -->|K21| MISSING["MissingRequiredFieldError\n(ValidationError)\n→ Route to Quarantine"]
    DOMAIN -->|K22| FORMAT["InvalidDataFormatError\n(ValidationError)\n→ Route to Quarantine"]
    DOMAIN -->|K23| DQTHRESH["DataQualityThresholdError\n→ error_rate > 20%\n→ FAIL entire batch"]

    %% Infrastructure errors
    INFRA -->|"Lock lost"| LOCK["LockLostError\n(CriticalError)\n→ ABORT immediately\n→ No partial write"]
    INFRA -->|K24| LOCKACQ["LockAcquisitionError\n(CriticalError)\n→ FAIL, another instance running"]
    INFRA -->|K25| STORE["StorageError\n(RecoverableError)\n→ Retry Delta write"]
    INFRA -->|"CB tripped"| CB["CircuitBreakerOpenError\n(RecoverableError)\n→ Wait recovery_timeout (300s)\n→ HALF_OPEN probe"]

    %% Actions
    subgraph Actions["Error Actions"]
        RETRY["🔄 RETRY<br/>• max_attempts: 3<br/>• multiplier: 2.0<br/>• jitter: MD5-based"]
        QUARANTINE2["🔒 QUARANTINE<br/>• QuarantineEntry created<br/>• payload truncated 64KB<br/>• payload_hash computed"]
        FAIL_FAST["💥 FAIL FAST<br/>• No retry<br/>• Pipeline terminates<br/>• ExitCode.PIPELINE_ERROR"]
        BATCH_FAIL["🚫 BATCH FAIL<br/>• error_rate > 20%<br/>• Entire batch rejected<br/>• Checkpoint NOT saved"]
    end

    AUTH --> FAIL_FAST
    RATE --> RETRY
    SERVER --> RETRY
    SCHEMA --> QUARANTINE2
    MISSING --> QUARANTINE2
    FORMAT --> QUARANTINE2
    DQTHRESH --> BATCH_FAIL
    LOCK --> FAIL_FAST
    LOCKACQ --> FAIL_FAST
    STORE --> RETRY
    CB --> RETRY

    %% Retry exhaustion
    RETRY -->|K26| EXHAUST["RetryExhaustedError\n→ Record CB failure\n→ Circuit may trip"]
    EXHAUST --> FAIL_FAST

    %% Styling
    style Actions fill:#fff7ed,stroke:#f59e0b
    style FAIL_FAST fill:#ffe4e6,stroke:#dc2626
    style QUARANTINE2 fill:#ffe4e6,stroke:#e11d48,color:#000
    style RETRY fill:#f0fdf4,stroke:#16a34a

    linkStyle 0 stroke:#EF4444,stroke-width:2px,stroke-dasharray:4
    linkStyle 1 stroke:#EF4444,stroke-width:2px,stroke-dasharray:4
