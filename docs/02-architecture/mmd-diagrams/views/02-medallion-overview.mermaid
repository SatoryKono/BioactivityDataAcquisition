%% View: Overview | Parent: 02-medallion-full.mermaid
%% @uniform width=140 height=56 max_title_len=9 max_desc_lines=0
flowchart TB
%% keep-orphan: N10, N11, N12, N13, N14, N15, N5, N6, N7, N8, N9

    subgraph Application["Application Layer"]
        direction TB
        N2["normalize"]
        N4["flatten"]
        N5["B1"]
        N6["B2"]
        N7["B3"]
        N8["B4"]
        N9["S1"]
        N10["S2"]
        N11["S3"]
        N12["S4"]
        N13["G1"]
        N14["G2"]
        N15["G3"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N1["Bronze"]
        N3["Silver"]
    end

    N1 --> N2
    N3 --> N4

    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px

    linkStyle 0 stroke:#1E293B,stroke-width:4px
    linkStyle 1 stroke:#1E293B,stroke-width:4px
