%% Full reference diagram retained after decomposition.
%% Title: Batch Processing Flow — Extract to Write
%% Covers: RULES.md §2.1 (Data Flow), application/core/batch_executor.py
%% Rank: 9 (Score 8.44) — Core data processing loop for every batch
%% Updated: 2026-02-17

%% @version 1.0.0
%% @date 2026-02-24
%% @type sequenceDiagram
%% @level Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform sequence width=200 max_title_len=20
sequenceDiagram
 autonumber

 box Application Layer
 participant Runner as PipelineRunner
 participant BE as BatchExecutor<br/>(786 LOC)
 participant BT as BatchTransformer
 participant Trans as BaseTransformer<br/>(e.g., ActivityTransformer)
 participant BTM as BatchTracingManager
 end

 box Infrastructure Layer
 participant DS as DataSourcePort<br/>(e.g., ChemblAdapter)
 participant BW as BatchWriter
 participant Bronze as BronzeWriter
 participant Silver as SilverWriter
 participant Gold as GoldWriter
 participant QM as QuarantineManager
 participant BMR as BatchMetricsRecorder
 participant CM as CheckpointManager
 end

 Runner->>BE: execute_batch(batch_num)
 BE->>BTM: start_span("batch")

 Note over BE,DS: Extract Phase
 BE->>DS: async for page in fetch(entity_type,<br/>limit=1000, filter_ids=...)
 DS-->>BE: dict records (one API page)

 Note over BE,BT: Transform Phase
 BE->>BT: transform(raw_records)
 BT->>Trans: _transform_impl(records)
 Trans-->>BT: transformed records
 BT->>BT: normalize values<br/>(NaN→null, strip, dates→ISO)
 BT->>BT: add metadata<br/>(_run_id, _run_type, _ingestion_ts)
 BT->>BT: compute _content_hash (sha256)
 BT-->>BE: TransformResult(records, errors)

 Note over BE,BW: Write Phase
 BE->>BW: write(batch_data)
 BW->>Bronze: write_bronze(records)<br/>→ JSONL + zstd
 BW->>Silver: write_silver(df, primary_keys)<br/>→ Delta Lake merge/upsert
 BW->>Gold: write_gold(df)<br/>→ transform_for_gold() + strict validate

 alt DQ errors detected
 BW->>QM: route_failed_records(failures)
 QM->>QM: create QuarantineEntry<br/>truncate payload (64KB)
 end

 BW-->>BE: write complete

 Note over BE,BMR: Metrics Phase
 BE->>BMR: record(batch_size, duration, errors)
 BMR->>BMR: observe_histogram(batch_size)<br/>increment_counter(records_total)<br/>increment_counter(errors_total)
 BE->>BTM: end_span(status)

 BE-->>Runner: BatchResult(record_count, error_count)

 Runner->>CM: save(last_id, batch_num)
 CM->>CM: write JSON checkpoint<br/>(atomic file write)
