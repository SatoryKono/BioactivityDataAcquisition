%% View: Domain-Focus | Parent: 05-pipeline-lifecycle-states-full.mermaid
%% @uniform width=184 height=56 max_title_len=18 max_desc_lines=0
flowchart TB
%% keep-orphan: N11, N13

    subgraph Domain["Domain Layer"]
        direction TB
        N1["ERROR"]
        N4["LoadingConfig"]
        N5["HealthChecks"]
        N6["PassRecords"]
        N7["WarnRecords"]
        N9["LogError"]
        N11["ComputeHash"]
        N14["*"]
        N15["SHUTDOWN_REQUESTED"]
        N16["EXTRACTING"]
        N17["VALIDATING"]
        N18["ThresholdCheck"]
        N19["LOADING"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N2["TRANSFORMING"]
        N3["FetchBatch"]
        N12["FailBatch"]
        N13["FinishCurrentBatch"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N8["DQMetrics"]
        N20["RequestLock"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N10["BootstrapServices"]
    end

    N14 --> N4
    N4 --> N10
    N14 --> N20
    N14 --> N5
    N14 --> N3
    N16 --> N2
    N16 --> N1
    N2 --> N17
    N2 --> N1
    N18 --> N6
    N18 --> N7
    N18 --> N12
    N17 --> N19
    N17 --> N1
    N19 --> N1
    N14 --> N8
    N14 --> N9
    N16 --> N15
    N2 --> N15
    N17 --> N15
    N19 --> N15

    style Domain fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    style Application fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Infrastructure fill:#ffcdd2,stroke:#c62828,stroke-width:2px
    style Composition fill:#fff3e0,stroke:#e65100,stroke-width:2px

