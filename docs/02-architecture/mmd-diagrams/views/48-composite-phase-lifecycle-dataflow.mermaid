%% View: Data-Flow | Parent: 48-composite-phase-lifecycle-full.mermaid
%% @uniform width=312 height=56 max_title_len=34 max_desc_lines=0
flowchart TB
%% keep-orphan: N4

    subgraph Domain["Domain Layer"]
        direction TB
        N4["FSMStateHelper.validate_transition"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N3["merge_active"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N1["extracting_seed"]
        N2["keys_extracted"]
        N5["*"]
        N6["FAILED"]
        N7["ENRICHING"]
        N8["SEED_RUNNING"]
        N9["SEED_COMPLETED"]
        N10["DEPENDENCIES_RUNNING"]
        N11["MERGING"]
        N12["NOT_STARTED"]
    end

    N5 --> N12
    N12 --> N8
    N8 --> N9
    N8 --> N6
    N9 --> N10
    N9 --> N7
    N10 --> N6
    N7 --> N6
    N11 --> N6
    N6 --> N5
    N5 --> N1
    N5 --> N2
    N5 --> N3

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px

    %% linkStyle: data 0-2,4-5,10-12, err 3,6-9
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#1E293B,stroke-width:3px
    linkStyle 2 stroke:#1E293B,stroke-width:3px
    linkStyle 3 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 4 stroke:#1E293B,stroke-width:3px
    linkStyle 5 stroke:#1E293B,stroke-width:3px
    linkStyle 6 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 7 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 8 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 9 stroke:#c62828,stroke-width:2px,stroke-dasharray:4
    linkStyle 10 stroke:#1E293B,stroke-width:3px
    linkStyle 11 stroke:#1E293B,stroke-width:3px
    linkStyle 12 stroke:#1E293B,stroke-width:3px
