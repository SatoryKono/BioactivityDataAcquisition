    N1 --> N2
    N2 --> N4
    N1 --> N5
    N3 --> N12
    N3 --> N13
    N14 --> N10
    N9 --> N1
    N15 --> N6

    style Domain fill:#ffffff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#ffffff,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#ffffff,stroke:#dc2626,stroke-width:2px
    style Composition fill:#ffffff,stroke:#f59e0b,stroke-width:2px
    style Interfaces fill:#ffffff,stroke:#2563eb,stroke-width:2px

