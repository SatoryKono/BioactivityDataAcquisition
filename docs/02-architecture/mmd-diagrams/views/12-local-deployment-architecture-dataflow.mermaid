%% View: Data-Flow | Parent: 12-local-deployment-architecture-full.mermaid
%% @uniform width=168 height=56 max_title_len=16 max_desc_lines=1
flowchart LR
    APIS["External APIs"] -.-> RUN["chembl / pubchem / uniprot workers"]
    CLI["CLI"] --> RUN
    RUN ==> BRONZE["bronze/"]
    RUN ==> SILVER["silver/"]
    RUN ==> GOLD["gold/"]
    RUN --> QUAR["quarantine/"]
    RUN --> CKP["checkpoints/"]
    RUN --> LIN["lineage/"]

    classDef source fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    classDef sink fill:#fff1f2,stroke:#dc2626,stroke-width:1.8px;
    class APIS,CLI source;
    class RUN process;
    class BRONZE,SILVER,GOLD,QUAR,CKP,LIN sink;
