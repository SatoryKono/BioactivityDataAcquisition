%% View: Domain-Focus | Parent: 46-yaml-config-resolution-full.mermaid
%% @uniform width=200 height=56 max_title_len=20 max_desc_lines=0
flowchart TB
%% keep-orphan: N10, N11, N12, N13, N14, N15, N16, N17, N5, N6, N7, N8, N9

    subgraph Domain["Domain Layer"]
        direction TB
        N2["PIPELINE_CONFIG"]
        N3["TABLE_CONFIG"]
        N4["dq_config_file"]
        N5["DQ_DEFAULTS"]
        N7["DQ_ENTITY"]
        N8["DQ_INLINE"]
        N9["FILTER_ENTITY"]
        N10["CONFIG_LOADER"]
        N11["BASE_CONFIG_LOADER"]
        N12["DQ_CONFIG_LOADER"]
        N13["FILTER_CONFIG_LOADER"]
        N14["DQ_CONFIG"]
        N16["DQ_CONFIG_FILE"]
        N17["FILTER_CONFIG_FILE"]
        N18["br"]
        N19["YAML_LOADER"]
        N20["override"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N15["PIPELINE_YAML_CFG"]
        N1["PIPELINE"]
    end

    subgraph Composition["Composition Layer"]
        direction TB
        N6["DQ_PROVIDER"]
    end

    N19 --> N20
    N2 --> N3
    N1 --> N4
    N1 --> N18

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Composition fill:#fff7ed,stroke:#f59e0b,stroke-width:2px

    %% linkStyle: data 0, orch 3, di 1-2
    linkStyle 0 stroke:#1E293B,stroke-width:3px
    linkStyle 1 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 2 stroke:#6a1b9a,stroke-width:1.5px,stroke-dasharray:5
    linkStyle 3 stroke:#2e7d32,stroke-width:2px
