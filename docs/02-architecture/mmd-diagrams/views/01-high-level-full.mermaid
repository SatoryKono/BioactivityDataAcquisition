%% View: Full | Parent: (root)
%% Parent source: docs/02-architecture/mmd-diagrams/foundation/01-high-level.mmd
%% Full reference diagram retained after decomposition.
%% Title: High-Level System Architecture
%% Covers: RULES.md §1.1 (Five-Layer Architecture)
%% Updated: 2026-02-17
%% Components: CLI, Bootstrap, PipelineFactory, PipelineRunner, BaseTransformer, BaseHttpAdapter, StoragePort

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%% @nodes   25
%% @uniform width=200 height=56 max_title_len=20 max_desc_lines=1
%%{init: {'layout': 'elk', 'theme': 'base', 'themeVariables': {'fontFamily': 'Inter, Roboto, sans-serif'}, 'elk': {'mergeEdges': true, 'nodePlacementStrategy': 'BRANDES_KOEPF', 'cycleBreakingStrategy': 'GREEDY', 'spacing.nodeNode': 40, 'spacing.edgeNode': 30, 'spacing.edgeEdge': 20, 'edgeRouting': 'POLYLINE'}}}%%
flowchart TD
    subgraph Sources["External Data Sources"]
        A1[ChEMBL API<br/>]
        A2[PubChem API<br/>]
        A3[UniProt API<br/>]
        A4[PubMed API<br/>]
        A5[CrossRef API<br/>]
        A6[OpenAlex API<br/>]
        A7[Semantic Scholar API<br/>]
    end

    subgraph Interfaces["Interfaces Layer"]
        CLI["CLI (Click)<br/>"]
    end

    subgraph Composition["Composition Layer"]
        Boot[bootstrap_pipeline<br/>]
        Factory[PipelineFactory<br/>]
    end

    subgraph Application["Application Layer"]
        Runner[PipelineRunner<br/>]
        Executor[PipelineExecutor<br/>]
        Trans[BaseTransformer<br/>]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        Adapters[HTTP Adapters<br/>7 providers]
        Storage[Storage Writers<br/>]
    end

    subgraph Lake["Data Lake — Local Storage"]
        Bronze["Bronze Layer<br/>(JSONL + zstd)"]
        Silver["Silver Layer<br/>(Delta Lake)"]
        Gold["Gold Layer<br/>(Delta Lake)"]
        Quarantine["Quarantine<br/>(failed records)"]
    end

    Sources --> Adapters
    CLI --> Boot
    Boot --> Factory
    Factory --> Runner
    Runner --> Executor
    Executor --> Trans
    Trans --> Adapters
    Storage --> Bronze
    Storage --> Silver
    Storage --> Gold
    Trans -.->|DQ failure| Quarantine
    Executor --> Storage

    %% Styling — Medallion color scheme per diagramming policy §4.3
    classDef source fill:#eff6ff,stroke:#2563eb
    classDef iface fill:#eff6ff,stroke:#2563eb
    classDef comp fill:#fff7ed,stroke:#f59e0b
    classDef app fill:#f0fdf4,stroke:#16a34a
    classDef infra fill:#fff1f2,stroke:#dc2626
    classDef bronze fill:#fefce8,stroke:#f59e0b
    classDef silver fill:#f1f5f9,stroke:#475569
    classDef gold fill:#fefce8,stroke:#fefce8
    classDef quarantine fill:#ffe4e6,stroke:#e11d48

    class A1,A2,A3,A4,A5,A6,A7 source
    class CLI iface
    class Boot,Factory comp
    class Runner,Executor,Trans app
    class Adapters,Storage infra
    class Bronze bronze
    class Silver silver
    class Gold gold
    class Quarantine quarantine

    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px
    style Composition fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
    style Interfaces fill:#eff6ff,stroke:#2563eb,stroke-width:2px

    linkStyle 0 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 1 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 2 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 3 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 4 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 5 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 6 stroke:#475569,stroke-width:2px,stroke-dasharray:5
    linkStyle 7 stroke:#1E293B,stroke-width:4px
    linkStyle 8 stroke:#1E293B,stroke-width:4px
    linkStyle 9 stroke:#1E293B,stroke-width:4px
    linkStyle 10 stroke:#dc2626,stroke-width:2px,stroke-dasharray:4
    linkStyle 11 stroke:#475569,stroke-width:2px,stroke-dasharray:5
