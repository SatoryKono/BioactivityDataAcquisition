{
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#f3e5f5",
    "primaryBorderColor": "#6a1b9a",
    "primaryTextColor": "#212121",
    "secondaryColor": "#ffcdd2",
    "secondaryBorderColor": "#c62828",
    "secondaryTextColor": "#212121",
    "tertiaryColor": "#e8f5e9",
    "tertiaryBorderColor": "#2e7d32",
    "tertiaryTextColor": "#212121",
    "noteBkgColor": "#fff9c4",
    "noteBorderColor": "#f9a825",
    "noteTextColor": "#212121",

    "lineColor": "#546e7a",
    "textColor": "#212121",
    "mainBkg": "#e3f2fd",

    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif",
    "fontSize": "14px",

    "nodeBorder": "#1565c0",
    "clusterBkg": "#fafafa",
    "clusterBorder": "#90a4ae",
    "titleColor": "#0d47a1",

    "edgeLabelBackground": "#ffffff",
    "nodeTextColor": "#212121",

    "actorBkg": "#e3f2fd",
    "actorBorder": "#1565c0",
    "actorTextColor": "#0d47a1",
    "actorLineColor": "#546e7a",
    "signalColor": "#546e7a",
    "signalTextColor": "#212121",
    "labelBoxBkgColor": "#e3f2fd",
    "labelBoxBorderColor": "#1565c0",
    "labelTextColor": "#0d47a1",
    "loopTextColor": "#546e7a",
    "activationBorderColor": "#1565c0",
    "activationBkgColor": "#bbdefb",
    "sequenceNumberColor": "#ffffff",

    "classText": "#212121",

    "fillType0": "#e3f2fd",
    "fillType1": "#fff3e0",
    "fillType2": "#e8f5e9",
    "fillType3": "#f3e5f5",
    "fillType4": "#fce4ec",
    "fillType5": "#e0f7fa",
    "fillType6": "#fff8e1",
    "fillType7": "#efebe9",

    "pie1": "#1565c0",
    "pie2": "#e65100",
    "pie3": "#2e7d32",
    "pie4": "#6a1b9a",
    "pie5": "#b71c1c",
    "pie6": "#00838f",
    "pie7": "#f9a825",
    "pie8": "#4e342e",

    "cScale0": "#e3f2fd",
    "cScale1": "#bbdefb",
    "cScale2": "#90caf9",
    "cScale3": "#64b5f6",
    "cScale4": "#42a5f5",
    "cScale5": "#2196f3",
    "cScale6": "#1e88e5",
    "cScale7": "#1976d2"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 24,
    "nodeSpacing": 50,
    "rankSpacing": 60,
    "htmlLabels": true,
    "useMaxWidth": true,
    "diagramPadding": 16,
    "wrappingWidth": 200,
    "defaultRenderer": "elk"
  },
  "sequence": {
    "mirrorActors": false,
    "messageAlign": "center",
    "actorMargin": 80,
    "width": 180,
    "height": 50,
    "boxMargin": 12,
    "boxTextMargin": 6,
    "noteMargin": 16,
    "messageMargin": 40,
    "diagramMarginX": 50,
    "diagramMarginY": 16,
    "useMaxWidth": true,
    "rightAngles": false,
    "showSequenceNumbers": false
  },
  "class": {
    "defaultRenderer": "elk",
    "useMaxWidth": true
  },
  "state": {
    "useMaxWidth": true,
    "padding": 12,
    "dividerColor": "#90a4ae",
    "defaultRenderer": "elk"
  },
  "er": {
    "useMaxWidth": true,
    "fontSize": 13
  },
  "pie": {
    "useMaxWidth": true
  },
  "mindmap": {
    "useMaxWidth": true,
    "padding": 20
  },
  "gantt": {
    "useMaxWidth": true,
    "fontSize": 13,
    "barHeight": 24,
    "barGap": 6,
    "topPadding": 60,
    "leftPadding": 100,
    "gridLineStartPadding": 40,
    "numberSectionStyles": 4
  },
  "elk": {
    "mergeEdges": true,
    "nodePlacementStrategy": "NETWORK_SIMPLEX",
    "cycleBreakingStrategy": "GREEDY"
  }
}
