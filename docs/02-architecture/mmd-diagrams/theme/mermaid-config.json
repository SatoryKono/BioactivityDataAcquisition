{
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#F5F3FF",
    "primaryBorderColor": "#7C3AED",
    "primaryTextColor": "#212121",
    "secondaryColor": "#FFF1F2",
    "secondaryBorderColor": "#DC2626",
    "secondaryTextColor": "#212121",
    "tertiaryColor": "#F0FDF4",
    "tertiaryBorderColor": "#16A34A",
    "tertiaryTextColor": "#212121",
    "noteBkgColor": "#fff9c4",
    "noteBorderColor": "#f9a825",
    "noteTextColor": "#212121",

    "lineColor": "#475569",
    "textColor": "#212121",
    "mainBkg": "#EFF6FF",

    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif",
    "fontSize": "18px",

    "nodeBorder": "#2563EB",
    "clusterBkg": "#F8FAFC",
    "clusterBorder": "#64748B",
    "titleColor": "#1E293B",

    "edgeLabelBackground": "transparent",
    "nodeTextColor": "#212121",

    "actorBkg": "#EFF6FF",
    "actorBorder": "#2563EB",
    "actorTextColor": "#1E293B",
    "actorLineColor": "#475569",
    "signalColor": "#475569",
    "signalTextColor": "#212121",
    "labelBoxBkgColor": "#EFF6FF",
    "labelBoxBorderColor": "#2563EB",
    "labelTextColor": "#1E293B",
    "loopTextColor": "#475569",
    "activationBorderColor": "#2563EB",
    "activationBkgColor": "#DBEAFE",
    "sequenceNumberColor": "#ffffff",

    "classText": "#212121",

    "fillType0": "#EFF6FF",
    "fillType1": "#FFF7ED",
    "fillType2": "#F0FDF4",
    "fillType3": "#F5F3FF",
    "fillType4": "#FFF1F2",
    "fillType5": "#ECFEFF",
    "fillType6": "#FEFCE8",
    "fillType7": "#F8FAFC",

    "pie1": "#2563EB",
    "pie2": "#EA580C",
    "pie3": "#16A34A",
    "pie4": "#7C3AED",
    "pie5": "#DC2626",
    "pie6": "#0891B2",
    "pie7": "#CA8A04",
    "pie8": "#475569",

    "cScale0": "#EFF6FF",
    "cScale1": "#DBEAFE",
    "cScale2": "#BFDBFE",
    "cScale3": "#93C5FD",
    "cScale4": "#60A5FA",
    "cScale5": "#3B82F6",
    "cScale6": "#2563EB",
    "cScale7": "#1D4ED8"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 24,
    "nodeSpacing": 55,
    "rankSpacing": 50,
    "htmlLabels": true,
    "useMaxWidth": true,
    "diagramPadding": 16,
    "wrappingWidth": 220
  },
  "sequence": {
    "mirrorActors": false,
    "messageAlign": "center",
    "actorMargin": 90,
    "width": 180,
    "height": 50,
    "boxMargin": 12,
    "boxTextMargin": 6,
    "noteMargin": 16,
    "messageMargin": 40,
    "diagramMarginX": 50,
    "diagramMarginY": 16,
    "useMaxWidth": true,
    "rightAngles": true,
    "showSequenceNumbers": false
  },
  "elk": {
    "mergeEdges": true,
    "nodePlacementStrategy": "BRANDES_KOEPF",
    "cycleBreakingStrategy": "GREEDY",
    "direction": "RIGHT",
    "spacing.nodeNode": 45,
    "spacing.edgeNode": 35,
    "spacing.edgeEdge": 25,
    "edgeRouting": "POLYLINE"
  },
  "class": {
    "defaultRenderer": "elk",
    "useMaxWidth": true,
    "padding": 16,
    "htmlLabels": true
  },
  "state": {
    "useMaxWidth": true,
    "padding": 12,
    "dividerColor": "#90a4ae",
    "defaultRenderer": "elk"
  },
  "er": {
    "useMaxWidth": true,
    "fontSize": 14
  },
  "pie": {
    "useMaxWidth": true
  },
  "mindmap": {
    "useMaxWidth": true,
    "padding": 20
  },
  "gantt": {
    "useMaxWidth": true,
    "fontSize": 14,
    "barHeight": 24,
    "barGap": 6,
    "topPadding": 60,
    "leftPadding": 100,
    "gridLineStartPadding": 40,
    "numberSectionStyles": 4
  }
}
