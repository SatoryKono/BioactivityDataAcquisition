%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform width=216 height=108 max_title_len=22 max_desc_lines=4
flowchart TB
%% keep-orphan: BLOCK, OK, SR
    subgraph Legend["Legend"]
        direction LR
        OK["✅ Allowed Import<br/>"]
        BLOCK["❌ Forbidden Import<br/>"]
    end

    subgraph Layers["BioETL Five-Layer Architecture"]
        INT["<b>Interfaces Layer</b><br/>CLI (Click), HealthServer<br/><i>src/bioetl/interfaces/</i><br/>"]
        COMP["<b>Composition Layer</b><br/>GenericPipelineFactory, RunnerFactory<br/>ServicesBuilder, PipelineRegistry<br/><i>src/bioetl/composition/</i><br/>"]
        APP["<b>Application Layer</b><br/>PipelineRunner, BatchExecutor<br/>PreflightService, PostrunService<br/>23 Transformers<br/><i>src/bioetl/application/</i>"]
        INFRA["<b>Infrastructure Layer</b><br/>ChemblAdapter, PubChemAdapter<br/>SilverWriter, MemoryLock<br/>UnifiedHTTPClient, PrometheusMetrics<br/><i>src/bioetl/infrastructure/</i>"]
        DOM["<b>Domain Layer</b><br/>24 Ports (Protocol)<br/>Entities, Aggregates, Schemas<br/>Config, Types, Exceptions<br/><i>src/bioetl/domain/</i>"]
    end

    %% Allowed imports (solid green arrows)
    INT -->|"✅ imports"| COMP
    INT -->|"✅ imports"| APP
    INT -->|"✅ imports"| INFRA
    INT -->|"✅ imports"| DOM

    COMP -->|"✅ imports"| APP
    COMP -->|"✅ imports"| INFRA
    COMP -->|"✅ imports"| DOM

    APP -->|"✅ imports"| DOM

    INFRA -->|"✅ imports"| DOM

    %% Forbidden imports (red dashed arrows)
    DOM -.-x|"❌ FORBIDDEN"| APP
    DOM -.-x|"❌ FORBIDDEN"| INFRA
    DOM -.-x|"❌ FORBIDDEN"| COMP
    DOM -.-x|"❌ FORBIDDEN"| INT

    APP -.-x|"❌ FORBIDDEN"| INFRA
    APP -.-x|"❌ FORBIDDEN"| COMP
    APP -.-x|"❌ FORBIDDEN"| INT

    INFRA -.-x|"❌ FORBIDDEN"| APP
    INFRA -.-x|"❌ FORBIDDEN"| COMP
    INFRA -.-x|"❌ FORBIDDEN"| INT

    COMP -.-x|"❌ FORBIDDEN"| INT

    subgraph Enforcement["Enforcement Mechanism"]
        IL["import-linter<br/>Blocks PR on violation<br/>"]
        AT["tests/architecture/<br/>pytest architecture tests<br/>"]
        SR["ai-selfreview-rules.md<br/>ARCH-001 detection scripts<br/>"]
    end

    IL -.-> Layers
    AT -.-> Layers

    %% Styling
    style DOM fill:#e8f5e9,stroke:#2e7d32,stroke-width:3px
    style APP fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style INFRA fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style COMP fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style INT fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
