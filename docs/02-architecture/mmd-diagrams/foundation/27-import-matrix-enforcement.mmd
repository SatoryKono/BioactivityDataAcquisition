%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
flowchart TB
%% keep-orphan: BLOCK, OK, SR
    subgraph Legend["Legend"]
        direction LR
        OK["✅ Allowed Import"]
        BLOCK["❌ Forbidden Import"]
    end

    subgraph Layers["BioETL Five-Layer Architecture"]
        INT["<b>Interfaces Layer</b>\nCLI (Click), HealthServer\n<i>src/bioetl/interfaces/</i>"]
        COMP["<b>Composition Layer</b>\nGenericPipelineFactory, RunnerFactory\nServicesBuilder, PipelineRegistry\n<i>src/bioetl/composition/</i>"]
        APP["<b>Application Layer</b>\nPipelineRunner, BatchExecutor\nPreflightService, PostrunService\n23 Transformers\n<i>src/bioetl/application/</i>"]
        INFRA["<b>Infrastructure Layer</b>\nChemblAdapter, PubChemAdapter\nSilverWriter, MemoryLock\nUnifiedHTTPClient, PrometheusMetrics\n<i>src/bioetl/infrastructure/</i>"]
        DOM["<b>Domain Layer</b>\n24 Ports (Protocol)\nEntities, Aggregates, Schemas\nConfig, Types, Exceptions\n<i>src/bioetl/domain/</i>"]
    end

    %% Allowed imports (solid green arrows)
    INT -->|"✅ imports"| COMP
    INT -->|"✅ imports"| APP
    INT -->|"✅ imports"| INFRA
    INT -->|"✅ imports"| DOM

    COMP -->|"✅ imports"| APP
    COMP -->|"✅ imports"| INFRA
    COMP -->|"✅ imports"| DOM

    APP -->|"✅ imports"| DOM

    INFRA -->|"✅ imports"| DOM

    %% Forbidden imports (red dashed arrows)
    DOM -.-x|"❌ FORBIDDEN"| APP
    DOM -.-x|"❌ FORBIDDEN"| INFRA
    DOM -.-x|"❌ FORBIDDEN"| COMP
    DOM -.-x|"❌ FORBIDDEN"| INT

    APP -.-x|"❌ FORBIDDEN"| INFRA
    APP -.-x|"❌ FORBIDDEN"| COMP
    APP -.-x|"❌ FORBIDDEN"| INT

    INFRA -.-x|"❌ FORBIDDEN"| APP
    INFRA -.-x|"❌ FORBIDDEN"| COMP
    INFRA -.-x|"❌ FORBIDDEN"| INT

    COMP -.-x|"❌ FORBIDDEN"| INT

    subgraph Enforcement["Enforcement Mechanism"]
        IL["import-linter\nBlocks PR on violation"]
        AT["tests/architecture/\npytest architecture tests"]
        SR["ai-selfreview-rules.md\nARCH-001 detection scripts"]
    end

    IL -.-> Layers
    AT -.-> Layers

    %% Styling
    style DOM fill:#e8f5e9,stroke:#2e7d32,stroke-width:3px
    style APP fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style INFRA fill:#fff3e0,stroke:#e65100,stroke-width:2px
    style COMP fill:#fce4ec,stroke:#c62828,stroke-width:2px
