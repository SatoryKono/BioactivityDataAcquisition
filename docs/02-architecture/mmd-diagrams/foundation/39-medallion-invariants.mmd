%% Title: Medallion Architecture Invariants (ARCH-007)
%% Covers: RULES.md §2.1 (Medallion), ARCH-007 clear policy
%% Rank: 14 (Score 8.19) — Critical data safety rules
%% Updated: 2026-02-17

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform width=272 height=112 max_title_len=27 max_desc_lines=4
flowchart TB
%% keep-orphan: E3, E4
    subgraph RunTypes["RunType Enum (domain/types.py)"]
        INC["RunType.INCREMENTAL<br/>'Fetch new data since last run'<br/><br/>"]
        BF["RunType.BACKFILL<br/>'Re-fetch a date range'<br/><br/>"]
        RB["RunType.REBUILD<br/>'Full clean rebuild'<br/><br/>"]
    end

    subgraph Policy["MedallionLifecycleService\n(application/services/medallion_lifecycle.py)"]
        CHECK{{"Check RunType<br/><br/><br/>"}}
    end

    subgraph IncPath["INCREMENTAL Path"]
        I1["❌ DO NOT clear Silver<br/><br/><br/>"]
        I2["❌ DO NOT clear Gold<br/><br/><br/>"]
        I3["Silver: merge/upsert<br/>(content_hash dedup)<br/><br/>"]
        I4["Gold: merge/append<br/><br/><br/>"]
    end

    subgraph BFPath["BACKFILL Path"]
        B1["✅ MUST clear Silver<br/>SilverWriter.clear()<br/><br/>"]
        B2["✅ MUST clear Gold<br/>GoldWriter.clear()<br/><br/>"]
        B3["Silver: full reload<br/><br/><br/>"]
        B4["Gold: full reload<br/><br/><br/>"]
    end

    subgraph RBPath["REBUILD Path"]
        R1["✅ MUST clear Silver<br/>SilverWriter.clear()<br/><br/>"]
        R2["✅ MUST clear Gold<br/>GoldWriter.clear()<br/><br/>"]
        R3["Silver: full rebuild<br/>from Bronze/API<br/><br/>"]
        R4["Gold: full rebuild<br/>from Silver<br/><br/>"]
    end

    subgraph Enforcement["Enforcement"]
        E1["PipelineRunner checks<br/>run_type before execution<br/><br/>"]
        E2["MedallionLifecycleService<br/>enforces clear policy<br/><br/>"]
        E3["ClearResult tracks<br/>what was cleared<br/><br/>"]
        E4["Tests verify:<br/>INCREMENTAL never clears<br/><br/>"]
    end

    subgraph Bronze["Bronze Layer (Always Append)"]
        BZ["BronzeWriter.write_bronze()<br/>• ALWAYS append-only<br/>• Never cleared by run_type<br/>• 90-day retention policy"]
    end

    %% Flow
    INC --> CHECK
    BF --> CHECK
    RB --> CHECK

    CHECK -->|"INCREMENTAL"| I1
    I1 --> I2 --> I3 --> I4

    CHECK -->|"BACKFILL"| B1
    B1 --> B2 --> B3 --> B4

    CHECK -->|"REBUILD"| R1
    R1 --> R2 --> R3 --> R4

    E1 -.-> CHECK
    E2 -.-> Policy

    BZ -.->|"unaffected by run_type"| Bronze

    %% Styling
    style IncPath fill:#e8f5e9,stroke:#2e7d32
    style BFPath fill:#fff3e0,stroke:#e65100
    style RBPath fill:#ffebee,stroke:#c62828
    style Bronze fill:#fff3e0,stroke:#e65100,color:#212121
    style Policy fill:#e3f2fd,stroke:#1565c0
