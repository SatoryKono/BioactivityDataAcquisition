%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform width=200 height=112 max_title_len=19 max_desc_lines=4
flowchart TD
    ROOT["Exception&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>(Python built-in)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]

    BIOETL["BioETLError&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>domain/exceptions/base.py&nbsp;&nbsp;&nbsp;<br/>error_type: ErrorType&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>context: dict&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]

    ROOT --> BIOETL

    %% Three main branches
    BIOETL --> CRITICAL["CriticalError<br/>error_type = CRITICAL<br/>Action: ABORT pipeline"]
    BIOETL --> RECOVERABLE["RecoverableError<br/>error_type = RECOVERABLE<br/>Action: RETRY with backoff"]
    BIOETL --> DQ_ERROR["DataQualityError<br/>error_type = DATA_QUALITY<br/>Action: QUARANTINE record"]

    %% ── CriticalError subtree ──
    CRITICAL --> INVALID_STATE["InvalidStateError<br/>current_state, attempted_operation"]
    CRITICAL --> POLICY_VIOLATION["PolicyViolationError<br/>policy, violation_details"]
    CRITICAL --> LOCK_LOST["LockLostError<br/>lock_key, run_id"]
    CRITICAL --> LOCK_ACQ["LockAcquisitionError<br/>lock_key, holder, ttl"]
    CRITICAL --> CHECKPOINT_CONFLICT["CheckpointConflictError<br/>pipeline, existing_run_id"]
    CRITICAL --> MERGE_CONFLICT["MergeConflictError<br/>table, conflicting_keys"]
    CRITICAL --> AUTH_FAILURE["AuthFailureError<br/>provider, status_code"]
    CRITICAL --> METRICS_ERROR["MetricsServerError<br/>host, port"]
    CRITICAL --> RUNNER_EXECUTED["RunnerAlreadyExecutedError"]
    CRITICAL --> INFRA_ERROR["InfrastructureError<br/>component, operation"]
    CRITICAL --> STORAGE_QUOTA["StorageQuotaExceededError<br/>path, current_size, limit"]
    CRITICAL --> DELTA_TX["DeltaTransactionError<br/>table, operation"]
    CRITICAL --> DELTA_SCHEMA_V["DeltaSchemaValidationError<br/>table, expected, actual"]

    %% ── RecoverableError subtree ──
    RECOVERABLE --> NETWORK["NetworkError<br/>url, status_code, method"]
    RECOVERABLE --> TIMEOUT["TimeoutError<br/>url, timeout_seconds"]
    RECOVERABLE --> RATE_LIMIT["RateLimitError<br/>provider, retry_after"]
    RECOVERABLE --> CB_OPEN["CircuitBreakerOpenError<br/>provider, failures, recovery_timeout"]
    RECOVERABLE --> RETRY_EXHAUSTED["RetryExhaustedError<br/>url, attempts, last_error"]
    RECOVERABLE --> API_ERROR["ApiError<br/>provider, endpoint, status_code"]
    RECOVERABLE --> EXT_SERVICE["ExternalServiceError<br/>service, operation"]

    EXT_SERVICE --> SVC_UNAVAIL["ServiceUnavailableError<br/>service, status_code"]
    EXT_SERVICE --> RATE_EXCEEDED["RateLimitExceededError<br/>service, retry_after"]
    EXT_SERVICE --> SVC_AUTH["ServiceAuthenticationError<br/>service, status_code"]
    EXT_SERVICE --> DATA_VALID_EXT["DataValidationError<br/>service, field, message"]

    RECOVERABLE --> STORAGE_ERR["StorageError<br/>path, operation"]

    STORAGE_ERR --> BUCKET_404["BucketNotFoundError<br/>bucket"]
    STORAGE_ERR --> TABLE_404["TableNotFoundError<br/>table"]
    STORAGE_ERR --> UPLOAD_ERR["UploadError<br/>path, size"]
    STORAGE_ERR --> SCHEMA_EVOL["SchemaEvolutionError<br/>table, old_schema, new_schema"]
    STORAGE_ERR --> BRONZE_VALID["BronzeValidationError<br/>path, reason"]
    STORAGE_ERR --> CACHED_EMPTY["CachedBronzeEmptyError<br/>path"]
    STORAGE_ERR --> DELTA_WRITE["DeltaWriteConflictError<br/>table, version"]
    STORAGE_ERR --> DELTA_OPT["DeltaOptimizeError<br/>table"]

    %% ── DataQualityError subtree ──
    DQ_ERROR --> VALIDATION["ValidationError<br/>field, message, record_id"]

    VALIDATION --> SCHEMA_VIOL["SchemaViolationError<br/>schema_name, violations: list"]
    VALIDATION --> MISSING_FIELD["MissingRequiredFieldError<br/>field, entity_type"]
    VALIDATION --> INVALID_FORMAT["InvalidDataFormatError<br/>field, expected, actual"]

    BIOETL --> DQ_THRESHOLD["DataQualityThresholdError<br/>pipeline, ratio, threshold"]

    %% ── ErrorClassifier ──
    CLASSIFIER["ErrorClassifier&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>domain/error_classifier.py&nbsp;&nbsp;<br/>.classify(error) → ErrorType<br/>&nbsp;"]
    CLASSIFIER -.->|"CRITICAL"| CRITICAL
    CLASSIFIER -.->|"RECOVERABLE"| RECOVERABLE
    CLASSIFIER -.->|"DATA_QUALITY"| DQ_ERROR
    CLASSIFIER -.->|"UNKNOWN"| ROOT

    %% ── ErrorType enum ──
    ERROR_TYPE["ErrorType (StrEnum)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>domain/types.py&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>CRITICAL | RECOVERABLE&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>DATA_QUALITY | UNKNOWN&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
    CLASSIFIER --> ERROR_TYPE

    %% ── Action outcomes ──

    CRITICAL -.->|"triggers"| ACTION_ABORT
    RECOVERABLE -.->|"triggers"| ACTION_RETRY
    DQ_ERROR -.->|"triggers"| ACTION_QUARANTINE

    %% Styling
    style ROOT fill:#f5f5f5,stroke:#333
    style BIOETL fill:#FFE0B2,stroke:#E65100,stroke-width:3px
    style CRITICAL fill:#FFCDD2,stroke:#C62828,stroke-width:2px
    style RECOVERABLE fill:#FFF9C4,stroke:#F57F17,stroke-width:2px
    style DQ_ERROR fill:#E1BEE7,stroke:#6A1B9A,stroke-width:2px
    style CLASSIFIER fill:#E3F2FD,stroke:#1565C0,stroke-width:2px
    style ERROR_TYPE fill:#E8F5E9,stroke:#2E7D32
    style ACTION_ABORT fill:#ffebee,stroke:#C62828
    style ACTION_RETRY fill:#fff3e0,stroke:#E65100
    style ACTION_QUARANTINE fill:#CE93D8,stroke:#6A1B9A
