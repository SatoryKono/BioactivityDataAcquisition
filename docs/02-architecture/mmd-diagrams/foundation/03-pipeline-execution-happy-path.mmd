%% Title: Pipeline Execution — Happy Path
%% Covers: RULES.md §3 (Pipeline Execution), §3.3 (Locking), §3.4 (Postrun)
%% Updated: 2026-02-17
%% Components: CLI, bootstrap_pipeline, PipelineRunner, LockManager, PreflightService, PipelineExecutor, PostrunService

%% @version 1.1.0
%% @date 2026-02-24
%% @type sequenceDiagram
%% @level Mixed (System / Component / Class)

%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform sequence width=248 max_title_len=26
sequenceDiagram
 autonumber
 participant CLI as CLI
 participant Bootstrap as bootstrap_pipeline()
 participant Runner as PipelineRunner
 participant LockMgr as LockManager
 participant Preflight as PreflightService
 participant Executor as PipelineExecutor
 participant Adapter as DataSourceAdapter
 participant Processor as RecordProcessor
 participant Writers as Bronze/Silver/Gold Writers
 participant Postrun as PostrunService
 participant Checkpoint as CheckpointManager

 CLI->>Bootstrap: run(pipeline_name, config)
 Bootstrap->>Runner: create(services, config)

 rect rgb(240, 248, 255)
 Note over Runner,LockMgr: Phase 1: Lock Acquisition
 Runner->>LockMgr: acquire_lock(resource, owner_id, ttl=90s)
 LockMgr-->>Runner: LockResult(acquired=true)
 Runner->>LockMgr: start_heartbeat(interval=30s)
 activate LockMgr
 end

 rect rgb(255, 250, 240)
 Note over Runner,Preflight: Phase 2: Preflight Checks
 Runner->>Preflight: run_checks()
 Preflight->>Adapter: health_check()
 Adapter-->>Preflight: HealthStatus.HEALTHY
 Preflight-->>Runner: PreflightResult(passed=true)
 end

 rect rgb(240, 255, 240)
 Note over Runner,Writers: Phase 3: ETL Execution
 Runner->>Executor: execute(pipeline)

 loop For each batch
 Executor->>Adapter: fetch(query)
 Adapter-->>Executor: AsyncIterator[BronzeRecord]

 Executor->>Processor: process_batch(records)
 Processor->>Writers: write_bronze(records)
 Writers-->>Processor: BronzeWriteResult

 Processor->>Processor: transform(records)
 Note right of Processor: normalize, compute hash, add metadata

 Processor->>Writers: merge_silver(records, primary_key)
 Writers->>LockMgr: validate_owner()
 LockMgr-->>Writers: valid
 Writers-->>Processor: WriteResult

 Processor->>Writers: write_gold(records, schema)
 Writers->>LockMgr: validate_owner()
 LockMgr-->>Writers: valid
 Writers-->>Processor: WriteResult

 Processor-->>Executor: BatchResult

 Note over LockMgr: Every 30s
 LockMgr->>LockMgr: heartbeat()
 end

 Executor-->>Runner: ExecutionResult
 end

 rect rgb(255, 240, 245)
 Note over Runner,Checkpoint: Phase 4: Postrun & Cleanup
 Runner->>Postrun: run_checks(metrics)
 Note right of Postrun: DQ threshold validation
 Postrun-->>Runner: PostrunResult

 Runner->>Checkpoint: delete(pipeline_name)
 Checkpoint-->>Runner: deleted

 Runner->>LockMgr: release_lock()
 deactivate LockMgr
 LockMgr-->>Runner: released
 end

 Runner==>>CLI: RunResult(success=true, metrics)
