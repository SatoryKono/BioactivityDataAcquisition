flowchart TB
%% keep-orphan: CheckpointPort, CriticalError, DataQualityError, DataSourcePort, HealthStatus, InvalidStateError, LockPort, Measurement, MetricsPort, QuarantinePort, RecoverableError, RunType, StoragePort, TracingPort
    subgraph domain["Domain Layer (DDD)"]
        subgraph ports["ports/"]
            DataSourcePort
            StoragePort
            LockPort
            CheckpointPort
            QuarantinePort
            MetricsPort
            TracingPort
        end

        subgraph aggregates["aggregates/"]
            Batch["Batch Aggregate<br/>───────────────<br/>• add_record()<br/>• quarantine_record()<br/>• seal()<br/>• mark_committed()"]

            PipelineRun["PipelineRun Aggregate<br/>───────────────<br/>• start()<br/>• record_stage_success()<br/>• complete()<br/>• fail()"]

            QuarantineEntry["QuarantineEntry Aggregate<br/>───────────────<br/>• mark_retrying()<br/>• mark_recovered()<br/>• mark_dead_letter()<br/>"]
        end

        subgraph events["Domain Events"]
            BatchCreated
            BatchSealed
            BatchWritten
            RunStarted
            RunCompleted
            RecordQuarantined
        end

        subgraph value_objects["value_objects/"]
            RunID["RunID (UUID)<br/>"]
            BatchID["BatchID (UUID)<br/>"]
            EntityID["EntityID (str)<br/>"]
            ContentHash["ContentHash (str)<br/>"]
            Measurement["Measurement<br/>(value, unit, relation)<br/>"]
        end

        subgraph types["types.py"]
            RunType["RunType Enum<br/>(INCREMENTAL, BACKFILL, REBUILD)<br/>"]
            HealthStatus["HealthStatus Enum<br/>(HEALTHY, DEGRADED, UNHEALTHY)<br/>"]
        end

        subgraph exceptions["exceptions/"]
            CriticalError
            RecoverableError
            DataQualityError
            InvalidStateError
        end
    end

    %% Relationships
    Batch --> BatchCreated
    Batch --> BatchSealed
    Batch --> BatchWritten
    Batch --> RecordQuarantined
    PipelineRun --> RunStarted
    PipelineRun --> RunCompleted

    Batch --> RunID
    Batch --> BatchID
    PipelineRun --> RunID
    QuarantineEntry --> EntityID
    QuarantineEntry --> ContentHash

    %% State machines
    subgraph batch_states["Batch State Machine"]
        B_SEALED --> B_WRITING["WRITING"]
        B_WRITING --> B_COMMITTED["COMMITTED"]
        B_WRITING --> B_FAILED["FAILED"]
    end

    subgraph run_states["PipelineRun State Machine"]
        R_RUNNING --> R_COMPLETED["COMPLETED"]
        R_RUNNING --> R_FAILED["FAILED"]
        R_RUNNING --> R_SHUTDOWN["SHUTDOWN"]
    end
