%% Title: Layer Interaction — Hexagonal Architecture
%% Covers: RULES.md §1.1 (Layers), §1.2 (Ports & Adapters)
%% Updated: 2026-02-17
%% Components: CLI, bootstrap_pipeline, PipelineRunner, PipelineExecutor, BaseTransformer, Port interfaces, Adapters, Storage Writers

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)
%% @uniform width=224 height=56 max_title_len=23 max_desc_lines=0

flowchart TB
%% keep-orphan: Entities, Exceptions, Locking, Types
    subgraph Interfaces["Interfaces Layer"]
        CLI[CLI Entry Point&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
    end

    subgraph Composition["Composition Layer"]
        Bootstrap[bootstrap_pipeline&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        Registry[PipelineRegistry&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        Factories[Factories&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]

        Bootstrap --> Registry
        Bootstrap --> Factories
    end

    subgraph Application["Application Layer"]
        Runner[PipelineRunner&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        BatchExec[BatchExecutor&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        Transformer[BaseTransformer&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        Services[PipelineServices&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]

        subgraph Composite["Composite Pipeline (ADR-026)"]
            CompositeRunner[CompositePipelineRunner]
            Coordinator[EnrichmentCoordinator&nbsp;&nbsp;]
            Merger[MergeService&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        end

        Runner --> BatchExec
        BatchExec --> Transformer
        Runner --> Services
        CompositeRunner --> Coordinator
        CompositeRunner --> Merger
        CompositeRunner -.->|"delegates"| Runner
    end

    subgraph Domain["Domain Layer"]
        Ports[Port Interfaces&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        Types[Core Types&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        Entities[Domain Entities&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        Exceptions[Exception Hierarchy&nbsp;&nbsp;&nbsp;&nbsp;]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        Adapters[Data Source Adapters&nbsp;&nbsp;&nbsp;]
        Storage[Storage Writers&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        Observability[Metrics & Tracing&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;]
        Locking[Locks & Checkpoints&nbsp;&nbsp;&nbsp;&nbsp;]
    end

    %% Layer Dependencies
    CLI --> Bootstrap
    Factories --> Runner
    Application --> Ports
    Adapters -.->|implements| Ports
    Storage -.->|implements| Ports
    Observability -.->|implements| Ports

    %% Styling
    classDef domainStyle fill:#f3e5f5,stroke:#6a1b9a
    classDef appStyle fill:#e8f5e9,stroke:#2e7d32
    classDef infraStyle fill:#ffcdd2,stroke:#c62828
    classDef compStyle fill:#fff3e0,stroke:#e65100
    classDef ifaceStyle fill:#e3f2fd,stroke:#1565c0

    class Domain domainStyle
    class Application appStyle
    class Infrastructure infraStyle
    class Composition compStyle
    class Interfaces ifaceStyle
