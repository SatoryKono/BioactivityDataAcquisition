    style Bronze fill:#fff7ed,stroke:#f59e0b,color:#212121
    style Silver fill:#f1f5f9,stroke:#475569,color:#212121
    style GoldLayer fill:#fefce8,stroke:#ca8a04,color:#212121
    style QuarDB fill:#ffe4e6,stroke:#dc2626,color:#212121
