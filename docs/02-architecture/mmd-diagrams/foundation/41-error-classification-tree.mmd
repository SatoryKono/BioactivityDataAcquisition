%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform width=168 height=112 max_title_len=14 max_desc_lines=4
flowchart TB
    ERROR["Error Occurred&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]

    ERROR --> HTTP{{"HTTP Status Code?"}}
    ERROR --> DOMAIN{{"Domain Error?"}}
    ERROR --> INFRA{{"Infrastructure Error?"}}

    %% HTTP errors
    HTTP -->|"401, 403"| AUTH["ServiceAuthenticationError\n(CriticalError)\n→ FAIL FAST, no retry\n→ Check API key config"]
    HTTP -->|"404"| NOTFOUND["ApiError\n(RecoverableError)\n→ Log warning\n→ Skip entity"]
    HTTP -->|"429"| RATE["RateLimitExceededError\n(RecoverableError)\n→ Check Retry-After header\n→ Exponential backoff"]
    HTTP -->|"500, 502, 504"| SERVER["ServiceUnavailableError\n(RecoverableError)\n→ Retry with backoff\n→ Max 3 attempts"]
    HTTP -->|"Other"| UNKNOWN_HTTP["ExternalServiceError\n→ Log, classify, retry"]

    %% Domain errors
    DOMAIN -->|"Schema mismatch"| SCHEMA["SchemaViolationError\n(DataQualityError → ValidationError)\n→ Route to Quarantine"]
    DOMAIN -->|"Missing field"| MISSING["MissingRequiredFieldError\n(ValidationError)\n→ Route to Quarantine"]
    DOMAIN -->|"Invalid format"| FORMAT["InvalidDataFormatError\n(ValidationError)\n→ Route to Quarantine"]
    DOMAIN -->|"DQ threshold"| DQTHRESH["DataQualityThresholdError\n→ error_rate > 20%\n→ FAIL entire batch"]

    %% Infrastructure errors
    INFRA -->|"Lock lost"| LOCK["LockLostError\n(CriticalError)\n→ ABORT immediately\n→ No partial write"]
    INFRA -->|"Lock timeout"| LOCKACQ["LockAcquisitionError\n(CriticalError)\n→ FAIL, another instance running"]
    INFRA -->|"Storage failure"| STORE["StorageError\n(RecoverableError)\n→ Retry Delta write"]
    INFRA -->|"CB tripped"| CB["CircuitBreakerOpenError\n(RecoverableError)\n→ Wait recovery_timeout (300s)\n→ HALF_OPEN probe"]

    %% Actions
    subgraph Actions["Error Actions"]
        ACT_RETRY["RETRY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>max_attempts: 3&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>multiplier: 2.0&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>jitter: MD5-based&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        ACT_QUARANTINE["QUARANTINE&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>QuarantineEntry created<br/>payload truncated 64KB&nbsp;<br/>payload_hash computed&nbsp;&nbsp;"]
        FAIL_FAST["FAIL FAST&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>No retry&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Pipeline terminates&nbsp;&nbsp;&nbsp;&nbsp;<br/>ExitCode.PIPELINE_ERROR"]
        BATCH_FAIL["BATCH FAIL&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>error_rate > 20%&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Entire batch rejected&nbsp;&nbsp;<br/>Checkpoint NOT saved&nbsp;&nbsp;&nbsp;"]
    end

    AUTH --> FAIL_FAST
    RATE --> ACT_RETRY
    SERVER --> ACT_RETRY
    SCHEMA --> ACT_QUARANTINE
    MISSING --> ACT_QUARANTINE
    FORMAT --> ACT_QUARANTINE
    DQTHRESH --> BATCH_FAIL
    LOCK --> FAIL_FAST
    LOCKACQ --> FAIL_FAST
    STORE --> ACT_RETRY
    CB --> ACT_RETRY

    %% Retry exhaustion
    ACT_RETRY -->|"max exhausted"| EXHAUST["RetryExhaustedError<br/>Record CB failure<br/>Circuit may trip"]
    EXHAUST --> FAIL_FAST

    %% Styling
    style Actions fill:#fff3e0,stroke:#e65100
    style FAIL_FAST fill:#ffebee,stroke:#c62828
    style ACT_QUARANTINE fill:#ffebee,stroke:#c62828,color:#212121
    style ACT_RETRY fill:#e8f5e9,stroke:#2e7d32
