%% Title: Full Medallion Data Flow with Lineage and DQ
%% Covers: RULES.md §2.1 (Medallion Architecture), §2.3 (Quarantine), §3.1 (DQ)
%% Updated: 2026-02-17
%% Components: BronzeWriter, SilverWriter, GoldWriter, DQMonitorPort, QuarantineManager, LineageLog

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
%% @uniform width=200 height=144 max_title_len=20 max_desc_lines=6
flowchart LR
    subgraph Sources["External Sources"]
        ChEMBL["ChEMBL API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        PubChem["PubChem API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        UniProt["UniProt API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        PubMed["PubMed API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        CrossRef["CrossRef API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        OpenAlex["OpenAlex API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        S2["Semantic Scholar API<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Bronze_Layer["Bronze Layer"]
        direction TB
        BronzeWriter["BronzeWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        Bronze[("Bronze Storage&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━<br/>📁 Format: JSONL + zstd<br/>⏱️ Retention: 90 days<br/>✅ Validation: None<br/>📍 Path: bronze/v1/<br/>{provider}/{entity}/{date}/")]
    end

    subgraph Silver_Layer["Silver Layer"]
        direction TB
        SilverWriter["SilverWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        Silver[("Silver Storage&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━<br/>📁 Format: Delta Lake<br/>⏱️ Retention: Permanent<br/>✅ Validation: Pandera (soft<br/>&nbsp;<br/>&nbsp;)\n🔄 Strategy: Merge/Upsert\n🔑 Key: content_hash")]
    end

    subgraph Gold_Layer["Gold Layer"]
        direction TB
        GoldWriter["GoldWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        Gold[("Gold Storage&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━<br/>📁 Format: Delta/Parquet<br/>⏱️ Retention: Permanent<br/>✅ Validation: Pandera (strict<br/>&nbsp;<br/>&nbsp;)\n🔄 Strategy: SCD2/Append")]
    end

    subgraph DQ_Branch["Data Quality Branch"]
        DQValidator["DQ Validator&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>━━━━━━━━━━━━━━━<br/>⚠️ Soft: >5% errors<br/>❌ Hard: >20% errors<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Lineage["Lineage Tracking"]
    end

    %% Main flow
    ChEMBL --> BronzeWriter
    PubChem --> BronzeWriter
    UniProt --> BronzeWriter
    PubMed --> BronzeWriter
    CrossRef --> BronzeWriter
    OpenAlex --> BronzeWriter
    S2 --> BronzeWriter

    BronzeWriter --> Bronze
    Bronze --> SilverWriter

    SilverWriter --> DQValidator
    DQValidator -->|"✅ Pass"| Silver
    DQValidator -->|"❌ Fail"| Quarantine

    Silver --> GoldWriter
    GoldWriter --> Gold

    %% Lineage tracking
    Bronze -.->|"batch_id"| LineageLog
    Silver -.->|"transform_version"| LineageLog

    %% Styling
    style Bronze fill:#CD7F32,color:#fff
    style Silver fill:#C0C0C0,color:#000
    style Gold fill:#FFD700,color:#000
    style Quarantine fill:#FF6B6B,color:#fff
    style LineageLog fill:#87CEEB,color:#000
