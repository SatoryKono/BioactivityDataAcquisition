%% Title: Full Medallion Data Flow with Lineage and DQ
%% Covers: RULES.md §2.1 (Medallion Architecture), §2.3 (Quarantine), §3.1 (DQ)
%% Updated: 2026-02-17
%% Components: BronzeWriter, SilverWriter, GoldWriter, DQMonitorPort, QuarantineManager, LineageLog

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform width=336 height=168 max_title_len=20 max_desc_lines=7
flowchart LR
    subgraph Sources["External Sources"]
        ChEMBL["ChEMBL API<br/><br/><br/><br/><br/><br/>"]
        PubChem["PubChem API<br/><br/><br/><br/><br/><br/>"]
        UniProt["UniProt API<br/><br/><br/><br/><br/><br/>"]
        PubMed["PubMed API<br/><br/><br/><br/><br/><br/>"]
        CrossRef["CrossRef API<br/><br/><br/><br/><br/><br/>"]
        OpenAlex["OpenAlex API<br/><br/><br/><br/><br/><br/>"]
        S2["Semantic Scholar API<br/><br/><br/><br/><br/><br/>"]
    end

    subgraph Bronze_Layer["Bronze Layer"]
        direction TB
        BronzeWriter["BronzeWriter<br/><br/><br/><br/><br/><br/>"]
        Bronze[("Bronze Storage<br/>━━━━━━━━━━━━━━━<br/>📁 Format: JSONL + zstd<br/>⏱️ Retention: 90 days<br/>✅ Validation: None<br/>📍 Path: bronze/v1/<br/>{provider}/{entity}/{date}/")]
    end

    subgraph Silver_Layer["Silver Layer"]
        direction TB
        SilverWriter["SilverWriter<br/><br/><br/><br/><br/><br/>"]
        Silver[("Silver Storage<br/>━━━━━━━━━━━━━━━<br/>📁 Format: Delta Lake<br/>⏱️ Retention: Permanent<br/>✅ Validation: Pandera (soft<br/>)\n🔄 Strategy: Merge/Upsert\n🔑 Key: content_hash<br/>")]
    end

    subgraph Gold_Layer["Gold Layer"]
        direction TB
        GoldWriter["GoldWriter<br/><br/><br/><br/><br/><br/>"]
        Gold[("Gold Storage<br/>━━━━━━━━━━━━━━━<br/>📁 Format: Delta/Parquet<br/>⏱️ Retention: Permanent<br/>✅ Validation: Pandera (strict<br/>)\n🔄 Strategy: SCD2/Append<br/>")]
    end

    subgraph DQ_Branch["Data Quality Branch"]
        DQValidator["DQ Validator<br/>━━━━━━━━━━━━━━━<br/>⚠️ Soft: >5% errors<br/>❌ Hard: >20% errors<br/><br/><br/>"]
    end

    subgraph Lineage["Lineage Tracking"]
    end

    %% Main flow
    ChEMBL --> BronzeWriter
    PubChem --> BronzeWriter
    UniProt --> BronzeWriter
    PubMed --> BronzeWriter
    CrossRef --> BronzeWriter
    OpenAlex --> BronzeWriter
    S2 --> BronzeWriter

    BronzeWriter --> Bronze
    Bronze --> SilverWriter

    SilverWriter --> DQValidator
    DQValidator -->|"✅ Pass"| Silver
    DQValidator -->|"❌ Fail"| Quarantine

    Silver --> GoldWriter
    GoldWriter --> Gold

    %% Lineage tracking
    Bronze -.->|"batch_id"| LineageLog
    Silver -.->|"transform_version"| LineageLog

    %% Styling
    style Bronze fill:#fff7ed,stroke:#f59e0b,color:#212121
    style Silver fill:#f1f5f9,stroke:#475569,color:#212121
    style Gold fill:#fefce8,stroke:#ca8a04,color:#212121
    style Quarantine fill:#ffe4e6,stroke:#dc2626,color:#212121
    style LineageLog fill:#eff6ff,stroke:#2563eb,color:#212121
