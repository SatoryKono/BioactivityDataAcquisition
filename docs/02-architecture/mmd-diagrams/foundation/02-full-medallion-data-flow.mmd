%% Components: BronzeWriter, SilverWriter, GoldWriter, DQMonitorPort, QuarantineManager, LineageLog

%% @version 1.0.0
%% @date 2026-02-24
%% @type flowchart
%% @level Mixed (System / Component / Class)

%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform width=336 height=168 max_title_len=20 max_desc_lines=7
flowchart LR
 subgraph Sources["External Sources"]
 ChEMBL["ChEMBL API"\]
 PubChem["PubChem API"\]
 UniProt["UniProt API"\]
 PubMed["PubMed API"\]
 CrossRef["CrossRef API"\]
 OpenAlex["OpenAlex API"\]
 S2["Semantic Scholar API"\]
 end

 subgraph Bronze_Layer["Bronze Layer"]
 direction TB
 BronzeWriter["BronzeWriter"\]
 Bronze[("Bronze Storage<br/>-----------------<br/> Format: JSONL + zstd<br/>⏱️ Retention: 90 days<br/>[OK] Validation: None<br/>📍 Path: bronze/v1/<br/>{provider}/{entity}/{date}/")]
 end

 subgraph Silver_Layer["Silver Layer"]
 direction TB
 SilverWriter["SilverWriter"\]
 Silver[("Silver Storage<br/>-----------------<br/> Format: Delta Lake<br/>⏱️ Retention: Permanent<br/>[OK] Validation: Pandera (soft<br/>)\n🔄 Strategy: Merge/Upsert\n🔑 Key: content_hash<br/>")]
 end

 subgraph Gold_Layer["Gold Layer"]
 direction TB
 GoldWriter["GoldWriter"\]
 Gold[("Gold Storage<br/>-----------------<br/> Format: Delta/Parquet<br/>⏱️ Retention: Permanent<br/>[OK] Validation: Pandera (strict<br/>)\n🔄 Strategy: SCD2/Append<br/>")]
 end

 subgraph DQ_Branch["Data Quality Branch"]
 DQValidator["DQ Validator<br/>-----------------<br/>[!] Soft: >5% errors<br/>[X] Hard: >20% errors"\]
 end

 subgraph Lineage["Lineage Tracking"]
 end

 %% Main flow
 ChEMBL --> BronzeWriter
 PubChem --> BronzeWriter
 UniProt --> BronzeWriter
 PubMed --> BronzeWriter
 CrossRef --> BronzeWriter
 OpenAlex --> BronzeWriter
 S2 --> BronzeWriter

 BronzeWriter --> Bronze
 Bronze --> SilverWriter

 SilverWriter --> DQValidator
 DQValidator -->|"[OK] Pass"| Silver
 DQValidator -->|"[X] Fail"| Quarantine

 Silver --> GoldWriter
 GoldWriter --> Gold

 %% Lineage tracking
 Bronze -.->|"batch_id"| LineageLog
 Silver -.->|"version"| LineageLog

 %% Styling
 style Bronze fill:#fff7ed,stroke:#f59e0b,color:#212121
 style Silver fill:#f1f5f9,stroke:#475569,color:#212121
 style Gold fill:#fefce8,stroke:#ca8a04,color:#212121
 style Quarantine fill:#ffe4e6,stroke:#dc2626,color:#212121
 style LineageLog fill:#eff6ff,stroke:#2563eb,color:#212121

 %% linkStyle: default for all edges
 linkStyle default stroke:#1e293b,stroke-width:1.5px
