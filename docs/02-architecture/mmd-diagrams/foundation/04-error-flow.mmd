%% Updated: 2026-02-17
%% Components: ErrorClassifier, QuarantineManager, RecordProcessor, BatchTransformer

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)
%% @nodes   19

%%{init: {'layout': 'elk', 'theme': 'base', 'themeVariables': {'fontFamily': 'Inter, Roboto, sans-serif'}, 'elk': {'mergeEdges': true, 'nodePlacementStrategy': 'BRANDES_KOEPF', 'cycleBreakingStrategy': 'GREEDY', 'spacing.nodeNode': 40, 'spacing.edgeNode': 30, 'spacing.edgeEdge': 20, 'edgeRouting': 'POLYLINE'}}}%%
flowchart TD
    subgraph Pipeline["Pipeline Execution"]
        B -->|Pass| C[BatchTransformer<br/>normalize & enrich]
        B -->|Fail| Classify

        C --> D{Silver DQ<br/>Validation}
        D -->|Pass| E[SilverWriter<br/>Delta merge]
        D -->|Fail| Classify

        E --> F{Gold DQ<br/>Validation}
        F -->|Pass| G[GoldWriter<br/>SCD2 write]
        F -->|Fail| Classify

        G --> H[Record committed]
    end

    subgraph Classification["Error Classification (§3.1)"]
        Classify{ErrorClassifier} -->|"CriticalError<br/>(infra failure)"| Critical
        Classify -->|"RecoverableError<br/>(transient)"| Retry
        Classify -->|"DataQualityError<br/>(bad data)"| DQ
    end

    subgraph ErrorHandling["Error Handling"]
        RetryCheck -->|No| A
        RetryCheck -->|Yes| DQ
    end

    subgraph Quarantine["Quarantine (§2.3)"]
        QMeta --> QLog[Log WARNING<br/>+ DQ metrics]
        QLog --> Continue[Continue<br/>pipeline]
    end

    %% Styling
    classDef success fill:#f0fdf4,stroke:#16a34a
    classDef error fill:#ffe4e6,stroke:#dc2626
    classDef quarantine fill:#fff7ed,stroke:#f59e0b
    classDef classify fill:#eff6ff,stroke:#2563eb

    class H,G success
    class Critical,LogCritical error
    class QWrite,QMeta,QLog,DQ quarantine
    class Classify classify
