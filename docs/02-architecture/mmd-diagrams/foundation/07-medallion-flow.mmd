%% Title: Medallion Data Flow (Sources → Bronze → Silver → Gold)
%% Covers: RULES.md §2.1 (Medallion Architecture), §2.8 (Transformation)
%% Updated: 2026-02-17
%% Components: BronzeWriter, SilverWriter, GoldWriter, ChEMBL, PubChem, UniProt, PubMed

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)
%% @uniform width=296 height=72 max_title_len=32 max_desc_lines=2

flowchart LR
%% keep-orphan: B, G, S
    subgraph Sources["External Sources"]
        ChEMBL[(ChEMBL API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;)]
        PubChem[(PubChem API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;)]
        UniProt[(UniProt API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;)]
        PubMed[(PubMed API&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;)]
    end

    subgraph Bronze["Bronze Layer"]
        direction TB
        BronzeWriter[BronzeWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;]
        BronzeData[("JSONL + zstd&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Append-only<br/>90d retention")]

        BronzeWriter --> BronzeData
    end

    subgraph Silver["Silver Layer"]
        direction TB
        SilverWriter[SilverWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;]
        SilverData[("Delta Lake&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>Merge/Upsert<br/>ACID transactions")]

        SilverWriter --> SilverData
    end

    subgraph Gold["Gold Layer"]
        direction TB
        GoldWriter[GoldWriter&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;]
        GoldData[("Delta Lake&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>SCD Type 2<br/>Analytics-ready")]

        GoldWriter --> GoldData
    end

    %% Data Flow
    ChEMBL --> BronzeWriter
    PubChem --> BronzeWriter
    UniProt --> BronzeWriter
    PubMed --> BronzeWriter

    BronzeData --> |Transform| SilverWriter
    SilverData --> |Validate| GoldWriter

    %% Annotations
    subgraph Legend["Data Characteristics"]
        B["Bronze: Raw, immutable&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        S["Silver: Normalized, deduplicated<br/>&nbsp;<br/>&nbsp;"]
        G["Gold: Validated, flattened&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    %% Styling
    classDef source fill:#e3f2fd,stroke:#1976d2
    classDef bronze fill:#fff8e1,stroke:#ffa000
    classDef silver fill:#e8eaf6,stroke:#3f51b5
    classDef gold fill:#fff3e0,stroke:#ff9800

    class ChEMBL,PubChem,UniProt,PubMed source
    class BronzeWriter,BronzeData bronze
    class SilverWriter,SilverData silver
    class GoldWriter,GoldData gold
