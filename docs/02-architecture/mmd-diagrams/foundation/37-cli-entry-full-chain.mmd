%% Title: CLI Entry Point to Pipeline Execution Full Chain
%% Covers: RULES.md §1.1 (Interfaces Layer), interfaces/cli/
%% Rank: 12 (Score 8.31) — From click command to exit code
%% Updated: 2026-02-17

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform width=264 height=162 max_title_len=28 max_desc_lines=7
flowchart TB
    subgraph CLI["Interfaces Layer (Click)"]
        CMD["$ bioetl run chembl_activity\n--run-type incremental\n--batch-size 1000"]
        PARSE["Parse CLI Arguments<br/>• pipeline_name<br/>• run_type (RunType enum)<br/>• batch_size, resume flag<br/>"]
        OPTS["Build RunOptions<br/>• pipeline_name<br/>• run_type<br/>• batch_size<br/>• resume: bool<br/>"]
    end

    subgraph Service["Application Service Layer"]
        PRS["PipelineRunnerService.run()<br/>• lookup pipeline in registry<br/>• validate run options<br/>"]
        RESOLVE["PipelineRegistry.get(name)<br/>→ PipelineFactoryPort<br/>"]
    end

    subgraph Bootstrap["Composition Layer"]
        BOOT["bootstrap_pipeline()<br/>→ assembly.py<br/>"]
        ASSEMBLE["Full Assembly Sequence<br/>1. Logger<br/>2. Config<br/>3. Storage<br/>4. HTTP Client<br/>5. Adapter<br/>6. Services<br/>7. Runner"]
    end

    subgraph Execute["Application Core"]
        OBS_ENTER["PipelineObserver.__enter__()<br/>→ log started, inc counter<br/>"]
        RUNNER["PipelineRunner.run()<br/>"]
        LOCK["LockManager.acquire()<br/>→ HeartbeatTask.start()<br/>"]
        PRE["PreflightService.run()<br/>→ PreflightReport<br/>"]
        BATCH["BatchExecutor loop<br/>→ extract/transform/validate/write<br/>"]
        POST["PostrunService.run()<br/>→ vacuum, DQ report<br/>"]
        UNLOCK["LockManager.release()<br/>→ HeartbeatTask.stop()<br/>"]
        OBS_EXIT["PipelineObserver.__exit__()<br/>→ observe duration<br/>"]
    end

    subgraph Result["Result & Exit"]
        RES_OK["RunResult(status=SUCCESS)<br/>PipelineRunResult.SUCCESS<br/>"]
        RES_FAIL["RunResult(status=FAILED)<br/>PipelineRunResult.FAILED<br/>"]
        EXIT_OK["ExitCode.SUCCESS (0)<br/>"]
        EXIT_ERR["ExitCode.PIPELINE_ERROR (1)<br/>ExitCode.CONFIG_ERROR (2)<br/>"]
    end

    %% Flow
    CMD --> PARSE --> OPTS
    OPTS --> PRS
    PRS --> RESOLVE
    RESOLVE --> BOOT --> ASSEMBLE

    ASSEMBLE --> OBS_ENTER
    OBS_ENTER --> RUNNER
    RUNNER --> LOCK --> PRE

    PRE -->|"pass"| BATCH
    PRE -->|"fail"| RES_FAIL

    BATCH --> POST --> UNLOCK --> OBS_EXIT

    OBS_EXIT -->|"success"| RES_OK
    OBS_EXIT -->|"error"| RES_FAIL

    LOCK -->|"LockAcquisitionError"| RES_FAIL
    BATCH -->|"LockLostError"| RES_FAIL

    RES_OK --> EXIT_OK
    RES_FAIL --> EXIT_ERR

    %% Styling
    style CLI fill:#f3e5f5,stroke:#6a1b9a
    style Bootstrap fill:#fce4ec,stroke:#c62828
    style Execute fill:#e3f2fd,stroke:#1565c0
    style Result fill:#e8f5e9,stroke:#2e7d32
