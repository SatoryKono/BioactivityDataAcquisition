%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
flowchart TB
    subgraph CLI["Interfaces Layer (Click)"]
        CMD["$ bioetl run chembl_activity\n--run-type incremental\n--batch-size 1000"]
        PARSE["Parse CLI Arguments\n• pipeline_name\n• run_type (RunType enum)\n• batch_size, resume flag"]
        OPTS["Build RunOptions\n• pipeline_name\n• run_type\n• batch_size\n• resume: bool"]
    end

    subgraph Service["Application Service Layer"]
        PRS["PipelineRunnerService.run()\n• lookup pipeline in registry\n• validate run options"]
        RESOLVE["PipelineRegistry.get(name)\n→ PipelineFactoryPort"]
    end

    subgraph Bootstrap["Composition Layer"]
        BOOT["bootstrap_pipeline()\n→ assembly.py"]
        ASSEMBLE["Full Assembly Sequence\n1. Logger\n2. Config\n3. Storage\n4. HTTP Client\n5. Adapter\n6. Services\n7. Runner"]
    end

    subgraph Execute["Application Core"]
        OBS_ENTER["PipelineObserver.__enter__()\n→ log started, inc counter"]
        RUNNER["PipelineRunner.run()"]
        LOCK["LockManager.acquire()\n→ HeartbeatTask.start()"]
        PRE["PreflightService.run()\n→ PreflightReport"]
        BATCH["BatchExecutor loop\n→ extract/transform/validate/write"]
        POST["PostrunService.run()\n→ vacuum, DQ report"]
        UNLOCK["LockManager.release()\n→ HeartbeatTask.stop()"]
        OBS_EXIT["PipelineObserver.__exit__()\n→ observe duration"]
    end

    subgraph Result["Result & Exit"]
        RES_OK["RunResult(status=SUCCESS)\nPipelineRunResult.SUCCESS"]
        RES_FAIL["RunResult(status=FAILED)\nPipelineRunResult.FAILED"]
        EXIT_OK["ExitCode.SUCCESS (0)"]
        EXIT_ERR["ExitCode.PIPELINE_ERROR (1)\nExitCode.CONFIG_ERROR (2)"]
    end

    %% Flow
    CMD --> PARSE --> OPTS
    OPTS --> PRS
    PRS --> RESOLVE
    RESOLVE --> BOOT --> ASSEMBLE

    ASSEMBLE --> OBS_ENTER
    OBS_ENTER --> RUNNER
    RUNNER --> LOCK --> PRE

    PRE -->|"pass"| BATCH
    PRE -->|"fail"| RES_FAIL

    BATCH --> POST --> UNLOCK --> OBS_EXIT

    OBS_EXIT -->|"success"| RES_OK
    OBS_EXIT -->|"error"| RES_FAIL

    LOCK -->|"LockAcquisitionError"| RES_FAIL
    BATCH -->|"LockLostError"| RES_FAIL

    RES_OK --> EXIT_OK
    RES_FAIL --> EXIT_ERR

