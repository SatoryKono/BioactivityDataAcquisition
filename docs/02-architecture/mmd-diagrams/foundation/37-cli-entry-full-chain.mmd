flowchart TB
    subgraph CLI["Interfaces Layer (Click)"]
        CMD["$ bioetl run chembl_activity\n--run-type incremental\n--batch-size 1000"]
        PARSE["Parse CLI Arguments&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>• pipeline_name<br/>• run_type (RunType enum)<br/>• batch_size, resume flag<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        OPTS["Build RunOptions&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>• pipeline_name<br/>• run_type<br/>• batch_size<br/>• resume: bool<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Service["Application Service Layer"]
        PRS["PipelineRunnerService.run()&nbsp;<br/>• lookup pipeline in registry<br/>• validate run options<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        RESOLVE["PipelineRegistry.get(name)&nbsp;&nbsp;<br/>→ PipelineFactoryPort<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Bootstrap["Composition Layer"]
        BOOT["bootstrap_pipeline()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>→ assembly.py<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        ASSEMBLE["Full Assembly Sequence&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>1. Logger<br/>2. Config<br/>3. Storage<br/>4. HTTP Client<br/>5. Adapter<br/>6. Services<br/>7. Runner"]
    end

    subgraph Execute["Application Core"]
        OBS_ENTER["PipelineObserver.__enter__()<br/>→ log started, inc counter<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        RUNNER["PipelineRunner.run()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        LOCK["LockManager.acquire()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>→ HeartbeatTask.start()<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        PRE["PreflightService.run()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>→ PreflightReport<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        BATCH["BatchExecutor loop&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>→ extract/transform/validate/write<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        POST["PostrunService.run()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>→ vacuum, DQ report<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        UNLOCK["LockManager.release()&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>→ HeartbeatTask.stop()<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        OBS_EXIT["PipelineObserver.__exit__()&nbsp;<br/>→ observe duration<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    subgraph Result["Result & Exit"]
        RES_OK["RunResult(status=SUCCESS)&nbsp;&nbsp;&nbsp;<br/>PipelineRunResult.SUCCESS<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        RES_FAIL["RunResult(status=FAILED)&nbsp;&nbsp;&nbsp;&nbsp;<br/>PipelineRunResult.FAILED<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        EXIT_OK["ExitCode.SUCCESS (0)&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
        EXIT_ERR["ExitCode.PIPELINE_ERROR (1)&nbsp;<br/>ExitCode.CONFIG_ERROR (2)<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;<br/>&nbsp;"]
    end

    %% Flow
    CMD --> PARSE --> OPTS
    OPTS --> PRS
    PRS --> RESOLVE
    RESOLVE --> BOOT --> ASSEMBLE

    ASSEMBLE --> OBS_ENTER
    OBS_ENTER --> RUNNER
    RUNNER --> LOCK --> PRE

    PRE -->|"pass"| BATCH
    PRE -->|"fail"| RES_FAIL

    BATCH --> POST --> UNLOCK --> OBS_EXIT

    OBS_EXIT -->|"success"| RES_OK
    OBS_EXIT -->|"error"| RES_FAIL

    LOCK -->|"LockAcquisitionError"| RES_FAIL
    BATCH -->|"LockLostError"| RES_FAIL

    RES_OK --> EXIT_OK
    RES_FAIL --> EXIT_ERR

