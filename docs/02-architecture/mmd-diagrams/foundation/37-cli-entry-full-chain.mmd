%% @uniform width=712 height=184 max_title_len=71 max_desc_lines=8
flowchart TB
    subgraph CLI["Interfaces Layer (Click)"]
        CMD["bioetl run<br/>pipeline=chembl_activity<br/>run_type=incremental<br/>resume=true"]
        PARSE["Parse CLI Arguments<br/>• pipeline_name<br/>• run_type (RunType enum)<br/>• resume flag"]
        OPTS["Build RunOptions<br/>• pipeline_name<br/>• run_type<br/>• resume: bool"]
    end

    subgraph Service["Application Service Layer"]
        PRS["PipelineRunnerService.run()<br/>• lookup pipeline in registry<br/>• validate run options"]
        RESOLVE["PipelineRegistry.get(name)<br/>→ PipelineFactoryPort"]
    end

    subgraph Bootstrap["Composition Layer"]
        BOOT["bootstrap_pipeline()<br/>→ assembly.py"]
        ASSEMBLE["Full Assembly Sequence<br/>1. Logger<br/>2. Config<br/>3. Storage<br/>4. HTTP Client<br/>5. Adapter<br/>6. Services<br/>7. Runner"]
    end

    subgraph Execute["Application Core"]
        OBS_ENTER["PipelineObserver.__enter__()<br/>→ log started, inc counter"]
        RUNNER["PipelineRunner.run()"]
        LOCK["LockManager.acquire()<br/>→ HeartbeatTask.start()"]
        PRE["PreflightService.run()<br/>→ PreflightReport"]
        BATCH["BatchExecutor loop<br/>→ extract/transform/validate/write"]
        POST["PostrunService.run()<br/>→ vacuum, DQ report"]
        UNLOCK["LockManager.release()<br/>→ HeartbeatTask.stop()"]
        OBS_EXIT["PipelineObserver.__exit__()<br/>→ observe duration"]
    end

    subgraph Result["Result & Exit"]
        RES_OK["RunResult(status=SUCCESS)<br/>PipelineRunResult.SUCCESS"]
        RES_FAIL["RunResult(status=FAILED)<br/>PipelineRunResult.FAILED"]
        EXIT_OK["ExitCode.SUCCESS (0)"]
        EXIT_ERR["ExitCode.PIPELINE_ERROR (1)<br/>ExitCode.CONFIG_ERROR (2)"]
    end

    %% Flow
    CMD --> PARSE --> OPTS
    OPTS ==> PRS
    PRS --> RESOLVE
    RESOLVE --> BOOT --> ASSEMBLE

    ASSEMBLE --> OBS_ENTER
    OBS_ENTER --> RUNNER
    RUNNER --> LOCK --> PRE

    PRE -->|"pass"| BATCH
    PRE -->|"fail"| RES_FAIL

    BATCH --> POST --> UNLOCK --> OBS_EXIT

    OBS_EXIT -->|"success"| RES_OK
    OBS_EXIT -->|"error"| RES_FAIL

    LOCK -->|"lock error"| RES_FAIL
    BATCH -->|"LockLostError"| RES_FAIL

    RES_OK --> EXIT_OK
    RES_FAIL --> EXIT_ERR

    %% Styling
    style CLI fill:#f5f3ff,stroke:#7c3aed
    style Bootstrap fill:#ffe4e6,stroke:#dc2626
    style Execute fill:#eff6ff,stroke:#2563eb
    style Result fill:#f0fdf4,stroke:#16a34a
