%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%% @nodes   29
%% @uniform width=376 height=128 max_title_len=37 max_desc_lines=5
%%{init: {'layout': 'elk', 'theme': 'base', 'themeVariables': {'fontFamily': 'Inter, Roboto, sans-serif'}, 'elk': {'mergeEdges': true, 'nodePlacementStrategy': 'BRANDES_KOEPF', 'cycleBreakingStrategy': 'GREEDY', 'spacing.nodeNode': 40, 'spacing.edgeNode': 30, 'spacing.edgeEdge': 20, 'edgeRouting': 'POLYLINE'}}}%%
flowchart TB
        SS[("Seed Silver Table<br/>(e.g., chembl/publication<br/>)<br/><br/>")]

    subgraph Extract["Key Extraction"]
        KE["KeyExtractorService.extract_keys()<br/>• read seed Silver via DeltaReader<br/>• select join_key columns (doi, pmid)<br/>• deduplicate → unique key list<br/>"]
        DOIS["DOI Keys<br/>(~50,000 unique)<br/><br/><br/>"]
        PMIDS["PMID Keys<br/>(~30,000 unique)<br/><br/><br/>"]
    end

    subgraph FanOut["Fan-Out (EnrichmentCoordinator)"]
        EC["EnrichmentCoordinator.run_enrichers()<br/>• asyncio.gather(*tasks,<br/>return_exceptions=True)<br/>• timeout per enricher<br/>"]
        E1["CrossRef Enricher<br/>filter_ids = DOIs<br/>required = true<br/>timeout = 3600s<br/>"]
        E2["PubMed Enricher<br/>filter_ids = PMIDs<br/>required = true<br/>timeout = 3600s<br/>"]
        E3["OpenAlex Enricher<br/>filter_ids = DOIs<br/>required = false<br/>timeout = 1800s<br/>"]
        E4["SemanticScholar Enricher<br/>filter_ids = DOIs<br/>required = false<br/>timeout = 1800s<br/>"]
    end

    subgraph Results["Enricher Silver Tables"]
        R1[("crossref/publication/"<br/>)]
        R2[("pubmed/publication/"<br/>)]
        R3[("openalex/publication/"<br/>)]
        R4[("semanticscholar/publication/"<br/>)]
    end

    subgraph FanIn["Fan-In (MergeService)"]
        DD["EnricherDeduplicator<br/>• remove duplicates<br/>across enrichers<br/><br/>"]
        MS["MergeService.merge()<br/>• LEFT OUTER JOIN<br/>seed ⟕ enrichers<br/>• ConflictResolution<br/>(coalesce: first non-null)"]
        CO["ColumnOrderer<br/>• FieldGroup priority<br/>• exclude TRASH group<br/><br/>"]
    end

    subgraph Output["Gold Output"]
        GW["GoldWriter.write_gold()<br/>CompositePublicationGoldSchema<br/><br/><br/>"]
        GT[("gold/composite/publication/"<br/>)]
    end

    %% Flow
    SS --> KE
    KE --> DOIS & PMIDS

    DOIS --> EC
    PMIDS --> EC
    EC -->|"parallel"| E1 & E2 & E3 & E4

    E1 --> R1
    E2 --> R2
    E3 --> R3
    E4 --> R4

    R1 & R2 & R3 & R4 --> DD
    DD --> MS
    SS -->|"seed data"| MS
    MS --> CO --> GW --> GT

    %% Error handling
    E3 -.->|"timeout/fail\n(required=false)"| EC
    E4 -.->|"timeout/fail\n(required=false)"| EC

    %% Styling
    style FanOut fill:#ffffff,stroke:#2563eb,stroke-width:2px
    style FanIn fill:#ffffff,stroke:#dc2626,stroke-width:2px
    style Output fill:#ffffff,stroke:#ca8a04,stroke-width:2px
