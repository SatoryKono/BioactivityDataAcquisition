%% Title: Fan-Out/Fan-In Pattern — Composite Pipeline Enrichment
%% Covers: ADR-026 (Composite Pipeline Pattern), application/composite/
%% Rank: 18 (Score 8.00) — Parallel enrichment via asyncio.gather
%% Updated: 2026-02-17

%% @version 1.0.0
%% @date 2026-02-24
%% @type flowchart
%% @level Mixed (System / Component / Class)

%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform width=376 height=128 max_title_len=37 max_desc_lines=5
flowchart TB
 subgraph Seed["Seed Pipeline Result"]
 SS[("Seed Silver Table<br/>(e.g., chembl/publication<br/>)<br/><br/>")]
 end

 subgraph Extract["Key Extraction"]
 KE["KeyExtractorService.extract_keys()<br/>• read seed Silver via DeltaReader<br/>• select join_key columns (doi, pmid)<br/>• deduplicate → unique key list"\]
 DOIS["DOI Keys<br/>(~50,000 unique)"\]
 PMIDS["PMID Keys<br/>(~30,000 unique)"\]
 end

 subgraph FanOut["Fan-Out (EnrichmentCoordinator)"]
 EC["EnrichmentCoordinator.run_enrichers()<br/>• asyncio.gather(*tasks,<br/>return_exceptions=True)<br/>• timeout per enricher"\]
 E1["CrossRef Enricher<br/>filter_ids = DOIs<br/>required = true<br/>timeout = 3600s"\]
 E2["PubMed Enricher<br/>filter_ids = PMIDs<br/>required = true<br/>timeout = 3600s"\]
 E3["OpenAlex Enricher<br/>filter_ids = DOIs<br/>required = false<br/>timeout = 1800s"\]
 E4["SemanticScholar Enricher<br/>filter_ids = DOIs<br/>required = false<br/>timeout = 1800s"\]
 end

 subgraph Results["Enricher Silver Tables"]
 R1[("crossref/publication/"<br/>)]
 R2[("pubmed/publication/"<br/>)]
 R3[("openalex/publication/"<br/>)]
 R4[("semanticscholar/publication/"<br/>)]
 end

 subgraph FanIn["Fan-In (MergeService)"]
 DD["EnricherDeduplicator<br/>• remove duplicates<br/>across enrichers"\]
 MS["MergeService.merge()<br/>• LEFT OUTER JOIN<br/>seed ⟕ enrichers<br/>• ConflictResolution<br/>(coalesce: first non-null)"]
 CO["ColumnOrderer<br/>• FieldGroup priority<br/>• exclude TRASH group"\]
 end

 subgraph Output["Gold Output"]
 GW["GoldWriter.write_gold()<br/>CompositePublicationGoldSchema"\]
 GT[("gold/composite/publication/"<br/>)]
 end

 %% Flow
 SS --> KE
 KE --> DOIS & PMIDS

 DOIS --> EC
 PMIDS --> EC
 EC -->|"parallel"| E1 & E2 & E3 & E4

 E1 --> R1
 E2 --> R2
 E3 --> R3
 E4 --> R4

 R1 & R2 & R3 & R4 --> DD
 DD --> MS
 SS -->|"seed data"| MS
 MS --> CO --> GW --> GT

 %% Error handling
 E3 -.->|"timeout/fail"| EC
 E4 -.->|"timeout/fail"| EC

 %% Styling
 style FanOut fill:#eff6ff,stroke:#2563eb
 style FanIn fill:#ffe4e6,stroke:#dc2626
 style Output fill:#fefce8,stroke:#ca8a04,color:#212121
