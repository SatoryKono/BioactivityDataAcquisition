%% Title: Fan-Out/Fan-In Pattern — Composite Pipeline Enrichment
%% Covers: ADR-026 (Composite Pipeline Pattern), application/composite/
%% Rank: 18 (Score 8.00) — Parallel enrichment via asyncio.gather
%% Updated: 2026-02-17

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
flowchart TB
    subgraph Seed["Seed Pipeline Result"]
        SS[("Seed Silver Table\n(e.g., chembl/publication)")]
    end

    subgraph Extract["Key Extraction"]
        KE["KeyExtractorService.extract_keys()\n• read seed Silver via DeltaReader\n• select join_key columns (doi, pmid)\n• deduplicate → unique key list"]
        DOIS["DOI Keys\n(~50,000 unique)"]
        PMIDS["PMID Keys\n(~30,000 unique)"]
    end

    subgraph FanOut["Fan-Out (EnrichmentCoordinator)"]
        EC["EnrichmentCoordinator.run_enrichers()\n• asyncio.gather(*tasks,\n  return_exceptions=True)\n• timeout per enricher"]
        E1["CrossRef Enricher\nfilter_ids = DOIs\nrequired = true\ntimeout = 3600s"]
        E2["PubMed Enricher\nfilter_ids = PMIDs\nrequired = true\ntimeout = 3600s"]
        E3["OpenAlex Enricher\nfilter_ids = DOIs\nrequired = false\ntimeout = 1800s"]
        E4["SemanticScholar Enricher\nfilter_ids = DOIs\nrequired = false\ntimeout = 1800s"]
    end

    subgraph Results["Enricher Silver Tables"]
        R1[("crossref/publication/")]
        R2[("pubmed/publication/")]
        R3[("openalex/publication/")]
        R4[("semanticscholar/publication/")]
    end

    subgraph FanIn["Fan-In (MergeService)"]
        DD["EnricherDeduplicator\n• remove duplicates\n  across enrichers"]
        MS["MergeService.merge()\n• LEFT OUTER JOIN\n  seed ⟕ enrichers\n• ConflictResolution\n  (coalesce: first non-null)"]
        CO["ColumnOrderer\n• FieldGroup priority\n• exclude TRASH group"]
    end

    subgraph Output["Gold Output"]
        GW["GoldWriter.write_gold()\nCompositePublicationGoldSchema"]
        GT[("gold/composite/publication/")]
    end

    %% Flow
    SS --> KE
    KE --> DOIS & PMIDS

    DOIS --> EC
    PMIDS --> EC
    EC -->|"parallel"| E1 & E2 & E3 & E4

    E1 --> R1
    E2 --> R2
    E3 --> R3
    E4 --> R4

    R1 & R2 & R3 & R4 --> DD
    DD --> MS
    SS -->|"seed data"| MS
    MS --> CO --> GW --> GT

    %% Error handling
    E3 -.->|"timeout/fail\n(required=false)"| EC
    E4 -.->|"timeout/fail\n(required=false)"| EC

    %% Styling
    style FanOut fill:#e3f2fd,stroke:#1565c0
    style FanIn fill:#fce4ec,stroke:#c62828
    style Output fill:#FFD700,stroke:#ccac00,color:#000
