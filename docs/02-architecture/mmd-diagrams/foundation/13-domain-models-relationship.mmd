    %% Inheritance from BaseEntity
    BaseEntity <|-- Activity : extends
    BaseEntity <|-- Assay : extends
    BaseEntity <|-- Target : extends
    BaseEntity <|-- Molecule : extends
    BaseEntity <|-- PublicationEntityBase : extends
    BaseEntity <|-- UniprotTarget : extends
    BaseEntity <|-- PubchemMolecule : extends

    %% Publication hierarchy
    PublicationEntityBase <|-- ChemblPublication : extends
    PublicationEntityBase <|-- PubMedPublication : extends
    PublicationEntityBase <|-- CrossRefPublication : extends
    PublicationEntityBase <|-- OpenAlexPublication : extends
    PublicationEntityBase <|-- SemanticScholarPublication : extends

    %% ChEMBL Entity Relationships
    Activity --> Assay : assay_id
    Activity --> Molecule : molecule_id
    Activity --> Target : target_id (nullable)
    Assay --> Target : target_id (nullable)
    Assay --> ChemblPublication : document_chembl_id (nullable)
    Molecule --> Molecule : parent_molecule_id (self-ref)

    %% Cross-provider relationships (conceptual)
    Target ..> UniprotTarget : uniprot_accessions
    Molecule ..> PubchemMolecule : inchikey match
    ChemblPublication ..> PubMedPublication : pmid match
    ChemblPublication ..> CrossRefPublication : doi match
    OpenAlexPublication ..> PubMedPublication : pmid match
    SemanticScholarPublication ..> PubMedPublication : pmid match

    %% Notes
    note for BaseEntity "All entities inherit lineage fields:\n- entity_id (business key)\n- content_hash (SHA256)\n- run_id (correlation)\n- run_type (INCREMENTAL|BACKFILL|REBUILD)\n- ingestion_ts (timestamp)"

    note for PublicationEntityBase "Unified publication fields (ADR-024):\n- Cross-ref IDs: pmid, doi, pmc_id\n- Metrics: citations_received, citations_made\n- Year range: 1500-2100\n- ORCID validation: author_orcids"

    note for QuarantineRecord "Failed records during DQ validation\nRetention: 30 days\nStates: NEW -> IGNORED | REPROCESSED"
