    subgraph Hexagon["Domain Layer — Ports (Protocol)"]
        direction TB

        subgraph DataPorts["Data Ports"]
            DSP["DataSourcePort\n• fetch() → AsyncIterator\n• health_check() → HealthStatus"]
            FDSP["FilterableDataSourcePort\n• fetch_filtered()"]
            SP["StoragePort\n• write_bronze()\n• write_silver()\n• write_gold()"]
            DRP["DeltaReaderPort\n• read_table()\n• get_schema()"]
        end

        subgraph CoordPorts["Coordination Ports"]
            LP["LockPort\n• acquire()\n• release()\n• renew()"]
            CPP["CheckpointPort\n• save()\n• load()\n• delete()"]
            QP["QuarantinePort\n• write()\n• read_sample()\n• purge()"]
        end

        subgraph ObsPorts["Observability Ports"]
            LGP["LoggerPort\n• info() / warning()\n• error() / debug()\n• bind()"]
            MP["MetricsPort\n• increment_counter()\n• observe_histogram()\n• set_gauge()"]
            TP["TracingPort\n• get_tracer()\n• start_span()"]
            DQM["DQMonitorPort\n• record_metrics()"]
        end

        subgraph QualityPorts["Quality & Security Ports"]
            SVP["SilverValidatorPort\n• validate()"]
            GVP["GoldValidatorPort\n• validate()"]
            PIIP["PiiHasherPort\n• hash_field()"]
            INP["InputFilterPort\n• filter()"]
        end

        subgraph MetaPorts["Metadata & Config Ports"]
            MWP["MetadataWriterPort\n• write()"]
