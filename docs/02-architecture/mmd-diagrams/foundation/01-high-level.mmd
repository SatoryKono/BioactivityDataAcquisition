%% Title: High-Level System Architecture
%% Covers: RULES.md §1.1 (Five-Layer Architecture)
%% Updated: 2026-02-17
%% Components: CLI, Bootstrap, PipelineFactory, PipelineRunner, BaseTransformer, BaseHttpAdapter, StoragePort

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
flowchart TD
    subgraph Sources["External Data Sources"]
        A1[ChEMBL API]
        A2[PubChem API]
        A3[UniProt API]
        A4[PubMed API]
        A5[CrossRef API]
        A6[OpenAlex API]
        A7[Semantic Scholar API]
    end

    subgraph Interfaces["Interfaces Layer"]
        CLI["CLI (Click)"]
    end

    subgraph Composition["Composition Layer"]
        Boot[bootstrap_pipeline]
        Factory[PipelineFactory]
    end

    subgraph Application["Application Layer"]
        Runner[PipelineRunner]
        Executor[PipelineExecutor]
        Trans[BaseTransformer]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        Adapters[HTTP Adapters<br/>7 providers]
        Storage[Storage Writers]
    end

    subgraph Lake["Data Lake — Local Storage"]
        Bronze["Bronze Layer<br/>(JSONL + zstd)"]
        Silver["Silver Layer<br/>(Delta Lake)"]
        Gold["Gold Layer<br/>(Delta Lake)"]
        Quarantine["Quarantine<br/>(failed records)"]
    end

    Sources --> Adapters
    CLI --> Boot
    Boot --> Factory
    Factory --> Runner
    Runner --> Executor
    Executor --> Trans
    Trans --> Adapters
    Storage --> Bronze
    Storage --> Silver
    Storage --> Gold
    Trans -.->|DQ failure| Quarantine
    Executor --> Storage

    %% Styling — Medallion color scheme per diagramming policy §4.3
    classDef source fill:#e3f2fd,stroke:#2196F3,color:#0d47a1
    classDef iface fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef comp fill:#fff3e0,stroke:#e65100,color:#bf360c
    classDef app fill:#e8f5e9,stroke:#388e3c,color:#1b5e20
    classDef infra fill:#ffcdd2,stroke:#c62828,color:#b71c1c
    classDef bronze fill:#fff8e1,stroke:#FFA500,color:#e65100
    classDef silver fill:#eceff1,stroke:#607d8b,color:#263238
    classDef gold fill:#fff8e1,stroke:#FFD700,color:#f57f17
    classDef quarantine fill:#ffebee,stroke:#FF6B6B,color:#b71c1c

    class A1,A2,A3,A4,A5,A6,A7 source
    class CLI iface
    class Boot,Factory comp
    class Runner,Executor,Trans app
    class Adapters,Storage infra
    class Bronze bronze
    class Silver silver
    class Gold gold
    class Quarantine quarantine
