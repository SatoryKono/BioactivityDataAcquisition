%% Title: High-Level System Architecture
%% Covers: RULES.md §1.1 (Five-Layer Architecture)
%% Updated: 2026-02-17
%% Components: CLI, Bootstrap, PipelineFactory, PipelineRunner, BaseTransformer, BaseHttpAdapter, StoragePort

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {'theme': 'base', 'themeVariables': {'lineWidth': '2'}}}%%
%% @uniform width=200 height=56 max_title_len=20 max_desc_lines=1
flowchart TD
    subgraph Sources["External Data Sources"]
    end

    subgraph Interfaces["Interfaces Layer"]
        CLI["CLI (Click)<br/>"]
    end

    subgraph Composition["Composition Layer"]
        Boot[bootstrap_pipeline<br/>]
        Factory[PipelineFactory<br/>]
    end

    subgraph Application["Application Layer"]
        Runner[PipelineRunner<br/>]
        Executor[PipelineExecutor<br/>]
        Trans[BaseTransformer<br/>]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        Adapters[HTTP Adapters<br/>7 providers]
        Storage[Storage Writers<br/>]
    end

    subgraph Lake["Data Lake — Local Storage"]
        Bronze["Bronze Layer<br/>(JSONL + zstd)"]
        Silver["Silver Layer<br/>(Delta Lake)"]
        Gold["Gold Layer<br/>(Delta Lake)"]
    end

    Sources --> Adapters
    CLI --> Boot
    Boot --> Factory
    Factory --> Runner
    Runner --> Executor
    Executor --> Trans
    Trans --> Adapters
    Storage --> Bronze
    Storage --> Silver
    Storage --> Gold
    Trans -.->|DQ failure| Quarantine
    Executor --> Storage

    %% Styling — Medallion color scheme per diagramming policy §4.3
    classDef source fill:#e3f2fd,stroke:#1565c0,color:#212121
    classDef iface fill:#e3f2fd,stroke:#1565c0,color:#212121
    classDef comp fill:#fff3e0,stroke:#e65100,color:#212121
    classDef app fill:#e8f5e9,stroke:#2e7d32,color:#212121
    classDef infra fill:#ffcdd2,stroke:#c62828,color:#212121
    classDef bronze fill:#fff3e0,stroke:#e65100,color:#212121
    classDef silver fill:#eceff1,stroke:#607d8b,color:#212121
    classDef gold fill:#fff8e1,stroke:#f9a825,color:#212121
    classDef quarantine fill:#ffebee,stroke:#c62828,color:#212121

    class A1,A2,A3,A4,A5,A6,A7 source
    class CLI iface
    class Boot,Factory comp
    class Runner,Executor,Trans app
    class Adapters,Storage infra
    class Bronze bronze
    class Silver silver
    class Gold gold
    class Quarantine quarantine
