{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$version": "1.0.0",
    "title": "Assay Data Contract",
    "description": "Defines the schema for the gold 'Assay' entity, aligned with RULES.md §7.1. This contract is for data consumers.",
    "type": "object",
    "properties": {
        "assay_chembl_id": {
            "type": "string",
            "description": "Unique ChEMBL identifier for the assay.",
            "pattern": "^CHEMBL\\d+$"
        },
        "target_chembl_id": {
            "type": ["string", "null"],
            "description": "ChEMBL ID of the biological target."
        },
        "document_chembl_id": {
            "type": ["string", "null"],
            "description": "ChEMBL ID of the source publication."
        },
        "assay_type": {
            "type": "string",
            "description": "Type code: B (Binding), F (Functional), A (ADMET), T (Toxicity), P (Physicochemical), U (Unassigned).",
            "enum": ["B", "F", "A", "T", "P", "U"]
        },
        "assay_type_description": {
            "type": ["string", "null"],
            "description": "Full description of the assay type."
        },
        "assay_organism": {
            "type": ["string", "null"],
            "description": "Organism name (e.g., Homo sapiens)."
        },
        "confidence_score": {
            "type": ["integer", "null"],
            "description": "Confidence score (0-9).",
            "minimum": 0,
            "maximum": 9
        },
        "confidence_description": {
            "type": ["string", "null"],
            "description": "Description of the confidence level."
        },
        "description": {
            "type": ["string", "null"],
            "description": "Text description of the assay."
        },
        "bao_format": {
            "type": ["string", "null"],
            "description": "BioAssay Ontology format URI."
        },
        "bao_label": {
            "type": ["string", "null"],
            "description": "BioAssay Ontology label."
        },
        "assay_pref_name": {
            "type": ["string", "null"],
            "description": "Preferred assay name (if available)."
        },
        "score": {
            "type": ["number", "null"],
            "description": "Assay score (distinct from confidence_score)."
        },
        "variant_accession": {
            "type": ["string", "null"],
            "description": "UniProt accession of the variant."
        },
        "variant_isoform": {
            "type": ["string", "null"],
            "description": "Isoform identifier."
        },
        "variant_mutation": {
            "type": ["string", "null"],
            "description": "Mutation description (e.g., V600E)."
        },
        "variant_organism": {
            "type": ["string", "null"],
            "description": "Organism name for the variant."
        },
        "variant_sequence": {
            "type": ["string", "null"],
            "description": "Amino acid sequence of the variant."
        },
        "variant_tax_id": {
            "type": ["integer", "null"],
            "description": "NCBI Taxonomy ID for the variant."
        },
        "_source_batch_id": {
            "type": "string",
            "description": "Internal ID linking to the source Bronze batch for lineage.",
            "format": "uuid"
        },
        "_content_hash": {
            "type": "string",
            "description": "SHA-256 hash of the record's content for versioning and deduplication."
        },
        "_ingestion_ts": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp of when the record was ingested."
        }
    },
    "required": [
        "assay_chembl_id",
        "_content_hash",
        "_ingestion_ts"
    ]
}
