{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$version": "1.0.0",
    "title": "Target Data Contract",
    "description": "Defines the schema for the gold 'Target' entity, aligned with RULES.md §7.1. This contract is for data consumers.",
    "type": "object",
    "properties": {
        "target_chembl_id": {
            "type": "string",
            "description": "Primary ChEMBL identifier for the target.",
            "pattern": "^CHEMBL\\d+$"
        },
        "target_type": {
            "type": ["string", "null"],
            "description": "Target type classification.",
            "enum": [
                "SINGLE PROTEIN",
                "PROTEIN FAMILY",
                "PROTEIN COMPLEX",
                "PROTEIN COMPLEX GROUP",
                "SELECTIVITY GROUP",
                "CHIMERIC PROTEIN",
                "CELL-LINE",
                "TISSUE",
                "ORGANISM",
                "MACROMOLECULE",
                "SMALL MOLECULE",
                "LIPID",
                "METAL",
                "UNKNOWN",
                null
            ]
        },
        "pref_name": {
            "type": ["string", "null"],
            "description": "Preferred name of the target."
        },
        "tax_id": {
            "type": ["integer", "null"],
            "description": "NCBI Taxonomy ID."
        },
        "organism": {
            "type": ["string", "null"],
            "description": "Organism name (e.g., Homo sapiens)."
        },
        "species_group_flag": {
            "type": ["boolean", "null"],
            "description": "Whether this represents a species group."
        },
        "downgraded": {
            "type": ["boolean", "null"],
            "description": "Whether the target has been downgraded."
        },
        "component_accessions": {
            "type": ["array", "null"],
            "items": {"type": "string"},
            "description": "List of UniProt accessions for target components."
        },
        "component_ids": {
            "type": ["array", "null"],
            "items": {"type": "integer"},
            "description": "List of component IDs."
        },
        "component_types": {
            "type": ["array", "null"],
            "items": {"type": "string"},
            "description": "List of component types (e.g., PROTEIN)."
        },
        "component_relationships": {
            "type": ["array", "null"],
            "items": {"type": "string"},
            "description": "List of component relationship types."
        },
        "component_descriptions": {
            "type": ["array", "null"],
            "items": {"type": "string"},
            "description": "List of component descriptions."
        },
        "_source_batch_id": {
            "type": "string",
            "description": "Internal ID linking to the source Bronze batch for lineage.",
            "format": "uuid"
        },
        "_content_hash": {
            "type": "string",
            "description": "SHA-256 hash of the record's content for versioning and deduplication."
        },
        "_ingestion_ts": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp of when the record was ingested."
        }
    },
    "required": [
        "target_chembl_id",
        "_content_hash",
        "_ingestion_ts"
    ]
}
