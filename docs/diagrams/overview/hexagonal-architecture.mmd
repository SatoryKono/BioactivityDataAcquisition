---
title: BioETL Hexagonal Architecture
description: Ports and Adapters pattern implementation
---
flowchart TB

classDef domain fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
classDef application fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d47a1
classDef infrastructure fill:#fff3e0,stroke:#ef6c00,stroke-width:2px,color:#e65100
classDef interface fill:#fce4ec,stroke:#c2185b,stroke-width:2px,color:#880e4f
classDef external fill:#f5f5f5,stroke:#424242,stroke-width:1px,color:#212121
classDef port fill:#b2dfdb,stroke:#00897b,stroke-width:2px,color:#004d40

subgraph External["External Systems"]
    ChEMBLAPI["ChEMBL REST API"]:::external
    FileSystem["File System\n(CSV, Parquet)"]:::external
    Prometheus["Prometheus"]:::external
    User["User/CLI"]:::external
end

subgraph Interfaces["Interfaces Layer"]
    CLI["CLI\n(Typer)"]:::interface
    REST["REST API"]:::interface
    CompositionRoot["Composition Root"]:::interface
end

subgraph Application["Application Layer"]
    UseCases["Use Cases\n- RunPipeline"]:::application
    Orchestrator["Pipeline Orchestrator"]:::application
    Factories["Factories"]:::application
    Services["Services\n- Configuration\n- Schema\n- Observability"]:::application
end

subgraph Domain["Domain Layer"]
    Entities["Entities\n- Activity\n- Assay\n- Target\n- Molecule\n- Publication"]:::domain
    ValueObjects["Value Objects\n- ChemblID\n- InChIKey\n- Timestamp"]:::domain
    DomainServices["Domain Services\n- EntityFactory\n- BusinessKeyService"]:::domain

    subgraph Ports["Ports (Interfaces)"]
        ExtractionPort["ExtractionServiceABC"]:::port
        OutputPort["DataWriterPort"]:::port
        ConfigPort["ConfigLoaderPortABC"]:::port
        ValidationPort["ValidationServiceABC"]:::port
        TransformPort["TransformerABC"]:::port
    end
end

subgraph Infrastructure["Infrastructure Layer"]
    subgraph Adapters["Adapters"]
        ChemblClient["ChEMBL HTTP Client"]:::infrastructure
        CsvWriter["CSV Writer"]:::infrastructure
        ParquetWriter["Parquet Writer"]:::infrastructure
        YamlLoader["YAML Config Loader"]:::infrastructure
        PanderaValidator["Pandera Validator"]:::infrastructure
    end
end

%% External connections
User --> CLI
User --> REST
CLI --> CompositionRoot
REST --> CompositionRoot
ChemblClient --> ChEMBLAPI
CsvWriter --> FileSystem
ParquetWriter --> FileSystem
YamlLoader --> FileSystem

%% Internal connections
CompositionRoot --> UseCases
CompositionRoot --> Factories
UseCases --> Orchestrator
Orchestrator --> Services
Services --> Ports
Factories --> Adapters

%% Port-Adapter connections
ExtractionPort -.-> ChemblClient
OutputPort -.-> CsvWriter
OutputPort -.-> ParquetWriter
ConfigPort -.-> YamlLoader
ValidationPort -.-> PanderaValidator
