    class RunPipelineRequest {
        +pipeline_name: str
        +config_path: Path
        +limit: int
        +dry_run: bool
        +output_format: str
        +filters: dict
    }

    class RunPipelineResponse {
        +success: bool
        +output_path: Path
        +record_count: int
        +duration: timedelta
        +errors: list[str]
        +metadata: dict
    }

    class UseCaseABC {
        <<interface>>
        +execute(request) Response
    }

    UseCaseABC <|.. RunPipelineUseCase
    RunPipelineUseCase ..> RunPipelineRequest : accepts
    RunPipelineUseCase ..> RunPipelineResponse : returns

