---
title: Application Factories Package
description: bioetl.application.factories - Service and component factories
---
classDiagram
    direction TB

    class ApplicationServiceFactory {
        +create_validation_service() ValidationService
        +create_schema_service() SchemaBootstrapService
        +create_configuration_service() ConfigurationService
        -_config: PipelineConfig
        -_provider_registry: ProviderRegistryABC
    }

    class PipelineRuntimeFactory {
        +create_runtime_context() PipelineRuntimeContext
        +create_stage_manager() StageRuntimeManager
        +create_error_handler() StageErrorHandler
        -_hooks: list[PipelineHookABC]
        -_error_policy: ErrorPolicyABC
    }

    class PipelineHookFactory {
        +create_logging_hook() LoggingPipelineHookImpl
        +create_metrics_hook() MetricsPipelineHookImpl
        +create_all_hooks() list[PipelineHookABC]
        -_logger: Logger
        -_metrics: MetricsCollector
    }

    class TransformComponentFactory {
        +create_transformer() TransformerABC
        +create_post_transformer() TransformerABC
        +create_normalizer() NormalizationServiceABC
        -_schema_contract: PipelineSchemaModel
    }

    class RecordSourceFactory {
        +create_api_source() ApiRecordSource
        +create_csv_source() CsvRecordSourceImpl
        +create_id_list_source() IdListRecordSourceImpl
        +resolve_source(config) RecordSourceABC
        -_extraction_service: ExtractionServiceABC
    }

    class ProviderServiceFactory {
        +create_hash_service() HashServiceABC
        +create_index_generator() IndexGeneratorABC
        +create_timestamp_provider() TimestampProviderABC
        -_provider_registry: ProviderRegistryABC
    }

    class NoopFactory {
        +create_noop_service() NoopService
        +create_noop_hook() NoopHook
    }

    %% Relationships
    ApplicationServiceFactory --> ProviderServiceFactory : uses
    PipelineRuntimeFactory --> PipelineHookFactory : uses
    TransformComponentFactory --> ProviderServiceFactory : uses
    RecordSourceFactory --> ApplicationServiceFactory : uses

    note for ApplicationServiceFactory "Main factory for\napplication services"
    note for RecordSourceFactory "Creates record sources\nbased on source type config"
