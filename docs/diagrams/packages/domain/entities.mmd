---
title: Domain Entities Package
description: bioetl.domain.entities - Core business entities
---
classDiagram
    direction TB

    class EntityBase {
        <<abstract>>
        +id: str
        +created_at: datetime
        +updated_at: datetime
    }

    class Activity {
        +activity_id: str
        +assay_chembl_id: str
        +molecule_chembl_id: str
        +target_chembl_id: str
        +standard_value: float
        +standard_units: str
        +standard_type: str
        +pchembl_value: float
        +activity_comment: str
    }

    class Assay {
        +assay_chembl_id: str
        +assay_type: str
        +assay_organism: str
        +assay_description: str
        +assay_strain: str
        +assay_tissue: str
        +assay_cell_type: str
        +document_chembl_id: str
        +target_chembl_id: str
    }

    class Target {
        +target_chembl_id: str
        +target_type: str
        +pref_name: str
        +organism: str
        +tax_id: int
        +target_components: list
    }

    class Molecule {
        +molecule_chembl_id: str
        +molecule_type: str
        +pref_name: str
        +max_phase: int
        +molecular_formula: str
        +molecule_structures: dict
        +molecule_properties: dict
    }

    class Publication {
        +document_chembl_id: str
        +pubmed_id: int
        +doi: str
        +title: str
        +authors: str
        +journal: str
        +year: int
        +volume: str
        +first_page: str
        +last_page: str
    }

    class Cell {
        +cell_chembl_id: str
        +cell_name: str
        +cell_description: str
        +cell_source_organism: str
        +cell_source_tax_id: int
    }

    class Tissue {
        +tissue_chembl_id: str
        +pref_name: str
        +uberon_id: str
        +efo_id: str
    }

    EntityBase <|-- Activity
    EntityBase <|-- Assay
    EntityBase <|-- Target
    EntityBase <|-- Molecule
    EntityBase <|-- Publication
    EntityBase <|-- Cell
    EntityBase <|-- Tissue

    Activity --> Assay : assay_chembl_id
    Activity --> Molecule : molecule_chembl_id
    Activity --> Target : target_chembl_id
    Assay --> Publication : document_chembl_id
    Assay --> Target : target_chembl_id
