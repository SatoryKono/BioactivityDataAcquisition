---
title: Domain Value Objects Package
description: bioetl.domain.value_objects - Immutable value types
---
classDiagram
    direction TB

    class ValueObject {
        <<abstract>>
        +__eq__(other) bool
        +__hash__() int
    }

    %% Identifiers
    class ChemblID {
        +value: str
        +entity_type: str
        +validate() bool
        +from_string(s) ChemblID
    }

    class InChIKey {
        +value: str
        +connectivity_layer: str
        +stereochemistry_layer: str
        +validate() bool
    }

    class SMILES {
        +value: str
        +is_canonical: bool
        +validate() bool
    }

    %% Temporal
    class Timestamp {
        +value: datetime
        +timezone: str
        +to_iso() str
        +to_unix() int
    }

    class DateRange {
        +start: date
        +end: date
        +contains(date) bool
        +overlap(other) DateRange
    }

    %% Network
    class URL {
        +scheme: str
        +host: str
        +path: str
        +query: dict
        +to_string() str
    }

    class APIEndpoint {
        +base_url: URL
        +path: str
        +version: str
        +build_url(params) URL
    }

    %% Crypto
    class Hash {
        +value: str
        +algorithm: str
        +validate() bool
    }

    class Checksum {
        +value: str
        +algorithm: str
        +file_path: Path
        +verify(data) bool
    }

    ValueObject <|-- ChemblID
    ValueObject <|-- InChIKey
    ValueObject <|-- SMILES
    ValueObject <|-- Timestamp
    ValueObject <|-- DateRange
    ValueObject <|-- URL
    ValueObject <|-- APIEndpoint
    ValueObject <|-- Hash
    ValueObject <|-- Checksum

    APIEndpoint --> URL : base_url
    Checksum --> Hash : algorithm

    note for ValueObject "Immutable objects defined\nby their attributes"
    note for ChemblID "ChEMBL entity identifier\ne.g., CHEMBL123"
    note for InChIKey "International Chemical\nIdentifier Key"
