    class ValidatorFactoryABC {
        <<interface>>
        +create_validator(schema_name) Validator
        +register_schema(name, schema) void
    }

    class ValidationContracts {
        <<interface>>
        +ValidationError
        +ValidationResult
        +ValidationContext
    }

    class ValidationError {
        +column: str
        +row_index: int
        +message: str
        +severity: ErrorSeverity
    }

    class ValidationResult {
        +is_valid: bool
        +errors: list[ValidationError]
        +warnings: list[ValidationError]
        +row_count: int
        +error_count: int
    }

    class ValidationContext {
        +schema_name: str
        +strict_mode: bool
        +coerce_types: bool
    }

    ValidationServiceABC ..> ValidationResult : returns
