---
title: All Factory Classes
description: Factory classes across all layers
---
classDiagram
    direction TB

    %% Application Layer Factories
    class ApplicationServiceFactory {
        <<Application>>
        +create_validation_service()
        +create_schema_service()
        +create_configuration_service()
    }

    class PipelineRuntimeFactory {
        <<Application>>
        +create_runtime_context()
        +create_stage_manager()
        +create_error_handler()
    }

    class PipelineHookFactory {
        <<Application>>
        +create_logging_hook()
        +create_metrics_hook()
        +create_all_hooks()
    }

    class TransformComponentFactory {
        <<Application>>
        +create_transformer()
        +create_post_transformer()
        +create_normalizer()
    }

    class RecordSourceFactory {
        <<Application>>
        +create_api_source()
        +create_csv_source()
        +create_id_list_source()
        +resolve_source()
    }

    class ProviderServiceFactory {
        <<Application>>
        +create_hash_service()
        +create_index_generator()
        +create_timestamp_provider()
    }

    class ChemblPipelineFactory {
        <<Application>>
        +create_pipeline()
        +create_components()
        +create_transformer()
    }

    class NoopFactory {
        <<Application>>
        +create_noop_service()
        +create_noop_hook()
    }

    %% Infrastructure Layer Factories
    class TransformFactories {
        <<Infrastructure>>
        +create_hash_service()
        +create_index_generator()
        +create_timestamp_provider()
        +create_normalizer()
    }

    class OutputFactories {
        <<Infrastructure>>
        +create_csv_writer()
        +create_parquet_writer()
        +create_unified_loader()
    }

    class LoggingFactories {
        <<Infrastructure>>
        +create_progress_reporter()
        +create_logger()
    }

    class ObservabilityFactories {
        <<Infrastructure>>
        +create_metrics_collector()
        +create_tracer()
    }

    class ConverterFactories {
        <<Infrastructure>>
        +create_rename_converter()
        +create_dropna_converter()
    }

    class ChemblClientFactories {
        <<Infrastructure>>
        +create_http_client()
        +create_extraction_service()
    }

    class BaseClientFactories {
        <<Infrastructure>>
        +create_rate_limiter()
        +create_cache()
        +create_http_transport()
    }

    %% Interfaces Layer Factories
    class DefaultInfrastructureFactory {
        <<Interfaces>>
        +create_client()
        +create_loader()
        +create_config_loader()
    }

    class DefaultObservabilityFactory {
        <<Interfaces>>
        +create_metrics()
        +create_logger()
        +create_tracer()
    }

    class ProviderRegistryFactory {
        <<Interfaces>>
        +create_registry()
        +load_providers()
    }

    %% Relationships
    ApplicationServiceFactory --> ProviderServiceFactory
    PipelineRuntimeFactory --> PipelineHookFactory
    ChemblPipelineFactory --> TransformComponentFactory
    ChemblPipelineFactory --> RecordSourceFactory
    DefaultInfrastructureFactory --> ChemblClientFactories
    DefaultInfrastructureFactory --> OutputFactories
    DefaultObservabilityFactory --> ObservabilityFactories
