---
title: All Adapter Classes
description: Port adapter implementations
---
classDiagram
    direction TB

    %% Config Adapters
    class ConfigLoaderAdapter {
        +load(path) Config
        +load_yaml(path) dict
        +load_json(path) dict
        -_loader: YamlConfigLoader
    }

    class ConfigLoaderPortABC {
        <<interface>>
        +load(path) Config
    }

    ConfigLoaderPortABC <|.. ConfigLoaderAdapter

    %% Registry Adapters
    class ABCRegistryResolverAdapter {
        +resolve(name) Type
        +register(name, cls)
        +list_registered() list
        -_registry: dict
    }

    %% Data Adapters
    class PandasTabularAdapter {
        +to_dataframe(records) DataFrame
        +from_dataframe(df) list
        +apply_schema(df, schema) DataFrame
        -_dtypes: dict
    }

    %% Output Adapters
    class DataWriterAdapter {
        +write(df, path) WriteResult
        -_csv_writer: CsvWriter
        -_parquet_writer: ParquetWriter
        -_metadata_builder: MetadataBuilder
    }

    class DataWriterPort {
        <<interface>>
        +write(df, path) WriteResult
    }

    DataWriterPort <|.. DataWriterAdapter

    %% Schema Adapters
    class SchemaAdapter {
        +get_schema(entity) PanderaSchema
        +validate(df, schema) ValidationResult
        -_schemas: dict
    }

    %% Client Adapters
    class ChemblHttpClientImpl {
        +get(url, params) Response
        +fetch_records(filters) Records
        -_transport: HttpTransport
        -_rate_limiter: RateLimiter
    }

    class HttpClientABC {
        <<interface>>
        +get(url, params) Response
    }

    HttpClientABC <|.. ChemblHttpClientImpl

    %% Extraction Adapters
    class ChemblExtractionServiceImpl {
        +fetch_records() Iterable
        +get_total_count() int
        -_client: ChemblHttpClientImpl
        -_parser: ResponseParser
    }

    class ExtractionServiceABC {
        <<interface>>
        +fetch_records() Iterable
    }

    ExtractionServiceABC <|.. ChemblExtractionServiceImpl

    %% Loader Adapters
    class UnifiedLoaderImpl {
        +write(df, path) WriteResult
        -_csv_writer: CsvWriter
        -_parquet_writer: ParquetWriter
    }

    class LoaderABC {
        <<interface>>
        +write(df, path) WriteResult
    }

    LoaderABC <|.. UnifiedLoaderImpl

    %% Observability Adapters
    class ObservabilityAdapters {
        +create_prometheus_metrics() MetricsCollector
        +create_structured_logger() Logger
    }

    %% Validation Adapters
    class PanderaValidator {
        +validate(df) DataFrame
        +get_errors() list
        -_schema: PanderaSchema
    }

    class ValidationServiceABC {
        <<interface>>
        +validate(df) DataFrame
    }

    ValidationServiceABC <|.. PanderaValidator
