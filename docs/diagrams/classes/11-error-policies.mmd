---
title: Error Policy Classes
description: Error handling strategy implementations
---
classDiagram
    direction TB

    %% Contract
    class ErrorPolicyABC {
        <<interface>>
        +handle_error(error, context) void
        +should_continue() bool
        +get_errors() list~Error~
    }

    %% Implementations
    class FailFastErrorPolicy {
        +handle_error(error, context) void
        +should_continue() bool
        +get_errors() list~Error~
        -_error: Error
    }

    class ContinueOnErrorPolicy {
        +handle_error(error, context) void
        +should_continue() bool
        +get_errors() list~Error~
        -_errors: list~Error~
        -_max_errors: int
    }

    class LogOnlyErrorPolicy {
        +handle_error(error, context) void
        +should_continue() bool
        +get_errors() list~Error~
        -_logger: Logger
    }

    %% Supporting Classes
    class StageErrorHandler {
        +handle(error, stage, context) void
        +should_continue(error) bool
        -_policy: ErrorPolicyABC
        -_logger: Logger
    }

    class PipelineError {
        +message: str
        +stage: str
        +timestamp: datetime
        +traceback: str
        +context: dict
    }

    class ValidationError {
        +column: str
        +row_index: int
        +message: str
        +severity: ErrorSeverity
    }

    class ExtractionError {
        +url: str
        +status_code: int
        +message: str
        +retry_count: int
    }

    %% Enums
    class ErrorSeverity {
        <<enumeration>>
        WARNING
        ERROR
        CRITICAL
    }

    %% Relationships
    ErrorPolicyABC <|.. FailFastErrorPolicy
    ErrorPolicyABC <|.. ContinueOnErrorPolicy
    ErrorPolicyABC <|.. LogOnlyErrorPolicy

    StageErrorHandler --> ErrorPolicyABC
    StageErrorHandler ..> PipelineError : produces

    PipelineError <|-- ValidationError
    PipelineError <|-- ExtractionError

    ValidationError --> ErrorSeverity
