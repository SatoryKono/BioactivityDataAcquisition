---
title: Output Writer Classes
description: All output writing-related classes
---
classDiagram
    direction TB

    %% Contracts
    class LoaderABC {
        <<interface>>
        +write(df, path) WriteResult
    }

    class DataWriterPort {
        <<interface>>
        +write(df, path) WriteResult
    }

    class DeterministicWriterABC {
        <<interface>>
        +write(df, path) WriteResult
        +get_checksum() str
    }

    %% Main Loader
    class UnifiedLoaderImpl {
        +write(df, path) WriteResult
        +write_all(dfs, paths) list~WriteResult~
        -_csv_writer: CsvWriter
        -_parquet_writer: ParquetWriter
        -_metadata_writer: MetadataWriter
        -_format: OutputFormat
    }

    %% Base Writer
    class BaseWriter {
        <<abstract>>
        +write(df, path) WriteResult
        #_ensure_dir(path)
        #_get_checksum(path) str
    }

    %% Format Writers
    class CsvWriter {
        +write(df, path) WriteResult
        -_delimiter: str
        -_encoding: str
        -_quoting: int
        -_index: bool
    }

    class ParquetWriter {
        +write(df, path) WriteResult
        -_compression: str
        -_engine: str
        -_row_group_size: int
    }

    class MetadataWriter {
        +write(metadata, path) WriteResult
        +write_json(data, path)
        +write_yaml(data, path)
        -_format: str
    }

    class QualityReportWriter {
        +write(report, path) WriteResult
        -_format: str
    }

    %% Components
    class DataWriterAdapter {
        +write(df, path) WriteResult
        -_writer: BaseWriter
        -_metadata_builder: MetadataBuilder
        -_checksum_calc: ChecksumCalculator
    }

    class MetadataBuilder {
        +build(context) Metadata
        +add_field(key, value)
        -_fields: dict
    }

    class ChecksumCalculator {
        +calculate(path) str
        +calculate_from_bytes(data) str
        +verify(path, expected) bool
        -_algorithm: str
    }

    class QcReportGenerator {
        +generate(df) QcReport
        +calculate_stats(df) dict
        -_checks: list
    }

    class QcArtifactWriter {
        +write(report, path)
        +write_summary(report)
    }

    class ColumnOrder {
        +reorder(df, columns) DataFrame
        +get_order(entity) list
        -_orders: dict
    }

    %% Converters
    class RenameColumnsConverter {
        +convert(df) DataFrame
        -_mapping: dict
    }

    class DropNaRowsConverter {
        +convert(df) DataFrame
        -_subset: list
    }

    class NoopConverter {
        +convert(df) DataFrame
    }

    %% Relationships
    LoaderABC <|.. UnifiedLoaderImpl
    DataWriterPort <|.. DataWriterAdapter
    DeterministicWriterABC <|.. CsvWriter
    DeterministicWriterABC <|.. ParquetWriter

    BaseWriter <|-- CsvWriter
    BaseWriter <|-- ParquetWriter
    BaseWriter <|-- MetadataWriter
    BaseWriter <|-- QualityReportWriter

    UnifiedLoaderImpl --> CsvWriter
    UnifiedLoaderImpl --> ParquetWriter
    UnifiedLoaderImpl --> MetadataWriter
    DataWriterAdapter --> MetadataBuilder
    DataWriterAdapter --> ChecksumCalculator
    DataWriterAdapter --> QcReportGenerator
    QcReportGenerator --> QcArtifactWriter
