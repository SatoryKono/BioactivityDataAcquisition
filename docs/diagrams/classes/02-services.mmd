---
title: All Service Classes
description: Service classes across all layers
---
classDiagram
    direction TB

    %% Domain Services
    class EntityFactory {
        <<Domain>>
        +create_activity()
        +create_assay()
        +create_target()
        +create_molecule()
        +create_publication()
    }

    class BusinessKeyService {
        <<Domain>>
        +generate_key()
        +validate_key()
        +extract_components()
    }

    class VersionFormatter {
        <<Domain>>
        +format_version()
        +parse_version()
        +compare_versions()
    }

    class ValidationServiceABC {
        <<Domain - Interface>>
        +validate()
        +get_errors()
        +is_valid()
    }

    %% Application Services
    class ConfigurationService {
        <<Application>>
        +load_config()
        +validate_config()
        +merge_configs()
        +get_effective_config()
    }

    class SchemaBootstrapService {
        <<Application>>
        +bootstrap()
        +register_schemas()
        +get_schema()
    }

    class SchemaContractProviderImpl {
        <<Application>>
        +get_contract()
        +register_contract()
        +list_contracts()
    }

    class FilterEnrichmentService {
        <<Application>>
        +enrich_filters()
        +apply_defaults()
        +validate_filters()
    }

    class ObservabilityService {
        <<Application>>
        +setup_metrics()
        +setup_logging()
        +setup_tracing()
    }

    class ConfigMigrationService {
        <<Application>>
        +migrate()
        +detect_version()
        +get_migration_path()
    }

    class BackgroundExecutor {
        <<Application>>
        +submit()
        +wait_all()
        +shutdown()
    }

    class ProviderRegistryResolver {
        <<Application>>
        +resolve()
        +list_providers()
        +register()
    }

    %% Infrastructure Services
    class HashServiceImpl {
        <<Infrastructure>>
        +hash_row()
        +hash_business_key()
    }

    class PanderaValidator {
        <<Infrastructure>>
        +validate()
        +get_errors()
    }

    class ChemblExtractionServiceImpl {
        <<Infrastructure>>
        +fetch_records()
        +get_total_count()
    }

    %% Relationships
    ValidationServiceABC <|.. PanderaValidator
    ConfigurationService --> SchemaContractProviderImpl
    SchemaBootstrapService --> SchemaContractProviderImpl
