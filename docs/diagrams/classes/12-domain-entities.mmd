---
title: Domain Entity Classes
description: Core business entities
---
classDiagram
    direction TB

    class EntityBase {
        <<abstract>>
        +id: str
        +created_at: datetime
        +updated_at: datetime
        +to_dict() dict
        +from_dict(data) Entity
    }

    class Activity {
        +activity_id: str
        +assay_chembl_id: str
        +molecule_chembl_id: str
        +target_chembl_id: str
        +standard_value: float
        +standard_units: str
        +standard_type: str
        +standard_relation: str
        +pchembl_value: float
        +activity_comment: str
        +data_validity_comment: str
        +potential_duplicate: bool
    }

    class Assay {
        +assay_chembl_id: str
        +assay_type: str
        +assay_type_description: str
        +assay_organism: str
        +assay_description: str
        +assay_strain: str
        +assay_tissue: str
        +assay_cell_type: str
        +assay_subcellular_fraction: str
        +document_chembl_id: str
        +target_chembl_id: str
        +confidence_score: int
        +bao_format: str
    }

    class Target {
        +target_chembl_id: str
        +target_type: str
        +pref_name: str
        +organism: str
        +tax_id: int
        +species_group_flag: bool
        +target_components: list
    }

    class Molecule {
        +molecule_chembl_id: str
        +molecule_type: str
        +pref_name: str
        +max_phase: int
        +therapeutic_flag: bool
        +dosed_ingredient: bool
        +structure_type: str
        +molecule_hierarchy: dict
        +molecule_structures: dict
        +molecule_properties: dict
        +cross_references: list
    }

    class Publication {
        +document_chembl_id: str
        +pubmed_id: int
        +doi: str
        +title: str
        +authors: str
        +journal: str
        +year: int
        +volume: str
        +issue: str
        +first_page: str
        +last_page: str
        +abstract: str
    }

    class Cell {
        +cell_chembl_id: str
        +cell_name: str
        +cell_description: str
        +cell_source_organism: str
        +cell_source_tax_id: int
        +cell_source_tissue: str
        +cellosaurus_id: str
        +cl_lincs_id: str
        +clo_id: str
        +efo_id: str
    }

    class Tissue {
        +tissue_chembl_id: str
        +pref_name: str
        +uberon_id: str
        +efo_id: str
        +bto_id: str
    }

    %% Inheritance
    EntityBase <|-- Activity
    EntityBase <|-- Assay
    EntityBase <|-- Target
    EntityBase <|-- Molecule
    EntityBase <|-- Publication
    EntityBase <|-- Cell
    EntityBase <|-- Tissue

    %% Relationships
    Activity "1" --> "1" Assay : assay_chembl_id
    Activity "1" --> "1" Molecule : molecule_chembl_id
    Activity "1" --> "1" Target : target_chembl_id
    Assay "1" --> "0..1" Publication : document_chembl_id
    Assay "1" --> "0..1" Target : target_chembl_id
    Assay "1" --> "0..1" Cell : cell_type
    Assay "1" --> "0..1" Tissue : tissue
