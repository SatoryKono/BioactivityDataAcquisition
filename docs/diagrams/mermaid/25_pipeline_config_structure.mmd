%%{init: {'theme':'base', 'themeVariables': { 'fontSize':'13px'}}}%%
classDiagram
    class PipelineConfig {
        <<dataclass - 106 LOC>>
        +pipeline_name: str
        +provider: str
        +entity: str
        +version: str
        +source: SourceConfig
        +sink: SinkConfig
        +transforms: list~TransformConfig~
        +dq_config: DQConfig
        +filters: dict | None
        +batch_size: int
        +checkpoint_enabled: bool
        +metadata: dict
    }

    class SourceConfig {
        <<dataclass>>
        +type: str (api, file, database)
        +endpoint: str | None
        +auth_type: str | None
        +rate_limit: RateLimitConfig | None
        +pagination: PaginationConfig | None
        +filters: dict | None
        +headers: dict | None
    }

    class SinkConfig {
        <<dataclass>>
        +bronze: BronzeConfig
        +silver: SilverConfig
        +gold: GoldConfig
    }

    class BronzeConfig {
        <<dataclass>>
        +enabled: bool
        +path: str
        +format: str (jsonl)
        +compression: str (zstd)
        +retention_days: int
    }

    class SilverConfig {
        <<dataclass>>
        +enabled: bool
        +table_name: str
        +write_mode: SilverWriteMode
        +partition_by: list~str~ | None
        +primary_key: str
        +schema_version: str
    }

    class GoldConfig {
        <<dataclass>>
        +enabled: bool
        +table_name: str
        +write_mode: GoldWriteMode
        +partition_by: list~str~ | None
        +gold_filters: list~str~
        +strict_validation: bool
    }

    class TransformConfig {
        <<dataclass>>
        +transformer_class: str
        +enabled: bool
        +params: dict | None
    }

    class DQConfig {
        <<dataclass - 78 LOC>>
        +soft_fail_threshold: float (0.05)
        +hard_fail_threshold: float (0.20)
        +enabled_checks: list~str~
        +rules: list~DQRule~
        +quarantine_invalid: bool
    }

    class DQRule {
        <<dataclass>>
        +rule_type: str
        +field: str
        +condition: str
        +threshold: float | None
        +severity: str (warning, error)
    }

    class ValidationConfig {
        <<dataclass - 50 LOC>>
        +publication_year_min: int (1900)
        +publication_year_max: int (current_year)
        +molecular_weight_min: float (0.0)
        +molecular_weight_max: float (2000.0)
        +pchembl_value_min: float (0.0)
        +pchembl_value_max: float (14.0)
        +required_fields: list~str~
    }

    class TableConfig {
        <<dataclass - 38 LOC>>
        +bronze_path_template: str
        +silver_table_name: str
        +gold_table_name: str
        +primary_key: str
        +partition_columns: list~str~ | None
    }

    class RuntimeConfig {
        <<dataclass - 98 LOC>>
        +run_type: RunType (incremental|backfill|rebuild)
        +limit: int | None
        +dry_run: bool
        +data_dir: Path
        +log_level: str
        +filters: dict | None
        +clear_policy: ClearPolicy
        +lock_ttl: int
        +heartbeat_interval: int
    }

    class RateLimitConfig {
        <<dataclass>>
        +requests_per_second: float
        +burst_size: int
    }

    class PaginationConfig {
        <<dataclass>>
        +type: str (offset|cursor|page)
        +page_size: int
        +max_pages: int | None
    }

    class SilverWriteMode {
        <<enumeration>>
        MERGE
        APPEND
        DELETE
    }

    class GoldWriteMode {
        <<enumeration>>
        OVERWRITE
        APPEND
        SCD2
    }

    class RunType {
        <<enumeration>>
        INCREMENTAL
        BACKFILL
        REBUILD
    }

    class ClearPolicy {
        <<enumeration>>
        NONE
        SILVER_ONLY
        GOLD_ONLY
        ALL
    }

    PipelineConfig *-- SourceConfig : has
    PipelineConfig *-- SinkConfig : has
    PipelineConfig *-- TransformConfig : contains
    PipelineConfig *-- DQConfig : has

    SinkConfig *-- BronzeConfig : has
    SinkConfig *-- SilverConfig : has
    SinkConfig *-- GoldConfig : has

    SourceConfig *-- RateLimitConfig : optional
    SourceConfig *-- PaginationConfig : optional

    DQConfig *-- DQRule : contains

    SilverConfig -- SilverWriteMode : uses
    GoldConfig -- GoldWriteMode : uses

    RuntimeConfig -- RunType : has
    RuntimeConfig -- ClearPolicy : has

    note for PipelineConfig "Loaded from YAML:<br/>configs/pipelines/{provider}/{entity}.yaml<br/><br/>Example:<br/>configs/pipelines/chembl/activity.yaml"

    note for DQConfig "DQ Thresholds:<br/>- soft_fail: 5% → warning<br/>- hard_fail: 20% → fail batch<br/><br/>Rules:<br/>- Field validation<br/>- Cross-field validation<br/>- Conditional validation"

    note for RuntimeConfig "CLI Parameters:<br/>bioetl run chembl_activity \\<br/>  --run-type incremental \\<br/>  --limit 1000 \\<br/>  --data-dir /path/to/data"

    note for SilverConfig "Write Modes:<br/>- MERGE: Default, by content_hash<br/>- APPEND: Add new rows<br/>- DELETE: Remove by filter"

    note for GoldConfig "Write Modes:<br/>- OVERWRITE: Full table replace<br/>- APPEND: Add rows<br/>- SCD2: Slowly changing dimension<br/><br/>gold_filters: Exclude JSON fields"
