%%{init: {'theme':'base', 'themeVariables': { 'fontSize':'15px'}}}%%
graph TB
    subgraph external["External Systems"]
        ChEMBL[(ChEMBL API)]
        PubChem[(PubChem API)]
        UniProt[(UniProt API)]
        CrossRef[(CrossRef API)]
        OpenAlex[(OpenAlex API)]
        PubMed[(PubMed API)]
        SemanticScholar[(SemanticScholar API)]
        FileSystem[(Local File System)]
        DeltaLake[(Delta Lake)]
    end

    subgraph adapters["Infrastructure Layer - Adapters (Implements Ports)"]
        direction TB

        subgraph inbound["Inbound Adapters"]
            CLIAdapter[CLI Interface<br/>Click Commands]
        end

        subgraph outbound["Outbound Adapters"]
            ChemblAdapter[ChemblAdapter]
            PubChemAdapter[PubChemAdapter]
            UniProtAdapter[UniProtAdapter]
            CrossRefAdapter[CrossRefAdapter]
            OpenAlexAdapter[OpenAlexAdapter]
            PubMedAdapter[PubMedAdapter]
            SSAdapter[SemanticScholarAdapter]

            BronzeWriter[BronzeWriter<br/>JSONL Storage]
            SilverWriter[SilverWriter<br/>Delta Merge]
            GoldWriter[GoldWriter<br/>Delta Validated]

            MemoryLock[MemoryLock]
            CheckpointAdapter[CheckpointAdapter]
            QuarantineAdapter[QuarantineAdapter]

            StructlogLogger[StructlogLogger]
            PrometheusMetrics[PrometheusMetrics]
            OTELTracer[OpenTelemetryTracer]
        end
    end

    subgraph hexagon["Domain Layer - Business Logic (Hexagon Core)"]
        direction TB

        subgraph ports_left["Inbound Ports<br/>(Use Cases)"]
            RunPipeline["Run Pipeline<br/>Use Case"]
        end

        subgraph core["Domain Core"]
            Aggregates[DDD Aggregates<br/>PipelineRun<br/>Batch<br/>QuarantineEntry]
            Entities[Entities<br/>ChemblActivity<br/>UniProtProtein<br/>etc.]
            ValueObjects[Value Objects<br/>Activity<br/>DQMetrics<br/>RunContext]
            DomainServices[Domain Services<br/>DataNormalization<br/>IdentityService]
        end

        subgraph ports_right["Outbound Ports<br/>(Interfaces/Protocols)"]
            DataSourcePort[DataSourcePort<br/>Protocol]
            StoragePort[StoragePort<br/>Protocol]
            LockPort[LockPort<br/>Protocol]
            CheckpointPort[CheckpointPort<br/>Protocol]
            QuarantinePort[QuarantinePort<br/>Protocol]
            TracingPort[TracingPort<br/>Protocol]
            MetricsPort[MetricsPort<br/>Protocol]
            LoggerPort[LoggerPort<br/>Protocol]
            CircuitBreakerPort[CircuitBreakerPort<br/>Protocol]
            RateLimiterPort[RateLimiterPort<br/>Protocol]
        end
    end

    subgraph application["Application Layer"]
        PipelineRunner[PipelineRunner]
        BatchExecutor[BatchExecutor]
        RecordProcessor[RecordProcessor]
        BaseTransformer[BaseTransformer]
    end

    subgraph composition["Composition Layer - DI Container"]
        Bootstrap[bootstrap_pipeline<br/>Composition Root]
        Factories[Factories<br/>Create & Wire]
    end

    %% External → Inbound Adapters
    User([User]) -->|CLI Commands| CLIAdapter

    %% Inbound Adapters → Application
    CLIAdapter -->|Calls| Bootstrap
    Bootstrap -->|Creates| PipelineRunner

    %% Application → Domain
    PipelineRunner -->|Uses| RunPipeline
    RunPipeline -->|Uses| Aggregates
    RunPipeline -->|Uses| DomainServices

    %% Domain → Outbound Ports
    Aggregates -->|Requires| DataSourcePort
    Aggregates -->|Requires| StoragePort
    Aggregates -->|Requires| LockPort

    %% Composition wires Adapters → Ports
    Bootstrap -.->|"Injects"| ChemblAdapter
    Bootstrap -.->|"Injects"| BronzeWriter
    Bootstrap -.->|"Injects"| MemoryLock

    %% Outbound Adapters implement Ports
    ChemblAdapter -.->|Implements| DataSourcePort
    PubChemAdapter -.->|Implements| DataSourcePort
    UniProtAdapter -.->|Implements| DataSourcePort
    CrossRefAdapter -.->|Implements| DataSourcePort
    OpenAlexAdapter -.->|Implements| DataSourcePort
    PubMedAdapter -.->|Implements| DataSourcePort
    SSAdapter -.->|Implements| DataSourcePort

    BronzeWriter -.->|Implements| StoragePort
    SilverWriter -.->|Implements| StoragePort
    GoldWriter -.->|Implements| StoragePort

    MemoryLock -.->|Implements| LockPort
    CheckpointAdapter -.->|Implements| CheckpointPort
    QuarantineAdapter -.->|Implements| QuarantinePort

    StructlogLogger -.->|Implements| LoggerPort
    PrometheusMetrics -.->|Implements| MetricsPort
    OTELTracer -.->|Implements| TracingPort

    %% Outbound Adapters → External Systems
    ChemblAdapter -->|HTTP Requests| ChEMBL
    PubChemAdapter -->|HTTP Requests| PubChem
    UniProtAdapter -->|HTTP Requests| UniProt
    CrossRefAdapter -->|HTTP Requests| CrossRef
    OpenAlexAdapter -->|HTTP Requests| OpenAlex
    PubMedAdapter -->|HTTP Requests| PubMed
    SSAdapter -->|HTTP Requests| SemanticScholar

    BronzeWriter -->|Writes JSONL| FileSystem
    SilverWriter -->|Delta Merge| DeltaLake
    GoldWriter -->|Delta Write| DeltaLake

    CheckpointAdapter -->|Saves State| FileSystem
    QuarantineAdapter -->|Saves Failed Records| FileSystem

    classDef externalStyle fill:#ffebee,stroke:#c62828,stroke-width:2px
    classDef adapterStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef domainStyle fill:#e3f2fd,stroke:#1565c0,stroke-width:3px,font-weight:bold
    classDef portStyle fill:#fff9c4,stroke:#f57f17,stroke-width:2px
    classDef appStyle fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef compStyle fill:#fce4ec,stroke:#880e4f,stroke-width:2px

    class ChEMBL,PubChem,UniProt,CrossRef,OpenAlex,PubMed,SemanticScholar,FileSystem,DeltaLake,User externalStyle
    class CLIAdapter,ChemblAdapter,PubChemAdapter,UniProtAdapter,CrossRefAdapter,OpenAlexAdapter,PubMedAdapter,SSAdapter,BronzeWriter,SilverWriter,GoldWriter,MemoryLock,CheckpointAdapter,QuarantineAdapter,StructlogLogger,PrometheusMetrics,OTELTracer adapterStyle
    class Aggregates,Entities,ValueObjects,DomainServices domainStyle
    class DataSourcePort,StoragePort,LockPort,CheckpointPort,QuarantinePort,TracingPort,MetricsPort,LoggerPort,CircuitBreakerPort,RateLimiterPort,RunPipeline portStyle
    class PipelineRunner,BatchExecutor,RecordProcessor,BaseTransformer appStyle
    class Bootstrap,Factories compStyle
