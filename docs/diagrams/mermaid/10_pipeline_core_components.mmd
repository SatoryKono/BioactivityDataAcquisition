%%{init: {'theme':'base', 'themeVariables': { 'fontSize':'13px'}}}%%
graph TB
    subgraph runner["PipelineRunner (186 LOC)"]
        direction TB
        RunnerInit["__init__(services, config)"]
        RunMethod["async run()"]
        Preflight["_preflight_checks()"]
        Execute["_execute()"]
        Postrun["_postrun()"]
        Shutdown["shutdown()"]

        RunMethod --> Preflight
        Preflight --> Execute
        Execute --> Postrun
    end

    subgraph services["RunnerServices Bundle"]
        direction TB
        ServicesStruct["RunnerServices:<br/>- data_source: DataSourcePort<br/>- storage: StoragePort<br/>- lock: LockPort<br/>- checkpoint: CheckpointPort<br/>- quarantine: QuarantinePort<br/>- observer: PipelineObserver<br/>- metrics: MetricsPort<br/>- logger: LoggerPort<br/>- tracer: TracingPort"]
    end

    subgraph executor["BatchExecutor (150 LOC)"]
        direction TB
        ExecutorLoop["execute_loop()"]
        LoadCheckpoint["load_checkpoint()"]
        FetchBatch["fetch_next_batch()"]
        ProcessBatch["process_batch()"]
        AdaptiveSize["adjust_batch_size()"]

        ExecutorLoop --> LoadCheckpoint
        LoadCheckpoint --> FetchBatch
        FetchBatch --> ProcessBatch
        ProcessBatch --> AdaptiveSize
        AdaptiveSize --> FetchBatch
    end

    subgraph processor["RecordProcessor (200 LOC)"]
        direction TB
        ProcessMethod["async process(batch)"]
        Transform["transform_records()"]
        WriteBronze["write_bronze()"]
        WriteSilver["write_silver()"]
        WriteGold["write_gold()"]

        ProcessMethod --> Transform
        Transform --> WriteBronze
        WriteBronze --> WriteSilver
        WriteSilver --> WriteGold
    end

    subgraph transformer["BatchTransformer (200 LOC)"]
        direction TB
        TransformBatch["transform_batch()"]
        ApplyTransformer["apply_base_transformer()"]
        ValidateSchema["validate_schema()"]
        CheckDQ["check_dq_rules()"]
        QuarantineHandler["handle_quarantine()"]

        TransformBatch --> ApplyTransformer
        ApplyTransformer --> ValidateSchema
        ValidateSchema --> CheckDQ
        CheckDQ --> QuarantineHandler
    end

    subgraph writer["BatchWriter (180 LOC)"]
        direction TB
        WriterInit["__init__(storage, lock)"]
        WriteMethod["async write(batch, layers)"]
        LockGuard["validate_lock_ownership()"]
        BronzeOp["_write_bronze()"]
        SilverOp["_write_silver()"]
        GoldOp["_write_gold()"]

        WriteMethod --> LockGuard
        LockGuard --> BronzeOp
        BronzeOp --> SilverOp
        SilverOp --> GoldOp
    end

    subgraph metrics_recorder["BatchMetricsRecorder (100 LOC)"]
        direction TB
        RecordStart["record_batch_start()"]
        RecordSuccess["record_batch_success()"]
        RecordFailure["record_batch_failure()"]
        EmitMetrics["emit_to_prometheus()"]

        RecordStart --> RecordSuccess
        RecordSuccess --> EmitMetrics
        RecordStart --> RecordFailure
        RecordFailure --> EmitMetrics
    end

    subgraph managers["Supporting Managers"]
        direction TB

        LockMgr["LockManager (150 LOC)<br/>acquire_with_heartbeat()<br/>release_lock()<br/>validate_ownership()"]

        CheckpointMgr["CheckpointManager (120 LOC)<br/>save_checkpoint(state)<br/>load_checkpoint() → state<br/>cleanup_old_checkpoints()"]

        QuarantineMgr["QuarantineManager (100 LOC)<br/>quarantine_record(record, reason)<br/>query_quarantine(filters)<br/>update_status(entry_id, status)"]

        MemoryMon["MemoryMonitor (200 LOC)<br/>get_current_usage() → float<br/>calculate_batch_size(target) → int<br/>monitor_loop()"]
    end

    %% Component Interactions
    RunMethod --> |"Injects"| ServicesStruct
    RunMethod --> |"Calls"| ExecutorLoop

    ExecutorLoop --> |"Uses"| ProcessBatch
    ProcessBatch --> |"Delegates to"| ProcessMethod

    ProcessMethod --> |"Uses"| TransformBatch
    ProcessMethod --> |"Uses"| WriteMethod

    TransformBatch --> |"Uses"| QuarantineMgr
    WriteMethod --> |"Uses"| LockMgr

    ExecutorLoop --> |"Uses"| CheckpointMgr
    ExecutorLoop --> |"Uses"| MemoryMon

    ProcessMethod --> |"Records metrics"| RecordStart
    ProcessMethod --> |"Records metrics"| RecordSuccess

    %% Services Usage
    ServicesStruct -.-> |"Provides"| ProcessMethod
    ServicesStruct -.-> |"Provides"| WriteMethod
    ServicesStruct -.-> |"Provides"| TransformBatch

    %% Observer Pattern
    Observer["PipelineObserver<br/>(Wraps execution with observability)"]
    Observer -.-> |"Wraps"| RunMethod
    Observer --> |"Emits traces"| ServicesStruct
    Observer --> |"Emits metrics"| ServicesStruct
    Observer --> |"Logs events"| ServicesStruct

    %% Preflight and Postrun Services
    PreflightSvc["PreflightService (120 LOC)<br/>check_infrastructure()<br/>check_provider_health()<br/>validate_config()"]

    PostrunSvc["PostrunService (180 LOC)<br/>analyze_dq_metrics()<br/>emit_final_metrics()<br/>trigger_vacuum()<br/>cleanup_resources()"]

    Preflight --> PreflightSvc
    Postrun --> PostrunSvc

    classDef runnerStyle fill:#e3f2fd,stroke:#1565c0,stroke-width:3px
    classDef executorStyle fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef processorStyle fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef writerStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef managerStyle fill:#fff9c4,stroke:#f57f17,stroke-width:2px
    classDef serviceStyle fill:#fce4ec,stroke:#880e4f,stroke-width:2px

    class runner,RunMethod,Preflight,Execute,Postrun runnerStyle
    class executor,ExecutorLoop,FetchBatch,ProcessBatch executorStyle
    class processor,ProcessMethod,Transform,WriteBronze,WriteSilver,WriteGold processorStyle
    class writer,WriteMethod,BronzeOp,SilverOp,GoldOp writerStyle
    class managers,LockMgr,CheckpointMgr,QuarantineMgr,MemoryMon managerStyle
    class services,ServicesStruct,PreflightSvc,PostrunSvc,Observer serviceStyle
