%%{init: {
  "theme": "base",
  "themeVariables": {
    "actorLineColor": "#444",
    "actorTextColor": "#111",
    "actorBkg": "#f5f5f5",
    "actorBorderRadius": 6,
    "actorFontSize": "18px",
    "sequenceNumberColor": "#444",
    "activationBkgColor": "#e3e7ec",
    "activationBorderColor": "#444"
  }
}}%%
%% Shared palette (per diagramming policy)
classDef actorPrimary   fill:#f5f5f5,stroke:#444,stroke-width:1.5px,color:#111,font-size:22px;
classDef actorSecondary fill:#e3e7ec,stroke:#555,stroke-width:1.2px,color:#111,font-size:18px;
classDef actorExternal  fill:#dde7f2,stroke:#44546a,stroke-width:1.5px,color:#111,font-size:22px;
linkStyle default stroke:#666,stroke-width:1.2px,color:#111;

sequenceDiagram
    autonumber

    participant UseCase as RunPipelineUseCase
    participant ConfigLoader as PipelineConfigLoader
    participant ProviderLoader as ProviderRegistryLoader
    participant ContainerFactory as Container Factory
    participant Orchestrator as PipelineOrchestrator
    participant Pipeline as PipelineBase/ChemblPipeline
    participant Hooks as PipelineHooks (Logging+Metrics)
    participant ErrorPolicy as ErrorPolicyManager
    participant Extraction as ChemblExtractionServiceImpl
    participant Transformer as ChemblTransformerImpl
    participant Validator as ValidationService
    participant Writer as UnifiedOutputWriter
    participant Storage as Deterministic Storage

    class UseCase actorPrimary
    class ConfigLoader actorSecondary
    class ProviderLoader actorSecondary
    class ContainerFactory actorSecondary
    class Orchestrator actorPrimary
    class Pipeline actorPrimary
    class Hooks actorSecondary
    class ErrorPolicy actorSecondary
    class Extraction actorSecondary
    class Transformer actorSecondary
    class Validator actorSecondary
    class Writer actorPrimary
    class Storage actorExternal

    UseCase->>ConfigLoader: load config (path or registry) with profile + profiles_root
    ConfigLoader-->>UseCase: PipelineConfig
    UseCase->>UseCase: validate require_rest_interface flag
    alt output override provided
        UseCase->>UseCase: apply output_path override (mkdir, mutate sink)
    end
    UseCase->>ProviderLoader: create_provider_loader()
    ProviderLoader-->>UseCase: ProviderRegistry
    UseCase->>Orchestrator: PipelineOrchestrator(..., container_factory, provider_loader_factory)
    Orchestrator->>Pipeline: build_pipeline(limit) using registry + container

    activate Pipeline
    Pipeline->>Hooks: on_start(run_ctx)
    Pipeline->>ErrorPolicy: bind(run_ctx)

    loop Extract + Transform + Validate batches
        Pipeline->>Extraction: extract_all(limit)
        Extraction-->>Pipeline: batch_df
        Pipeline->>Transformer: apply(batch_df)
        Transformer-->>Pipeline: normalized_df
        Pipeline->>Validator: validate(schema_name, normalized_df)
        Validator-->>Pipeline: validated_df
        Pipeline->>Pipeline: accumulate(validated_df)
    end

    alt dry_run or PipelineType.TRANSFORM_ONLY
        Pipeline->>Hooks: on_stage_start("write"); skip persistent write
    else
        Pipeline->>Writer: write(all_validated_df, output_cfg)
        Writer-->>Storage: atomic persist + meta.yaml + QC sidecars
    end

    Pipeline->>Hooks: on_finish(success, stats)
    Pipeline-->>Orchestrator: RunResult(meta, duration, hooks summary)
    deactivate Pipeline
    Orchestrator-->>UseCase: RunResult

    Note over Pipeline,ErrorPolicy: Any exception invokes ErrorPolicy -> hooks.on_error -> propagate to orchestrator.