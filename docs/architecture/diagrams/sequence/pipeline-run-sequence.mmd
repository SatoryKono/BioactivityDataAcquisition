sequenceDiagram
    autonumber
    participant CLI as CLI (Typer)
    participant Orchestrator as PipelineOrchestrator
    participant Container as PipelineContainer
    participant Pipeline as PipelineBase/ChemblPipeline
    participant Hooks as PipelineHooks (Logging+Metrics)
    participant ErrorPolicy as ErrorPolicyManager
    participant Extraction as ChemblExtractionServiceImpl
    participant Transformer as ChemblTransformerImpl
    participant Validator as ValidationService
    participant Writer as UnifiedOutputWriter
    participant Storage as Deterministic Storage

    CLI->>Orchestrator: run(pipeline_name, cli_args)
    Orchestrator->>Container: build_pipeline_dependencies(config)
    Container-->>Orchestrator: Dependencies (extraction, transformer, validator, writer, hooks, error policy)
    Orchestrator->>Pipeline: instantiate(config, deps)
    Orchestrator->>Pipeline: run()
    activate Pipeline
    Pipeline->>Hooks: on_start(run_ctx)
    Pipeline->>ErrorPolicy: bind(run_ctx)

    loop Extract + Transform batches
        Pipeline->>Hooks: on_stage_start("extract")
        Pipeline->>Extraction: extract_all(config)
        activate Extraction
        Extraction-->>Pipeline: batch_df
        deactivate Extraction

        Pipeline->>Hooks: on_stage_start("transform")
        Pipeline->>Transformer: apply(batch_df)
        activate Transformer
        Transformer-->>Pipeline: normalized_df
        deactivate Transformer

        Pipeline->>Hooks: on_stage_start("validate")
        Pipeline->>Validator: validate(schema_name, normalized_df)
        activate Validator
        Validator-->>Pipeline: validated_df
        deactivate Validator

        Pipeline->>Pipeline: accumulate(validated_df)
    end

    Pipeline->>Hooks: on_stage_end("extract/transform/validate")

    alt Dry run?
        Pipeline->>Hooks: on_stage_start("write")
        Pipeline->>Pipeline: skip write but produce metrics/meta preview
        Pipeline->>Hooks: on_stage_end("write")
    else
        Pipeline->>Hooks: on_stage_start("write")
        Pipeline->>Writer: write(all_validated_df, output_cfg)
        activate Writer
        Writer->>Writer: stable sort + atomic CSV/Parquet
        Writer->>Storage: persist dataset + meta.yaml
        Writer-->>Pipeline: WriteResult(meta)
        deactivate Writer
        Pipeline->>Hooks: on_stage_end("write")
    end

    Pipeline->>Hooks: on_finish(success=True, stats)
    Pipeline-->>Orchestrator: RunResult(meta, duration, hooks summary)
    deactivate Pipeline
    Orchestrator-->>CLI: exit code + summary

    Note over Pipeline,ErrorPolicy: Any exception invokes ErrorPolicy -> hooks.on_error -> propagate to orchestrator.