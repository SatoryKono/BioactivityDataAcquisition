sequenceDiagram
    autonumber
    participant CLI as CLI command
    participant Orchestrator as PipelineOrchestrator
    participant Container as PipelineContainer
    participant Registry as ProviderRegistryLoader
    participant Factories as Provider factories (clients, writers, hooks)
    participant Pipeline as Pipeline class

    CLI->>Orchestrator: run(pipeline_name, cli_args)
    Orchestrator->>Container: build_pipeline_dependencies(config)
    Container->>Registry: load_provider_registry(profile)
    Registry-->>Container: ProviderRegistryABC
    Container->>Factories: resolve default_xxx_factory()
    Factories-->>Container: concrete implementations (ExtractionServiceImpl, OutputWriter, Hooks...)
    Container->>Container: compose Dependencies dataclass
    Container-->>Orchestrator: Dependencies
    Orchestrator->>Pipeline: instantiate(pipeline_cls, config, deps)
    Orchestrator-->>CLI: ready Pipeline -> run()

