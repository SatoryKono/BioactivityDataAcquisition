%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui', 'lineWidth': '2'}}}%%
classDiagram
    direction TB

    class BasePipeline {
        <<abstract>>
        #_config: PipelineConfig
        #_runtime: RuntimeConfig
        #_services: PipelineServices

        +create(config, runtime, services)$ BasePipeline
        +config() PipelineConfig
        +runtime() RuntimeConfig
        +services() PipelineServices
        +pipeline_name() str
        +provider() str
        +entity() str
        +run_id() RunID
        +run_type() RunType
    }

    class BaseTransformer {
        <<abstract>>
        #_config: PipelineConfig
        #_runtime: RuntimeConfig
        #_logger: LoggerPort

        +transform(record: BronzeRecord) SilverRecord
        +transform_batch(records: list) list~SilverRecord~
        #_transform_impl(record)* SilverRecord
        #compute_content_hash(provider, data) ContentHash
        #serialize_json(value) str
        #entity_to_silver_record(entity) SilverRecord
        #_get_required_field(record, field) Any
        #_extract_nested(record, path) Any
        #_create_entity(**kwargs) BaseEntity
    }

    class BaseChemblTransformer {
        <<abstract>>
        +provider: str = "chembl"
        #_normalize_chembl_id(id: str) str
        #_normalize_units(value, units) tuple
        #_parse_chembl_date(date_str) date
    }

    class ActivityTransformer {
        +entity: str = "activity"
        #_transform_impl(record) SilverRecord
        -_normalize_activity_value(record) float
        -_extract_target_info(record) dict
    }

    class MoleculeTransformer {
        +entity: str = "molecule"
        #_transform_impl(record) SilverRecord
        -_normalize_smiles(smiles) str
        -_extract_properties(record) dict
    }

    class AssayTransformer {
        +entity: str = "assay"
        #_transform_impl(record) SilverRecord
        -_normalize_assay_type(type) str
    }

    class TargetTransformer {
        +entity: str = "target"
        #_transform_impl(record) SilverRecord
        -_extract_uniprot_accessions(record) list
        -_extract_gene_names(record) list
    }

    class DocumentTransformer {
        +entity: str = "document"
        #_transform_impl(record) SilverRecord
        -_parse_authors(authors) list
    }

    class BasePubchemTransformer {
        <<abstract>>
        +provider: str = "pubchem"
        #_normalize_cid(cid) str
    }

    class CompoundTransformer {
        +entity: str = "compound"
        #_transform_impl(record) SilverRecord
        -_extract_properties(record) dict
    }

    class BaseUniprotTransformer {
        <<abstract>>
        +provider: str = "uniprot"
        #_normalize_accession(acc) str
    }

    class ProteinTransformer {
        +entity: str = "protein"
        #_transform_impl(record) SilverRecord
        -_extract_features(record) dict
        -_extract_go_terms(record) list
    }

    class BasePubmedTransformer {
        <<abstract>>
        +provider: str = "pubmed"
        #_normalize_pmid(pmid) str
    }

    class PublicationTransformer {
        +entity: str = "publication"
        #_transform_impl(record) SilverRecord
        -_parse_authors(authors) list
        -_extract_mesh_terms(record) list
    }

    %% Inheritance - Transformers
    BaseTransformer <|-- BaseChemblTransformer
    BaseTransformer <|-- BasePubchemTransformer
    BaseTransformer <|-- BaseUniprotTransformer
    BaseTransformer <|-- BasePubmedTransformer

    BaseChemblTransformer <|-- ActivityTransformer
    BaseChemblTransformer <|-- MoleculeTransformer
    BaseChemblTransformer <|-- AssayTransformer
    BaseChemblTransformer <|-- TargetTransformer
    BaseChemblTransformer <|-- DocumentTransformer

    BasePubchemTransformer <|-- CompoundTransformer
    BaseUniprotTransformer <|-- ProteinTransformer
    BasePubmedTransformer <|-- PublicationTransformer

    %% Pipeline uses Transformer
    BasePipeline --> BaseTransformer : uses

    %% Notes
    note for BasePipeline "Container for configuration\nand injected services.\n\nDoes NOT orchestrate execution\n(that's PipelineRunner's job)"

    note for BaseTransformer "Template Method Pattern\n━━━━━━━━━━━━━━━━━━━━━━\n• transform() - public API\n• _transform_impl() - override point\n\nProvides:\n• Content hash computation\n• JSON serialization\n• Field extraction utilities"

    note for BaseChemblTransformer "ChEMBL-specific normalization:\n• ID formatting (CHEMBL123)\n• Unit conversion (nM → μM)\n• Date parsing"
