flowchart LR
    classDef stepPrimary   fill:#f5f5f5,stroke:#444,stroke-width:1.5px;
    classDef stepSecondary fill:#e3e7ec,stroke:#555,stroke-width:1.2px;
    classDef external      fill:#dde7f2,stroke:#44546a,stroke-width:1.5px;
