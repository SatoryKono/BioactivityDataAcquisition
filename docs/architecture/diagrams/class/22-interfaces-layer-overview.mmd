classDiagram
    class TyperApp {
        +command(name)(fn)
        +callback(fn)
    }
    class CLICommandABC {
        <<interface>>
        +register(app: TyperApp)
        +run(**kwargs)
    }
    class RunPipelineCommand {
        +__call__(pipeline_name, config_path, profile, limit, output, dry_run)
    }
    class ListPipelinesCommand {
        +__call__()
    }
    class ValidateConfigCommand {
        +__call__(path)
    }
    class RestServer {
        +start()
        +POST /pipelines/run
    }
    class MQConsumer {
        +consume(message)
    }
    class OrchestratorFacade {
        +run_pipeline(request)
    }

    CLICommandABC <|-- RunPipelineCommand
    CLICommandABC <|-- ListPipelinesCommand
    CLICommandABC <|-- ValidateConfigCommand
    TyperApp --> CLICommandABC : registers commands
    RunPipelineCommand --> OrchestratorFacade
    RestServer --> OrchestratorFacade
    MQConsumer --> OrchestratorFacade

