classDiagram
    class PipelineOrchestrator {
        +run(pipeline_name, cli_args)
        +build_pipeline(name, config) -> PipelineBase
    }
    class PipelineContainer {
        +build_pipeline_dependencies(config) -> Dependencies
        +load_provider_registry(profile) -> ProviderRegistryABC
    }
    class PipelineRegistry {
        +register(name, pipeline_cls)
        +get(name) -> type[PipelineBase]
    }
    class PipelineBase {
        <<abstract>>
        +run()
        +extract()
        +transform(df)
        +validate(df)
        +write(df)
        -hooks : list[PipelineHookABC]
        -error_policy : ErrorPolicyABC
    }
    class ChemblPipelineBase {
        +entity : str
        +stages : PipelineStagesConfig
    }
    class PipelineHooksManager {
        +attach(hooks)
        +emit(event, ctx)
    }
    class ErrorPolicyManager {
        +handle(stage, exc)
    }
    class ValidationAppService {
        +validate(schema_name, df)
    }
    class PipelineStagesConfig {
        +extract : bool
        +transform : bool
        +validate : bool
        +write : bool
    }

    PipelineOrchestrator --> PipelineRegistry : resolves pipeline class
    PipelineOrchestrator --> PipelineContainer : builds dependencies
    PipelineContainer --> PipelineHooksManager
    PipelineContainer --> ErrorPolicyManager
    PipelineContainer --> ValidationAppService
    PipelineContainer --> PipelineBase : instantiate with deps
    PipelineBase <|-- ChemblPipelineBase
    PipelineBase --> PipelineHooksManager : notifies events
    PipelineBase --> ErrorPolicyManager : delegates failures

