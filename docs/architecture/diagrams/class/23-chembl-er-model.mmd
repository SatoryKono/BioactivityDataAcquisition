classDiagram
    class Activity {
        +activity_id : int
        +assay_chembl_id : str
        +molecule_chembl_id : str
        +target_chembl_id : str?
        +document_chembl_id : str
        +standard_type/value/units
    }
    class Assay {
        +assay_chembl_id : str
        +assay_type : str
        +target_chembl_id : str?
        +bao_endpoint/format
    }
    class Target {
        +target_chembl_id : str
        +target_pref_name : str?
        +target_organism : str?
        +target_tax_id : int?
    }
    class Publication {
        +document_chembl_id : str
        +doi : str?
        +document_journal/year
    }
    class Molecule {
        +molecule_chembl_id : str
        +parent_molecule_chembl_id : str?
        +canonical_smiles : str?
        +max_phase : int?
    }

    Activity --> Assay : many-to-one\nassay_chembl_id
    Activity --> Target : many-to-one\n(target inferred)
    Activity --> Publication : many-to-one\n(document_chembl_id)
    Activity --> Molecule : many-to-one\nmolecule_chembl_id
    Assay --> Target : zero-or-one target per assay
    Molecule --> Molecule : parent-child (salt/base)

