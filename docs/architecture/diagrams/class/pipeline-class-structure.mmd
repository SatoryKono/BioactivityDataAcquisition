%%{init: { 'classDiagram': { 'useMaxWidth': true } }}%%
classDiagram

    class PipelineBase {
        <<Abstract>>
        +run(output_path, dry_run) RunResult
        +_process_extract_stage(...)
        +_perform_write_stage(...)
        +_normalize_meta(...)
        #_runtime_manager: StageRuntimeManagerImpl
        #_extractor: ExtractorABC
        #_transformer: TransformerABC
        #_post_transformer: TransformerABC
    }

    class ChemblPipelineBase {
        +_extraction_service
        +_entity_model_registry
        +ID_COLUMN: str
        +API_FILTER_KEY: str
        +get_version()
        +get_chembl_release()
    }

    class PipelineExecutor {
        +execute(pipeline, output_path, dry_run) RunResult
        -_run_extraction_phase(...)
        -_run_write_phase(...)
    }

    class StageRuntimeManagerImpl {
        +reset()
        +notify_stage_start(stage, context)
        +notify_stage_end(stage, result)
        +execute_stage(stage, context, fn, on_retry)
        +process_chunk(raw_chunk, context, ...)
        +make_stage_result(stage, count, chunks)
        +handle_stage_failure(stage, results, context)
    }

    class HookNotifier {
        +register_hook(hook)
        +notify_stage_start(stage, ctx)
        +notify_stage_end(stage, result)
        +notify_stage_error(stage, error)
    }

    class StageCounter {
        +mark_stage_start(stage)
        +make_stage_result(stage, ...)
    }

    class StageErrorHandler {
        +handle_error(stage, exc, ctx, attempt)
        +should_retry(error)
        +get_last_error_messages()
    }

    class ErrorPolicyABC {
        <<Interface>>
        +handle(error, context) ErrorAction
        +should_retry(error) bool
    }

    class PipelineHookABC {
        <<Interface>>
        +on_stage_start(stage, context)
        +on_stage_end(stage, result)
        +on_error(stage, error)
    }

    class ValidationService {
        -_schema_provider: SchemaProviderABC
        -_validator_factory: ValidatorFactoryABC
        +validate(df, entity_name)
    }

    class SchemaProviderABC <<Interface>>
    class ValidatorFactoryABC <<Interface>>

    class HashServiceABC <<Interface>>
    class HasherABC <<Interface>>
    class Blake2bHashService
    class HasherImpl

    class LoaderABC <<Interface>>
    class UnifiedLoaderImpl {
        +load(df, path, context) WriteResult
        +write_metadata(meta, path)
        +write_qc_report(df, path)
    }

    class TransformerABC <<Interface>>
    class TransformerChainImpl
    class HashColumnsTransformerImpl
    class IndexColumnTransformerImpl
    class DatabaseVersionTransformerImpl
    class FulldateTransformerImpl
    class NormalizationServiceABC <<Interface>>
    class NormalizationServiceImpl

    class IndexGeneratorABC <<Interface>>
    class SequentialIndexGenerator
    class TimestampProviderABC <<Interface>>
    class DeterministicTimestampProvider

    class ExtractorABC <<Interface>>
    class ExtractStage {
        +extract(**kwargs) Iterable[DataFrame]
    }
    class ChemblExtractionServiceImpl
    class RecordSourceABC <<Interface>>
    class CsvRecordSourceImpl
    class IdListRecordSourceImpl

    class ChemblTransformerImpl {
        +apply(df) DataFrame
    }

    PipelineBase <|-- ChemblPipelineBase
    PipelineBase o-- PipelineExecutor : uses
    PipelineBase o-- ValidationService : uses
    PipelineBase o-- LoaderABC : uses
    PipelineBase o-- HashServiceABC : uses
    PipelineBase o-- TransformerABC : uses
    PipelineBase o-- ExtractorABC : uses
    PipelineBase o-- PipelineHookABC : hooks
    PipelineBase o-- ErrorPolicyABC : error policy
    PipelineBase o-- IndexGeneratorABC : indexes
    PipelineBase o-- TimestampProviderABC : timestamps

    PipelineExecutor o-- StageRuntimeManagerImpl
    StageRuntimeManagerImpl *-- HookNotifier
    StageRuntimeManagerImpl *-- StageCounter
    StageRuntimeManagerImpl *-- StageErrorHandler
    StageErrorHandler ..> ErrorPolicyABC
    HookNotifier ..> PipelineHookABC

    ValidationService ..> SchemaProviderABC : delegates
    ValidationService ..> ValidatorFactoryABC : delegates

    HashServiceABC <|-- Blake2bHashService
    HasherABC <|-- HasherImpl
    Blake2bHashService ..> HasherABC

    LoaderABC <|-- UnifiedLoaderImpl

    TransformerABC <|-- TransformerChainImpl
    TransformerChainImpl *-- HashColumnsTransformerImpl
    TransformerChainImpl *-- IndexColumnTransformerImpl
    TransformerChainImpl *-- DatabaseVersionTransformerImpl
    TransformerChainImpl *-- FulldateTransformerImpl
    TransformerChainImpl ..> HashServiceABC
    TransformerChainImpl ..> IndexGeneratorABC
    TransformerChainImpl ..> TimestampProviderABC

    NormalizationServiceABC <|-- NormalizationServiceImpl
    ChemblTransformerImpl --|> TransformerABC
    ChemblTransformerImpl ..> ValidationService
    ChemblTransformerImpl ..> NormalizationServiceABC

    IndexGeneratorABC <|-- SequentialIndexGenerator
    TimestampProviderABC <|-- DeterministicTimestampProvider

    ExtractorABC <|-- ExtractStage
    ExtractStage ..> ChemblExtractionServiceImpl
    ExtractStage ..> RecordSourceABC
    RecordSourceABC <|-- CsvRecordSourceImpl
    RecordSourceABC <|-- IdListRecordSourceImpl

    ChemblPipelineBase o-- ChemblTransformerImpl
    ChemblPipelineBase o-- ExtractStage
    ChemblPipelineBase ..> NormalizationServiceABC

    class PipelineBase domainPrimary
    class ChemblPipelineBase domainPrimary
    class PipelineExecutor domainPrimary
