classDiagram
    class PipelineConfig {
        id : str
        provider : str
        entity : str
        input_mode : csv|id_only|auto_detect
        input_path : str?
        output_path : str
        batch_size : PositiveInt
        dry_run : bool
        primary_key : str?
        provider_config : ProviderConfigUnion
        runtime : RuntimeConfig
        observability : ObservabilityConfig
        quality : QualityConfig
        features : FeatureFlagsConfig
        pipeline : dict[str, Any]
        fields : list[dict[str, Any]]
    }

    class RuntimeConfig {
        pagination : PaginationConfig
        http : HttpClientConfig
        storage : StorageConfig
        csv : CsvInputConfig
    }

    class ObservabilityConfig {
        logging : LoggingConfig
        metrics : MetricsConfig
    }

    class QualityConfig {
        determinism : DeterminismConfig
        qc : QcConfig
        hashing : HashingConfig
        normalization : NormalizationConfig
    }

    class FeatureFlagsConfig {
        interfaces : InterfaceFeaturesConfig
    }

    class PaginationConfig {
        limit : int
        offset : int
        max_pages : int?
    }

    class HttpClientConfig {
        timeout_sec : PositiveFloat
        max_retries : NonNegativeInt
        retry_on_status : tuple[int, ...]
        backoff_factor : float
        backoff_max : float
        rate_limit_per_sec : PositiveFloat
        circuit_breaker_enabled : bool
        circuit_breaker_threshold : int
        circuit_breaker_recovery_sec : float
    }

    class StorageConfig {
        output_path : str
        cache_path : str
        temp_path : str
    }

    class HashingConfig {
        algorithm : str
        digest_size_bytes : int
        business_key_fields : list[str]
    }

    PipelineConfig --> RuntimeConfig
    PipelineConfig --> ObservabilityConfig
    PipelineConfig --> QualityConfig
    PipelineConfig --> FeatureFlagsConfig
    RuntimeConfig --> PaginationConfig
    RuntimeConfig --> HttpClientConfig
    RuntimeConfig --> StorageConfig
    QualityConfig --> HashingConfig

