%%{init: { 'flowchart': { 'htmlLabels': true, 'useMaxWidth': true } }}%%
flowchart LR
    classDef group fill:#e6ecef,stroke:#333,stroke-width:1.5px,color:#111,font-size:22px;
    classDef suite fill:#f5f5f5,stroke:#444,stroke-width:1.5px,color:#111,font-size:22px;
    classDef detail fill:#e3e7ec,stroke:#555,stroke-width:1.2px,color:#111,font-size:18px;
    linkStyle default stroke:#666,stroke-width:1.2px,color:#111;

    subgraph Unit["tests/bioetl/**"]
        application["application/\n- pipelines/test_pipeline_base.py\n- container/orchestrator tests"]:::suite
        domainTests["domain/\n- schemas/test_activity_schema.py\n- services (hash/normalizers)"]:::suite
        infraTests["infrastructure/\n- clients/test_unified_client.py\n- output/test_writer.py"]:::suite
        interfacesTests["interfaces/\n- cli/test_run_command.py"]:::suite
    end
    class Unit group

    subgraph Golden["tests/golden/"]
        goldenActivity["test_activity_chembl_golden.py\nfixtures: tests/fixtures/input/activity.csv"]:::suite
        goldenAssay["test_assay_chembl_golden.py"]:::suite
        goldenTarget["test_target_chembl_golden.py"]:::suite
        goldenDocument["test_document_chembl_golden.py"]:::suite
        goldenTestItem["test_testitem_chembl_golden.py"]:::suite
    end
    class Golden group

    subgraph Integration["tests/integration/"]
        cliSmoke["test_cli_smoke.py\nruns bioetl run ... --dry-run"]:::suite
        configIntegration["test_config_profiles.py"]:::suite
    end
    class Integration group

    subgraph Architecture["tests/architecture/"]
        layering["test_layer_dependencies.py\n(import-linter enforcement)"]:::suite
        duplication["test_architecture_rules.py"]:::suite
    end
    class Architecture group

    Unit --> Golden --> Integration --> Architecture
    architectureNote(["pytest.ini enforces markers: unit, integration, golden"]):::detail
    Integration --> architectureNote

