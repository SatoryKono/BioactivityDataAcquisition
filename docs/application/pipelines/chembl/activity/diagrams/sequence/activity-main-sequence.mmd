sequenceDiagram
    autonumber
    participant CLI as CLI
    participant Orchestrator as PipelineOrchestrator
    participant Pipeline as ActivityPipeline
    participant Extraction as ChemblExtractionServiceImpl
    participant DataClient as ChemblDataClientHTTPImpl
    participant Transformer as ChemblTransformerImpl
    participant Validator as ValidationService(ActivityTableSchema)
    participant Writer as UnifiedOutputWriter

    CLI->>Orchestrator: run("activity_chembl", args)
    Orchestrator->>Pipeline: instantiate + run()
    Pipeline->>Extraction: extract_all("activity")
    loop pages
        Extraction->>DataClient: request_activity(filters, offset, limit)
        DataClient-->>Extraction: page (records + page_meta)
        Extraction-->>Pipeline: batch (RawActivityPayload serialized)
        Pipeline->>Transformer: apply(batch_df)
        Transformer-->>Pipeline: normalized_df (serialized nested fields)
        Pipeline->>Validator: validate("chembl.activity", normalized_df)
        Validator-->>Pipeline: validated_df
        Pipeline->>Pipeline: append(validated_df)
    end
    alt dry_run == False
        Pipeline->>Writer: write(all_validated_df, output_cfg)
        Writer-->>Pipeline: result(meta.yaml, checksums)
    else dry_run
        Pipeline->>Pipeline: skip write but log stats
    end
    Pipeline-->>Orchestrator: RunResult(meta, duration)
    Orchestrator-->>CLI: success / error

