classDiagram
    class ActivityPipeline {
        <<ChemblPipelineBase>>
        +entity = "activity"
        +input_mode : api|csv|id_only
        +stages : PipelineStagesConfig
        -extraction_service : ChemblExtractionServiceImpl
        -transformer : ChemblTransformerImpl
        -validation_service : ValidationService
        -hash_service : HashService
        -output_writer : UnifiedOutputWriter
        -hooks : list[PipelineHookABC]
        +run() -> RunResult
    }

    class ChemblExtractionServiceImpl {
        +extract_all(config) -> Iterable[DataFrame]
        -client : ChemblDataClientHTTPImpl
        -record_sources : CsvRecordSourceImpl
    }

    class ChemblTransformerImpl {
        +apply(df) -> DataFrame
        -normalization_service : NormalizationServiceABC
        -hash_service : HashService
        -schema_columns : list[str]
    }

    class ValidationService {
        +validate("chembl.activity", df) -> DataFrame
        -schema_registry : SchemaRegistry
    }

    class UnifiedOutputWriter {
        +write(df, cfg) -> WriteResult
        -csv_writer : CsvWriter
        -metadata_writer : MetadataWriter
    }

    class HashService {
        +hash_row(df) -> DataFrame
        +hash_business_key(df, fields) -> DataFrame
    }

    ActivityPipeline o-- ChemblExtractionServiceImpl
    ActivityPipeline o-- ChemblTransformerImpl
    ActivityPipeline o-- ValidationService
    ActivityPipeline o-- HashService
    ActivityPipeline o-- UnifiedOutputWriter

