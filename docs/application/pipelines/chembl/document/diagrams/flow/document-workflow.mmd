flowchart TD
    classDef stepPrimary   fill:#f5f5f5,stroke:#444,stroke-width:1.5px,color:#111,font-size:22px;
    classDef stepSecondary fill:#e3e7ec,stroke:#555,stroke-width:1.2px,color:#111,font-size:18px;
    classDef stepDecision  fill:#e6ecef,stroke:#333,stroke-width:1.5px,color:#111,font-size:22px;
    classDef stepTerminal  fill:#dde7f2,stroke:#44546a,stroke-width:1.5px,color:#111,font-size:22px;
    linkStyle default stroke:#666,stroke-width:1.2px,color:#111;

    Start([Start document_chembl run]):::stepTerminal --> Extract["Extract document records\n- /document endpoint (API/CSV)\n- flatten base metadata (doi, journal, year)"]:::stepPrimary
    Extract --> Enrich["Literature enrichment\n- query OpenAlex/Semantic Scholar by DOI\n- capture citation_count, topics, external IDs"]:::stepPrimary
    Enrich --> Transform["DocumentTransformer\n- normalize DOI format\n- coerce year to int\n- ensure deterministic serialization"]:::stepPrimary
    Transform --> Hash["Add hash_row/hash_business_key/index/extracted_at"]:::stepSecondary
    Hash --> Validate["DocumentTableSchema validation\n- document_chembl_id regex\n- year numeric\n- DOI optional"]:::stepPrimary
    Validate --> Decision{Dry run?}:::stepDecision
    Decision -- No --> Write["UnifiedOutputWriter\nstable sort by document_chembl_id\natomic CSV/Parquet"]:::stepPrimary
    Write --> Meta["meta.yaml + QC"]:::stepSecondary --> End([Success]):::stepTerminal
    Decision -- Yes --> SkipWrite["Skip write but log summary"]:::stepSecondary --> End
    Enrich -->|API timeout| Warn["Log warning, set enrichment_partial=true"]:::stepSecondary --> Transform

