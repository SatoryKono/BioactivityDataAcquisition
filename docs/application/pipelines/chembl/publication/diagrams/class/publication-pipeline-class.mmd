classDiagram
    class PublicationPipeline {
        <<ChemblPipelineBase>>
        +entity = "publication"
        -extraction_service : ChemblExtractionServiceImpl
        -transformer : PublicationTransformer
        -enrichment_service : LiteratureEnrichmentService
        -validation_service : ValidationService
        -output_writer : UnifiedOutputWriter
    }

    class LiteratureEnrichmentService {
        +fetch_openalex(dois) -> dict
        +fetch_semantic_scholar(dois) -> dict
        -openalex_client : UnifiedAPIClient
        -semantic_client : UnifiedAPIClient
    }

    class PublicationTransformer {
        <<ChemblTransformerImpl>>
        +merge_enrichment(df, enrichment) -> DataFrame
        -_normalize_doi()
        -_coerce_year()
    }

    PublicationPipeline o-- ChemblExtractionServiceImpl
    PublicationPipeline o-- LiteratureEnrichmentService
    PublicationPipeline o-- PublicationTransformer
    PublicationPipeline o-- ValidationService
    PublicationPipeline o-- UnifiedOutputWriter

