%%{init: { 'flowchart': { 'htmlLabels': true, 'useMaxWidth': true } }}%%
flowchart TD
    classDef stepPrimary   fill:#f5f5f5,stroke:#444,stroke-width:1.5px,color:#111,font-size:22px;
    classDef stepSecondary fill:#e3e7ec,stroke:#555,stroke-width:1.2px,color:#111,font-size:18px;
    classDef stepDecision  fill:#e6ecef,stroke:#333,stroke-width:1.5px,color:#111,font-size:22px;
    classDef stepTerminal  fill:#dde7f2,stroke:#44546a,stroke-width:1.5px,color:#111,font-size:22px;
    linkStyle default stroke:#666,stroke-width:1.2px,color:#111;

    Start([Start testitem_chembl run]):::stepTerminal --> Extract["Extract molecule/test item records\n- /molecule endpoint\n- flatten properties/structures/synonyms\n- supports CSV + ID-only modes"]:::stepPrimary
    Extract --> Transform["ChemblTransformerImpl (TestItem)\n- serialize ATC classifications\n- explode molecule_properties & structures\n- ensure parent_molecule_chembl_id pointers"]:::stepPrimary
    Transform --> Hash["Hash columns + index + extracted_at"]:::stepSecondary
    Hash --> Validate["TestItemSchema validation\n- molecule_chembl_id regex\n- canonical_smiles optional\n- parent_id consistent"]:::stepPrimary
    Validate --> Decision{Dry run?}:::stepDecision
    Decision -- No --> Write["UnifiedOutputWriter\nstable sort by molecule_chembl_id"]:::stepPrimary
    Write --> Meta["meta.yaml + QC"]:::stepSecondary --> End([Success]):::stepTerminal
    Decision -- Yes --> SkipWrite["Skip write but log stats"]:::stepSecondary --> End
    Extract -->|API/CSV error| Fail([FailFast]):::stepTerminal

