sequenceDiagram
    autonumber
    participant CLI as CLI
    participant Orchestrator as PipelineOrchestrator
    participant Pipeline as TestItemPipeline
    participant Extraction as ChemblExtractionService
    participant DataClient as ChemblDataClientHTTPImpl
    participant Transformer as ChemblTransformerImpl
    participant Validator as ValidationService(TestItemSchema)
    participant Writer as UnifiedOutputWriter

    CLI->>Orchestrator: run("testitem_chembl")
    Orchestrator->>Pipeline: build + run
    Pipeline->>Extraction: extract_all("molecule")
    loop page
        Extraction->>DataClient: request_molecule(offset)
        DataClient-->>Extraction: molecule page
        Extraction-->>Pipeline: batch_df
        Pipeline->>Transformer: apply(batch_df)
        Transformer-->>Pipeline: normalized_df (serialized ATC/properties/synonyms)
        Pipeline->>Validator: validate("chembl.testitem", normalized_df)
        Validator-->>Pipeline: validated_df
        Pipeline->>Pipeline: accumulate(validated_df)
    end
    alt dry_run == False
        Pipeline->>Writer: write(sorted_df, cfg)
        Writer-->>Pipeline: meta/checksums
    else dry_run
        Pipeline->>Pipeline: skip write
    end
    Pipeline-->>Orchestrator: RunResult
    Orchestrator-->>CLI: summary

