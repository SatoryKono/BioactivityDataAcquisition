sequenceDiagram
    autonumber
    participant CLI as CLI
    participant Orchestrator as PipelineOrchestrator
    participant Pipeline as AssayPipeline
    participant Extraction as ChemblExtractionService
    participant DataClient as ChemblDataClientHTTPImpl
    participant Transformer as AssayTransformer
    participant Validator as ValidationService(AssaySchema)
    participant Writer as UnifiedOutputWriter

    CLI->>Orchestrator: run("assay_chembl", args)
    Orchestrator->>Pipeline: build + run
    Pipeline->>Extraction: extract_all("assay")
    loop for each page
        Extraction->>DataClient: request_assay(filters, offset)
        DataClient-->>Extraction: page dict
        Extraction-->>Pipeline: batch_df
        Pipeline->>Transformer: do_transform(batch_df)
        Transformer->>Transformer: normalize assay_classifications & parameters
        Transformer-->>Pipeline: normalized_df
        Pipeline->>Validator: validate("chembl.assay", normalized_df)
        Validator-->>Pipeline: validated_df
        Pipeline->>Pipeline: append(validated_df)
    end
    alt dry_run == False
        Pipeline->>Writer: write(sorted_df, output_cfg)
        Writer-->>Pipeline: meta + checksums
    else dry_run
        Pipeline->>Pipeline: skip write (log stats only)
    end
    Pipeline-->>Orchestrator: RunResult
    Orchestrator-->>CLI: summary

