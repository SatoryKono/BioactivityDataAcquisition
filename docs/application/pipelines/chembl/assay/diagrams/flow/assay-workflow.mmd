%%{init: { 'flowchart': { 'htmlLabels': true, 'useMaxWidth': true } }}%%
flowchart TD
    start([Start assay chembl run])
    extract(["Extract assay pages"])
    transform(["Transform and normalize"])
    validate(["Validate with Pandera schema"])
    decision{Dry run?}
    write(["Stable sort + write outputs"])
    meta(["Generate meta.yaml"])
    skip_write(["Skip write; produce summary"])
    retry{Retry / Skip / Fail per policy}
    success_state([Success])

    start --> extract
    extract --> transform
    transform --> validate
    validate --> decision
    decision -- No --> write
    decision -- Yes --> skip_write
    write --> meta
    meta --> success_state
    skip_write --> success_state
    extract -->|Error| retry
    retry --> extract
    retry --> success_state

