classDiagram
    class AssayPipeline {
        <<ChemblPipelineBase>>
        +entity = "assay"
        -extraction_service : ChemblExtractionServiceImpl
        -transformer : AssayTransformer
        -validation_service : ValidationService
        -output_writer : UnifiedOutputWriter
        -hash_service : HashService
    }

    class AssayTransformer {
        <<ChemblTransformerImpl>>
        +do_transform(df) -> DataFrame
        -_serialize_classifications()
        -_serialize_parameters()
    }

    class ChemblExtractionServiceImpl {
        +extract_all("assay")
    }

    class ValidationService {
        +validate("chembl.assay", df) -> DataFrame
    }

    class UnifiedOutputWriter {
        +write(df, cfg) -> WriteResult
    }

    class HashService {
        +hash_row()
        +hash_business_key()
    }

    AssayPipeline o-- ChemblExtractionServiceImpl
    AssayPipeline o-- AssayTransformer
    AssayPipeline o-- ValidationService
    AssayPipeline o-- UnifiedOutputWriter
    AssayPipeline o-- HashService

