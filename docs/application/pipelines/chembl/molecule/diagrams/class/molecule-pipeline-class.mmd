classDiagram
    class MoleculePipeline {
        <<ChemblPipelineBase>>
        +entity = "molecule"
        -extraction_service : ChemblExtractionServiceImpl
        -transformer : ChemblTransformerImpl
        -validation_service : ValidationService
        -hash_service : HashService
        -output_writer : UnifiedOutputWriter
    }

    class ChemblExtractionServiceImpl {
        +extract_all("molecule")
        -client : ChemblDataClientHTTPImpl
        -csv_source : CsvRecordSourceImpl
    }

    class ChemblTransformerImpl {
        +apply(df) -> DataFrame
        -_serialize_nested_fields()
        -_ensure_required_columns()
    }

    class ValidationService {
        +validate("chembl.testitem", df)
    }

    class HashService {
        +hash_row()
        +hash_business_key()
    }

    class UnifiedOutputWriter {
        +write(df, cfg)
    }

    MoleculePipeline o-- ChemblExtractionServiceImpl
    MoleculePipeline o-- ChemblTransformerImpl
    MoleculePipeline o-- ValidationService
    MoleculePipeline o-- HashService
    MoleculePipeline o-- UnifiedOutputWriter

