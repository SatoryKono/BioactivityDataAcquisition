flowchart TD
    classDef stepPrimary   fill:#f5f5f5,stroke:#444,stroke-width:1.5px,color:#111,font-size:22px;
    classDef stepSecondary fill:#e3e7ec,stroke:#555,stroke-width:1.2px,color:#111,font-size:18px;
    classDef stepDecision  fill:#e6ecef,stroke:#333,stroke-width:1.5px,color:#111,font-size:22px;
    classDef stepTerminal  fill:#dde7f2,stroke:#44546a,stroke-width:1.5px,color:#111,font-size:22px;
    linkStyle default stroke:#666,stroke-width:1.2px,color:#111;

    Start([Start target_chembl run]):::stepTerminal --> Extract["Extract target records\n- /target endpoint API/CSV\n- flatten components (accessions, synonyms)"]:::stepPrimary
    Extract --> Enrich["External enrichment\n- fetch UniProt/IUPHAR by accession\n- merge gene_name / sequence metadata"]:::stepPrimary
    Enrich --> Transform["TargetTransformer\n- normalize identifiers\n- explode multi-component families\n- enforce CHEMBL regex"]:::stepPrimary
    Transform --> Hash["Post-transform hash/index/extracted_at"]:::stepSecondary
    Hash --> Validate["TargetSchema validation\n- target_chembl_id required\n- gene/taxonomy optional"]:::stepPrimary
    Validate --> Decision{Dry run?}:::stepDecision
    Decision -- No --> Write["UnifiedOutputWriter\nstable sort by target_chembl_id"]:::stepPrimary
    Write --> Meta["meta.yaml + QC"]:::stepSecondary
    Meta --> End([Success]):::stepTerminal
    Decision -- Yes --> SkipWrite["Skip write but emit metrics"]:::stepSecondary --> End
    Extract -->|API error| Fail([FailFast]):::stepTerminal
    Enrich -->|Unreachable| Warn["Log warning + enrichment_partial=true"]:::stepSecondary --> Transform

