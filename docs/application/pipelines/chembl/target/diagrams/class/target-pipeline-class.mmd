classDiagram
    class TargetPipeline {
        <<ChemblPipelineBase>>
        +entity = "target"
        -extraction_service : ChemblExtractionServiceImpl
        -transformer : TargetTransformer
        -enrichment_service : TargetEnrichmentService
        -validation_service : ValidationService
        -output_writer : UnifiedOutputWriter
    }

    class TargetEnrichmentService {
        +fetch_uniprot(batch) -> dict
        +fetch_iuphar(batch) -> dict
        -client : UnifiedAPIClient
        -rate_limit : RateLimiter
    }

    class TargetTransformer {
        <<ChemblTransformerImpl>>
        +do_transform(df, enrichment) -> DataFrame
        -_merge_synonyms()
        -_normalize_components()
    }

    TargetPipeline o-- ChemblExtractionServiceImpl
    TargetPipeline o-- TargetEnrichmentService
    TargetPipeline o-- TargetTransformer
    TargetPipeline o-- ValidationService
    TargetPipeline o-- UnifiedOutputWriter

