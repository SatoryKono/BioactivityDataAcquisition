%% Shared palette (per diagramming policy)
classDef actorPrimary   fill:#f5f5f5,stroke:#444,stroke-width:1.5px,color:#111,font-size:22px;
classDef actorSecondary fill:#e3e7ec,stroke:#555,stroke-width:1.2px,color:#111,font-size:18px;
classDef actorExternal  fill:#dde7f2,stroke:#44546a,stroke-width:1.5px,color:#111,font-size:22px;
linkStyle default stroke:#666,stroke-width:1.2px,color:#111;

sequenceDiagram
    autonumber
    participant CLI as CLI
    participant Orchestrator as PipelineOrchestrator
    participant Pipeline as TargetPipeline
    participant Extraction as ChemblExtractionService
    participant DataClient as ChemblDataClientHTTPImpl
    participant Enrich as UniProt/IUPHAR Client
    participant Transformer as TargetTransformer
    participant Validator as ValidationService(TargetTableSchema)
    participant Writer as UnifiedOutputWriter

    class CLI actorPrimary
    class Orchestrator actorPrimary
    class Pipeline actorPrimary
    class Extraction actorSecondary
    class DataClient actorSecondary
    class Enrich actorExternal
    class Transformer actorSecondary
    class Validator actorSecondary
    class Writer actorPrimary

    CLI->>Orchestrator: run("target_chembl")
    Orchestrator->>Pipeline: build + run
    Pipeline->>Extraction: extract_all("target")
    loop page
        Extraction->>DataClient: request_target(offset)
        DataClient-->>Extraction: target page
        Extraction-->>Pipeline: batch_df
        Pipeline->>Enrich: fetch_uniprot(batch_df.uniprot_accession)
        Enrich-->>Pipeline: enrichment dict (gene_name, sequence, iuphar_id)
        Pipeline->>Transformer: merge_enrichment(batch_df, enrichment)
        Transformer-->>Pipeline: normalized_df
        Pipeline->>Validator: validate("chembl.target", normalized_df)
        Validator-->>Pipeline: validated_df
        Pipeline->>Pipeline: append(validated_df)
    end
    alt dry_run == False
        Pipeline->>Writer: write(sorted_df, cfg)
        Writer-->>Pipeline: meta/checksums
    else dry_run
        Pipeline->>Pipeline: skip write
    end
    Pipeline-->>Orchestrator: RunResult
    Orchestrator-->>CLI: summary

