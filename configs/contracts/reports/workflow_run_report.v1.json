{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bioetl://contracts/reports/workflow_run_report.v1.json",
  "title": "workflow_run_report_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "plan",
    "execution",
    "totals"
  ],
  "properties": {
    "schema_version": {
      "const": "workflow_run_report_v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_name", "status"],
      "properties": {
        "workflow_name": { "type": "string", "minLength": 1 },
        "workflow_version": { "type": ["string", "null"] },
        "workflow_run_id": { "type": ["string", "null"] },
        "manifest_id": { "type": ["string", "null"] },
        "execution_fingerprint": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": ["success", "failed", "partial", "running"]
        },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "duration_seconds": { "type": ["number", "null"] },
        "resumed": { "type": "boolean" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "kind"],
            "properties": {
              "step_id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "pipeline_name": { "type": ["string", "null"] },
              "transform_name": { "type": ["string", "null"] },
              "depends_on": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "status", "records_extracted"],
        "properties": {
          "step_id": { "type": "string" },
          "kind": { "type": ["string", "null"] },
          "pipeline_name": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "records_extracted": { "type": "integer", "minimum": 0 },
          "records_bronze": { "type": ["integer", "null"], "minimum": 0 },
          "records_silver": { "type": ["integer", "null"], "minimum": 0 },
          "records_gold": { "type": ["integer", "null"], "minimum": 0 },
          "pipeline_run_id": { "type": ["string", "null"] },
          "pipeline_manifest_id": { "type": ["string", "null"] },
          "pipeline_report_ref": { "type": ["string", "null"] },
          "error_type": { "type": ["string", "null"] },
          "error_message": { "type": ["string", "null"] },
          "skip_reason": { "type": ["string", "null"] },
          "top_reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps_planned",
        "steps_succeeded",
        "steps_failed",
        "steps_skipped",
        "records_extracted_sum"
      ],
      "properties": {
        "steps_planned": { "type": "integer", "minimum": 0 },
        "steps_succeeded": { "type": "integer", "minimum": 0 },
        "steps_failed": { "type": "integer", "minimum": 0 },
        "steps_skipped": { "type": "integer", "minimum": 0 },
        "records_extracted_sum": { "type": "integer", "minimum": 0 },
        "records_silver_sum": { "type": ["integer", "null"], "minimum": 0 },
        "records_gold_sum": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "records_extracted": { "type": "integer", "minimum": 0 },
          "step_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "reasons_rollup": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
