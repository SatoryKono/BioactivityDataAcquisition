{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bioetl://contracts/reports/pipeline_run_report.v1.json",
  "title": "pipeline_run_report_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reason_catalog_version",
    "identity",
    "funnel",
    "layers",
    "reasons_top_n",
    "reconciliation",
    "tracking_coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "pipeline_run_report_v1"
    },
    "reason_catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "pipeline_name",
        "run_type",
        "status"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "manifest_id": { "type": ["string", "null"] },
        "pipeline_name": { "type": "string", "minLength": 1 },
        "provider": { "type": ["string", "null"] },
        "entity": { "type": ["string", "null"] },
        "run_type": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["success", "failed", "shutdown", "dry_run", "partial"]
        },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "duration_seconds": { "type": ["number", "null"] },
        "workflow_id": { "type": ["string", "null"] },
        "workflow_run_id": { "type": ["string", "null"] },
        "workflow_step_id": { "type": ["string", "null"] }
      }
    },
    "funnel": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "records_in",
          "records_out",
          "removed_total",
          "removals",
          "balance_status",
          "tracking"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "enum": [
              "extract",
              "bronze",
              "silver",
              "gold",
              "export"
            ]
          },
          "records_in": { "type": "integer", "minimum": 0 },
          "records_out": { "type": "integer", "minimum": 0 },
          "removed_total": { "type": "integer", "minimum": 0 },
          "removals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome", "reason_code", "count"],
              "properties": {
                "outcome": {
                  "type": "string",
                  "enum": [
                    "filtered_out",
                    "quarantined",
                    "skipped",
                    "deduplicated",
                    "excluded_by_contract",
                    "other"
                  ]
                },
                "reason_code": { "type": "string", "minLength": 1 },
                "reason_family": { "type": ["string", "null"] },
                "count": { "type": "integer", "minimum": 0 },
                "sample_refs": {
                  "type": "array",
                  "items": { "type": "string" },
                  "maxItems": 20
                }
              }
            }
          },
          "balance_status": {
            "type": "string",
            "enum": ["OK", "DEGRADED", "FAILING", "UNKNOWN"]
          },
          "tracking": {
            "type": "string",
            "enum": ["full", "partial", "not_tracked"]
          },
          "unaccounted": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bronze_records",
        "silver_valid",
        "silver_filtered_out",
        "silver_quarantined",
        "silver_skipped",
        "silver_deduplicated",
        "gold_written",
        "gold_excluded_by_contract",
        "gold_quarantined",
        "gold_skipped",
        "gold_deduplicated"
      ],
      "properties": {
        "bronze_records": { "type": "integer", "minimum": 0 },
        "silver_valid": { "type": "integer", "minimum": 0 },
        "silver_filtered_out": { "type": "integer", "minimum": 0 },
        "silver_quarantined": { "type": "integer", "minimum": 0 },
        "silver_skipped": { "type": "integer", "minimum": 0 },
        "silver_deduplicated": { "type": "integer", "minimum": 0 },
        "gold_written": { "type": "integer", "minimum": 0 },
        "gold_excluded_by_contract": { "type": "integer", "minimum": 0 },
        "gold_quarantined": { "type": "integer", "minimum": 0 },
        "gold_skipped": { "type": "integer", "minimum": 0 },
        "gold_deduplicated": { "type": "integer", "minimum": 0 }
      }
    },
    "reasons_top_n": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason_code", "count"],
        "properties": {
          "reason_code": { "type": "string" },
          "reason_family": { "type": ["string", "null"] },
          "outcome": { "type": ["string", "null"] },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string" },
          "ref": { "type": "string" },
          "hash": { "type": ["string", "null"] }
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "silver_vs_bronze_status",
        "gold_vs_silver_status",
        "silver_accounted",
        "gold_accounted"
      ],
      "properties": {
        "silver_vs_bronze_status": {
          "type": "string",
          "enum": ["OK", "DEGRADED", "FAILING", "UNKNOWN"]
        },
        "gold_vs_silver_status": {
          "type": "string",
          "enum": ["OK", "DEGRADED", "FAILING", "UNKNOWN"]
        },
        "silver_accounted": { "type": "integer", "minimum": 0 },
        "gold_accounted": { "type": "integer", "minimum": 0 },
        "silver_delta": { "type": "integer" },
        "gold_delta": { "type": "integer" }
      }
    },
    "tracking_coverage": {
      "type": "string",
      "enum": ["full", "partial", "not_tracked"]
    },
    "failure": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "error_type": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] },
        "failed_stage": { "type": ["string", "null"] },
        "exit_hint": { "type": ["string", "null"] }
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": true
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": true
    },
    "dq_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "contract_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": true
    },
    "stage_timings": {
      "type": "object",
      "additionalProperties": true
    },
    "http_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "performance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
