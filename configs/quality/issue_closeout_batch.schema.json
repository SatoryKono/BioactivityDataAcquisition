{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioetl.local/contracts/issue-closeout-batch.schema.json",
  "title": "BioETL issue closeout batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "issues"],
  "properties": {
    "schema_version": {"const": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "criteria"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/criterion"}
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "requires"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "requires": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["bundle_outcome"],
              "properties": {"bundle_outcome": {"const": "ADMIT"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["receipt_id"],
              "properties": {"receipt_id": {"type": "string", "minLength": 1}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_kind"],
              "properties": {
                "evidence_kind": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    }
  }
}
