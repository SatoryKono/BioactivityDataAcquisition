{
  "agent": {
    "default_profile": "bioetl-ask",
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_confirm": [{"pattern": "\\.env"}],
          "always_deny": [
            {"pattern": "\\bRemove-Item\\b"},
            {"pattern": "\\bgit\\s+clean\\b"},
            {"pattern": "\\bgit\\s+reset\\s+--hard\\b"}
          ]
        },
        "edit_file": {
          "default": "confirm",
          "always_deny": [
            {"pattern": "(^|[\\\\/])\\.env($|[.\\\\/])"},
            {"pattern": "\\.(pem|key|cert|crt)$"}
          ]
        },
        "write_file": {
          "default": "confirm",
          "always_deny": [
            {"pattern": "(^|[\\\\/])\\.env($|[.\\\\/])"},
            {"pattern": "\\.(pem|key|cert|crt)$"}
          ]
        },
        "delete_path": {
          "default": "confirm",
          "always_deny": [
            {"pattern": "(^|[\\\\/])\\.env($|[.\\\\/])"},
            {"pattern": "\\.(pem|key|cert|crt)$"}
          ]
        },
        "move_path": {
          "default": "confirm",
          "always_deny": [
            {"pattern": "(^|[\\\\/])\\.env($|[.\\\\/])"},
            {"pattern": "\\.(pem|key|cert|crt)$"}
          ]
        },
        "copy_path": {
          "default": "confirm",
          "always_deny": [
            {"pattern": "(^|[\\\\/])\\.env($|[.\\\\/])"},
            {"pattern": "\\.(pem|key|cert|crt)$"}
          ]
        },
        "create_directory": {
          "default": "confirm",
          "always_deny": [{"pattern": "(^|[\\\\/])\\.env($|[.\\\\/])"}]
        },
        "fetch": {"default": "confirm"},
        "search_web": {"default": "confirm"},
        "skill": {"default": "confirm"}
      }
    },
    "profiles": {
      "bioetl-ask": {
        "name": "BioETL Ask",
        "tools": {
          "diagnostics": true,
          "find_path": true,
          "grep": true,
          "list_directory": true,
          "read_file": true,
          "terminal": false,
          "edit_file": false,
          "write_file": false,
          "delete_path": false,
          "move_path": false,
          "copy_path": false,
          "create_directory": false,
          "spawn_agent": false,
          "skill": false,
          "fetch": false,
          "search_web": false
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      },
      "bioetl-write": {
        "name": "BioETL Write (confirm changes)",
        "tools": {
          "diagnostics": true,
          "find_path": true,
          "grep": true,
          "list_directory": true,
          "read_file": true,
          "terminal": true,
          "edit_file": true,
          "write_file": true,
          "delete_path": true,
          "move_path": true,
          "copy_path": true,
          "create_directory": true,
          "fetch": true,
          "search_web": true,
          "skill": false,
          "spawn_agent": false
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    }
  }
}
