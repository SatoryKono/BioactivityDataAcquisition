{
  "$defs": {
    "ConditionalValidationConfig": {
      "description": "Configuration for conditional validation rule.",
      "properties": {
        "name": {
          "description": "Unique validation rule name",
          "title": "Name",
          "type": "string"
        },
        "condition_field": {
          "description": "Field to check for condition",
          "title": "Condition Field",
          "type": "string"
        },
        "condition_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "Value(s) that trigger",
          "title": "Condition Value"
        },
        "condition_operator": {
          "default": "eq",
          "description": "Comparison operator",
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in"
          ],
          "title": "Condition Operator",
          "type": "string"
        },
        "then_validations": {
          "description": "Validations to apply when condition is true",
          "items": {
            "$ref": "#/$defs/FieldValidationConfig"
          },
          "title": "Then Validations",
          "type": "array"
        }
      },
      "required": [
        "name",
        "condition_field",
        "condition_value"
      ],
      "title": "ConditionalValidationConfig",
      "type": "object"
    },
    "CrossFieldValidationConfig": {
      "description": "Configuration for cross-field validation rule.",
      "properties": {
        "name": {
          "description": "Unique validation rule name",
          "title": "Name",
          "type": "string"
        },
        "fields": {
          "description": "Fields involved in validation",
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "condition": {
          "description": "Validation condition type",
          "enum": [
            "all_present",
            "any_present",
            "mutually_exclusive",
            "conditional_required",
            "custom"
          ],
          "title": "Condition",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "description": "Severity level (error or warn)",
          "enum": [
            "error",
            "warn"
          ],
          "title": "Severity",
          "type": "string"
        },
        "trigger_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field that triggers conditional requirement",
          "title": "Trigger Field"
        },
        "required_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field required when trigger is present",
          "title": "Required Field"
        },
        "validator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom validator name",
          "title": "Validator"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom error message",
          "title": "Error Message"
        }
      },
      "required": [
        "name",
        "fields",
        "condition"
      ],
      "title": "CrossFieldValidationConfig",
      "type": "object"
    },
    "DQReportYamlConfig": {
      "description": "Configuration for DQ report generation.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Generate DQ reports",
          "title": "Enabled",
          "type": "boolean"
        },
        "format": {
          "default": "json",
          "description": "Report format",
          "enum": [
            "json",
            "yaml",
            "csv"
          ],
          "title": "Format",
          "type": "string"
        },
        "include_sample_failures": {
          "default": true,
          "description": "Include sample failed records",
          "title": "Include Sample Failures",
          "type": "boolean"
        },
        "sample_size": {
          "default": 10,
          "description": "Number of sample failures",
          "maximum": 100,
          "minimum": 1,
          "title": "Sample Size",
          "type": "integer"
        },
        "output_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom output path",
          "title": "Output Path"
        }
      },
      "title": "DQReportYamlConfig",
      "type": "object"
    },
    "FieldValidationConfig": {
      "description": "Configuration for a single field validation rule.",
      "properties": {
        "field": {
          "description": "Field name to validate",
          "title": "Field",
          "type": "string"
        },
        "type": {
          "description": "Validation type",
          "enum": [
            "required",
            "not_null",
            "range",
            "pattern",
            "enum",
            "max_length",
            "not_empty_list",
            "custom"
          ],
          "title": "Type",
          "type": "string"
        },
        "nullable": {
          "default": true,
          "description": "Whether field can be null",
          "title": "Nullable",
          "type": "boolean"
        },
        "severity": {
          "default": "error",
          "description": "Severity level (error or warn)",
          "enum": [
            "error",
            "warn"
          ],
          "title": "Severity",
          "type": "string"
        },
        "severity_enricher": {
          "anyOf": [
            {
              "enum": [
                "error",
                "warn"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override severity when running as enricher in composite pipeline",
          "title": "Severity Enricher"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum value (range)",
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum value (range)",
          "title": "Max"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex pattern",
          "title": "Pattern"
        },
        "allowed": {
          "description": "Allowed values",
          "items": {
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "max_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum string length",
          "title": "Max Length"
        },
        "validator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom validator name",
          "title": "Validator"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom error message",
          "title": "Error Message"
        }
      },
      "required": [
        "field",
        "type"
      ],
      "title": "FieldValidationConfig",
      "type": "object"
    },
    "KeyNullabilityRuleConfig": {
      "description": "Nullability policy for Silver merge/partition keys.",
      "properties": {
        "field": {
          "description": "Field name",
          "title": "Field",
          "type": "string"
        },
        "key_type": {
          "description": "Key role in Silver write strategy",
          "enum": [
            "merge",
            "partition"
          ],
          "title": "Key Type",
          "type": "string"
        },
        "nullable": {
          "default": false,
          "description": "Whether null values are allowed for this key field",
          "title": "Nullable",
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "key_type"
      ],
      "title": "KeyNullabilityRuleConfig",
      "type": "object"
    },
    "ThresholdsConfig": {
      "description": "Threshold configuration section.\n\nValidates DQ error thresholds for warning and failure modes.\nEnforces the invariant that soft_fail must be less than hard_fail.\n\nAttributes:\n    soft_fail: Warning threshold (0.0-1.0). Default: 0.05 (5%).\n        When error rate exceeds this threshold, a warning is emitted.\n    hard_fail: Failure threshold (0.0-1.0). Default: 0.20 (20%).\n        When error rate exceeds this threshold, the batch fails.\n\nExample:\n    >>> thresholds = ThresholdsConfig(soft_fail=0.05, hard_fail=0.15)\n    >>> thresholds.soft_fail\n    0.05\n    >>> thresholds.hard_fail\n    0.15",
      "properties": {
        "soft_fail": {
          "default": 0.05,
          "description": "Warning threshold (0.0-1.0). Default: 0.05 (5%)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Soft Fail",
          "type": "number"
        },
        "hard_fail": {
          "default": 0.2,
          "description": "Failure threshold (0.0-1.0). Default: 0.20 (20%)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hard Fail",
          "type": "number"
        }
      },
      "title": "ThresholdsConfig",
      "type": "object"
    }
  },
  "description": "Complete DQ configuration file schema.\n\nRepresents structure of configs/quality/*.yaml files.\nSupports three levels of field validations for hierarchical merge:\n- common_*: from _defaults.yaml\n- provider_*: from providers/{provider}.yaml\n- entity_*: from entities/{provider}/{entity}.yaml\n\nThe merge order is: common → provider → entity (entity takes precedence).\n\nAttributes:\n    version: Schema version for compatibility checking.\n    provider: Provider name (optional, for provider/entity configs).\n    entity: Entity name (optional, for entity configs).\n    thresholds: DQ threshold configuration (soft/hard fail).\n    strict_validation: DQ-only strictness flag for hierarchical quality configs.\n        Contract YAML under configs/contracts/* uses strict_dq_validation as the\n        canonical file key; strict_validation there is legacy alias wording only.\n    invalid_record_policy: How to handle invalid records.\n    report: DQ report generation settings.\n    common_field_validations: Field validations from defaults.\n    provider_field_validations: Field validations from provider config.\n    entity_field_validations: Field validations from entity config.\n    common_cross_field_validations: Cross-field validations from defaults.\n    entity_cross_field_validations: Cross-field validations from entity.\n    entity_conditional_validations: Conditional validations from entity.\n\nExample:\n    >>> config = DQConfigFile(\n    ...     provider='chembl',\n    ...     entity='activity',\n    ...     thresholds=ThresholdsConfig(soft_fail=0.05, hard_fail=0.15),\n    ...     entity_field_validations=[\n    ...         FieldValidationConfig(\n    ...             field='activity_id',\n    ...             type='range',\n    ...             nullable=False\n    ...         )\n    ...     ]\n    ... )\n    >>> domain = config.to_domain()",
  "properties": {
    "version": {
      "default": "1.0.0",
      "description": "Schema version for compatibility checking",
      "title": "Version",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider name (for provider/entity configs)",
      "title": "Provider"
    },
    "entity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Entity name (for entity configs)",
      "title": "Entity"
    },
    "thresholds": {
      "$ref": "#/$defs/ThresholdsConfig",
      "description": "DQ threshold configuration"
    },
    "strict_validation": {
      "default": false,
      "description": "Enable DQ-only stricter validation rules for configs/quality/*.yaml. Contract YAML under configs/contracts/* uses strict_dq_validation as the canonical file key.",
      "title": "Strict Validation",
      "type": "boolean"
    },
    "invalid_record_policy": {
      "default": "quarantine",
      "description": "Policy for handling invalid records",
      "enum": [
        "quarantine",
        "skip",
        "fail"
      ],
      "title": "Invalid Record Policy",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/DQReportYamlConfig",
      "description": "DQ report generation settings"
    },
    "common_field_validations": {
      "description": "Field validations from _defaults.yaml",
      "items": {
        "$ref": "#/$defs/FieldValidationConfig"
      },
      "title": "Common Field Validations",
      "type": "array"
    },
    "provider_field_validations": {
      "description": "Field validations from provider config",
      "items": {
        "$ref": "#/$defs/FieldValidationConfig"
      },
      "title": "Provider Field Validations",
      "type": "array"
    },
    "entity_field_validations": {
      "description": "Field validations from entity config",
      "items": {
        "$ref": "#/$defs/FieldValidationConfig"
      },
      "title": "Entity Field Validations",
      "type": "array"
    },
    "common_cross_field_validations": {
      "description": "Cross-field validations from _defaults.yaml",
      "items": {
        "$ref": "#/$defs/CrossFieldValidationConfig"
      },
      "title": "Common Cross Field Validations",
      "type": "array"
    },
    "entity_cross_field_validations": {
      "description": "Cross-field validations from entity config",
      "items": {
        "$ref": "#/$defs/CrossFieldValidationConfig"
      },
      "title": "Entity Cross Field Validations",
      "type": "array"
    },
    "key_nullability": {
      "description": "Nullability rules for merge/partition key fields",
      "items": {
        "$ref": "#/$defs/KeyNullabilityRuleConfig"
      },
      "title": "Key Nullability",
      "type": "array"
    },
    "entity_conditional_validations": {
      "description": "Conditional validations from entity config",
      "items": {
        "$ref": "#/$defs/ConditionalValidationConfig"
      },
      "title": "Entity Conditional Validations",
      "type": "array"
    }
  },
  "title": "DQConfigFile",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
