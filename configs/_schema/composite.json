{
  "$defs": {
    "AggregationFieldSchema": {
      "description": "Pydantic schema for aggregation field specification.",
      "properties": {
        "source": {
          "description": "Source column name to aggregate",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "agg": {
          "description": "Aggregation function to apply",
          "enum": [
            "collect_list",
            "collect_set",
            "count",
            "first",
            "concat_str"
          ],
          "title": "Agg",
          "type": "string"
        },
        "filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional filter condition (e.g., \"term_type == 'MESH'\")",
          "title": "Filter"
        }
      },
      "required": [
        "source",
        "agg"
      ],
      "title": "AggregationFieldSchema",
      "type": "object"
    },
    "AggregationSchema": {
      "description": "Pydantic schema for 1:M enricher aggregation config.",
      "properties": {
        "group_by": {
          "description": "Join key to group by",
          "minLength": 1,
          "title": "Group By",
          "type": "string"
        },
        "order_by": {
          "description": "Canonical ordering columns used before deterministic aggregation",
          "items": {
            "type": "string"
          },
          "title": "Order By",
          "type": "array"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/AggregationFieldSchema"
          },
          "description": "Map of output_field -> aggregation spec",
          "minProperties": 1,
          "title": "Fields",
          "type": "object"
        }
      },
      "required": [
        "group_by",
        "fields"
      ],
      "title": "AggregationSchema",
      "type": "object"
    },
    "ColumnGroupSchema": {
      "description": "Pydantic schema for column group configuration.",
      "properties": {
        "name": {
          "description": "Group name for logging",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "fields": {
          "description": "Explicit field names to include",
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex pattern to match field names",
          "title": "Pattern"
        },
        "provider_order": {
          "description": "Order of providers within this group",
          "items": {
            "type": "string"
          },
          "title": "Provider Order",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "ColumnGroupSchema",
      "type": "object"
    },
    "CompositeConfigSchema": {
      "description": "Pydantic schema for complete composite pipeline configuration.\n\nValidates structural/types contract for the 'composite' YAML section and\nconverts to domain CompositeConfig.\n\nBusiness invariants (join-key compatibility, uniqueness, etc.) are owned by\nthe domain layer and enforced via delegated validation.",
      "properties": {
        "name": {
          "description": "Composite pipeline name",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "description": "Configuration version (semver)",
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "seed": {
          "$ref": "#/$defs/SeedSchema",
          "description": "Seed pipeline configuration"
        },
        "dependencies": {
          "description": "List of dependency configurations (run after seed, before enrichers)",
          "items": {
            "$ref": "#/$defs/DependencySchema"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "enrichers": {
          "description": "List of enricher configurations (optional if dependencies provided)",
          "items": {
            "$ref": "#/$defs/EnricherSchema"
          },
          "title": "Enrichers",
          "type": "array"
        },
        "merge": {
          "$ref": "#/$defs/MergeSchema",
          "description": "Merge step configuration"
        },
        "dq_overrides": {
          "$ref": "#/$defs/CompositeDQSchema",
          "description": "Data quality configuration"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionSchema",
          "description": "Execution options"
        },
        "lineage": {
          "$ref": "#/$defs/LineageSchema",
          "description": "Lineage tracking configuration"
        },
        "cross_validation": {
          "$ref": "#/$defs/CrossValidationSchema",
          "description": "Cross-validation configuration for pre-merge checks"
        }
      },
      "required": [
        "name",
        "version",
        "seed",
        "merge"
      ],
      "title": "CompositeConfigSchema",
      "type": "object"
    },
    "CompositeDQSchema": {
      "additionalProperties": false,
      "description": "Pydantic schema for composite data quality configuration.",
      "properties": {
        "dq_config_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional pointer to the external composite DQ bundle file",
          "title": "Dq Config File"
        },
        "soft_fail_threshold": {
          "default": 0.1,
          "description": "Default soft threshold (0.0-1.0)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Soft Fail Threshold",
          "type": "number"
        },
        "hard_fail_threshold": {
          "default": 0.3,
          "description": "Default hard threshold (0.0-1.0)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hard Fail Threshold",
          "type": "number"
        },
        "enricher_overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/DQOverrideSchema"
          },
          "description": "Per-enricher DQ threshold overrides",
          "title": "Enricher Overrides",
          "type": "object"
        },
        "required_fields": {
          "description": "Fields required in final Gold output",
          "items": {
            "type": "string"
          },
          "title": "Required Fields",
          "type": "array"
        },
        "field_validations": {
          "description": "Field-level validation rules for composite Gold output",
          "items": {
            "$ref": "#/$defs/FieldValidationConfig"
          },
          "title": "Field Validations",
          "type": "array"
        },
        "cross_field_validations": {
          "description": "Cross-field validation rules for composite Gold output",
          "items": {
            "$ref": "#/$defs/CrossFieldValidationConfig"
          },
          "title": "Cross Field Validations",
          "type": "array"
        }
      },
      "title": "CompositeDQSchema",
      "type": "object"
    },
    "CrossFieldValidationConfig": {
      "description": "Configuration for cross-field validation rule.",
      "properties": {
        "name": {
          "description": "Unique validation rule name",
          "title": "Name",
          "type": "string"
        },
        "fields": {
          "description": "Fields involved in validation",
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "condition": {
          "description": "Validation condition type",
          "enum": [
            "all_present",
            "any_present",
            "mutually_exclusive",
            "conditional_required",
            "custom"
          ],
          "title": "Condition",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "description": "Severity level (error or warn)",
          "enum": [
            "error",
            "warn"
          ],
          "title": "Severity",
          "type": "string"
        },
        "trigger_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field that triggers conditional requirement",
          "title": "Trigger Field"
        },
        "required_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field required when trigger is present",
          "title": "Required Field"
        },
        "validator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom validator name",
          "title": "Validator"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom error message",
          "title": "Error Message"
        }
      },
      "required": [
        "name",
        "fields",
        "condition"
      ],
      "title": "CrossFieldValidationConfig",
      "type": "object"
    },
    "CrossValidationSchema": {
      "description": "Pydantic schema for cross-validation configuration.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Enable cross-validation",
          "title": "Enabled",
          "type": "boolean"
        },
        "warning_threshold": {
          "default": 1,
          "description": "Mismatches to trigger WARNING",
          "minimum": 1,
          "title": "Warning Threshold",
          "type": "integer"
        },
        "error_threshold": {
          "default": 2,
          "description": "Mismatches to trigger ENRICHER_ERROR",
          "minimum": 2,
          "title": "Error Threshold",
          "type": "integer"
        },
        "quarantine_threshold": {
          "default": 2,
          "description": "Enricher errors to quarantine seed",
          "minimum": 1,
          "title": "Quarantine Threshold",
          "type": "integer"
        },
        "fuzzy_threshold": {
          "default": 0.8,
          "description": "Jaccard threshold for fuzzy",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Fuzzy Threshold",
          "type": "number"
        },
        "numeric_tolerance": {
          "default": 0.1,
          "description": "Relative tolerance for numeric",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Numeric Tolerance",
          "type": "number"
        },
        "enricher_pairings": {
          "description": "Per-enricher field pairings",
          "items": {
            "$ref": "#/$defs/EnricherFieldPairingSchema"
          },
          "title": "Enricher Pairings",
          "type": "array"
        }
      },
      "title": "CrossValidationSchema",
      "type": "object"
    },
    "DQAllowedScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "DQOverrideSchema": {
      "additionalProperties": false,
      "description": "Pydantic schema for per-enricher DQ threshold override.",
      "properties": {
        "soft_fail_threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override soft threshold (0.0-1.0)",
          "title": "Soft Fail Threshold"
        },
        "hard_fail_threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override hard threshold (0.0-1.0)",
          "title": "Hard Fail Threshold"
        }
      },
      "title": "DQOverrideSchema",
      "type": "object"
    },
    "DependencySchema": {
      "description": "Pydantic schema for dependency pipeline configuration.",
      "properties": {
        "pipeline": {
          "description": "Name of the dependency pipeline",
          "minLength": 1,
          "title": "Pipeline",
          "type": "string"
        },
        "join_keys": {
          "description": "Keys to extract from key_source for filtering",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Join Keys",
          "type": "array"
        },
        "required": {
          "default": false,
          "description": "If True, failure causes composite failure",
          "title": "Required",
          "type": "boolean"
        },
        "timeout_seconds": {
          "default": 600,
          "description": "Maximum time for dependency execution in seconds",
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "silver_table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to dependency's Silver table",
          "title": "Silver Table"
        },
        "key_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source of join keys: None/'seed' for seed keys, or pipeline name for chained dependencies",
          "title": "Key Source"
        },
        "filter_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Field name to use when filtering the target API. Defaults to first join_key. Useful when source column differs from target API field (e.g., protein_classification_id vs protein_class_id)",
          "title": "Filter Field"
        },
        "filter_fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Multiple field names for multi-field API filtering (AND logic). When set, ALL specified fields are passed as filters to the API. Example: ['molecule_chembl_id', 'document_chembl_id'] produces ?molecule_chembl_id__in=...&document_chembl_id__in=... Mutually exclusive with filter_field.",
          "title": "Filter Fields"
        },
        "key_filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SQL-like condition to filter records from key_source before extracting join keys. Example: \"mapping_status = 'found'\" to only fetch successfully mapped IDs.",
          "title": "Key Filter"
        }
      },
      "required": [
        "pipeline",
        "join_keys"
      ],
      "title": "DependencySchema",
      "type": "object"
    },
    "EnricherFieldPairingSchema": {
      "description": "Pydantic schema for enricher field pairing.",
      "properties": {
        "enricher_pipeline": {
          "description": "Enricher pipeline name",
          "minLength": 1,
          "title": "Enricher Pipeline",
          "type": "string"
        },
        "fields": {
          "description": "Field comparison specs",
          "items": {
            "$ref": "#/$defs/FieldComparisonSpecSchema"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "enricher_pipeline",
        "fields"
      ],
      "title": "EnricherFieldPairingSchema",
      "type": "object"
    },
    "EnricherSchema": {
      "description": "Pydantic schema for enricher pipeline configuration.",
      "properties": {
        "pipeline": {
          "description": "Name of the enricher pipeline",
          "minLength": 1,
          "title": "Pipeline",
          "type": "string"
        },
        "join_keys": {
          "description": "Keys to join on from seed",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Join Keys",
          "type": "array"
        },
        "required": {
          "default": false,
          "description": "If True, failure causes composite failure",
          "title": "Required",
          "type": "boolean"
        },
        "filter_condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SQL-like condition to filter keys",
          "title": "Filter Condition"
        },
        "timeout_seconds": {
          "default": 600,
          "description": "Maximum time for enricher execution in seconds",
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "fallback_strategy": {
          "default": "skip",
          "description": "Strategy when enricher fails",
          "enum": [
            "skip",
            "use_cached",
            "fail"
          ],
          "title": "Fallback Strategy",
          "type": "string"
        },
        "silver_table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to enricher Silver table",
          "title": "Silver Table"
        },
        "limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional limit on records to enrich",
          "title": "Limit"
        },
        "cardinality": {
          "default": "one_to_one",
          "description": "Cardinality of enricher data (one_to_one or many_to_one)",
          "enum": [
            "one_to_one",
            "many_to_one"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "aggregation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AggregationSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Aggregation config for many_to_one enrichers"
        }
      },
      "required": [
        "pipeline",
        "join_keys"
      ],
      "title": "EnricherSchema",
      "type": "object"
    },
    "ExecutionSchema": {
      "description": "Pydantic schema for execution options.",
      "properties": {
        "max_concurrency": {
          "default": 4,
          "description": "Maximum concurrent enrichers",
          "exclusiveMinimum": 0,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "checkpoint_enabled": {
          "default": true,
          "description": "Enable checkpointing for resume",
          "title": "Checkpoint Enabled",
          "type": "boolean"
        },
        "retry": {
          "$ref": "#/$defs/RetrySchema",
          "description": "Retry configuration"
        }
      },
      "title": "ExecutionSchema",
      "type": "object"
    },
    "FieldComparisonSpecSchema": {
      "description": "Pydantic schema for a single field comparison specification.",
      "properties": {
        "field": {
          "description": "Unified Silver column name",
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "method": {
          "default": "exact",
          "description": "Comparison method",
          "enum": [
            "exact",
            "fuzzy",
            "numeric_tolerance",
            "skip"
          ],
          "title": "Method",
          "type": "string"
        },
        "threshold": {
          "default": 0.0,
          "description": "Threshold for fuzzy/numeric",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "field"
      ],
      "title": "FieldComparisonSpecSchema",
      "type": "object"
    },
    "FieldValidationConfig": {
      "description": "Configuration for a single field validation rule.",
      "properties": {
        "field": {
          "description": "Field name to validate",
          "title": "Field",
          "type": "string"
        },
        "type": {
          "description": "Validation type",
          "enum": [
            "required",
            "not_null",
            "range",
            "pattern",
            "enum",
            "max_length",
            "not_empty_list",
            "custom"
          ],
          "title": "Type",
          "type": "string"
        },
        "nullable": {
          "default": true,
          "description": "Whether field can be null",
          "title": "Nullable",
          "type": "boolean"
        },
        "severity": {
          "default": "error",
          "description": "Severity level (error or warn)",
          "enum": [
            "error",
            "warn"
          ],
          "title": "Severity",
          "type": "string"
        },
        "severity_enricher": {
          "anyOf": [
            {
              "enum": [
                "error",
                "warn"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Override severity when running as enricher in composite pipeline",
          "title": "Severity Enricher"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum value (range)",
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum value (range)",
          "title": "Max"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex pattern",
          "title": "Pattern"
        },
        "allowed": {
          "description": "Allowed values",
          "items": {
            "$ref": "#/$defs/DQAllowedScalar"
          },
          "title": "Allowed",
          "type": "array"
        },
        "max_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum string length",
          "title": "Max Length"
        },
        "validator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom validator name",
          "title": "Validator"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom error message",
          "title": "Error Message"
        }
      },
      "required": [
        "field",
        "type"
      ],
      "title": "FieldValidationConfig",
      "type": "object"
    },
    "JsonDict": {
      "additionalProperties": true,
      "type": "object"
    },
    "LineageSchema": {
      "description": "Pydantic schema for lineage tracking configuration.",
      "properties": {
        "track_field_sources": {
          "default": true,
          "description": "Track which source provided each field",
          "title": "Track Field Sources",
          "type": "boolean"
        },
        "track_timestamps": {
          "default": true,
          "description": "Include enrichment timestamps",
          "title": "Track Timestamps",
          "type": "boolean"
        },
        "track_status": {
          "default": true,
          "description": "Include per-record enrichment status",
          "title": "Track Status",
          "type": "boolean"
        },
        "provider_lookup_fields": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "Per-provider mapping of lookup metadata field names",
          "title": "Provider Lookup Fields",
          "type": "object"
        },
        "track_source_for_fields": {
          "description": "Field names requiring source tracking for overlapping data",
          "items": {
            "type": "string"
          },
          "title": "Track Source For Fields",
          "type": "array"
        }
      },
      "title": "LineageSchema",
      "type": "object"
    },
    "MergeOutputSchema": {
      "description": "Pydantic schema for merge output paths.",
      "properties": {
        "silver": {
          "description": "Path for merged Silver table",
          "minLength": 1,
          "title": "Silver",
          "type": "string"
        },
        "gold": {
          "description": "Path for merged Gold table",
          "minLength": 1,
          "title": "Gold",
          "type": "string"
        }
      },
      "required": [
        "silver",
        "gold"
      ],
      "title": "MergeOutputSchema",
      "type": "object"
    },
    "MergeSchema": {
      "additionalProperties": false,
      "description": "Pydantic schema for merge step configuration.",
      "properties": {
        "strategy": {
          "default": "left_outer",
          "description": "Join strategy for merging",
          "enum": [
            "left_outer",
            "inner",
            "union"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "conflict_resolution": {
          "default": "seed_priority",
          "description": "Strategy for field conflicts",
          "enum": [
            "seed_priority",
            "enricher_priority",
            "latest_timestamp",
            "explicit_rules",
            "coalesce"
          ],
          "title": "Conflict Resolution",
          "type": "string"
        },
        "field_priorities": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Mapping of field to source priority list",
          "title": "Field Priorities",
          "type": "object"
        },
        "normalization_compatibility_overrides": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Explicit justification map for intentional field-level normalization mismatches",
          "title": "Normalization Compatibility Overrides",
          "type": "object"
        },
        "field_mappings": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Mapping to rename fields during merge",
          "title": "Field Mappings",
          "type": "object"
        },
        "output": {
          "$ref": "#/$defs/MergeOutputSchema",
          "description": "Output paths for Silver and Gold tables"
        },
        "sort_by": {
          "$ref": "#/$defs/MergeSortBySchema",
          "description": "Deterministic row ordering policy for merged outputs"
        },
        "preserve_all_sources": {
          "default": false,
          "description": "Keep all provider-qualified columns instead of coalescing",
          "title": "Preserve All Sources",
          "type": "boolean"
        },
        "column_groups": {
          "description": "Column ordering by semantic groups",
          "items": {
            "$ref": "#/$defs/ColumnGroupSchema"
          },
          "title": "Column Groups",
          "type": "array"
        },
        "exclude_fields": {
          "description": "Columns to drop from merged output (supports glob patterns)",
          "items": {
            "type": "string"
          },
          "title": "Exclude Fields",
          "type": "array"
        }
      },
      "required": [
        "output",
        "sort_by"
      ],
      "title": "MergeSchema",
      "type": "object"
    },
    "MergeSortBySchema": {
      "description": "Deterministic sort policy for merged Silver/Gold outputs.",
      "properties": {
        "silver": {
          "description": "Sort columns for merged Silver output",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Silver",
          "type": "array"
        },
        "gold": {
          "description": "Sort columns for merged Gold output",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Gold",
          "type": "array"
        }
      },
      "required": [
        "silver",
        "gold"
      ],
      "title": "MergeSortBySchema",
      "type": "object"
    },
    "RetrySchema": {
      "description": "Pydantic schema for retry configuration.",
      "properties": {
        "max_attempts": {
          "default": 3,
          "description": "Maximum retry attempts per enricher",
          "minimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        },
        "backoff_multiplier": {
          "default": 2.0,
          "description": "Backoff multiplier for retries",
          "exclusiveMinimum": 0,
          "title": "Backoff Multiplier",
          "type": "number"
        }
      },
      "title": "RetrySchema",
      "type": "object"
    },
    "SeedSchema": {
      "description": "Pydantic schema for seed pipeline configuration.",
      "properties": {
        "pipeline": {
          "description": "Name of the seed pipeline",
          "minLength": 1,
          "title": "Pipeline",
          "type": "string"
        },
        "output_keys": {
          "description": "Keys to extract for enrichment",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Output Keys",
          "type": "array"
        },
        "silver_table": {
          "description": "Path to seed Silver table output",
          "minLength": 1,
          "title": "Silver Table",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional limit on records to extract",
          "title": "Limit"
        }
      },
      "required": [
        "pipeline",
        "output_keys",
        "silver_table"
      ],
      "title": "SeedSchema",
      "type": "object"
    }
  },
  "description": "Pydantic schema for complete composite configuration file.\n\nValidates the entire YAML file structure including schema_version\nand maintenance metadata.",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "description": "Schema version for file format",
      "title": "Schema Version",
      "type": "string"
    },
    "composite": {
      "$ref": "#/$defs/CompositeConfigSchema",
      "description": "The composite pipeline configuration"
    },
    "gold_filters": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonDict"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deprecated legacy field; composite-local gold_filters are unsupported"
    },
    "maintenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonDict"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional maintenance configuration"
    }
  },
  "required": [
    "composite"
  ],
  "title": "CompositeConfigFileSchema",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
