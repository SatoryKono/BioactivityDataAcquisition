{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioetl/pipeline-config-schema-v2.1",
  "title": "BioETL Pipeline Configuration Schema v2.1",
  "description": "Schema for BioETL pipeline configurations. Note: 'sink' is optional when using convention-based path resolution (ADR-029).",
  "type": "object",
  "required": [
    "pipeline_name",
    "provider",
    "entity_type",
    "version",
    "primary_keys",
    "silver_table",
    "gold_table"
  ],
  "properties": {
    "pipeline_name": {
      "type": "string",
      "pattern": "^[a-z]+_[a-z_]+$",
      "description": "Unique pipeline identifier in format {provider}_{entity}"
    },
    "provider": {
      "type": "string",
      "enum": ["chembl", "pubchem", "uniprot", "pubmed", "crossref", "openalex", "semanticscholar"],
      "description": "Data provider name"
    },
    "entity_type": {
      "type": "string",
      "description": "Entity type (e.g., activity, assay, molecule, work for CrossRef)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of config"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the pipeline"
    },
    "primary_keys": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "description": "Primary key field(s) for entity. Auto-propagated to sink.silver.primary_key and sort_by.columns"
    },
    "silver_table": {
      "type": "string",
      "description": "Silver layer table name"
    },
    "gold_table": {
      "type": "string",
      "description": "Gold layer table name"
    },
    "loading_strategy": {
      "type": "string",
      "enum": ["incremental", "full_scan_only"],
      "default": "incremental",
      "description": "Data loading strategy. 'full_scan_only' disables checkpoint resume (ADR-031)"
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "description": "Override default batch size for API requests (provider default used if not specified)"
    },
    "checkpoint_interval": {
      "type": "integer",
      "minimum": 1,
      "description": "Override checkpoint interval (records processed between checkpoints)"
    },
    "source_file": {
      "type": "string",
      "description": "Reference to source configuration file. Auto-computed as ../../sources/{provider}.yaml if not specified"
    },
    "dq_config_file": {
      "type": "string",
      "description": "Reference to DQ configuration file. Auto-computed as ../../dq/entities/{provider}/{entity_type}.yaml if not specified"
    },
    "filter_config_file": {
      "type": "string",
      "description": "Reference to filter configuration file. Auto-computed as ../../filter/entities/{provider}/{entity_type}.yaml if not specified"
    },
    "column_groups_file": {
      "type": "string",
      "description": "Reference to column groups file (legacy). Prefer data_schema_file for new configs"
    },
    "data_schema_file": {
      "type": "string",
      "description": "Reference to data schema file with layer-specific column definitions (silver/gold)"
    },
    "source": {
      "type": "object",
      "description": "Pipeline-specific source configuration (overrides values from source_file)"
    },
    "dq_rules": {
      "type": "object",
      "properties": {
        "soft_fail_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.05
        },
        "hard_fail_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.20
        }
      }
    },
    "sink": {
      "type": "object",
      "description": "Sink configuration for medallion layers. Optional when using convention-based paths (ADR-029)",
      "properties": {
        "bronze": {
          "type": "object",
          "description": "Bronze layer configuration. Path auto-computed if not specified",
          "properties": {
            "path": {"type": "string", "description": "Output path. Default: data/output/bronze/{provider}/{entity_type}"},
            "flat_structure": {"type": "boolean", "default": true, "description": "If true, path already includes provider/entity"}
          }
        },
        "silver": {
          "type": "object",
          "description": "Silver layer configuration. Path, primary_key, sort_by auto-computed if not specified",
          "properties": {
            "path": {"type": "string", "description": "Output path. Default: data/output/silver/{provider}/{entity_type}"},
            "primary_key": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Merge key. Default: primary_keys from root"
            },
            "partition_by": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Partition columns. Default: [] (no partitioning)"
            },
            "sort_by": {
              "type": "object",
              "description": "Sort configuration for deterministic writes (ADR-014)",
              "properties": {
                "columns": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "Sort columns. Default: primary_keys"
                },
                "ascending": {"type": "boolean", "default": true}
              }
            },
            "csv_export": {
              "type": "object",
              "properties": {
                "path": {"type": "string", "description": "CSV export path. Default: same as silver path"}
              }
            },
            "flat_structure": {"type": "boolean", "default": true}
          }
        },
        "gold": {
          "type": "object",
          "description": "Gold layer configuration. Path, sort_by auto-computed if not specified",
          "properties": {
            "path": {"type": "string", "description": "Output path. Default: data/output/gold/{provider}/{entity_type}"},
            "sort_by": {
              "type": "object",
              "description": "Sort configuration for deterministic writes (ADR-014)",
              "properties": {
                "columns": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "Sort columns. Default: primary_keys"
                },
                "ascending": {"type": "boolean", "default": true}
              }
            },
            "csv_export": {
              "type": "object",
              "properties": {
                "path": {"type": "string", "description": "CSV export path. Default: same as gold path"}
              }
            },
            "flat_structure": {"type": "boolean", "default": true}
          }
        }
      }
    },
    "input_filter": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "source_path": {"type": "string"},
        "column_name": {"type": "string"},
        "filter_field": {"type": "string"},
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "fallback_column": {"type": "string"}
      }
    },
    "gold_filters": {
      "type": "object",
      "properties": {
        "required_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "exclude_if_present": {
          "type": "array",
          "items": {"type": "string"}
        },
        "columns": {
          "type": "object",
          "description": "Column filters with operator support",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "array",
                "items": {"type": "string"},
                "description": "Legacy format: list of allowed values (IN operator)"
              },
              {
                "type": "object",
                "description": "Extended format with operator",
                "required": ["operator"],
                "properties": {
                  "operator": {
                    "type": "string",
                    "enum": ["in", "not_in", "is_null", "is_not_null", "is_empty", "is_not_empty"]
                  },
                  "values": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Values for IN/NOT_IN operators"
                  }
                }
              }
            ]
          }
        },
        "ranges": {
          "type": "object",
          "description": "Numeric range filters",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "min": {"type": "number"},
              "max": {"type": "number"},
              "include_min": {"type": "boolean", "default": true},
              "include_max": {"type": "boolean", "default": true}
            }
          }
        },
        "list_lengths": {
          "type": "object",
          "description": "List length filters",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "min": {"type": "integer"},
              "max": {"type": "integer"}
            }
          }
        },
        "list_contains": {
          "type": "object",
          "description": "List contains filters",
          "additionalProperties": {
            "type": "object",
            "required": ["values"],
            "properties": {
              "values": {
                "type": "array",
                "items": {"type": "string"}
              },
              "mode": {
                "type": "string",
                "enum": ["all", "any"],
                "default": "all"
              }
            }
          }
        }
      }
    }
  }
}
