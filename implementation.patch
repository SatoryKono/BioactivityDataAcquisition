From: "google-labs-jules[bot]"
 <161369871+google-labs-jules[bot]@users.noreply.github.com>
Date: Mon, 19 Oct 2026 12:17:03 +0000
Subject: [PATCH 1/2] fix: resolve resume gate bypass for destructive steps

---
 .../control_plane/workflow/inspection_service.py    |  3 ++-
 .../control_plane/_execution_resume_support.py      |  7 ++++++-
 .../workflow/control_plane/execution_recording.py   | 13 ++++++++-----
 .../control_plane/execution_recording_state.py      |  6 +++++-
 4 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/src/bioetl/application/services/control_plane/workflow/inspection_service.py b/src/bioetl/application/services/control_plane/workflow/inspection_service.py
index 278d2683a..9871467ed 100644
--- a/src/bioetl/application/services/control_plane/workflow/inspection_service.py
+++ b/src/bioetl/application/services/control_plane/workflow/inspection_service.py
@@ -86,7 +86,8 @@ class WorkflowInspectionService:
             completed_at=state.completed_at,
             last_error_type=state.last_error_type,
             last_error_message=state.last_error_message,
-            repair_required=state.repair_required,
+            repair_required=state.repair_required
+            or any(step.commit_pending_confirmation for step in state.steps),
             repair_hint=state.repair_hint,
             ambiguous_step_ids=state.ambiguous_step_ids,
             ledger_entry_count=len(self.ledger_port.list_entries(state.manifest_id)),
diff --git a/src/bioetl/application/services/workflow/control_plane/_execution_resume_support.py b/src/bioetl/application/services/workflow/control_plane/_execution_resume_support.py
index 305d317a7..3e6a0bb6a 100644
--- a/src/bioetl/application/services/workflow/control_plane/_execution_resume_support.py
+++ b/src/bioetl/application/services/workflow/control_plane/_execution_resume_support.py
@@ -170,7 +170,12 @@ def _validate_repair_requirements(
     force_steps: tuple[str, ...],
 ) -> None:
     """Ensure repair requirements are satisfied when needed."""
-    if latest_state.repair_required and not (repair_steps or force_steps):
+    has_unconfirmed = any(
+        step.commit_pending_confirmation for step in latest_state.steps
+    )
+    if (latest_state.repair_required or has_unconfirmed) and not (
+        repair_steps or force_steps
+    ):
         raise RuntimeError(
             latest_state.repair_hint
             or "Workflow resume requires explicit --repair-steps or --force-steps"
diff --git a/src/bioetl/application/services/workflow/control_plane/execution_recording.py b/src/bioetl/application/services/workflow/control_plane/execution_recording.py
index 26ba6c351..d810ca9ff 100644
--- a/src/bioetl/application/services/workflow/control_plane/execution_recording.py
+++ b/src/bioetl/application/services/workflow/control_plane/execution_recording.py
@@ -65,17 +65,20 @@ def record_workflow_started(
     if force_steps:
         context.ledger.record_force_requested(step_ids=force_steps)
     started_entry = context.ledger.record_workflow_started(resumed=resumed)
+    ambiguous = _remove_step_ids(
+        context.state.ambiguous_step_ids,
+        (*repair_steps, *force_steps),
+    )
     context.state = replace(
         context.state,
         status="running",
         updated_at=started_entry.occurred_at,
         last_event_id=started_entry.entry_id,
-        repair_required=False,
-        repair_hint=None,
-        ambiguous_step_ids=_remove_step_ids(
-            context.state.ambiguous_step_ids,
-            repair_steps,
+        repair_required=bool(ambiguous) or any(
+            step.commit_pending_confirmation for step in context.state.steps
         ),
+        repair_hint=context.state.repair_hint if ambiguous else None,
+        ambiguous_step_ids=ambiguous,
     )
     context.state_port.save(context.state)

diff --git a/src/bioetl/application/services/workflow/control_plane/execution_recording_state.py b/src/bioetl/application/services/workflow/control_plane/execution_recording_state.py
index 8a0f6b49e..f0b7f70dd 100644
--- a/src/bioetl/application/services/workflow/control_plane/execution_recording_state.py
+++ b/src/bioetl/application/services/workflow/control_plane/execution_recording_state.py
@@ -52,7 +52,11 @@ def _apply_completed_step_state(
             step_id=result.step_id,
             fingerprint=fingerprint,
         )
-    return state if pending else _clear_ambiguous_step(state, result.step_id)
+    if pending:
+        return state
+    if result.status == "success":
+        return _clear_ambiguous_step(state, result.step_id)
+    return state


 def _retains_completed_evidence(
--
2.53.0


