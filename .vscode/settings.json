{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv-win/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": ["src"],
  "python.analysis.diagnosticMode": "workspace",
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "python.testing.pytestPath": "${workspaceFolder}/.venv-win/Scripts/pytest.exe",
  "python.testing.pytestArgs": [
    "tests"
  ],
  "testing.automaticallyOpenTestExplorer": true,
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}/src",
    "PYTHONPYCACHEPREFIX": "${env:TEMP}/bioetl-pycache",
    "UV_LINK_MODE": "copy"
  },
  "terminal.integrated.profiles.windows": {
    "BioETL Codex (WSL)": {
      "path": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-NoExit",
        "-File",
        "${workspaceFolder}/scripts/ai/codex/cursor-launch.ps1",
        "-Mode",
        "interactive"
      ],
      "icon": "robot",
      "color": "terminal.ansiCyan"
    }
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  }
}
