{
    "python.testing.pytestArgs": [
        "tests",
        "-m",
        "unit",
        "--ignore=tests/integration",
        "--ignore=tests/golden",
        "-ra",
        "-q",
        "--strict-markers",
        "--strict-config",
        "--tb=short"
    ],
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "python.testing.cwd": "${workspaceFolder}",
    "python.defaultInterpreterPath": "python.exe",
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestPath": "pytest",
    "python.terminal.activateEnvironment": false,
    "python.venvPath": "",
    "python.venvFolders": [],
    "python.analysis.extraPaths": [
        "./src"
    ],
    "python.autoComplete.extraPaths": [
        "./src"
    ],
    "python.analysis.exclude": [
        "**/tests/services/**"
    ],
    "python.linting.pylintArgs": [
        "--ignore=tests/services"
    ],
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.editor.enablePreviewFromCodeNavigation": false,
    "chatgpt.openOnStartup": false,
    "chatgpt.commentCodeLensEnabled": false,
    "mermaid-editor.generate.quality": 5,
    "mermaid-editor.generate.scale": 5,
    "mermaid.startOnLoad": true,
    "markdown-mermaid.lightModeTheme": "default",
    "markdown-mermaid.darkModeTheme": "dark"
}
