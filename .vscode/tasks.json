{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BioETL: ruff check",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        "src",
        "tests"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "BioETL: ruff format",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "format",
        "src",
        "tests"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "BioETL: mypy strict",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/engineering/dev/run_mypy.sh"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/engineering/dev/run_mypy.ps1"
        ]
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "BioETL: pytest quick",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "pytest",
        "tests",
        "--cov=src/bioetl",
        "--cov-report=term",
        "-q",
        "-x"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "BioETL: pytest current file",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "pytest",
        "${file}",
        "-q"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "BioETL: architecture tests",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "pytest",
        "tests/architecture",
        "-v"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "BioETL: Codex interactive (WSL)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        ".\\scripts\\ops\\codex.bat"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "BioETL: Codex exec full-auto (WSL)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        ".\\scripts\\ops\\codex-exec.bat",
        "${input:codexExecPrompt}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "codexExecPrompt",
      "type": "promptString",
      "description": "Prompt for codex exec --full-auto"
    }
  ]
}
