{
  "version": "0.2.0",
  "configurations": [
  

    {
      "name": "BioETL: run pipeline via uv (prompt pipeline/limit)",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run python -m bioetl run --pipeline ${input:bioetlPipeline} --limit ${input:bioetlLimit}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "BioETL: run chembl_molecule --limit 100 via uv",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run python -m bioetl run --pipeline chembl_molecule --limit 100",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "BioETL: run pytest current file via uv",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run python -m pytest \"${file}\" -q",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "BioETL: run tests via uv",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run python -m pytest tests -q",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "BioETL: Codex interactive (WSL)",
      "type": "node-terminal",
      "request": "launch",
      "command": "cmd.exe /c .\\scripts\\ops\\codex.bat",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "BioETL: Codex exec full-auto (WSL)",
      "type": "node-terminal",
      "request": "launch",
      "command": "cmd.exe /c .\\scripts\\ops\\codex-exec.bat \"${input:codexExecPrompt}\"",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "bioetlPipeline",
      "type": "promptString",
      "description": "Pipeline name (e.g. chembl_molecule, pubmed_publication)",
      "default": "chembl_molecule"
    },
    {
      "id": "bioetlLimit",
      "type": "promptString",
      "description": "Row limit",
      "default": "100"
    },
    {
      "id": "codexExecPrompt",
      "type": "promptString",
      "description": "Prompt for codex exec --full-auto"
    }
  ]
}
