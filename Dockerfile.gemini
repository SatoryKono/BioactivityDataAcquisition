# Gemini CLI - Google AI Assistant Container
FROM node:22-alpine

WORKDIR /workspace

# Install Gemini CLI globally
RUN npm install -g --no-fund @google/gemini-cli@latest

# Create non-root user
RUN addgroup gemini && adduser -D -G gemini gemini
USER gemini

# Set working directory to project root (mounted volume)
WORKDIR /workspace

# Default command - show help
ENTRYPOINT ["gemini"]
CMD ["--help"]
