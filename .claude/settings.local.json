{
  "permissions": {
    "allow": [
      "Bash(where:*)",
      "Bash(uv run ruff format:*)",
      "Bash(if [ -f .coverage ])",
      "Bash(then uv run coverage report --precision=1)",
      "Bash(else echo \"Нет данных coverage\")",
      "Bash(fi:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(ls:*)",
      "Bash(xargs:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(uv run:*)",
      "Bash(if not exist \"tests\\\\unit\\\\pipelines\\\\uniprot\\\\extractors\" mkdir \"tests\\\\unit\\\\pipelines\\\\uniprot\\\\extractors\")"
    ]
  },
  {
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/bioetl"]
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git", "--repository", "/path/to/bioetl"]
    },
    "sqlite": {
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "~/bioetl/data/local.db"]
    },
    "obsidian": {
      "command": "uvx",
      "args": ["obsidian-mcp"],
      "env": {
        "OBSIDIAN_VAULT_PATH": "/path/to/bioetl/docs"
      }
    },
    "neo4j-memory": {
      "command": "npx",
      "args": ["-y", "@jovanhsu/mcp-neo4j-memory-server"],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "password"
      }
    },
    "basic-memory": {
      "command": "uvx",
      "args": ["basic-memory"],
      "env": {
        "BASIC_MEMORY_DATA_DIR": "/path/to/bioetl/docs"
      }
    },
    "duckdb": {
      "command": "uvx",
      "args": ["mcp-server-duckdb", "--db-path", "~/bioetl/data/analytics.duckdb"]
    },
    "biomcp": {
      "command": "uvx",
      "args": ["biomcp"]
    },
    "arxiv": {
      "command": "uvx", 
      "args": ["arxiv-mcp"]
    }
  }
}