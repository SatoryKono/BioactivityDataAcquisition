{
  "permissions": {
    "allow": [
      "Bash(python -c:*)",
      "Bash(python -m pytest:*)",
      "Bash(find:*)",
      "Bash(python -m lint_imports:*)",
      "Bash(python -m mypy:*)",
      "Bash(python -m ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(pytest:*)",
      "Bash(wc:*)",
      "Bash(echo:*)",
      "mcp__sequential-thinking__sequentialthinking",
      "Bash(python extract_publication_fields.py:*)",
      "Bash(python generate_validation_schema.py:*)",
      "Bash(.venvScriptspip install openpyxl)",
      "Bash(.venvScriptspip.exe install openpyxl)",
      "Bash(python -m pip install:*)",
      "Bash(python:*)",
      "Bash(code --install-extension:*)",
      "Bash(code .)",
      "Bash(grep:*)"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true
  },
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/bioetl"
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "--repository",
        "/path/to/bioetl"
      ]
    },
    "obsidian": {
      "command": "uvx",
      "args": [
        "obsidian-mcp"
      ],
      "env": {
        "OBSIDIAN_VAULT_PATH": "/path/to/vault"
      }
    },
    "neo4j-memory": {
      "command": "npx",
      "args": [
        "-y",
        "@jovanhsu/mcp-neo4j-memory-server"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "password"
      }
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    }
  }
}
