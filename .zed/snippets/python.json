      "",
      "",
      "@pytest.mark.unit",
      "def test_${3:behavior}() -> None:",
      "    \"\"\"${4:Expected behavior under test}.\"\"\"",
      "    result = ${5:Symbol}(${6:args})",
      "    assert ${7:result is not None}"
    ]
  },
