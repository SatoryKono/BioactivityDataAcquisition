[
  {
    "label": "Format code",
    "command": "uv",
    "args": ["run", "--active", "--no-sync", "ruff", "format", "."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all",
    "env": {
      "UV_PROJECT_ENVIRONMENT": ".venv-win",
      "VIRTUAL_ENV": ".venv-win",
      "PYTHONDONTWRITEBYTECODE": "1",
    },
  },
  {
    "label": "Lint code",
    "command": "uv",
    "args": ["run", "--active", "--no-sync", "ruff", "check", "."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all",
    "env": {
      "UV_PROJECT_ENVIRONMENT": ".venv-win",
      "VIRTUAL_ENV": ".venv-win",
      "PYTHONDONTWRITEBYTECODE": "1",
    },
  },
  {
