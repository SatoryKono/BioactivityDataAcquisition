      "run",
      "--active",
      "--no-sync",
      "pytest",
      "$ZED_FILE",
      "-v",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1",
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "UV_PROJECT_ENVIRONMENT": ".venv-win",
      "VIRTUAL_ENV": ".venv-win",
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["python-test"],
    "reveal": "always",
    "save": "current",
  },
