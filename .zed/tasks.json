[
  {
    "label": "Format code",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "ruff",
      "format",
      "."
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all"
  },
