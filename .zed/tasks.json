[
  {
    "label": "Format code",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "$ZED_WORKTREE_ROOT/scripts/engineering/dev/zed_task.ps1",
      "-Module",
      "ruff",
      "--",
      "format",
      "."
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "Lint code",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "ruff",
      "check",
      "."
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "Type check",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "mypy",
      "src/"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "all"
  },
  {
    "label": "Test: current file",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "$ZED_FILE",
      "-v",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "python-test"
    ],
    "reveal": "always",
    "save": "current"
  },
  {
    "label": "Test: nearest symbol",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "$ZED_FILE",
      "-k",
      "$ZED_SYMBOL",
      "-v",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "save": "current"
  },
  {
    "label": "Test: smoke",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/smoke/",
      "-v",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: unit-fast",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/unit/",
      "-q",
      "-m",
      "not repo_backed and not slow and not serial and not benchmark and not memory",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: unit",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/unit/",
      "-q",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: architecture",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/architecture/",
      "-q",
      "-m",
      "architecture and not slow and not benchmark and not memory",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: integration-replay",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/integration/",
      "-q",
      "-m",
      "not e2e and not live and not slow and not benchmark and not memory",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: contracts",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/contract/",
      "tests/unit/contracts/",
      "-q",
      "-m",
      "no_api or not network",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "-p",
      "no:xdist",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: security",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/security/",
      "-q",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: e2e-smoke",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/e2e/",
      "-m",
      "e2e_smoke",
      "-v",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark",
      "--maxfail=1"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: failed last run",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/",
      "--lf",
      "-x",
      "-v",
      "--tb=short",
      "--no-cov",
      "-p",
      "no:benchmark"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: coverage (gate 85%)",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pytest",
      "tests/",
      "--ignore=tests/e2e",
      "--ignore=tests/contract",
      "-m",
      "not memory and not benchmark and not slow",
      "--cov=src/bioetl",
      "--cov-report=term-missing",
      "--cov-report=html:reports/coverage/htmlcov",
      "--cov-fail-under=85",
      "-q",
      "--tb=short"
    ],
    "env": {
      "VCR_RECORD_MODE": "none",
      "PYTHONDONTWRITEBYTECODE": "1",
      "VIRTUAL_ENV": "$ZED_WORKTREE_ROOT/.venv-win"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Architecture compliance",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/lint-imports.exe",
    "args": [
      "--config",
      "pyproject.toml"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Security scan",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "bandit",
      "-r",
      "src/"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Dependency audit",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "pip_audit"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Dead code detection",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "vulture",
      "src/bioetl"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Complexity check",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "-m",
      "xenon",
      "--max-absolute",
      "B",
      "--max-modules",
      "B",
      "--max-average",
      "A",
      "src/bioetl"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Refresh MCP config",
    "command": "$ZED_WORKTREE_ROOT/.venv-win/Scripts/python.exe",
    "args": [
      "scripts/ai/codex/setup_mcp.py",
      "--skip-codex",
      "--skip-gemini-settings"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  }
]
