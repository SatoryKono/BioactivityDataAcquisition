[
  {
    "label": "Format code",
    "command": "uv",
    "args": ["run", "ruff", "format", "."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Lint code",
    "command": "uv",
    "args": ["run", "ruff", "check", "."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Type check",
    "command": "uv",
    "args": ["run", "mypy", "src/"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Test: current file",
    "command": "uv",
    "args": ["run", "pytest", "$ZED_FILE", "-v"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["python-test"],
    "reveal": "always"
  },
  {
    "label": "Run unit tests",
    "command": "uv",
    "args": ["run", "pytest", "tests/unit/", "-v"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Run integration tests",
    "command": "uv",
    "args": ["run", "pytest", "tests/integration/", "-v"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Run architecture tests",
    "command": "uv",
    "args": ["run", "pytest", "tests/architecture/", "-v"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Run E2E smoke tests",
    "command": "uv",
    "args": ["run", "pytest", "-m", "e2e_smoke", "-v"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Run fast tests only",
    "command": "uv",
    "args": ["run", "pytest", "-v", "-m", "unit"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Coverage report",
    "command": "uv",
    "args": [
      "run",
      "pytest",
      "--cov=src/bioetl",
      "--cov-report=html"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Architecture compliance",
    "command": "uv",
    "args": ["run", "lint-imports", "--config", "pyproject.toml"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Security scan",
    "command": "uv",
    "args": ["run", "bandit", "-r", "src/"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Dependency audit",
    "command": "uv",
    "args": ["run", "pip-audit"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Dead code detection",
    "command": "uv",
    "args": ["run", "vulture", "src/bioetl"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Complexity check",
    "command": "uv",
    "args": [
      "run",
      "xenon",
      "--max-absolute",
      "B",
      "--max-modules",
      "B",
      "--max-average",
      "A",
      "src/bioetl"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "Refresh MCP config",
    "command": "uv",
    "args": [
      "run",
      "python",
      "scripts/ai/codex/setup_mcp.py",
      "--skip-codex",
      "--skip-gemini-settings"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  }
]
