      "scripts/engineering/dev/zed_run.py",
      "-m",
      "ruff",
      "format",
      "."
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "save": "all",
    "allow_concurrent_runs": false
  },
