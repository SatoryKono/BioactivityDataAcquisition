# BioETL MCP Memory Server - Persistent memory for AI agents
FROM node:26-alpine

WORKDIR /app

# Install dependencies once, cache node_modules
RUN npm install --production --no-fund @modelcontextprotocol/server-memory@2026.1.26

# Non-root user
RUN addgroup mcpuser && adduser -D -G mcpuser mcpuser
USER mcpuser

# Run the server
ENTRYPOINT ["npx", "@modelcontextprotocol/server-memory@2026.1.26"]
