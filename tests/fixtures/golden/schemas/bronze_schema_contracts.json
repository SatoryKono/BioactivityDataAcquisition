{
  "contract": "bronze_schema_contracts",
  "dataclass_contracts": {
    "BronzeLineageMetadataRequest": [
      "run_id",
      "run_type",
      "effective_ts",
      "provider",
      "entity",
      "batch_id"
    ],
    "BronzeMetadataPayloadRequest": [
      "run_id",
      "run_type",
      "provider",
      "entity",
      "record_count",
      "compressed_size",
      "output_path",
      "started_at",
      "completed_at",
      "duration_seconds",
      "source_metadata"
    ],
    "BronzeWriteArtifacts": [
      "record_count",
      "uncompressed_size",
      "compressed_size"
    ],
    "BronzeWritePostwriteContext": [
      "request",
      "prepared",
      "write_artifacts",
      "duration"
    ],
    "BronzeWritePrepared": [
      "records_iter",
      "record_list",
      "date_str",
      "relative_path",
      "metadata",
      "full_path",
      "meta_path"
    ],
    "BronzeWriteRequest": [
      "records",
      "provider",
      "entity",
      "date",
      "batch_id",
      "run_id",
      "run_type",
      "ingestion_ts",
      "source_metadata"
    ],
    "BronzeWriterRuntimeServices": [
      "tracing",
      "audit",
      "metadata_writer",
      "save_metadata",
      "metadata_coordinator",
      "lineage_store"
    ]
  },
  "file_contract": {
    "batch_filename_template": "batch_{YYYY-MM-DD}_{batch_id}.jsonl.zst",
    "compression": "zstd",
    "record_encoding": "json-bytes",
    "sidecar_suffix": ".zst.meta.json"
  },
  "layer": "bronze",
  "metadata_payload_sections": [
    "environment",
    "output",
    "output_ext",
    "pipeline",
    "runtime",
    "source"
  ],
  "required_metadata_fields": [
    "ingestion_ts",
    "run_id",
    "run_type",
    "batch_id"
  ],
  "version": 1,
  "write_error_types": [
    "OSError",
    "RuntimeError",
    "TypeError",
    "ValueError",
    "ZstdError"
  ]
}
