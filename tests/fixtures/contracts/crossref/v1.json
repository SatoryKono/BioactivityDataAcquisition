        "message.items[0].DOI": "str",
        "message.items-per-page": "int",
        "message.total-results": "int"
      }
    },
    "agency_lookup_for_doi": {
      "paths": {
        "status": "str",
        "message": "dict",
        "message.DOI": "str",
        "message.agency": "dict",
        "message.agency.id": "str"
      }
    }
  }
