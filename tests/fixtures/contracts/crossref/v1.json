{
  "provider": "crossref",
  "version": 1,
  "probes": {
    "work_lookup_by_doi": {
      "paths": {
        "status": "str",
        "message": "dict",
        "message.DOI": "str",
        "message.title": "list",
        "message.title[0]": "str"
      }
    },
    "works_query_endpoint": {
      "paths": {
        "status": "str",
        "message": "dict",
