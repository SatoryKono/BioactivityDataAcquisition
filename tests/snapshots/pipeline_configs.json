{
  "chembl_activity": {
    "batch_size": 100,
    "checkpoint_interval": 1000,
    "dq": {
      "hard_fail_threshold": 0.2,
      "soft_fail_threshold": 0.05,
      "strict_validation": false
    },
    "entity_type": "activity",
    "fields": [],
    "gold_filters": {
      "column_filters": [
        {
          "column": "standard_type",
          "values": [
            "IC50",
            "Ki"
          ]
        },
        {
          "column": "standard_units",
          "values": [
            "nM"
          ]
        },
        {
          "column": "standard_relation",
          "values": [
            "="
          ]
        },
        {
          "column": "assay_type",
          "values": [
            "B",
            "F"
          ]
        },
        {
          "column": "potential_duplicate",
          "values": [
            "0"
          ]
        }
      ],
      "exclude_if_present": [],
      "list_contains_filters": [],
      "list_length_filters": [],
      "range_filters": [
        {
          "column": "standard_value",
          "include_max": true,
          "include_min": false,
          "max_value": null,
          "min_value": 0.0
        }
      ],
      "required_fields": [
        "standard_type",
        "standard_value",
        "standard_units",
        "target_chembl_id"
      ]
    },
    "gold_table": null,
    "gold_write_mode": "overwrite",
    "on_schema_mismatch": "error",
    "partition_cols": [],
    "pipeline_name": "chembl_activity",
    "primary_keys": [
      "activity_id"
    ],
    "provider": "chembl",
    "silver_table": "chembl_activity",
    "write_mode": "merge"
  },
