{
  "_dq_error": {
    "checks": [],
    "coerce": false,
    "description": "Flag for data quality errors.",
    "dtype": "bool",
    "nullable": false,
    "required": true,
    "unique": false
  },
  "_dq_warn": {
    "checks": [],
    "coerce": false,
    "description": "Flag for data quality warnings.",
    "dtype": "bool",
    "nullable": false,
    "required": true,
    "unique": false
  },
  "_index": {
    "checks": [
      {
        "name": "greater_than_or_equal_to",
        "type": "ge"
      }
    ],
    "coerce": false,
    "description": "Sequential index of the record in the pipeline run.",
    "dtype": "int64",
    "nullable": false,
    "required": true,
    "unique": false
  },
