#!/usr/bin/env bash
# Amp orb setup for BioETL (#13216). Runs once per project snapshot; the
# result is cached as the snapshot used to start new orbs. Budget: 20
# minutes (Amp platform limit); a timeout publishes no snapshot.
# Docs: https://ampcode.com/docs/orbs/customizing
set -euo pipefail

# Python 3.13 from .python-version, locked dependencies.
uv sync --locked

# Node dependencies for docs/tooling; package-lock.json is canonical.
npm ci

# Official GitHub MCP binary for scripts/ai/mcp/github-mcp-wrapper.sh,
# installed to its candidate path $HOME/tools/bin. Pinned on purpose;
# bump deliberately. Read-only mode requires no digest approval.
GITHUB_MCP_VERSION="2.2.0"
mkdir -p "${HOME}/tools/bin"
gh_mcp_tmp="$(mktemp -d)"
curl -fsSL "https://github.com/github/github-mcp-server/releases/download/v${GITHUB_MCP_VERSION}/github-mcp-server_Linux_x86_64.tar.gz" -o "${gh_mcp_tmp}/ghmcp.tar.gz"
curl -fsSL "https://github.com/github/github-mcp-server/releases/download/v${GITHUB_MCP_VERSION}/github-mcp-server_${GITHUB_MCP_VERSION}_checksums.txt" -o "${gh_mcp_tmp}/checksums.txt"
( cd "${gh_mcp_tmp}" && grep "github-mcp-server_Linux_x86_64.tar.gz" checksums.txt | sha256sum -c - )
tar -xzf "${gh_mcp_tmp}/ghmcp.tar.gz" -C "${HOME}/tools/bin" github-mcp-server
chmod +x "${HOME}/tools/bin/github-mcp-server"
rm -rf "${gh_mcp_tmp}"

# No `git fetch --unshallow`: orbs clone the full branch history by default,
# which check_no_partial_tree.py requires.
# No `gh` commands: GitHub is not authenticated during setup (see
# .agents/resume for the post-activation check).
# No Docker/Redis/monitoring startup: ADR-010 (local-only deployment).
