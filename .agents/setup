#!/usr/bin/env bash
# Amp orb setup for BioETL (#13216). Runs once per project snapshot; the
# result is cached as the snapshot used to start new orbs. Budget: 20
# minutes (Amp platform limit); a timeout publishes no snapshot.
# Docs: https://ampcode.com/docs/orbs/customizing
set -euo pipefail
# The orb image presets core.hooksPath in the global git config, pointing
# outside any repository. The repo's hook-installation guard rejects an
# external hooks path ("external core.hooksPath requires host review"),
# so drop the inherited value; git falls back to the default .git/hooks.
# .agents/resume repeats this repair in case activation re-injects it.
git config --global --unset-all core.hooksPath || true

# Python 3.13 from .python-version, locked dependencies.
uv sync --locked

# Ignore inherited cache paths that may be absent or unwritable
# (for example /home/ubuntu/... causes EACCES in this orb).
export NPM_CONFIG_CACHE="${PWD}/.cache/npm-cache"
# Node dependencies for docs/tooling; package-lock.json is canonical.
npm ci
# Headless Chromium for the Playwright-based tooling tests (Grafana
# screenshot runtime). The browser is a dependency of the test suite, so
# it is installed into the snapshot here, never in .agents/resume. The
# tests launch only headless:true, so the headless shell suffices; the
# screenshot runtime scripts install their own full Chromium.
npx playwright install --only-shell chromium

# Keep the version selected for the Amp orb. Both immutable release
# archives are pinned by their GitHub-published SHA-256, never releases/latest.
# https://github.com/github/github-mcp-server/releases/tag/v2.2.0
install_github_mcp() (
  umask 077
  case "$(uname -s):$(uname -m)" in
    Linux:x86_64)
      archive_name="github-mcp-server_Linux_x86_64.tar.gz"
      archive_sha="157c5664b273e5070126d414f88cbab765630acde588f75dafdf9998c2235c51"
      ;;
    Linux:aarch64|Linux:arm64)
      archive_name="github-mcp-server_Linux_arm64.tar.gz"
      archive_sha="d21e4fca8603b59d99380f1c332aaea36d73033d52b389867adf2124ee150983"
      ;;
    *) echo "amp-setup: unsupported GitHub MCP platform" >&2; exit 64 ;;
  esac
  stage="$(mktemp -d "${TMPDIR:-/tmp}/bioetl-amp-github.XXXXXXXX")"
  trap 'rm -f -- "$stage/archive.tar.gz" "$stage/github-mcp-server"; rmdir -- "$stage"' EXIT
  curl --proto '=https' --proto-redir '=https' --tlsv1.2 \
    --fail --silent --show-error --location --retry 2 \
    --connect-timeout 10 --max-time 120 \
    --output "$stage/archive.tar.gz" \
    "https://github.com/github/github-mcp-server/releases/download/v2.2.0/$archive_name"
  printf '%s  %s\n' "$archive_sha" "$stage/archive.tar.gz" | sha256sum --check - >/dev/null
  tar -xOzf "$stage/archive.tar.gz" github-mcp-server > "$stage/github-mcp-server"
  install -D -m 0755 "$stage/github-mcp-server" "$HOME/tools/bin/github-mcp-server"
  "$HOME/tools/bin/github-mcp-server" --version >/dev/null
)
install_github_mcp

# Separate environment: do not add MCP SDK dependencies to BioETL's runtime.
bash scripts/ai/mcp/setup_public_fetch.sh

# No `git fetch --unshallow`: orbs clone the full branch history by default,
# which check_no_partial_tree.py requires.
# No `gh` commands: GitHub is not authenticated during setup (see
# .agents/resume for the post-activation check).
# No Docker/Redis/monitoring startup: ADR-010 (local-only deployment).
