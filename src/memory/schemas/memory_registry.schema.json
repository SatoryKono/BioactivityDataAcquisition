{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIMemorySurfaceRegistry",
  "type": "object",
  "required": ["schema_version", "_surface_defaults", "surfaces"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "_surface_defaults": {
      "type": "object"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "surface": {
      "type": "object",
      "required": [
        "memory_id",
        "agent_or_runtime",
        "memory_type",
        "subtype",
        "path_or_backend",
        "format",
        "scope",
        "owner",
        "canonicality",
        "source_of_truth",
        "readers",
        "writers",
        "lifetime",
        "retention_policy",
        "cleanup_policy",
        "load_trigger",
        "write_trigger",
        "version_binding",
        "branch_binding",
        "freshness_mechanism",
        "invalidation_mechanism",
        "conflict_resolution",
        "concurrency_model",
        "provenance",
        "security_classification",
        "contains_secrets_or_pii",
        "runtime_usage_proven",
        "evidence",
        "status",
        "risks"
      ],
      "properties": {
        "memory_id": {
          "type": "string",
          "pattern": "^MEM-[A-Z0-9-]+$"
        },
        "agent_or_runtime": {"type": "string", "minLength": 1},
        "memory_type": {
          "enum": [
            "contextual",
            "working",
            "episodic",
            "semantic",
            "procedural",
            "project",
            "user",
            "shared",
            "tool",
            "cache",
            "evidence",
            "decision"
          ]
        },
        "subtype": {"type": "string", "minLength": 1},
        "path_or_backend": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "canonicality": {
          "enum": [
            "canonical",
            "derived",
            "mirror",
            "generated",
            "transient",
            "cache",
            "local-only",
            "legacy",
            "unknown"
          ]
        },
        "source_of_truth": {"type": ["string", "null"]},
        "readers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "writers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "lifetime": {"type": "string", "minLength": 1},
        "retention_policy": {"type": "string", "minLength": 1},
        "cleanup_policy": {"type": "string", "minLength": 1},
        "load_trigger": {"type": "string", "minLength": 1},
        "write_trigger": {"type": "string", "minLength": 1},
        "version_binding": {"type": "string", "minLength": 1},
        "branch_binding": {"type": "string", "minLength": 1},
        "freshness_mechanism": {"type": "string", "minLength": 1},
        "invalidation_mechanism": {"type": "string", "minLength": 1},
        "conflict_resolution": {"type": "string", "minLength": 1},
        "concurrency_model": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "security_classification": {
          "enum": ["public", "internal", "confidential", "secret"]
        },
        "contains_secrets_or_pii": {"type": "boolean"},
        "runtime_usage_proven": {"type": "boolean"},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": ["PASS", "WARN", "FAIL", "NOT_PROVEN", "NOT_APPLICABLE"]
        },
        "risks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
