{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubagentHandoff",
  "type": "object",
  "required": ["schema_version", "envelope", "objective", "constraints", "evidence_digests", "context"],
  "properties": {
    "schema_version": {"const": 1},
    "envelope": {"$ref": "record_envelope.schema.json"},
    "objective": {"type": "string", "minLength": 1},
    "constraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence_digests": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "context": {
      "type": "object",
      "properties": {
        "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "symbols": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
