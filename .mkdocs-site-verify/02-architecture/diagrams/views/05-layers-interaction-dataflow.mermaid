flowchart LR
    CLI["CLI"]
    Builder["build_pipeline_runner"]
    Runner["PipelineRunner"]
    Executor["BatchExecutor"]
    Processing["BatchProcessingService"]
    TransformWrite["BatchTransformer / BatchWriter"]
    Services["PipelineService"]
    Ports["Domain ports"]
    Infra["Infra adapters"]

    CLI --> Builder --> Runner --> Executor --> Processing --> TransformWrite
    Runner --> Services
    Processing --> Services
    Services --> Ports
    Infra -.->|"implements"| Ports

    style CLI fill:#eff6ff,stroke:#2563eb,stroke-width:2px
    style Builder fill:#fff7ed,stroke:#f59e0b,stroke-width:2px
