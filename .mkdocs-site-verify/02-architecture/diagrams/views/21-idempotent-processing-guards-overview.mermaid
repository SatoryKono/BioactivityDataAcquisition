%% View: Overview | Parent: ../architecture/21-idempotent-processing-guards.mmd
%% @uniform width=176 height=64 max_title_len=18 max_desc_lines=1
flowchart LR
    START["Run / resume request"] --> LOCK["Acquire lock + start heartbeat"]
    LOCK --> LOAD["Load checkpoint state"]
    LOAD --> COMPAT["Identity compatibility check"]
    COMPAT --> EXEC["Execute with one active owner"]
    EXEC --> PUBLISH["Validate lock before publish"]
    PUBLISH --> FINISH["Delete or persist checkpoint"]

    classDef iface fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.8px;
    class START iface;
    class LOCK,LOAD,COMPAT,EXEC,PUBLISH,FINISH process;
