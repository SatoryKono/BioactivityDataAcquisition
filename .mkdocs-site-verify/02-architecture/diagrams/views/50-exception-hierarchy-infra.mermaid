%% View: Infrastructure-Mapping | Parent: 50-exception-hierarchy-full.mermaid
%% @uniform width=192 height=56 max_title_len=19 max_desc_lines=0
flowchart TB
%% keep-orphan: N11

    subgraph Domain["Domain Layer"]
        direction TB
        N5["METRICS_ERROR"]
        N8["DELTA_SCHEMA_V"]
        N17["DQ_ERROR"]
        N18["VALIDATION"]
    end

    subgraph Application["Application Layer"]
        direction TB
        N14["EXT_SERVICE"]
    end

    subgraph Infrastructure["Infrastructure Layer"]
        direction TB
        N1["STORAGE_ERR"]
        N2["LOCK_LOST"]
        N3["LOCK_ACQ"]
        N4["CHECKPOINT_CONFLICT"]
        N6["STORAGE_QUOTA"]
        N7["DELTA_TX"]
        N9["DELTA_WRITE"]
        N10["DELTA_OPT"]
        N11["ACTION_QUARANTINE"]
        N12["CRITICAL"]
        N13["RECOVERABLE"]
        N15["BIOETL"]
        N16["status_code"]
        N19["operation"]
        N20["expected"]
    end

    N15 ==> N12
    N15 --> N13
    N15 --> N17
    N12 --> N2
    N12 --> N3
    N12 --> N4
    N12 --> N16
    N12 --> N5
    N12 --> N19
    N12 --> N6
    N12 --> N7
    N12 --> N8
    N12 --> N20
    N13 --> N16
    N13 --> N14
    N13 --> N19
    N14 --> N16
    N13 --> N1
    N1 --> N9
    N1 --> N10
    N17 --> N18
    N18 --> N20

    style Domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
    style Application fill:#f0fdf4,stroke:#16a34a,stroke-width:2px
    style Infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:2px

    classDef port fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px,color:#111827;
    classDef adapter fill:#fff1f2,stroke:#dc2626,stroke-width:1px,color:#111827;
    classDef service fill:#eff6ff,stroke:#2563eb,stroke-width:1px,color:#111827;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#111827;
    classDef storage fill:#fff7ed,stroke:#f59e0b,stroke-width:1px,color:#111827;

    linkStyle default stroke:#475569,stroke-width:2px,stroke-dasharray:5
