# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Python files must use LF line endings
*.py text eol=lf
*.pyi text eol=lf

# Configuration files
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows batch files (keep CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.whl binary
*.gz binary
*.zip binary
*.zst binary

# Jupyter notebooks
*.ipynb text eol=lf

# VCR cassettes
*.json text eol=lf

# VCR cassettes and metadata sidecars live in git. GitHub LFS quota is
# exhausted and will not be increased; pointer files would make replay CI
# unreproducible. Keep YAML as regular text blobs (largest current cassette
# is well under GitHub's 100 MiB file limit).
tests/fixtures/vcr/**/*.yaml text eol=lf

