{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bioetl://contracts/reports/pipeline_run_report.v2.json",
  "title": "pipeline_run_report_v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reason_catalog_version",
    "identity",
    "funnel",
    "layers",
    "reasons_top_n",
    "reconciliation",
    "tracking_coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "pipeline_run_report_v2"
    },
    "reason_catalog_version": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/reason_catalog_version"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "pipeline_name",
        "run_type",
        "status"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pipeline_name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failed",
            "shutdown",
            "dry_run",
            "partial",
            "cancelled",
            "running",
            "started"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "workflow_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_step_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "funnel": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/funnel"
    },
    "layers": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/layers"
    },
    "reasons_top_n": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/reasons_top_n"
    },
    "artifacts": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/artifacts"
    },
    "reconciliation": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/reconciliation"
    },
    "tracking_coverage": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/tracking_coverage"
    },
    "failure": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/failure"
    },
    "io": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/io"
    },
    "quarantine": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/quarantine"
    },
    "dq_summary": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/dq_summary"
    },
    "contract_summary": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/contract_summary"
    },
    "schema_versions": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/schema_versions"
    },
    "stage_timings": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/stage_timings"
    },
    "http_summary": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/http_summary"
    },
    "performance": {
      "$ref": "bioetl://contracts/reports/pipeline_run_report.v1.json#/properties/performance"
    },
    "observations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "verdict",
          "reason",
          "facts"
        ],
        "properties": {
          "verdict": {
            "enum": [
              "OK",
              "WARN",
              "ERROR",
              "INCOMPLETE",
              "UNKNOWN",
              "N/A"
            ]
          },
          "reason": {
            "type": "string"
          },
          "facts": {
            "type": "object"
          }
        }
      }
    },
    "selected_run_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "evidence",
        "assessment"
      ],
      "properties": {
        "schema_version": {
          "const": "selected_run_snapshot_v1"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "object"
        },
        "assessment": {
          "type": "object",
          "required": [
            "rules_version",
            "execution_state",
            "verdict",
            "checks_verdict",
            "evidence_completeness",
            "domains"
          ],
          "properties": {
            "rules_version": {
              "const": "selected-run-v2"
            },
            "domains": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "domain",
                  "verdict",
                  "reason",
                  "applicable",
                  "evidence_ref",
                  "action"
                ],
                "properties": {
                  "domain": {
                    "enum": [
                      "Runtime",
                      "Control Plane",
                      "Workflow",
                      "Data Quality",
                      "Provider",
                      "Data Validation"
                    ]
                  },
                  "verdict": {
                    "enum": [
                      "OK",
                      "WARN",
                      "ERROR",
                      "INCOMPLETE",
                      "UNKNOWN",
                      "N/A"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "applicable": {
                    "type": "boolean"
                  },
                  "evidence_ref": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
