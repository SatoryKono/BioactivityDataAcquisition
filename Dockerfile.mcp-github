# BioETL MCP GitHub Server - GitHub API access for AI agents
FROM node:26-alpine

WORKDIR /app

# Install dependencies once, cache node_modules
RUN npm install --production --no-fund @modelcontextprotocol/server-github@2025.4.8

# Non-root user
RUN addgroup mcpuser && adduser -D -G mcpuser mcpuser
USER mcpuser

# Run the server (requires GITHUB_PERSONAL_ACCESS_TOKEN env var)
ENTRYPOINT ["npx", "@modelcontextprotocol/server-github@2025.4.8"]
