%% View: Full | Parent: (root)
%% Parent source: docs/02-architecture/diagrams/foundation/02-full-medallion-data-flow.mmd
%% Full reference diagram retained after decomposition.
%% Title: Medallion Architecture Layers
%% Covers: RULES.md §2.1 (Bronze/Silver/Gold), §2.3 (Quarantine)
%% Updated: 2026-02-17
%% Components: BronzeWriter, SilverWriter, GoldWriter, QuarantineManager
%% Legend: see 00-legend.mermaid

%% @version 1.0.0
%% @date    2026-02-24
%% @type    flowchart
%% @level   Mixed (System / Component / Class)

%%{init: {
  'flowchart': {
    'subGraphTitleMargin': { 'top': 12, 'bottom': 12 }
  },
  'layout': 'elk',
  'elk': {
    'mergeEdges': true,
    'nodePlacementStrategy': 'BRANDES_KOEPF',
    'edgeRouting': 'ORTHOGONAL'
  }
}}%%
%% @uniform width=224 height=56 max_title_len=23 max_desc_lines=1
flowchart LR
    subgraph Bronze["Bronze Layer"]
        direction TB
        B1["Raw Data<br/>JSONL + zstd"]
        B2["Append-Only writes<br/>"]
        B3["Retention: 90 days<br/>"]
        B4["content_hash tracking<br/>"]
    end

    subgraph Silver["Silver Layer"]
        direction TB
        S1["Normalized Data<br/>Delta Lake (ACID)"]
        S2["Merge by content_hash<br/>"]
        S3["Schema enforcement<br/>"]
        S4["Deduplication<br/>"]
    end

    subgraph Gold["Gold Layer"]
        direction TB
        G1["Business-Ready Data<br/>Delta Lake"]
        G2["Strict validation<br/>(Pandera schemas)"]
        G3["SCD Type 2 /<br/>Overwrite modes"]
        G4["Flattened for analytics<br/>"]
    end

    subgraph Quarantine["Quarantine"]
        direction TB
        Q1["Failed records<br/>(DQ errors)"]
        Q2["Error metadata +<br/>stack trace"]
        Q3["Replay support<br/>"]
    end

    Bronze -->|K01| Silver
    Silver -->|K02| Gold
    Bronze -.->|"DQ failure"| Quarantine
    Silver -.->|"DQ failure"| Quarantine
    Quarantine -.->|"Replay"| Bronze

    %% Styling — Medallion colors per policy §4.3
    classDef bronze fill:#fff7ed,stroke:#f59e0b,color:#212121
    classDef silver fill:#f8fafc,stroke:#475569,color:#212121
    classDef gold fill:#fefce8,stroke:#ca8a04,color:#212121
    classDef quarantine fill:#ffe4e6,stroke:#e11d48,color:#dc2626

    class B1,B2,B3,B4 bronze
    class S1,S2,S3,S4 silver
    class G1,G2,G3,G4 gold
    class Q1,Q2,Q3 quarantine

    linkStyle 0 stroke:#1E293B,stroke-width:4px
    linkStyle 1 stroke:#1E293B,stroke-width:4px
    linkStyle 2 stroke:#EF4444,stroke-width:2px,stroke-dasharray:4
    linkStyle 3 stroke:#EF4444,stroke-width:2px,stroke-dasharray:4
    linkStyle 4 stroke:#EF4444,stroke-width:2px,stroke-dasharray:4
