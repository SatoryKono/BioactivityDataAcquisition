%% @level   Mixed (System / Component / Class)
%% @uniform width=200 height=72 max_title_len=20 max_desc_lines=2
%%{init: {'layout': 'elk', 'flowchart': {'subGraphTitleMargin': {'top': 12, 'bottom': 12}}, 'elk': {'mergeEdges': true, 'nodePlacementStrategy': 'BRANDES_KOEPF', 'edgeRouting': 'ORTHOGONAL'}}}%%
flowchart TB
    subgraph External["External APIs"]
        CHEMBL["ChEMBL API"]
        PUBCHEM["PubChem API"]
        UNIPROT["UniProt API"]
        PUBMED["PubMed API"]
    end

    subgraph Local["Local Machine (Single Instance)"]
        subgraph Orchestration["CLI Execution"]
            CLI["CLI / Manual run"]
            SCHEDULE["Local scheduler"]
        end

        subgraph Runtime["Local Pipeline Workers"]
            ACT["chembl_activity"]
            ASSAY["chembl_assay"]
            TARGET["chembl_target"]
            MOL["chembl_molecule"]
            PC["pubchem_compound"]
            UNI["uniprot_protein"]
        end

        subgraph Locking["In-Process Locking"]
            LOCK["MemoryLock<br/>in-process only<br/>no cross-process coordination"]
        end

        subgraph Data["Local filesystem (data/)"]
            BRONZE["bronze/"]
            SILVER["silver/"]
            GOLD["gold/"]
            QUAR["quarantine/"]
            CKP["checkpoints/"]
            LIN["lineage/"]
        end

        subgraph Obs["Local Observability"]
            LOGS["logs"]
            METRICS["in-process metrics"]
        end
    end

    CHEMBL --> ACT
    PUBCHEM --> PC
    UNIPROT --> UNI
    PUBMED --> ACT

    CLI --> ACT
    CLI --> ASSAY
    CLI --> TARGET
    CLI --> MOL
    CLI --> PC
    CLI --> UNI
    SCHEDULE --> CLI

    ACT -.-> LOCK
    ASSAY -.-> LOCK
    TARGET -.-> LOCK
    MOL -.-> LOCK
    PC -.-> LOCK
    UNI -.-> LOCK

    ACT --> BRONZE
    ACT --> SILVER
    ACT --> GOLD
    ACT --> QUAR
    ACT --> CKP
    ACT --> LIN
    ACT --> LOGS
    ACT --> METRICS
