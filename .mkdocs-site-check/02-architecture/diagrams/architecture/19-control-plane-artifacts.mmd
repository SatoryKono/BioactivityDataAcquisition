flowchart LR
    CALLER["build_pipeline_runner / CLI run"]:::size-md
    CLI["run-manifest / lineage / inspection CLI"]:::size-md

    subgraph Launch["Runtime descriptors"]
        PRUN["PipelineRunContext<br/>launch descriptor"]:::size-md
        PCTX["PipelineContext<br/>in-run processing context"]:::size-md
    end

    subgraph Composition["Composition runtime builders"]
        CTRL["create_run_manifest_with_effective_config<br/>publish manifest + effective config"]:::size-md
        LCOL["attach_control_plane_collaborators<br/>bind manifest / ledger / lineage"]:::size-md
    end

    subgraph Application["Application services"]
        ECS["EffectiveConfigService"]:::size-md
        RMS["RunManifestService"]:::size-md
        RLS["RunLedgerService"]:::size-md
        CLOAD["CompositeCheckpointLoadService<br/>resume gate + replay coordinator"]:::size-md
        INS["RunManifestInspection +<br/>LineageInspection services"]:::size-md
    end

    subgraph Domain["Domain ports + replay model"]
        RMP["RunManifestPort"]:::size-md
        RLP["RunLedgerPort"]:::size-md
        LSP["LineageStorePort"]:::size-md
        CKPP["CompositeCheckpointPort"]:::size-md
        RPROJ["project_run_ledger_replay<br/>suffix after last_event_id"]:::size-md
    end

    subgraph Infra["Infrastructure stores"]
        EFS["FileEffectiveConfigArtifactStore"]:::size-md
        MFS["FileRunManifestStore"]:::size-md
        LGS["FileRunLedgerStore"]:::size-md
        LNS["FileLineageStore"]:::size-md
        LCK["LocalCheckpointAdapter"]:::size-md
    end

    subgraph Artifacts["Published artifacts"]
        ECFG["Effective-config artifact"]:::size-md
        MAN["Run manifest<br/>immutable provenance"]:::size-md
        LED["Run-ledger entries<br/>append-only events"]:::size-md
        FRAG["Lineage graph fragments"]:::size-md
        CKPT["Composite checkpoint snapshot<br/>anchors + last_event_id"]:::size-md
    end

    subgraph Runtime["Runtime publishers / consumers"]
        RUNNER["PipelineRunner"]:::size-md
        CRUN["CompositePipelineRunner"]:::size-md
        WRITERS["SilverWriter / GoldWriter"]:::size-md
    end

    CALLER --> PRUN
    PRUN --> CTRL
    CTRL --> ECS
    CTRL --> RMS
    CTRL --> RLS
    CTRL --> LCOL

    ECS --> ECFG
    ECS --> EFS
    RMS --> MAN
