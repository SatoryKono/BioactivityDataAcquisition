#!/usr/bin/env bash
# Codex Headless - простой запуск с API key

export OPENAI_API_KEY="[REDACTED]"

# Get Codex binary path
CODEX_BIN="$HOME/.cache/tools/codex-cli/npm-global/bin/codex"

# Check if Codex exists
if [[ ! -x "$CODEX_BIN" ]]; then
    echo "Installing Codex..."
    mkdir -p ~/.cache/tools/codex-cli/npm-global
    export NPM_CONFIG_PREFIX=~/.cache/tools/codex-cli/npm-global
    npm install -g @openai/codex@latest
fi

# Run Codex
"$CODEX_BIN" "$@"
