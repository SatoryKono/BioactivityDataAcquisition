#!/bin/bash

# gemini
# Unified Gemini launcher - Single entry point for all Gemini operations
# Usage: bash scripts/gemini/gemini [command] [options]

# Get script directory and project root FIRST
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Helper functions
print_header() {
  echo -e "${CYAN}"
  echo "╔════════════════════════════════════════════════════════════════════════════════╗"
  echo "║                         🧬 GEMINI - BioETL AI Assistant 🧬                    ║"
  echo "╚════════════════════════════════════════════════════════════════════════════════╝"
  echo -e "${NC}"
}

print_section() {
  echo -e "\n${BLUE}▶ $1${NC}"
}

print_error() {
  echo -e "${RED}✗ $1${NC}"
}

print_success() {
  echo -e "${GREEN}✓ $1${NC}"
}

print_info() {
  echo -e "${CYAN}ℹ $1${NC}"
}

# Show brief help
show_brief_help() {
  cat << EOF
Usage: bash scripts/gemini/gemini [command] [options]

Commands:
  interactive    Launch interactive menu (default)
  setup          Initialize Gemini environment
  sync           Sync profiles from Codex
  chat [profile] Chat with agent profile
  review [scope] Create code review task
  test [%] [sc]  Create test generation task
  config [scope] Create config audit task
  architecture   Create architecture analysis
  debug [issue]  Create debug/fix task
  status         Show environment status
  reset          Clear memory and reinitialize
  help           Show full help
  version        Show version

Quick start:
  bash scripts/gemini/gemini setup
  bash scripts/gemini/gemini sync
  bash scripts/gemini/gemini

For full help: bash scripts/gemini/gemini help
EOF
}

show_help() {
  print_header
  
  cat << 'EOF'

COMMANDS

  interactive                Launch interactive menu (default)
  
  setup                      Initialize Gemini environment
                            - Create .gemini/ structure
                            - Initialize memory file
                            - Validate MCP servers
  
  sync                       Sync agent profiles from Codex
                            - Copy py-* profiles
                            - Update .gemini/agents/
  
  chat [profile]             Launch chat mode with agent profile
                            - Default: py-review-orchestrator
                            - Live conversation, logged to session
  
  review [scope]             Create code review task
                            - scope: staged | file <path> | directory <path> | project
  
  test [coverage] [scope]    Create test generation task
                            - coverage: target % (default: 85)
                            - scope: application | domain | all
  
  config [scope]             Create configuration audit task
                            - scope: all | configs | specific
  
  architecture [focus]       Create architecture analysis task
                            - focus: debt | dependencies | layers | ports
  
  debug [issue] [file]       Create debug/fix task
                            - issue: problem description
                            - file: optional affected file path
  
  status                     Show environment status
  reset                      Clear memory and reinitialize
  help                       Show this help message
  version                    Show version information

EXAMPLES

  bash scripts/gemini/gemini setup
  bash scripts/gemini/gemini sync
  bash scripts/gemini/gemini
  bash scripts/gemini/gemini status
  bash scripts/gemini/gemini chat py-review-orchestrator
  bash scripts/gemini/gemini review staged
  bash scripts/gemini/gemini test 90 domain

EOF
}

show_version() {
  cat << 'EOF'
Gemini Interactive Launcher v1.0
Project: BioETL
Created: 2026-04-14
Status: Production Ready
EOF
}

# Validate environment
check_env() {
  local gemini_home="${PROJECT_ROOT}/.gemini"
  local config_file="${gemini_home}/config.toml"
  local mcp_settings="${gemini_home}/settings.json"
  local memory_file="${PROJECT_ROOT}/docs/00-project/ai/memory/gemini-memory.json"
  
  print_section "Checking Environment"
  
  [ -d "$gemini_home" ] && print_success "Gemini home: $gemini_home" || print_error "Gemini home: $gemini_home"
  [ -f "$config_file" ] && print_success "Config: config.toml" || print_error "Config not found: $config_file"
  [ -f "$mcp_settings" ] && print_success "MCP settings: loaded" || print_error "MCP settings not found: $mcp_settings"
  [ -f "$memory_file" ] && print_success "Memory file: gemini-memory.json" || print_warning "Memory file: will be created"
  
  # Check Node.js
  if command -v node &> /dev/null; then
    print_success "Node.js: $(node --version)"
  else
    print_warning "Node.js: not found"
  fi
  
  # Check UV
  if command -v uvx &> /dev/null; then
    print_success "UV: $(uvx --version 2>&1 | head -1)"
  else
    print_warning "UV: not found"
  fi
  
  # Return success only if config files exist
  if [ -f "$config_file" ] && [ -f "$mcp_settings" ]; then
    return 0
  else
    return 1
  fi
}

# Validate for interactive commands
validate_env() {
  local gemini_home="${PROJECT_ROOT}/.gemini"
  local config_file="${gemini_home}/config.toml"
  local mcp_settings="${gemini_home}/settings.json"
  
  if [ ! -f "$config_file" ] || [ ! -f "$mcp_settings" ]; then
    return 1
  fi
  
  return 0
}

# Command dispatchers
cmd_interactive() {
  if ! validate_env; then
    print_header
    print_section "Checking Environment"
    check_env
    echo ""
    print_error ""
    print_error "Environment check failed. Run setup first:"
    print_error "  bash scripts/gemini/gemini setup"
    print_error ""
    return 1
  fi
  
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/interactive.sh"
}

cmd_setup() {
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/setup.sh"
}

cmd_sync() {
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/sync.sh"
}

cmd_chat() {
  if ! validate_env; then
    print_error "Setup required first: bash scripts/gemini/gemini setup"
    return 1
  fi
  
  local profile="${1:-py-review-orchestrator}"
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/chat.sh" "$profile"
}

cmd_review() {
  if ! validate_env; then
    print_error "Setup required first: bash scripts/gemini/gemini setup"
    return 1
  fi
  
  local scope="${1:-staged}"
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/tasks/review.sh" "$scope" "${@:2}"
}

cmd_test() {
  if ! validate_env; then
    print_error "Setup required first: bash scripts/gemini/gemini setup"
    return 1
  fi
  
  local coverage="${1:-85}"
  local scope="${2:-application}"
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/tasks/test.sh" "$coverage" "$scope"
}

cmd_config() {
  if ! validate_env; then
    print_error "Setup required first: bash scripts/gemini/gemini setup"
    return 1
  fi
  
  local scope="${1:-all}"
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/tasks/config.sh" "$scope"
}

cmd_architecture() {
  if ! validate_env; then
    print_error "Setup required first: bash scripts/gemini/gemini setup"
    return 1
  fi
  
  local focus="${1:-debt}"
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/tasks/architecture.sh" "$focus"
}

cmd_debug() {
  if ! validate_env; then
    print_error "Setup required first: bash scripts/gemini/gemini setup"
    return 1
  fi
  
  local issue="${1}"
  local file="${2}"
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/tasks/debug.sh" "$issue" "$file"
}

cmd_status() {
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/status.sh"
}

cmd_reset() {
  PROJECT_ROOT="$PROJECT_ROOT" bash "${SCRIPT_DIR}/lib/reset.sh"
}

# Main dispatcher
main() {
  local command="${1:-interactive}"
  
  case "$command" in
    interactive) cmd_interactive ;;
    setup) cmd_setup ;;
    sync) cmd_sync ;;
    chat) cmd_chat "${@:2}" ;;
    review) cmd_review "${@:2}" ;;
    test) cmd_test "${@:2}" ;;
    config) cmd_config "${@:2}" ;;
    architecture) cmd_architecture "${@:2}" ;;
    debug) cmd_debug "${@:2}" ;;
    status) cmd_status ;;
    reset) cmd_reset ;;
    help|--help|-h) show_help ;;
    version|--version|-v) show_version ;;
    *)
      print_header
      print_error "Unknown command: $command"
      echo ""
      show_brief_help
      return 1
      ;;
  esac
}

main "$@"
