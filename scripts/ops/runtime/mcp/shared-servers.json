{
  "version": 3,
  "proxy_package": "mcp-proxy@6.5.4",
  "bind_note": "mcp-proxy CLI binds the chosen port; clients MUST use http://127.0.0.1:<port>/mcp only. Prefer host firewall for non-loopback.",
  "servers": {
    "adr-analysis": {
      "port": 8813,
      "path": "/mcp",
      "wrapper": "mcp_adr_analysis_wrapper",
      "class": "T2",
      "priority": 1,
      "daily": true
    },
    "context7": {
      "port": 8815,
      "path": "/mcp",
      "wrapper": "mcp_context7_wrapper",
      "class": "T2",
      "priority": 2,
      "daily": true
    },
    "ast-grep": {
      "port": 8816,
      "path": "/mcp",
      "wrapper": "mcp_ast_grep_wrapper",
      "class": "T2",
      "priority": 2,
      "daily": true
    },
    "github": {
      "port": 8820,
      "path": "/mcp",
      "wrapper": "github-mcp-wrapper",
      "class": "T2",
      "priority": 2,
      "daily": true,
      "notes": "W4: shared HTTP cuts multi-client stdio thrash"
    },
    "fetch": {
      "port": 8821,
      "path": "/mcp",
      "wrapper": "mcp_fetch_wrapper",
      "class": "T2",
      "priority": 2,
      "daily": true,
      "notes": "W4: shared HTTP cuts multi-client stdio thrash"
    },
    "brave-search": {
      "port": 8811,
      "path": "/mcp",
      "wrapper": "mcp_brave_search_wrapper",
      "class": "T2",
      "priority": 3,
      "daily": true,
      "notes": "docker run stdio; longer settle; single shared container"
    },
    "prometheus": {
      "port": 8822,
      "path": "/mcp",
      "wrapper": "mcp_prometheus_wrapper",
      "class": "T2",
      "priority": 4,
      "daily": true,
      "notes": "docker-backed; single shared container"
    },
    "grafana": {
      "port": 8823,
      "path": "/mcp",
      "wrapper": "mcp_grafana_wrapper",
      "class": "T2",
      "priority": 4,
      "daily": true,
      "notes": "docker-backed; single shared container"
    },
    "deja": {
      "port": 8814,
      "path": "/mcp",
      "wrapper": "mcp_deja_wrapper",
      "class": "T2",
      "priority": 1,
      "daily": false,
      "notes": "Optional: requires deja binary (go install github.com/vshulcz/deja-vu/cmd/deja@latest). Excluded from daily until host has binary."
    }
  }
}
