{
  "version": 4,
  "proxy_package": "mcp-proxy@6.5.4",
  "bind_host": "127.0.0.1",
  "connection_timeout_ms": 300000,
  "request_timeout_ms": 300000,
  "bind_note": "All local clients use the same loopback Streamable HTTP endpoints. The launcher must pass --host 127.0.0.1.",
  "servers": {
    "adr-analysis": {
      "port": 8813,
      "path": "/mcp",
      "wrapper": "mcp_adr_analysis_wrapper",
      "priority": 1,
      "daily": true,
      "readiness_timeout_sec": 180,
      "state_model": "stateless"
    },
    "memory": {
      "port": 8826,
      "path": "/mcp",
      "wrapper": "mcp_memory_wrapper",
      "priority": 1,
      "daily": true,
      "readiness_timeout_sec": 180,
      "state_model": "single_process_single_file"
    },
    "filesystem": {
      "port": 8827,
      "path": "/mcp",
      "wrapper": "mcp_filesystem_wrapper",
      "priority": 1,
      "daily": true,
      "readiness_timeout_sec": 180,
      "state_model": "shared_repo_root_allowlist"
    },
    "context7": {
      "port": 8815,
      "path": "/mcp",
      "wrapper": "mcp_context7_wrapper",
      "priority": 2,
      "daily": true,
      "readiness_timeout_sec": 180,
      "state_model": "stateless"
    },
    "ast-grep": {
      "port": 8816,
      "path": "/mcp",
      "wrapper": "mcp_ast_grep_wrapper",
      "priority": 2,
      "daily": true,
      "readiness_timeout_sec": 180,
      "state_model": "shared_repo_root"
    },
    "code-analyzer": {
      "port": 8828,
      "path": "/mcp",
      "wrapper": "mcp_code_analyzer_wrapper",
      "priority": 2,
      "daily": true,
      "readiness_timeout_sec": 180,
      "state_model": "shared_repo_root"
    },
    "github": {
      "port": 8820,
      "path": "/mcp",
      "wrapper": "github-mcp-wrapper",
      "priority": 3,
      "daily": true,
      "readiness_timeout_sec": 240,
      "state_model": "shared_credentials"
    },
    "fetch": {
      "port": 8821,
      "path": "/mcp",
      "wrapper": "mcp_fetch_wrapper",
      "priority": 3,
      "daily": true,
      "readiness_timeout_sec": 300,
      "state_model": "stateless"
    },
    "deja": {
      "port": 8814,
      "path": "/mcp",
      "wrapper": "mcp_deja_wrapper",
      "priority": 3,
      "daily": true,
      "readiness_timeout_sec": 240,
      "state_model": "shared_repo_root"
    },
    "mcp-code-interpreter": {
      "port": 8829,
      "path": "/mcp",
      "wrapper": "mcp_code_interpreter_wrapper",
      "priority": 4,
      "daily": true,
      "readiness_timeout_sec": 300,
      "state_model": "shared_process"
    },
    "mutmut": {
      "port": 8830,
      "path": "/mcp",
      "wrapper": "mcp_mutmut_wrapper",
      "priority": 4,
      "daily": true,
      "readiness_timeout_sec": 240,
      "state_model": "shared_repo_root"
    },
    "github-actions": {
      "port": 8831,
      "path": "/mcp",
      "wrapper": "mcp_github_actions_wrapper",
      "priority": 4,
      "daily": true,
      "readiness_timeout_sec": 240,
      "state_model": "shared_credentials"
    },
    "brave-search": {
      "port": 8811,
      "path": "/mcp",
      "wrapper": "mcp_brave_search_wrapper",
      "priority": 5,
      "daily": true,
      "readiness_timeout_sec": 300,
      "state_model": "shared_credentials"
    },
    "docker": {
      "port": 8817,
      "path": "/mcp",
      "wrapper": "mcp_docker_wrapper",
      "priority": 5,
      "daily": true,
      "readiness_timeout_sec": 300,
      "state_model": "shared_docker_host",
      "launch_mode": "windows_docker_streaming",
      "remote_port": 18817
    },
    "mermaid": {
      "port": 8818,
      "path": "/mcp",
      "wrapper": "mcp_mermaid_wrapper",
      "priority": 5,
      "daily": true,
      "readiness_timeout_sec": 300,
      "state_model": "stateless",
      "launch_mode": "windows_npx_streaming",
      "remote_port": 18818
    },
    "prometheus": {
      "port": 8822,
      "path": "/mcp",
      "wrapper": "mcp_prometheus_wrapper",
      "priority": 6,
      "daily": true,
      "readiness_timeout_sec": 300,
      "state_model": "shared_optional_upstream"
    },
    "grafana": {
      "port": 8823,
      "path": "/mcp",
      "wrapper": "mcp_grafana_wrapper",
      "priority": 6,
      "daily": true,
      "readiness_timeout_sec": 300,
      "state_model": "shared_optional_upstream"
    },
    "neo4j-cypher": {
      "port": 8824,
      "path": "/mcp",
      "wrapper": "mcp_neo4j_cypher_wrapper",
      "priority": 7,
      "daily": false,
      "readiness_timeout_sec": 300,
      "state_model": "shared_optional_upstream"
    },
    "neo4j-memory": {
      "port": 8825,
      "path": "/mcp",
      "wrapper": "mcp_neo4j_memory_wrapper",
      "priority": 7,
      "daily": false,
      "readiness_timeout_sec": 300,
      "state_model": "shared_optional_upstream"
    }
  }
}
