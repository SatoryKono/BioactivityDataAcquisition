{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Parity contract between .codex/** (source runtime) and .junie/** (mirror runtime). Enforced by scripts/ai/junie/check_junie_mirror.sh. Both trees are equal-peer canonical runtime sources; --sync copies from .codex/** into .junie/** only, never the reverse.",
  "version": "1.1.0",
  "source_runtime": ".codex",
  "mirror_runtime": ".junie",
  "parity_scope": {
    "agents": {
      "source_glob": ".codex/agents/py-*.md",
      "mirror_glob": ".junie/agents/py-*.md",
      "required_match": ["filename", "sha256"],
      "exclude_filenames": ["py-code-bot.md"]
    },
    "shared_agent_docs": {
      "source_files": [
        ".codex/agents/README.md",
        ".codex/agents/ORCHESTRATION.md"
      ],
      "mirror_files": [
        ".junie/agents/README.md",
        ".junie/agents/ORCHESTRATION.md"
      ],
      "required_match": ["sha256"]
    },
    "skills_catalog": {
      "source_file": ".codex/skills/SKILLS-CATALOG.md",
      "mirror_file": ".junie/skills/SKILLS-CATALOG.md",
      "required_match": ["sha256"]
    },
    "skills": {
      "source_glob": ".codex/skills/*/",
      "mirror_glob": ".junie/skills/*/",
      "required_match": ["directory_name"],
      "exclude_directory_names": ["py-code-bot"]
    },
    "skill_contents": {
      "source_glob": ".codex/skills/**/*",
      "mirror_glob": ".junie/skills/**/*",
      "required_match": ["relative_path", "sha256"],
      "exclude_relative_path_prefixes": ["py-code-bot/"]
    }
  },
  "runtime_only_files": {
    "codex_only": [
      ".codex/config.toml",
      ".codex/agents/CODEX-RUNTIME.md",
      ".codex/agents/py-audit-bot.toml",
      ".codex/agents/py-config-bot.toml",
      ".codex/agents/py-debug-bot.toml",
      ".codex/agents/py-doc-bot.toml",
      ".codex/agents/py-plan-bot.toml",
      ".codex/agents/py-test-bot.toml"
    ],
    "junie_only": [".junie/agents/JUNIE-RUNTIME.md", ".junie/guidelines.md"]
  },
  "runtime_semantics": {
    "junie_runtime_map": ".junie/agents/JUNIE-RUNTIME.md",
    "junie_guidelines": ".junie/guidelines.md",
    "required_dashboard_skills": [
      "observability-dashboard",
      "observability-prometheus"
    ],
    "forbidden_identifiers": [
      "py-architecture-debt-bot",
      "py-review-orchestrator",
      "py-test-swarm",
      "grafana-dashboard-render",
      "grafana-dashboard-extension"
    ]
  },
  "sync_policy": {
    "direction": "codex_to_junie",
    "never_write_to_codex": true,
    "preserve_runtime_only_files": true
  }
}
