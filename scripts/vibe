#!/usr/bin/env bash
# Launch Mistral Vibe from WSL in the current repository.
# Usage: ./vibe [args...]
# 
# Examples:
#   ./vibe                          # Start interactive mode
#   ./vibe "explain this code"      # Send prompt
#   ./vibe --help                   # Show vibe help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_error() { echo -e "${RED}[mistral]${NC} ERROR: $1" >&2; }
log_warn() { echo -e "${YELLOW}[mistral]${NC} $1"; }
log_info() { echo -e "${BLUE}[mistral]${NC} $1"; }

# Ensure user tools are in PATH
export PATH="${HOME}/.local/bin:${PATH}"

# Source uv environment if available
if [[ -f "${HOME}/.local/bin/env" ]]; then
    # shellcheck disable=SC1091
    source "${HOME}/.local/bin/env" 2>/dev/null || true
fi

# Check if vibe is installed
if ! command -v vibe >/dev/null 2>&1; then
    log_error "Mistral Vibe CLI not found in PATH"
    echo "[mistral] Install with one of:"
    echo "[mistral]   curl -LsSf https://mistral.ai/vibe/install.sh | bash"
    echo "[mistral]   python3 -m pip install --user mistral-vibe"
    echo "[mistral]   pipx install mistral-vibe"
    exit 1
fi

# Show version
VIBE_VERSION=$(vibe --version 2>/dev/null || echo "unknown")
log_info "Using Vibe ${VIBE_VERSION}"
log_info "Working directory: ${REPO_ROOT}"

# Launch vibe
if [[ $# -eq 0 ]]; then
    log_info "Starting interactive mode..."
    exec vibe --workdir "${REPO_ROOT}"
else
    log_info "Prompt: $*"
    exec vibe --workdir "${REPO_ROOT}" "$@"
fi
