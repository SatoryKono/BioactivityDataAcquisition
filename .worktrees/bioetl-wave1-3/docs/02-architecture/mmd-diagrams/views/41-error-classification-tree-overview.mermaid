%% View: Overview | Parent: 41-error-classification-tree-full.mermaid
%% Decomposed overview for error routing actions.
%% @uniform width=220 height=64 max_title_len=22 max_desc_lines=1
%%{init: {'layout':'elk','theme':'base','flowchart':{'nodeSpacing':54,'rankSpacing':68,'curve':'linear'},'elk':{'mergeEdges':true,'edgeRouting':'ORTHOGONAL','nodePlacementStrategy':'BRANDES_KOEPF'}}}%%
flowchart TB
    ERR["Error Occurred"]
    HTTP{{"HTTP Error?"}}
    DOMAIN{{"Domain Error?"}}
    INFRA{{"Infrastructure Error?"}}

    subgraph Actions["Action Outcomes"]
        direction LR
        RETRY["[A] Retry"]
        QUAR["[A] Quarantine"]
        BATCH["[A] Batch Fail"]
        FAIL["[A] Fail Fast"]
    end

    ERR --> HTTP
    ERR --> DOMAIN
    ERR --> INFRA

    HTTP -->|auth| FAIL
    HTTP -->|429/5xx| RETRY
    HTTP -.->|404/other| RETRY

    DOMAIN -->|schema/missing/format| QUAR
    DOMAIN -->|dq threshold| BATCH

    INFRA -->|lock| FAIL
    INFRA -->|storage/cb| RETRY

    BATCH ==> FAIL

    classDef layer_domain fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.8px;
    classDef layer_application fill:#f0fdf4,stroke:#16a34a,stroke-width:1.8px;
    classDef layer_infrastructure fill:#fff1f2,stroke:#dc2626,stroke-width:1.8px;
    classDef layer_external fill:#eff6ff,stroke:#2563eb,stroke-width:1.8px;
    classDef service fill:#f0fdf4,stroke:#16a34a,stroke-width:1.6px;
    classDef process fill:#f0fdf4,stroke:#16a34a,stroke-width:1.4px,stroke-dasharray:3 2;

    class DOMAIN,QUAR,BATCH layer_domain;
    class INFRA layer_infrastructure;
    class HTTP layer_external;
    class ERR,RETRY,FAIL layer_application;
