# Multi-stage build for bioetl: locked dependencies -> shell-less runtime.
# All non-scratch stages derive from one immutable Wolfi base image digest.
# docker:S8431 - pin by digest only (no tag+digest).
FROM chainguard/wolfi-base@sha256:19f7a7b40a11c435311e3784bd134c6b6f19677462440da48f96d5c84eefd669 AS builder

# Builder package installation requires root; the final scratch stage is non-root.
# hadolint ignore=DL3002
USER 0
WORKDIR /app

ENV UV_HTTP_TIMEOUT=300 \
    UV_CONCURRENT_DOWNLOADS=4 \
    UV_LINK_MODE=copy \
    UV_NO_PROGRESS=1

# Public Wolfi packages are version-pinned. Third-party project dependencies
# remain binary-only, so the builder does not need a compiler toolchain.
RUN echo 'https://packages.wolfi.dev/os' > /etc/apk/repositories \
    && apk add --no-cache \
        bash=5.3-r12 \
        python-3.13=3.13.15-r6 \
        uv=0.11.26-r0 \
    && python3.13 --version \
    && uv --version

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install locked third-party wheels before copying source. This keeps the
# dependency environment cacheable across source-only changes while preserving
# pyproject.toml and uv.lock as the application dependency authority.
COPY pyproject.toml uv.lock ./
RUN printf '# BioETL\n' > README.md \
    && UV_NO_BUILD=1 UV_HTTP_TIMEOUT=300 uv sync --no-dev --frozen --no-build --no-install-project \
        --python /usr/bin/python3.13 --directory /app

# Copy project source only after the dependency environment is materialized.
# Source-only changes therefore invalidate the small project-wheel layer, not
# the complete third-party environment.
COPY src/ ./src/

# Build the local wheel in an isolated environment whose backend is constrained
# Docker-locally, then install only that wheel into the locked environment.
RUN printf 'setuptools==83.0.0\n' > /tmp/build-constraints.txt \
    && UV_HTTP_TIMEOUT=300 uv build --wheel \
        --build-constraint /tmp/build-constraints.txt \
        --out-dir /tmp/bioetl-wheels --directory /app \
    && UV_HTTP_TIMEOUT=300 uv pip install --python /app/.venv/bin/python --no-deps \
        --only-binary :all: --no-index /tmp/bioetl-wheels/bioetl-*.whl \
    && rm -rf /tmp/bioetl-wheels /tmp/build-constraints.txt \
    && mkdir -p /app/logs

# Prepare the supported Python 3.13 runtime filesystem. Keep the apk database
# so Trivy can audit installed OS packages, while excluding executable package
# manager and shell surfaces from the final scratch stage.
FROM chainguard/wolfi-base@sha256:19f7a7b40a11c435311e3784bd134c6b6f19677462440da48f96d5c84eefd669 AS runtime-root

# Runtime-root assembles files only; the final scratch stage runs as 999:999.
# hadolint ignore=DL3002
USER 0
RUN echo 'https://packages.wolfi.dev/os' > /etc/apk/repositories \
    && apk add --no-cache \
        python-3.13=3.13.15-r6 \
        tzdata=2026c-r0 \
    && python3.13 --version \
    && mkdir -p /runtime-fs/tmp \
    && chown 999:999 /runtime-fs/tmp \
    && chmod 0700 /runtime-fs/tmp \
    && ! grep -Eq '^[^:]*:[^:]*:999:' /etc/passwd \
    && ! grep -Eq '^[^:]*:[^:]*:999:' /etc/group \
    && printf 'bioetl:x:999:999:BioETL runtime:/app:/sbin/nologin\n' >> /etc/passwd \
    && printf 'bioetl:x:999:\n' >> /etc/group \
    && rm -f \
        /bin/ash \
        /bin/bash \
        /bin/busybox \
        /bin/sh \
        /sbin/apk \
        /usr/bin/apk \
        /usr/bin/ash \
        /usr/bin/bash \
        /usr/bin/busybox \
        /usr/bin/sh

# Final runtime contains only the audited Wolfi root, locked venv, and configs.
FROM scratch

COPY --from=runtime-root /etc /etc
COPY --from=runtime-root /lib /lib
COPY --from=runtime-root /lib64 /lib64
COPY --from=runtime-root /usr /usr
COPY --from=runtime-root /runtime-fs/ /
WORKDIR /app

COPY --from=builder --chown=999:999 /app/.venv /app/.venv
COPY --chown=root:root configs/ ./configs/
COPY --from=builder --chown=999:999 /app/logs /app/logs

ENV PATH="/app/.venv/bin:/usr/bin"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

USER 999:999

EXPOSE 8000 8081

ENTRYPOINT ["bioetl"]

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3).read()"]

CMD ["health", "server", "--host", "0.0.0.0", "--port", "8000"]
