# Multi-stage build for bioetl: dependencies → runtime
# Stage 1: Builder (install dependencies with uv)
FROM python:3.12-slim@sha256:c3d81d25b3154142b0b42eb1e61300024426268edeb5b5a26dd7ddf64d9daf28 AS builder

WORKDIR /app

# Install build dependencies and uv
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libssl-dev \
    libffi-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv==0.11.26

# Copy package metadata and source required by setuptools/uv build resolution.
COPY pyproject.toml uv.lock ./
COPY src/ ./src/
RUN printf '# BioETL\n' > README.md \
    && uv sync --no-dev --frozen --directory /app

# Stage 2: Runtime (minimal image)
FROM python:3.12-slim@sha256:c3d81d25b3154142b0b42eb1e61300024426268edeb5b5a26dd7ddf64d9daf28

WORKDIR /app

# Install runtime dependencies and create non-root user for security
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && groupadd -r bioetl \
    && useradd -r -g bioetl bioetl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application source code as root-owned runtime assets. Default directory
# and file modes keep them readable/traversable while the non-root user cannot
# mutate them.
COPY --chown=root:root src/ ./src/
COPY --chown=root:root configs/ ./configs/

# Create logs directory
RUN mkdir -p /app/logs && chown bioetl:bioetl /app/logs

# Enable the venv
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Switch to non-root user
USER bioetl

# Expose metrics ports
EXPOSE 8000 8081

# Canonical CLI entrypoint so docker-compose can pass subcommands only.
ENTRYPOINT ["bioetl"]

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready').read()"

# Default command (override via docker-compose)
CMD ["health", "server", "--host", "0.0.0.0", "--port", "8000"]
