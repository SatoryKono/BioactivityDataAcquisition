# Multi-stage build for bioetl: dependencies → shell-less runtime
# All stages derive from one immutable Wolfi base image digest.
# docker:S8431 — pin by digest only (no tag+digest).
FROM chainguard/wolfi-base@sha256:19f7a7b40a11c435311e3784bd134c6b6f19677462440da48f96d5c84eefd669 AS builder

USER 0
WORKDIR /app

ENV UV_HTTP_TIMEOUT=300 \
    UV_CONCURRENT_DOWNLOADS=4 \
    UV_LINK_MODE=copy \
    UV_NO_PROGRESS=1

# Public Wolfi packages are version-pinned; no compiler is needed because the
# locked third-party environment is binary-only.
RUN echo 'https://packages.wolfi.dev/os' > /etc/apk/repositories \
    && apk add --no-cache \
        bash=5.3-r12 \
        python-3.13=3.13.15-r2 \
        uv=0.11.26-r0 \
    && python3.13 --version \
    && uv --version

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Copy package metadata and source required by setuptools/uv build resolution.
COPY pyproject.toml uv.lock ./
COPY src/ ./src/
# Lockfile-backed third-party install without sdist/setup scripts (Sonar docker:S8541).
# Local project: build a wheel, then install that binary artifact pinned by pyproject version.
RUN printf '# BioETL\n' > README.md \
    && UV_NO_BUILD=1 UV_HTTP_TIMEOUT=300 uv sync --no-dev --frozen --no-build --no-install-project \
        --python /usr/bin/python3.13 --directory /app \
    && UV_HTTP_TIMEOUT=300 uv build --wheel --out-dir /tmp/bioetl-wheels --directory /app \
    && BIOETL_VERSION="$(python3.13 -c "import tomllib; \
print(tomllib.load(open('pyproject.toml','rb'))['project']['version'])")" \
    && UV_HTTP_TIMEOUT=300 uv pip install --python /app/.venv/bin/python --no-deps \
        --only-binary :all: --no-index \
        --find-links=/tmp/bioetl-wheels "bioetl==${BIOETL_VERSION}" \
    && rm -rf /tmp/bioetl-wheels \
    && mkdir -p /app/logs

# End every stage as non-root; the runtime copy preserves explicit ownership.
USER 65532:65532

# Prepare the supported Python 3.13 runtime filesystem. Keep the apk database so
# Trivy can audit every installed OS package, while removing executable package
# manager and shell surfaces before the final scratch stage.
FROM chainguard/wolfi-base@sha256:19f7a7b40a11c435311e3784bd134c6b6f19677462440da48f96d5c84eefd669 AS runtime-root

USER 0
RUN echo 'https://packages.wolfi.dev/os' > /etc/apk/repositories \
    && apk add --no-cache \
        python-3.13=3.13.15-r2 \
        tzdata=2026c-r0 \
    && python3.13 --version \
    && rm -f /bin/sh /bin/busybox /sbin/apk /usr/bin/apk
USER 65532:65532

# Final runtime contains only the audited Wolfi root, locked venv, and configs.
FROM scratch

COPY --from=runtime-root /etc /etc
COPY --from=runtime-root /lib /lib
COPY --from=runtime-root /lib64 /lib64
COPY --from=runtime-root /usr /usr
WORKDIR /app

COPY --from=builder --chown=65532:65532 /app/.venv /app/.venv
COPY --chown=0:0 configs/ ./configs/
COPY --from=builder --chown=65532:65532 /app/logs /app/logs

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

USER 65532:65532

EXPOSE 8000 8081

ENTRYPOINT ["bioetl"]

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3).read()"]

CMD ["health", "server", "--host", "0.0.0.0", "--port", "8000"]
