{
  "mcpServers": {
    "memory": {
      "url": "http://127.0.0.1:8826/mcp"
    },
    "filesystem": {
      "url": "http://127.0.0.1:8827/mcp"
    },
    "fetch": {
      "url": "http://127.0.0.1:8821/mcp"
    },
    "github": {
      "command": "bash",
      "args": [
        "scripts/ai/mcp/github-mcp-wrapper.sh"
      ],
      "env": {
        "GITHUB_TOOLSETS": "context,issues,pull_requests,repos,users,actions,code_security,dependabot,notifications",
        "GITHUB_EXCLUDE_TOOLS": "create_or_update_file,push_files,delete_file,fork_repository,create_repository,merge_pull_request,actions_run_trigger",
        "GITHUB_LOCKDOWN_MODE": "true"
      }
    },
    "docker": {
      "url": "http://127.0.0.1:8817/mcp"
    },
    "context7": {
      "command": "bash",
      "args": [
        "scripts/ai/mcp/mcp_context7_wrapper.sh"
      ]
    },
    "ast-grep": {
      "command": "bash",
      "args": [
        "scripts/ai/mcp/mcp_ast_grep_wrapper.sh"
      ]
    },
    "mcp-code-interpreter": {
      "url": "http://127.0.0.1:8829/mcp"
    },
    "prometheus": {
      "url": "http://127.0.0.1:8822/mcp"
    },
    "grafana": {
      "url": "http://127.0.0.1:8823/mcp"
    },
    "brave-search": {
      "command": "bash",
      "args": [
        "scripts/ai/mcp/mcp_brave_search_wrapper.sh"
      ]
    },
    "neo4j-cypher": {
      "url": "http://127.0.0.1:8824/mcp"
    },
    "neo4j-memory": {
      "url": "http://127.0.0.1:8825/mcp"
    },
    "mermaid": {
      "url": "http://127.0.0.1:8818/mcp"
    },
    "deja": {
      "url": "http://127.0.0.1:8814/mcp"
    },
    "adr-analysis": {
      "url": "http://127.0.0.1:8813/mcp"
    },
    "mutmut": {
      "url": "http://127.0.0.1:8830/mcp"
    },
    "code-analyzer": {
      "url": "http://127.0.0.1:8828/mcp"
    },
    "github-actions": {
      "url": "http://127.0.0.1:8831/mcp"
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "headers": {
        "x-deepwiki-api-key": "${env:DEEPWIKI_API_KEY}",
        "x-deepwiki-organisation-id": "${env:DEEPWIKI_ORGANISATION_ID}"
      }
    },
    "ref": {
      "url": "https://api.ref.tools/mcp",
      "headers": {
        "x-ref-api-key": "${env:REF_TOOL_API_KEY}"
      }
    }
  }
}
