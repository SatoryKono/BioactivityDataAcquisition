{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@2026.1.26"
      ],
      "env": {
        "NPM_CONFIG_CACHE": ".cache/npm-cache",
        "MEMORY_FILE_PATH": "docs/00-project/ai/memory/mcp-memory.json"
      },
      "startup_timeout_sec": 120
    },
    "filesystem": {
      "command": "bash",
      "args": [
        "scripts/ai/mcp/mcp_filesystem_wrapper.sh"
      ],
      "env": {
        "NPM_CONFIG_CACHE": ".cache/npm-cache"
      }
    },
    "adr-analysis": {
      "type": "http",
      "url": "http://127.0.0.1:8813/mcp",
      "startup_timeout_sec": 60
    },
    "context7": {
      "type": "http",
      "url": "http://127.0.0.1:8815/mcp",
      "startup_timeout_sec": 60
    },
    "ast-grep": {
      "type": "http",
      "url": "http://127.0.0.1:8816/mcp",
      "startup_timeout_sec": 60
    },
    "github": {
      "type": "http",
      "url": "http://127.0.0.1:8820/mcp",
      "startup_timeout_sec": 60
    },
    "fetch": {
      "type": "http",
      "url": "http://127.0.0.1:8821/mcp",
      "startup_timeout_sec": 60
    },
    "brave-search": {
      "type": "http",
      "url": "http://127.0.0.1:8811/mcp",
      "startup_timeout_sec": 60
    },
    "prometheus": {
      "type": "http",
      "url": "http://127.0.0.1:8822/mcp",
      "startup_timeout_sec": 60
    },
    "grafana": {
      "type": "http",
      "url": "http://127.0.0.1:8823/mcp",
      "startup_timeout_sec": 60
    },
    "deja": {
      "type": "http",
      "url": "http://127.0.0.1:8814/mcp",
      "startup_timeout_sec": 60
    }
  }
}
