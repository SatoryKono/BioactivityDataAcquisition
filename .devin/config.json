{
  "version": 2,
  "permissions": {
    "ask": [
      "Read(.env*)",
      "Read(**/.env*)",
      "exec",
      "Write(**)"
    ],
    "allow": [
      "Read(**/.devin/**)",
      "Read(**/docs/**)",
      "Read(**/configs/**)",
      "Read(**/src/**)",
      "Read(**/tests/**)",
      "Read(**/scripts/**)",
      "Read(**/Makefile)"
    ],
    "deny": [
      "Write(.env*)",
      "Write(**/.env*)"
    ]
  },
  "read_config_from": {
    "agents_standard": true
  }
}
